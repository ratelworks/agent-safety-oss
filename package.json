{
  "name": "agent-safety-oss",
  "version": "1.3.0",
  "description": "Lightweight Korean construction-safety ontology MCP server for safety managers and site managers. Provides 88 MCP tools over a 94 docId legal-duty master, 132 form index, 19 guides, 3,336-node operational graph with canonical IRI + recursive Resource loading + 40-edge graphology traversal + GraphRepository SSoT + HarnessPolicy detection, bundled statutes, KOSHA Guide 1,039 bodies (offline), document generation/review, and field evidence/issue/action workflows.",
  "type": "module",
  "main": "build/index.js",
  "types": "build/index.d.ts",
  "exports": {
    ".": {
      "types": "./build/index.d.ts",
      "import": "./build/index.js",
      "default": "./build/index.js"
    },
    "./tool-registry": {
      "types": "./build/tool-registry.d.ts",
      "import": "./build/tool-registry.js"
    },
    "./ontology/*": "./build/ontology/*"
  },
  "bin": {
    "agent-safety-oss": "build/cli.js"
  },
  "files": [
    "build",
    "docs",
    "examples",
    "README.md",
    "README-EN.md",
    "LICENSE",
    "NOTICE.md",
    "CHANGELOG.md",
    ".env.example"
  ],
  "scripts": {
    "build": "tsc && tsx scripts/build/copy-ontology-assets.ts && node -e \"import('fs').then(fs=>fs.chmodSync('build/cli.js',0o755))\"",
    "watch": "tsc --watch",
    "start": "node build/index.js",
    "test": "npm run check:essence && npm run check:lightweight && npm run mcp:test:smoke",
    "test:full": "npm run mcp:test:all",
    "cli": "node build/cli.js",
    "dev": "tsx src/index.ts",
    "typecheck": "npm run typecheck:src && npm run build && npm run typecheck:scripts",
    "typecheck:src": "tsc --noEmit",
    "typecheck:scripts": "tsc --noEmit -p tsconfig.scripts.json",
    "mcp:start": "node build/cli.js serve",
    "mcp:tools": "node build/cli.js tools",
    "mcp:inspect": "npx @modelcontextprotocol/inspector node build/cli.js serve",
    "mcp:test:smoke": "tsx scripts/test/e2e-smoke.ts",
    "mcp:test:a2ui": "tsx scripts/test/test-a2ui-workflow.ts",
    "mcp:test:lifecycle": "tsx scripts/test/test-lifecycle-tools.ts",
    "mcp:test:scenarios": "tsx scripts/test/test-real-scenarios.ts",
    "mcp:test:real-input": "tsx scripts/test/field-real-input-eval.ts",
    "mcp:test:field-user": "tsx scripts/test/field-user-tester.ts",
    "mcp:test:coverage": "tsx scripts/audit/coverage-report.ts",
    "mcp:test:fillrate": "tsx scripts/test/test-document-fillrate.ts",
    "mcp:test:fillrate:top": "tsx scripts/test/test-document-fillrate.ts --top 20",
    "mcp:test:quality": "tsx scripts/quality/document-quality-test.ts",
    "mcp:test:reasoning": "tsx scripts/test/test-graph-reasoning.ts",
    "mcp:test:effect": "tsx scripts/test/test-graph-effect.ts",
    "mcp:test:consistency": "tsx scripts/test/test-graph-consistency.ts",
    "mcp:test:graph": "npm run mcp:test:reasoning && npm run mcp:test:consistency && npm run mcp:test:effect",
    "mcp:a2ui:demo": "node build/cli.js call render_a2ui_form --inputJson '{\"docId\":\"daily_tbm\",\"format\":\"jsonl\"}'",
    "mcp:demo:viewer": "tsx scripts/dev/demo-a2ui-viewer.ts",
    "mcp:test:all": "npm run build && npm run mcp:test:lifecycle && npm run mcp:test:a2ui && npm run mcp:test:scenarios && npm run mcp:test:fillrate:top && npm run mcp:test:graph",
    "sync-kosha": "tsx scripts/sync/sync-kosha-data.ts",
    "sync-safety-laws": "tsx scripts/sync/sync-safety-laws.ts",
    "crawl-kosha": "tsx scripts/sync/crawl-kosha-portal.ts",
    "validate-jsonld": "tsx scripts/verify/validate-jsonld.ts",
    "verify-graph": "tsx scripts/verify/verify-graph-integrity.ts",
    "verify-graph:strict": "tsx scripts/verify/verify-graph-integrity.ts --strict",
    "validate-shapes": "tsx scripts/verify/validate-shapes.ts",
    "validate-shapes:strict": "tsx scripts/verify/validate-shapes.ts --strict",
    "validate-shacl": "tsx scripts/verify/validate-shacl.ts",
    "evaluate-jsonld": "tsx scripts/verify/evaluate-jsonld.ts",
    "normalize-iri": "tsx scripts/ontology/normalize-iri-references.ts",
    "verify-kosha": "tsx scripts/verify/verify-kosha-guides.ts",
    "p0-verify": "tsx scripts/verify/p0-verify.ts",
    "ontology-test": "tsx scripts/verify/ontology-effect-test.ts",
    "export-rdf": "tsx scripts/ontology/export-rdf.ts",
    "sparql-test": "tsx scripts/verify/sparql-test.ts",
    "quality-regression": "tsx scripts/quality/quality-regression.ts",
    "quality-stress": "tsx scripts/quality/quality-stress-test.ts",
    "form-conformance": "tsx scripts/verify/form-conformance.ts",
    "auto-improve": "tsx scripts/quality/auto-improve.ts",
    "audit": "tsx scripts/audit/audit-graph-health.ts && tsx scripts/audit/legal-coverage-audit.ts",
    "audit:strict": "tsx scripts/audit/audit-graph-health.ts --strict",
    "audit:critical": "tsx scripts/audit/audit-graph-health.ts --strict --critical",
    "quality-all": "npm run build && npm run form-conformance && npm run quality-regression && npm run quality-stress",
    "verify-all": "npm run validate-jsonld && npm run verify-graph && npm run validate-shapes && npm run verify-kosha && npm run p0-verify && npm run audit:strict && npm run audit:graph-v2 && npm run audit:expand && npm run audit:blocker-contract && npm run audit:master-cycle-drift",
    "audit:blocker-contract": "tsx scripts/audit/audit-blocker-contract.ts",
    "audit:master-cycle-drift": "tsx scripts/audit/audit-master-cycle-drift.ts",
    "check:essence": "tsx scripts/verify/check-essence.ts",
    "check:lightweight": "tsx scripts/verify/check-lightweight.ts",
    "check:all": "npm run check:essence && npm run check:lightweight",
    "ontology:gate": "npm run validate-jsonld && npm run validate-shacl && npm run verify-graph && npm run audit:graph-v2 && npm run audit:strict && npm run ontology:operational && npm run verify:tool-capability && npm run verify:edge-context && npm run verify:link-type",
    "verify:tool-capability": "tsx scripts/verify/verify-tool-capability-drift.ts",
    "verify:edge-context": "tsx scripts/verify/verify-edge-context-drift.ts",
    "verify:link-type": "tsx scripts/verify/verify-link-type-semantics.ts",
    "prepublishOnly": "npm run build && npm run check:essence && npm run check:lightweight && npm run verify-all && npm run validate-shacl && npm run verify:tool-capability && npm run verify:edge-context && npm run verify:link-type && npm run form-conformance && npm run quality-regression && npm run check:doc-sync",
    "audit:expand": "tsx scripts/audit/audit-jsonld-expand.ts",
    "audit:graph-v2": "tsx scripts/audit/audit-ontology-v2.ts",
    "ontology:operational": "tsx scripts/verify/verify-operational-ontology.ts",
    "check:doc-sync": "tsx scripts/verify/check-doc-code-sync.ts"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "safety",
    "kosha",
    "industrial-safety",
    "construction-safety",
    "site-manager",
    "safety-manager",
    "korea",
    "msds",
    "risk-assessment",
    "open-source",
    "public-interest",
    "ontology",
    "agent-operating-layer",
    "construction-ontology"
  ],
  "author": {
    "name": "Ratelworks Inc.",
    "email": "alphamale@ratelworks.co.kr",
    "url": "https://ratelworks.co.kr"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ratelworks/agent-safety-oss"
  },
  "bugs": {
    "url": "https://github.com/ratelworks/agent-safety-oss/issues"
  },
  "homepage": "https://github.com/ratelworks/agent-safety-oss#readme",
  "engines": {
    "node": ">=20.19.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "commander": "^12.1.0",
    "fast-xml-parser": "^5.8.0",
    "graphology": "^0.26.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@rdfjs/dataset": "^2.0.2",
    "@rdfjs/parser-n3": "^2.1.0",
    "@types/jsonld": "^1.5.15",
    "@types/n3": "^1.26.1",
    "@types/node": "^22.19.19",
    "@zazuko/env-node": "^3.0.0",
    "clownface": "^2.0.3",
    "jsonld": "^9.0.0",
    "kordoc": "^2.8.0",
    "n3": "^2.0.3",
    "pdfjs-dist": "^5.7.284",
    "rdf-ext": "^2.6.0",
    "rdf-validate-shacl": "^0.6.5",
    "tsx": "^4.22.3",
    "typescript": "^5.7.2"
  }
}