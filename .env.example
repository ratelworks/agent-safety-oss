# ============================================================
# agent-safety-oss-mcp — 환경변수 샘플
# 복사: cp .env.example .env
# ============================================================
# 공공 OpenAPI 7개 (재해사례·사망사고·MSDS·보호구인증·안전보건자료실 등) 호출에는
# 라텔웍스 발행 AgentHQ API 키가 필수입니다.
# (KOSHA Guide 본문 1,039건은 번들 통합 — get_kosha_guide_md 도구로 키 없이 offline 조회)
#
# 가입 / 발급 (무료):
#   1. https://ratelworks.co.kr/agenthq/api-key
#   2. 이메일로 발송되는 키 (예: ASF_xxxx_yyyy) 를 받아
#   3. 아래 AGENTHQ_API_KEY 에 설정
#      또는 link_company_key MCP 도구로 ~/.agent-safety-oss-mcp/company-key.json 에 저장
#
# 키 없이 작동하는 도구:
#   - 법령 7종 검색·조회 (search_safety_laws / get_safety_law_article / list_core_safety_laws)
#   - 그래프 traversal (assemble_doc_context / generate_safety_document)
#   - 양식 94종 / KRAS 7방법 / 외국인 자료 딥링크 등 16개
# 즉 공공 OpenAPI 7개를 사용하지 않을 경우 키 없이도 대부분 도구 사용 가능.
# ============================================================

# ------------------------------------------------------------
# 라텔웍스 발행 AgentHQ API 키 (공공 OpenAPI 호출 시 필수)
# 발급: https://ratelworks.co.kr/agenthq/api-key
# ------------------------------------------------------------
AGENTHQ_API_KEY=

# ------------------------------------------------------------
# 런타임 옵션
# ------------------------------------------------------------
LOG_LEVEL=info
PORT=7345
CACHE_TTL_SEC=300
REQUEST_TIMEOUT_MS=15000

# ============================================================
# 라텔웍스 운영팀 / 사내 자체 중계 운영 조직 전용 옵션
# (외부 사용자에게는 해당 없음 — 일반 사용은 위 AGENTHQ_API_KEY 만 설정)
# ============================================================
# 라텔웍스 운영 KOSHA Live 중계를 우회하고 직접 호출하려는 경우
# (자체 중계 운영 / 운영팀 디버깅 / 데이터 거버넌스 정책 적용 시)
#
# KOSHA_RELAY_URL=                # 빈 문자열 → 라텔웍스 중계 우회. 미설정 → 코드 기본값(라텔웍스) 사용
# DATA_GO_KR_KEY=                 # KOSHA_RELAY_URL="" 시 필수 (자체 발급 data.go.kr 키)
# KOSHA_SAFETY_MATERIAL_KEY=      # 개별 API 키 분리 운영 시
# KOSHA_ACCIDENT_CASE_KEY=
# KOSHA_ACCIDENT_ATTACHMENT_KEY=
# KOSHA_CONSTRUCTION_FATAL_KEY=
# KOSHA_ALL_FATAL_KEY=
# KOSHA_MSDS_KEY=
# KOSHA_GUIDE_KEY=
# KOSHA_PPE_KEY=
