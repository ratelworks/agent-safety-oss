    {
      "@id": "hazard:cave_in",
      "@type": [
        "safety:Hazard",
        "bfo:BFO_0000016",
        "iso45001:Hazard",
        "owl:NamedIndividual"
      ],
      "rdfs:label": [
        {"@value": "굴착면 붕괴 위험", "@language": "ko"},
        {"@value": "Excavation Face Cave-in Hazard", "@language": "en"}
      ],
      "rdfs:comment": [
        {"@value": "굴착면이 무너지면서 작업자가 매몰·압사되는 위험. 사망 위험요인. 굴착 2m 이상에서 발생 가능성 ↑.", "@language": "ko"},
        {"@value": "Risk of workers being buried or crushed by excavation face collapse. Fatal hazard. Higher likelihood at depths ≥2m.", "@language": "en"}
      ],
      "safety:mitigatedBy": [
        {"@id": "control:eng_shoring"}
      ],
      "safety:supportedByGuide": [
        {"@id": "doc:kosha_guide/D-C-11-2026"}
      ],
      "prov:wasGeneratedBy": {"@id": "safety:process/skeleton-d2-2026-05-02"},
      "prov:generatedAtTime": {"@value": "2026-05-02T00:00:00Z", "@type": "xsd:dateTime"},
      "prov:wasDerivedFrom": {"@id": "doc:kosha_guide/D-C-11-2026"},
      "prov:hadPrimarySource": {"@id": "https://portal.kosha.or.kr/openapi/v1/file/down/CTC2026012914341697414755/1"},
      "safety:hashStatus": "not_computed",
      "safety:contentHash": "sha256:not-computed-hazard-cave-in-d2"
    },

    {
      "@id": "control:eng_shoring",
      "@type": [
        "safety:ControlMeasure",
        "bfo:BFO_0000016",
        "iso45001:Control",
        "owl:NamedIndividual"
      ],
      "rdfs:label": [
        {"@value": "흙막이 지보공 설치", "@language": "ko"},
        {"@value": "Earth Retaining Shoring Installation", "@language": "en"}
      ],
      "rdfs:comment": [
        {"@value": "굴착 시 굴착면이 붕괴하지 않도록 흙막이 지보공(파일·버팀대·띠장 등)을 설치하는 공학적(Engineering) 통제수단. ERIC 5계층의 Engineering control. KOSHA Guide D-C-1-2025(흙막이공사 기술지원규정) 별도 인용.", "@language": "ko"},
        {"@value": "Engineering control measure of installing earth retaining shoring (piles, struts, walers, etc.) to prevent excavation face collapse. Engineering level of ERIC hierarchy. Cross-referenced with KOSHA Guide D-C-1-2025 (Earth Retaining Construction Technical Guideline).", "@language": "en"}
      ],
      "prov:wasGeneratedBy": {"@id": "safety:process/skeleton-d2-2026-05-02"},
      "prov:generatedAtTime": {"@value": "2026-05-02T00:00:00Z", "@type": "xsd:dateTime"},
      "prov:wasDerivedFrom": {"@id": "doc:kosha_guide/D-C-11-2026"},
      "prov:hadPrimarySource": {"@id": "https://portal.kosha.or.kr/openapi/v1/file/down/CTC2026012914341697414755/1"},
      "safety:hashStatus": "not_computed",
      "safety:contentHash": "sha256:not-computed-control-eng-shoring-d2"
    },

    {
      "@id": "doc:kosha_guide/D-C-11-2026",
      "@type": [
        "safety:KoshaGuide",
        "iao:IAO_0000030",
        "prov:Entity",
        "iso45001:TechnicalGuideline",
        "cc:Document",
        "owl:NamedIndividual"
      ],
      "rdfs:label": [
        {"@value": "굴착 및 토공 안전작업에 관한 기술지원규정", "@language": "ko"},
        {"@value": "Technical Guideline on Excavation and Earthwork Safety Operations", "@language": "en"}
      ],
      "rdfs:comment": [
        {"@value": "한국산업안전보건공단(KOSHA)의 굴착·토공 안전작업 기술지원규정 (D-C-11-2026, 2026-01-30 공표). 산업안전보건기준에 관한 규칙 제2편 제4장 제2절 등 인용. 법적 강제 X, 기술적 권고.", "@language": "ko"},
        {"@value": "KOSHA Technical Guideline on Excavation and Earthwork Safety Operations (D-C-11-2026, published 2026-01-30). References Standard Regulation on OSH Part 2, Chapter 4, Section 2 etc. Not legally enforced — recommended.", "@language": "en"}
      ],
      "safety:guideNumber": "D-C-11-2026",
      "safety:legalAuthority": "recommended",
      "safety:legalBasis": [
        {"@id": "art:기준규칙:38"}
      ],
      "dcterms:issued": {"@value": "2026-01-30", "@type": "xsd:date"},
      "dcterms:publisher": "한국산업안전보건공단 (KOSHA)",
      "dcterms:license": "공공누리 출처표시-변경금지",
      "prov:wasGeneratedBy": {"@id": "safety:process/kosha-editorial-2026-01-30"},
