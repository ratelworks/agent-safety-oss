    {
      "@id": "art:기준규칙:38",
      "@type": [
        "safety:Article",
        "akn:Article",
        "iao:IAO_0000030",
        "prov:Entity",
        "cc:Document",
        "owl:NamedIndividual"
      ],
      "rdfs:label": [
        {"@value": "산업안전보건기준에 관한 규칙 제38조 (사전조사 및 작업계획서의 작성 등)", "@language": "ko"},
        {"@value": "Standard Regulation on OSH, Article 38 (Preliminary Survey and Work Plan Preparation)", "@language": "en"}
      ],
      "rdfs:comment": [
        {"@value": "고용노동부령 산업안전보건기준에 관한 규칙 제38조. 사업주는 별표 4의 작업을 하는 경우 근로자의 위험을 방지하기 위해 해당 작업·장소·기계기구·시설·설비 등 사전조사를 실시하고 작업계획서를 작성하여 작업을 지휘해야 한다.", "@language": "ko"},
        {"@value": "Article 38 of the Standard Regulation on Occupational Safety and Health (Ministry of Employment and Labor Ordinance). For Annex 4 operations, employers must conduct preliminary surveys (work, location, machinery, facility, equipment), prepare a work plan, and direct operations to prevent worker hazards.", "@language": "en"}
      ],
      "safety:articleNumber": "38",
      "safety:legalAuthority": "enforced",
      "dcterms:publisher": "고용노동부",
      "dcterms:license": "저작권법 제7조 (자유 인용)",
      "prov:wasGeneratedBy": {"@id": "safety:process/law-go-kr-sync"},
      "prov:generatedAtTime": {"@value": "2026-05-02T00:00:00Z", "@type": "xsd:dateTime"},
      "prov:wasDerivedFrom": {"@id": "https://www.law.go.kr/lsInfoP.do?lsiSeq=178530"},
      "prov:hadPrimarySource": {"@id": "https://www.law.go.kr/lsInfoP.do?lsiSeq=178530"},
      "safety:hashStatus": "not_computed",
      "safety:contentHash": "sha256:not-computed-기준규칙-§38"
    },

