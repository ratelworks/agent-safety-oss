    {
      "@id": "safety:action/create_work_plan_excavation",
      "@type": [
        "safety:Action",
        "prov:Plan",
        "iao:IAO_0000030",
        "owl:NamedIndividual"
      ],
      "rdfs:label": [
        {"@value": "굴착 작업계획서 자동 생성 액션", "@language": "ko"},
        {"@value": "Excavation Work Plan Auto-Generation Action", "@language": "en"}
      ],
      "rdfs:comment": [
        {"@value": "한국 안전관리자가 LLM에게 위임하는 굴착 작업계획서 자동 생성. 산안기준규칙 §38 + 별표 4 6호 기준. 그래프 traversal로 위험·통제·법조문·KOSHA Guide 자동 인용. PROV-O로 출처 추적 + 환각 0 보장.", "@language": "ko"},
        {"@value": "LLM-delegated automatic generation of excavation work plan. Based on Standard Regulation Article 38 + Annex 4 Item 6. Graph traversal auto-cites hazards, controls, legal articles, KOSHA Guides. PROV-O for provenance tracking + hallucination prevention.", "@language": "en"}
      ],
      "safety:appliesTo": {"@id": "activity:excavation_2m_plus"},
      "safety:hasParameter": "{\"$schema\":\"https://json-schema.org/draft/2020-12/schema\",\"type\":\"object\",\"properties\":{\"docId\":{\"type\":\"string\",\"const\":\"work_plan_excavation\"},\"draft\":{\"type\":\"object\",\"properties\":{\"siteName\":{\"type\":\"string\"},\"workDate\":{\"type\":\"string\",\"format\":\"date\"},\"workers\":{\"type\":\"integer\",\"minimum\":1},\"excavationDepth\":{\"type\":\"number\",\"minimum\":0,\"description\":\"meters\"},\"groundType\":{\"type\":\"string\"},\"groundwaterDepth\":{\"type\":\"number\",\"description\":\"meters\"},\"adjacentUtility\":{\"type\":\"string\"},\"workDuration\":{\"type\":\"integer\",\"description\":\"days\"}},\"required\":[\"siteName\",\"excavationDepth\"]},\"useProfile\":{\"type\":\"boolean\",\"default\":false},\"scale\":{\"type\":\"object\",\"properties\":{\"workforce\":{\"type\":\"integer\"},\"constructionValue\":{\"type\":\"number\"},\"industry\":{\"type\":\"string\"}}}},\"required\":[\"docId\",\"draft\"]}",
      "safety:submissionCriterion": "draft.excavationDepth >= 2.0 → 산안기준규칙 §38 의무 적용 (별표 4 6호). draft.excavationDepth < 2.0 → 미적용 (단 위험성평가는 별도 의무).",
      "safety:sideEffect": "{\"toolName\":\"generate_safety_document\",\"toolPath\":\"src/tools/generate-safety-document.ts\",\"inputMapping\":{\"docId\":\"$.parameters.docId\",\"draft\":\"$.parameters.draft\",\"useProfile\":\"$.parameters.useProfile\",\"scale\":\"$.parameters.scale\"},\"outputArtifact\":\"markdown\",\"provActivityClass\":\"prov:Activity\",\"auditLog\":\"prov:wasGeneratedBy + prov:generatedAtTime + prov:used\"}",
      "prov:wasGeneratedBy": {"@id": "safety:process/skeleton-d7a-2026-05-02"},
      "prov:generatedAtTime": {"@value": "2026-05-02T00:00:00Z", "@type": "xsd:dateTime"},
      "prov:wasDerivedFrom": {"@id": "doc:kosha_guide/D-C-11-2026"},
      "prov:hadPrimarySource": {"@id": "https://www.law.go.kr/lsInfoP.do?lsiSeq=178530"},
      "safety:hashStatus": "not_computed",
      "safety:contentHash": "sha256:not-computed-action-create-work-plan-excavation"
    },

