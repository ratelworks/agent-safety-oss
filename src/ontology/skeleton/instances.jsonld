    {
      "@id": "activity:excavation_2m_plus",
      "@type": [
        "safety:WorkActivity",
        "bfo:BFO_0000015",
        "iso45001:Activity",
        "owl:NamedIndividual"
      ],
      "rdfs:label": [
        {"@value": "굴착 작업 (깊이 2m 이상)", "@language": "ko"},
        {"@value": "Excavation Work (depth ≥2m)", "@language": "en"}
      ],
      "rdfs:comment": [
        {"@value": "건설현장에서 깊이 2m 이상 굴착하는 작업. 산업안전보건기준에 관한 규칙 제38조(사전조사 및 작업계획서 작성)·제347조(붕괴 등의 위험방지) 적용 대상.", "@language": "ko"},
        {"@value": "Excavation work of depth ≥2m at construction sites. Subject to Standard Regulation on OSH Article 38 (Preliminary Survey and Work Plan) and Article 347 (Cave-in Prevention).", "@language": "en"}
      ],
      "safety:hasHazard": [
        {"@id": "hazard:cave_in"}
      ],
      "safety:guidedBy": [
        {"@id": "doc:kosha_guide/D-C-11-2026"}
      ],
      "safety:legalBasis": [
        {"@id": "art:기준규칙:38"}
      ],
      "prov:wasGeneratedBy": {"@id": "safety:process/skeleton-d2-2026-05-02"},
