      "rdfs:domain": {"@id": "safety:PhotoEvidence"},
      "rdfs:range": {"@id": "xsd:anyURI"},
      "rdfs:label": [
        {"@value": "파일 URI", "@language": "ko"},
        {"@value": "file URI", "@language": "en"}
      ],
      "rdfs:comment": [
