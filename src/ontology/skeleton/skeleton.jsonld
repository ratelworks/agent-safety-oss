      ],
      "rdfs:isDefinedBy": {"@id": "https://safety.ratelworks.org/skeleton/v1"}
    },

    {
      "@id": "safety:dueBy",
      "@type": "owl:DatatypeProperty",
      "rdfs:domain": {"@id": "safety:CorrectiveAction"},
      "rdfs:range": {"@id": "xsd:date"},
      "rdfs:label": [
        {"@value": "조치 기한", "@language": "ko"},
        {"@value": "due by", "@language": "en"}
      ],
