    },

    {
      "@id": "safety:includes",
      "@type": "owl:ObjectProperty",
      "rdfs:domain": {"@id": "safety:SafetyReport"},
      "rdfs:range": {"@id": "safety:SafetyIssue"},
      "rdfs:label": [
        {"@value": "포함함", "@language": "ko"},
        {"@value": "includes", "@language": "en"}
      ],
      "rdfs:comment": [
        {"@value": "안전 보고서가 포함하는 안전 이슈를 연결한다.", "@language": "ko"},
        {"@value": "Links a safety report to the safety issues it includes.", "@language": "en"}
      ],
      "rdfs:isDefinedBy": {"@id": "https://safety.ratelworks.org/skeleton/v1"}
    },

    {
      "@id": "safety:legalBasis",
      "@type": "owl:ObjectProperty",
      "rdfs:range": {"@id": "safety:Article"},
      "rdfs:label": [
        {"@value": "법적 근거", "@language": "ko"},
        {"@value": "legal basis", "@language": "en"}
      ],
      "rdfs:comment": [
        {"@value": "Document 또는 WorkActivity의 법적 근거 조문을 표현. domain은 union(KoshaGuide, WorkActivity)이라 명시 X — SHACL Shape에서 case별 검증.", "@language": "ko"},
        {"@value": "Legal basis article for a Document or WorkActivity. Domain is union (KoshaGuide, WorkActivity), unspecified — case-specific validation in SHACL Shapes.", "@language": "en"}
      ],
      "rdfs:isDefinedBy": {"@id": "https://safety.ratelworks.org/skeleton/v1"}
    },

    {
      "@id": "safety:guideNumber",
      "@type": "owl:DatatypeProperty",
      "rdfs:domain": {"@id": "safety:KoshaGuide"},
      "rdfs:range": {"@id": "xsd:string"},
      "rdfs:label": [
        {"@value": "지침 번호", "@language": "ko"},
        {"@value": "guide number", "@language": "en"}
      ],
      "rdfs:comment": [
        {"@value": "KOSHA Guide 공식 번호 (예: C-39-2023, D-C-11-2026). SHACL pattern: ^[A-Z]+(-[A-Z]+)?-\\d+-\\d{4}$", "@language": "ko"},
        {"@value": "Official KOSHA Guide number (e.g., C-39-2023, D-C-11-2026). SHACL pattern: ^[A-Z]+(-[A-Z]+)?-\\d+-\\d{4}$", "@language": "en"}
      ],
      "rdfs:isDefinedBy": {"@id": "https://safety.ratelworks.org/skeleton/v1"}
    },

    {
      "@id": "safety:articleNumber",
      "@type": "owl:DatatypeProperty",
      "rdfs:domain": {"@id": "safety:Article"},
      "rdfs:range": {"@id": "xsd:string"},
      "rdfs:label": [
        {"@value": "조문 번호", "@language": "ko"},
        {"@value": "article number", "@language": "en"}
      ],
      "rdfs:comment": [
        {"@value": "법령 조문 번호 (예: 38, 347, 별표4). 한국 법령 위계: 편-장-절-조-별표.", "@language": "ko"},
        {"@value": "Law article number (e.g., 38, 347, Annex 4). Korean legal hierarchy: Part-Chapter-Section-Article-Annex.", "@language": "en"}
      ],
      "rdfs:isDefinedBy": {"@id": "https://safety.ratelworks.org/skeleton/v1"}
    },

    {
      "@id": "safety:legalAuthority",
      "@type": "owl:DatatypeProperty",
      "rdfs:range": {"@id": "xsd:string"},
      "rdfs:label": [
        {"@value": "법적 권위", "@language": "ko"},
        {"@value": "legal authority", "@language": "en"}
      ],
      "rdfs:comment": [
        {"@value": "Document의 법적 권위 등급. Enum: 'enforced'(법적 강제), 'recommended'(KOSHA Guide 등 권고), 'informational'(해석례·사례). KoshaGuide는 항상 'recommended' (SHACL constraint).", "@language": "ko"},
        {"@value": "Legal authority level of a Document. Enum: 'enforced' (legally binding), 'recommended' (KOSHA Guide etc.), 'informational' (interpretations, cases). KoshaGuide always 'recommended' (SHACL constraint).", "@language": "en"}
      ],
      "rdfs:isDefinedBy": {"@id": "https://safety.ratelworks.org/skeleton/v1"}
    },

    {
      "@id": "safety:severity",
      "@type": "owl:DatatypeProperty",
      "rdfs:domain": {"@id": "safety:SafetyIssue"},
      "rdfs:range": {"@id": "xsd:string"},
      "rdfs:label": [
        {"@value": "심각도", "@language": "ko"},
        {"@value": "severity", "@language": "en"}
      ],
      "rdfs:comment": [
        {"@value": "안전 이슈의 심각도. Enum: low, medium, high, critical.", "@language": "ko"},
        {"@value": "Severity level of a safety issue. Enum: low, medium, high, critical.", "@language": "en"}
      ],
      "rdfs:isDefinedBy": {"@id": "https://safety.ratelworks.org/skeleton/v1"}
    },

    {
      "@id": "safety:status",
      "@type": "owl:DatatypeProperty",
      "rdfs:range": {"@id": "xsd:string"},
      "rdfs:label": [
        {"@value": "상태", "@language": "ko"},
        {"@value": "status", "@language": "en"}
      ],
      "rdfs:comment": [
        {"@value": "안전 이슈 또는 개선조치의 처리 상태. Enum: open, in_progress, resolved, verified.", "@language": "ko"},
        {"@value": "Processing status of a safety issue or corrective action. Enum: open, in_progress, resolved, verified.", "@language": "en"}
      ],
      "rdfs:isDefinedBy": {"@id": "https://safety.ratelworks.org/skeleton/v1"}
    },

    {
      "@id": "safety:fileUri",
