  },
  "applicableWhen": {
    "appliesTo": "applic:chemicals_handling",
    "scaleNotes": "화학물질 취급 사업장 (5인 미만 포함). 50억 미만 + 5인 이상 사업장도 동일 의무."
  },
  "hasHazard": [
    "hazard:acute_toxic_gas",
    "hazard:fire_explosion",
    "hazard:chemical_burn",
    "hazard:chemical_exposure"
  ],
  "appliesToActivities": [
    "activity:chemical_handling",
    "activity:painting",
    "activity:cement_handling"
  ],
  "informedBy": [
    "entity:kosha",
    "src:kosha:msds"
  ],
  "iso45001Class": "iso45001:Hazard",
  "mitigatedBy": [
    "control:admin_msds",
    "control:ppe_chemical_suit",
    "control:ppe_respirator"
  ],
  "relatedDocs": [
    "doc:as_needed/msds_education_log",
    "doc:daily/hazard_chemical_workplace_log",
    "doc:semi_annual/work_environment_measurement"
  ],
  "industry": "construction",
  "industryNote": "본 OSS 1차 타겟은 건설업 (50억/50인 미만 중소건설현장). 제조업 등 타 업종도 산안법 공통 양식으로 활용 가능."
}
