{
  "@context": "../../context.jsonld",
  "@id": "doc:as_needed/ppe_register",
  "@type": [
    "Document",
    "DigitalDocument"
  ],
  "docId": "ppe_register",
  "title": "보호구 지급대장",
  "alternativeNames": [
    "보호구 지급·관리대장",
    "PPE 지급대장",
    "안전보호구 지급대장"
  ],
  "description": "산안기준규칙 제32조·제33조에 따라 사업주가 근로자에게 지급한 보호구를 기록·관리하는 대장. 안전모·안전화·안전대·보안경·방진마스크 등 인증품 지급 시 필수. 본 노드는 KOSHA·고용노동부 권장 양식 본문과 1:1 매핑 (kordoc parse_form 검증 2026-04-29).",
  "cycle": "cyc:as_needed",
  "trigger": "근로자에게 보호구 지급 시 (신규·교체·재지급).",
  "applicableWhen": {
    "appliesTo": "applic:all_workplace",
    "scaleNotes": "전 사업장 의무 — 50억 미만도 동일."
  },
  "exemptedWhen": {},
  "requiredFields": [
    {
      "key": "approval_charge",
      "label": "담당",
      "source": "공식 양식",
      "inputGuide": "본 양식 작성·관리 책임자.",
      "examples": [
        "김안전 (안전관리자)"
      ]
    },
    {
      "key": "approval_review",
      "label": "검토",
      "source": "공식 양식",
      "inputGuide": "검토 책임자 직책 + 성명 + 서명.",
      "examples": [
        "박감독 (관리감독자)"
      ]
    },
    {
      "key": "approval_owner",
      "label": "사업주",
      "source": "공식 양식",
      "inputGuide": "법인 대표 또는 위임받은 안전보건책임자.",
      "examples": [
        "황한일 (대표)"
      ]
    },
    {
      "key": "occupation",
      "label": "직종",
      "source": "공식 양식",
      "inputGuide": "건설업 직종 분류. 형틀목공·철근공·콘크리트공·전기공·미장공 등.",
      "examples": [
        "철근공"
      ]
    },
    {
      "key": "name",
      "label": "성명",
      "source": "공식 양식",
      "inputGuide": "법인등기부등본 상의 대표자 성명. 외국인은 영문 + 한글 병기.",
      "examples": [
        "황 룡",
        "홍길동",
        "John Smith (존 스미스)"
      ]
    },
    {
      "key": "ppeIssued_safety_helmet",
      "label": "안전모",
      "source": "공식 양식 — 지급 내역",
      "inputGuide": "지급 수량·규격·인증.",
      "examples": [
        "52개 (KOSHA AB / KCs 인증)"
      ]
    },
    {
      "key": "ppeIssued_safety_shoes",
      "label": "안전화",
      "source": "공식 양식",
      "inputGuide": "지급 수량·규격·인증.",
      "examples": [
        "52족 (KCs 인증, 발등보호 포함)"
      ]
    },
    {
      "key": "ppeIssued_safety_harness",
      "label": "안전대",
      "source": "공식 양식",
      "inputGuide": "지급 수량·규격·인증.",
      "examples": [
        "12개 (풀하네스 전체식, KCs 인증)"
      ]
    },
    {
      "key": "ppeIssued_safety_glasses",
      "label": "보안경",
      "source": "공식 양식",
      "inputGuide": "지급 수량·규격·인증.",
      "examples": [
        "20개 (충격·비산물 차단)"
      ]
    },
    {
      "key": "ppeIssued_other",
      "label": "기타",
      "source": "공식 양식",
      "inputGuide": "추가 보호구 (귀마개·방진마스크·방한복 등).",
      "examples": [
        "귀마개 20세트 (소음 90dB 이상 작업) + 방진마스크 30개 (분진작업)"
      ]
    },
    {
      "key": "workerSignature",
      "label": "지급 내역 (작업자 서명날인)",
      "source": "공식 양식",
      "inputGuide": "보호구 지급 작업자 명단 + 자필 서명.",
      "examples": [
        "박작업 (안전모·안전화 / 서명)"
      ]
    },
    {
      "key": "issueDate",
      "label": "지급일",
      "source": "공식 양식",
      "inputGuide": "지급 일자.",
      "examples": [
        "2026-04-29"
      ]
    },
    {
      "key": "remarks",
      "label": "비고",
      "source": "공식 양식",
      "inputGuide": "특이사항·추가 메모.",
      "examples": [
        "우천 시 작업 중지 / 외국인 근로자 통역 동석"
      ]
    }
  ],
  "reviewRules": [
    {
      "rule": "필수 — 직종·성명·지급일·작업자 서명",
      "severity": "blocker",
      "checkFields": [
        "occupation",
        "name",
        "issueDate",
        "workerSignature"
      ]
    },
    {
      "rule": "필수 — 지급 내역 1개 이상 (안전모·안전화·안전대·보안경·기타 중)",
      "severity": "manual_review"
    },
    {
      "rule": "권장 — KCs 안전인증품만 지급 (산안법 제83조·제84조)",
      "severity": "warning"
    },
    {
      "rule": "권장 — 교체 주기 관리 (안전대 1년·안전모 5년 권장)",
      "severity": "warning"
    },
    {
      "rule": "필수 — 결재선 (담당·사업주 서명)",
      "severity": "blocker",
      "checkFields": [
        "approvalChain"
      ]
    },
    {
      "rule": "사람 검토 — 미착용 시 작업중지·경고",
      "severity": "manual_review"
    },
    {
      "rule": "필수 — 위반 시 산안법 제175조 500만원 과태료",
      "severity": "manual_review",
      "legalBasis": "art:산안법:175"
    }
  ],
  "retention": "3년 (산안법 제164조)",
  "standardForm": {
    "source": "KOSHA·고용노동부 권장 양식 — 산안기준규칙 제32조·제33조 (보호구 지급)",
    "sourceUrl": "https://www.moel.go.kr/local/ansan/common/downloadFile.do?file_seq=21171049286&bbs_seq=64410&bbs_id=LOCAL5",
