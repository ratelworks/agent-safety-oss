          "label": "지급 일자",
          "required": true,
          "inputGuide": "YYYY-MM-DD.",
          "examples": [
            "2026-04-29"
          ],
          "checkPoints": []
        },
        {
          "key": "signature",
          "label": "수령자 서명",
          "required": true,
          "inputGuide": "수령자 자필 서명.",
          "examples": [
