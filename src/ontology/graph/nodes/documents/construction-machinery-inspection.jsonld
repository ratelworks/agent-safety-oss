  "docId": "construction_machinery_inspection",
  "title": "건설기계 일상점검",
  "description": "기준규칙 제78조~제116조 건설기계 안전. 운전 시작 전 일일점검. KOSHA Guide C-G-21 권장 양식. 굴삭기·로더·덤프트럭·롤러·콘크리트펌프·믹서트럭·크레인 운반차 등.",
  "cycle": "cyc:daily",
  "trigger": "운전 시작 전 매일",
  "applicableWhen": {
    "appliesTo": "applic:all_workplace",
    "scaleNotes": "건설기계 사용 모든 현장."
  },
  "legalBasis": [
    "art:기준규칙:78",
    "art:기준규칙:79",
    "art:기준규칙:38",
    "annex:기준규칙:별표4-3호",
    "art:기준규칙:86",
    "art:기준규칙:98",
    "art:기준규칙:99",
    "art:기준규칙:100",
    "art:기준규칙:104"
  ],
  "requiredFields": [
    {
      "key": "f_0_점검_일자",
      "label": "점검 일자",
      "source": "산안법 제93조 + KOSHA Guide",
      "inputGuide": "점검 실시일.",
      "examples": [
        "2026-04-29"
      ]
    },
    {
      "key": "f_1_점검자",
      "label": "점검자",
      "source": "산안법 제93조 + KOSHA Guide",
      "inputGuide": "작성한 사람의 성명 + 직책 + (가능 시) 자격번호.",
      "examples": [
        "홍길동 (안전관리자, 산업안전기사 자격 1234567호)",
        "김철수 (현장소장)"
      ]
    },
    {
      "key": "f_2_기계_종류_모델",
      "label": "기계 종류·모델",
      "source": "산안법 제93조 + KOSHA Guide",
      "inputGuide": "건설기계 종류 + 모델.",
      "examples": [
        "굴삭기 22톤 / Volvo EC220"
      ]
    },
    {
      "key": "f_3_엔진_유압",
      "label": "엔진·유압",
      "source": "산안법 제93조 + KOSHA Guide",
      "inputGuide": "엔진·유압 시스템 정상 작동.",
      "examples": [
        "엔진 정상 / 유압 누유 없음 / 유압유 적정"
      ]
    },
    {
      "key": "f_4_브레이크",
      "label": "브레이크",
      "source": "산안법 제93조 + KOSHA Guide",
      "inputGuide": "브레이크 작동·마모 점검.",
      "examples": [
        "주차·작업 브레이크 정상 / 마모 30% (한도 70%)"
      ]
    },
    {
      "key": "f_5_타이어_궤도",
      "label": "타이어·궤도",
      "source": "산안법 제93조 + KOSHA Guide",
      "inputGuide": "타이어 공기압·마모 또는 궤도 장력·마모.",
      "examples": [
        "궤도 장력 정상 / 마모 25% (한도 60%)"
      ]
    },
    {
      "key": "f_6_전도방지장치",
      "label": "전도방지장치",
      "source": "산안법 제93조 + KOSHA Guide",
      "inputGuide": "전도방지장치·아우트리거·안전바 작동.",
      "examples": [
        "아우트리거 4개소 정상 작동 / 안전바 정상"
      ]
    },
    {
      "key": "f_7_신호장치",
      "label": "신호장치",
      "source": "산안법 제93조 + KOSHA Guide",
      "inputGuide": "경음기·후진경보·점멸등 작동.",
      "examples": [
        "전체 정상 (90dB 이상)"
      ]
    },
    {
      "key": "f_8_결과__적합_부적합_",
      "label": "결과 (적합/부적합)",
      "source": "산안법 제93조 + KOSHA Guide",
      "inputGuide": "적합 / 부적합 + 부적합 시 시정 사항.",
      "examples": [
        "적합"
      ]
    },
    {
      "key": "f_9_조치_내용",
      "label": "조치 내용",
      "source": "산안법 제93조 + KOSHA Guide",
      "inputGuide": "발견 위험에 대한 즉시·계획 시정조치.",
      "examples": [
        "1) 안전난간 즉시 설치 / 2) 보호구 미착용자 1명 시정 지도 / 3) 7일 내 재점검"
      ]
    }
  ],
