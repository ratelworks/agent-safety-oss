      "checkFields": [
        "participantsList"
      ]
    },
    {
      "rule": "필수 — 결재선 (교육담당·검토·대표이사 3단)",
      "severity": "blocker",
      "checkFields": [
        "approvalChain"
      ]
    },
    {
      "rule": "권장 — 교육사진 첨부",
      "severity": "warning",
      "checkFields": [
        "trainingPhotos"
      ]
    },
    {
      "rule": "권장 — 정기 교육시간 준수 (사무직 분기 3h·그 외 6h·관리감독자 연 16h)",
      "severity": "warning"
    },
    {
      "rule": "권장 — 특별교육은 시행규칙 별표 5의 2 39종 중 해당 작업 (16h / 단기 2h)",
      "severity": "warning"
    },
    {
      "rule": "권장 — 건설업 기초안전보건교육 일용 4h, 이수증 별첨",
      "severity": "warning"
    },
    {
      "rule": "사람 검토 — 외국인 근로자 모국어 통역·자료 제공 여부",
      "severity": "manual_review"
    }
  ],
