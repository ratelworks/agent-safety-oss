    },
    {
      "rule": "사업주 + 안전관리자 서명",
      "severity": "blocker",
      "legalBasis": "art:기준규칙:57",
      "checkFields": [
        "compiler_sign",
        "principal_sign"
      ]
    }
  ],
  "penaltyOnMissing": "penalty:산안법:175",
  "retention": "1년",
