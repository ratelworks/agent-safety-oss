    },
    {
      "role": "사업주 / 안전보건관리책임자",
      "action": "최종 승인"
    }
  ],
  "reviewRules": [
    {
      "rule": "문서 메타 (사업장명·작성일자·작성자) 명시",
      "severity": "blocker",
      "legalBasis": "art:기준규칙:57",
      "checkFields": [
        "siteName",
        "compileDate",
        "compiler"
