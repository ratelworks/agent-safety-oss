  "title": "상시 위험성평가 (매월·매주·매일·TBM)",
  "alternativeNames": [
    "상시 위험성평가 월간 발굴 기록",
    "월 단위 위험요인 발굴·평가표"
  ],
  "description": "상시평가 선택 사업장이 매월 1회 이상 사업장 순회·아차사고·근로자 제안을 통해 유해·위험요인을 발굴하고 위험성 결정·감소대책을 수립·실행하기 위한 핵심 문서.",
  "cycle": "cyc:monthly",
  "trigger": "상시평가 선택 사업장이 매월 1회 이상 사업장 순회·아차사고·근로자 제안을 통해 유해·위험요인을 발굴하고 위험성 결정·감소대책을 수립·실행하기 위한 핵심 문서.",
  "applicableWhen": {
    "appliesTo": "applic:ongoing_assessment_selected",
    "scaleNotes": "50인 미만·50억 미만도 동일 적용. 안전관리자 미선임 시 사업주·현장소장이 직접 주관."
  },
  "exemptedWhen": {},
  "requiredFields": [
    {
      "key": "site_name",
      "label": "사업장명",
      "source": "위험성평가 고시 제15조",
      "inputGuide": "현장명 또는 본사명. 등기상 명칭 + 현장 식별자.",
      "examples": [
        "황룡건설(주) 삼성동 신축공사 현장"
      ]
    },
    {
      "key": "eval_period",
      "label": "평가 기간 (월)",
      "source": "위험성평가 고시 제15조 ②",
      "inputGuide": "평가 대상 월. YYYY-MM.",
      "examples": [
        "2026-04"
      ]
    },
    {
      "key": "monthly_review",
      "label": "매월 1회 이상 사업장 순회·아차사고·근로자 제안",
      "source": "위험성평가 고시 제15조 ④ 1호",
      "inputGuide": "월 1회 이상 사업장 순회 + 아차사고 보고 + 근로자 위험요인 제안 수렴.",
      "examples": [
        "1) 4/5 순회 (안전관리팀 3명) 12개 위험 / 2) 아차사고 2건 (4/12·4/22) / 3) 근로자 제안 5건"
      ]
    },
    {
      "key": "weekly_decision",
      "label": "매주 1회 이상 안전·보건 관리책임자 작업방법 결정",
      "source": "위험성평가 고시 제15조 ④ 2호",
      "inputGuide": "주 1회 이상 안전보건관리책임자 + 관리감독자 회의로 작업방법 결정.",
      "examples": [
        "매주 월요일 09:00 / 주간 위험요인 + 작업방법 결정 결과 회의록 첨부"
      ]
    },
    {
      "key": "daily_tbm",
      "label": "매 작업일 작업 전 TBM 안전점검회의",
      "source": "위험성평가 고시 제15조 ④ 3호",
      "inputGuide": "매 작업일 시작 전 TBM 회의 (위험성평가 고시 제15조 ④ 3호).",
      "examples": [
        "매일 07:30 TBM (작업반장+근로자) — 일별 TBM 회의록 별지 첨부"
      ]
    },
    {
      "key": "shared_with_workers",
      "label": "근로자 공유·게시 (제13조)",
      "source": "위험성평가 고시 제13조",
      "inputGuide": "위험성평가 결과 근로자 공유 + 현장 게시 (위험성평가 고시 제13조).",
      "examples": [
        "게시판 부착 + TBM 시 근로자 공유 + 안전 메일 (4/5)"
      ]
    },
    {
      "key": "record_3y",
      "label": "기록 보존 3년 (제14조)",
      "source": "위험성평가 고시 제14조",
      "inputGuide": "위험성평가 기록 3년 보존 의무 (위험성평가 고시 제14조).",
      "examples": [
        "전자문서 + 출력본 사무실 캐비닛 보관 (보존 만료: 2029-04)"
      ]
    }
  ],
