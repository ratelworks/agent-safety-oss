  "docId": "safety_health_regulation",
  "title": "안전보건관리규정",
  "description": "사업장 안전보건 유지 위한 관리규정 (산안법 제25조)",
  "cycle": "cyc:annual",
  "legalBasis": [
    "art:산안법:25",
    "art:산안법시행규칙:25",
    "art:산안법:26"
  ],
  "requiredFields": [
    {
      "key": "f_0_사업장명",
      "label": "사업장명",
      "source": "산안법 제25조 + 시행규칙 별표3",
      "inputGuide": "법인등기부등본 또는 사업자등록증 상의 정식 명칭. 약칭·통칭 사용 금지.",
      "examples": [
        "황룡건설(주)",
        "(주)라텔웍스",
        "현대건설 주식회사"
      ]
    },
    {
      "key": "f_1_작성일",
      "label": "작성일",
      "source": "산안법 제25조 + 시행규칙 별표3",
      "inputGuide": "YYYY-MM-DD 형식. 작성·점검·평가 실제 시행 일자.",
      "examples": [
        "2026-04-29",
        "2026-05-15"
      ]
    },
    {
      "key": "f_2_안전보건_관리조직과_직",
      "label": "안전보건 관리조직과 직무",
      "source": "산안법 제25조 + 시행규칙 별표3",
      "inputGuide": "수행 업무.",
      "examples": [
        "안전관리"
      ]
    },
    {
      "key": "f_3_안전보건교육에_관한_사",
      "label": "안전보건교육에 관한 사항",
      "source": "산안법 제25조 + 시행규칙 별표3",
      "inputGuide": "안전보건교육 관련 규정 (대상·시기·시간·방법).",
      "examples": [
        "1) 정기교육 (관리감독자 16시간/년, 근로자 6시간/분기) / 2) 신규채용 8시간 / 3) 작업변경 2시간"
      ]
    },
    {
      "key": "f_4_작업장_안전_보건관리에",
      "label": "작업장 안전·보건관리에 관한 사항",
      "source": "산안법 제25조 + 시행규칙 별표3",
      "inputGuide": "작업장 안전·보건관리 규정.",
      "examples": [
        "1) 위험성평가 매월 / 2) 합동점검 분기 / 3) MSDS 비치 / 4) 보호구 지급·교체"
      ]
    },
    {
      "key": "f_5_사고_조사_대책_수립",
      "label": "사고 조사·대책 수립",
      "source": "산안법 제25조 + 시행규칙 별표3",
      "inputGuide": "재해·아차사고 조사·대책 수립 절차.",
      "examples": [
        "1) 24시간 내 1차 조사 / 2) 7일 내 보고서 / 3) 재발방지 대책 + 이행 점검"
      ]
    },
    {
      "key": "f_6_그_밖에_안전보건_관련",
      "label": "그 밖에 안전보건 관련",
      "source": "산안법 제25조 + 시행규칙 별표3",
      "inputGuide": "기타 안전보건 관련 사항.",
      "examples": [
        "1) 비상연락망 / 2) 응급처치 / 3) 외국인 모국어 교육 / 4) 종사자 의견 청취"
      ]
    },
    {
      "key": "f_7_근로자_대표_의견_청취",
      "label": "근로자 대표 의견 청취",
      "source": "산안법 제25조 + 시행규칙 별표3",
      "inputGuide": "규정 제·개정 시 근로자대표 의견 청취 (산안법 제26조).",
      "examples": [
        "2026-01-15 근로자대표 (이작업) 서면 동의 + 회의록 첨부"
      ]
    },
    {
      "key": "f_8_사업주_서명",
      "label": "사업주 서명",
      "source": "산안법 제25조 + 시행규칙 별표3",
      "inputGuide": "법인등기부등본 상의 대표자 성명. 외국인은 영문 + 한글 병기.",
      "examples": [
        "황 룡",
        "홍길동",
        "John Smith (존 스미스)"
      ]
    }
  ],
  "reviewRules": [
    {
      "rule": "5+1항목 작성",
      "severity": "manual_review",
      "legalBasis": "art:산안법:25"
    },
    {
      "rule": "산업안전보건위원회 또는 근로자대표 의견 청취",
      "severity": "manual_review",
      "legalBasis": "art:산안법:26"
    }
  ],
