  "docId": "work_plan_demolition",
  "title": "해체 작업계획서",
  "description": "구축물·건축물·시설물 해체작업 (별표 4 10호, 2023-11-14 개정으로 확장)",
  "cycle": "cyc:ad_hoc",
  "trigger": "구축물·건축물 해체 작업 전",
  "applicableWhen": {
    "workType": "demolition"
  },
  "legalBasis": [
    "art:기준규칙:38",
    "annex:기준규칙:별표4-10호"
  ],
  "requiredFields": [
    {
      "key": "preSurvey",
      "label": "사전조사 — 해체건물 등의 구조, 주변 상황 등",
      "source": "산업안전보건기준에 관한 규칙 별표 4 제10호 사전조사 내용",
      "inputGuide": "해체 대상 건물 구조 — 철근콘크리트·철골·조적조·목구조 등 + 층수·연면적. (별표 4 원문 항목: 해체건물 등의 구조, 주변 상황 등)",
      "examples": [
        "철근콘크리트조 (지하 2·지상 8층, 연면적 4,200㎡)",
        "1978년 RC조 5층, 외벽 석면 양성(별첨), 인접 도로 5m, 지하 도시가스"
      ]
    },
    {
      "key": "demolitionMethod",
      "label": "가. 해체의 방법 및 해체 순서도면",
      "source": "산업안전보건기준에 관한 규칙 별표 4 제10호 작업계획서 내용 가목",
      "inputGuide": "해체 공법 (압쇄·발파·기계·인력 등) + 단계별 해체 순서 도면 첨부. (별표 4 원문 항목: 해체의 방법 및 해체 순서도면)",
      "examples": [
        "상층부 압쇄 + 하층부 인력 (8층→1층 순) / 도면 첨부",
        "기계식(굴삭기 + 압쇄기), 5층 → 1층 순차"
      ]
    },
    {
      "key": "facilities",
      "label": "나. 가설설비ㆍ방호설비ㆍ환기설비 및 살수ㆍ방화설비 등의 방법",
      "source": "산업안전보건기준에 관한 규칙 별표 4 제10호 작업계획서 내용 나목",
      "inputGuide": "비계·낙하방호망·분진차단막·살수설비 위치 + 작동 방법. (별표 4 원문 항목: 가설설비ㆍ방호설비ㆍ환기설비 및 살수ㆍ방화설비 등의 방법)",
      "examples": [
        "외부 시스템비계 + 분진차단막 (이중) + 상시 살수 + 소화기 6층마다 2대"
      ]
    },
    {
      "key": "communication",
      "label": "다. 사업장 내 연락방법",
      "source": "산업안전보건기준에 관한 규칙 별표 4 제10호 작업계획서 내용 다목",
      "inputGuide": "현장 내 비상·긴급 연락 체계 (무전기·확성기·핫라인). (별표 4 원문 항목: 사업장 내 연락방법)",
      "examples": [
        "현장: 무전기 채널 7 / 119·112 직통 / 안전관리자 010-1234-5678"
      ]
    },
    {
      "key": "disposalPlan",
      "label": "라. 해체물의 처분계획",
      "source": "산업안전보건기준에 관한 규칙 별표 4 제10호 작업계획서 내용 라목",
      "inputGuide": "해체 폐기물 분리·반출·재활용 계획 (석면·납·PCB 등 유해물 별도). (별표 4 원문 항목: 해체물의 처분계획)",
      "examples": [
        "철근콘크리트 분리 → 인근 재활용업체 / 석면 함유 폐기물 → 지정폐기물 처리업체"
      ]
    },
    {
      "key": "machinePlan",
      "label": "마. 해체작업용 기계ㆍ기구 등의 작업계획서",
      "source": "산업안전보건기준에 관한 규칙 별표 4 제10호 작업계획서 내용 마목",
      "inputGuide": "굴삭기·압쇄기·크러셔 등 사용 기계 + 안전조치. (별표 4 원문 항목: 해체작업용 기계ㆍ기구 등의 작업계획서)",
      "examples": [
        "굴삭기 30톤 (압쇄기 부착) 1대 / 크러셔 1대 / 안전검사필증 첨부"
      ]
    },
    {
      "key": "explosivesPlan",
      "label": "바. 해체작업용 화약류 등의 사용계획서",
      "source": "산업안전보건기준에 관한 규칙 별표 4 제10호 작업계획서 내용 바목",
      "inputGuide": "발파 사용 시 화약류 종류·수량·관리책임자 (해체에서 발파 사용은 드묾). (별표 4 원문 항목: 해체작업용 화약류 등의 사용계획서)",
      "examples": [
        "해당 없음 (인력·기계 해체)"
      ]
    },
    {
      "key": "otherSafety",
      "label": "사. 그 밖에 안전ㆍ보건에 관련된 사항",
      "source": "산업안전보건기준에 관한 규칙 별표 4 제10호 작업계획서 내용 사목",
      "inputGuide": "위 항목 외 추가 안전조치·보건조치. (별표 4 원문 항목: 그 밖에 안전ㆍ보건에 관련된 사항)",
      "examples": [
        "소음·진동 인근 민원 대응 + 작업시간 제한 (08:00~17:00) + 분진 측정 주 1회"
      ]
    },
    {
      "key": "notifiedToWorkers",
      "label": "작업계획서 내용을 해당 근로자에게 알림 (안전보건규칙 제38조제2항)",
      "source": "산업안전보건기준에 관한 규칙 제38조제2항",
      "inputGuide": "작성한 작업계획서의 내용을 해당 근로자에게 알렸는지와 그 방법·일시를 적는다.",
      "examples": [
        "작업 전 TBM 에서 작업계획서 내용 설명 (2026-03-02 07:30, 참석 12명 서명)"
      ]
    }
  ],
