  "title": "중량물 작업계획서",
  "description": "중량물 취급작업 (별표 4 11호)",
  "cycle": "cyc:ad_hoc",
  "trigger": "중량물 취급 작업 전",
  "applicableWhen": {
    "workType": "heavy_lifting"
  },
  "legalBasis": [
    "art:기준규칙:38",
    "annex:기준규칙:별표4-11호",
    "art:기준규칙:168"
  ],
  "requiredFields": [
    {
      "key": "f_0_추락위험_예방_안전대책",
      "label": "추락위험 예방 안전대책",
      "source": "산안기준규칙 제38조 + 별표 4 11호",
      "inputGuide": "중량물 작업 시 추락 예방 대책.",
      "examples": [
        "고소작업대 작업 시 안전대 100% 체결 + 안전난간"
      ]
    },
    {
      "key": "f_1_낙하위험_예방_안전대책",
      "label": "낙하위험 예방 안전대책",
      "source": "산안기준규칙 제38조 + 별표 4 11호",
      "inputGuide": "중량물 낙하 예방 대책 (양중 시).",
      "examples": [
        "두 줄 걸이 + 와이어로프 안전계수 5 이상 + 신호수 + 하부 통제선 (반경 1.5배)"
      ]
    },
    {
      "key": "f_2_전도위험_예방_안전대책",
      "label": "전도위험 예방 안전대책",
      "source": "산안기준규칙 제38조 + 별표 4 11호",
      "inputGuide": "중장비 전도 예방 대책.",
      "examples": [
        "아우트리거 4개소 완전 펴기 + 강판 받침대 + 지반 평탄도 확인"
      ]
    },
    {
      "key": "f_3_협착위험_예방_안전대책",
      "label": "협착위험 예방 안전대책",
      "source": "산안기준규칙 제38조 + 별표 4 11호",
      "inputGuide": "양중 하부 협착 예방 대책.",
      "examples": [
        "양중 하부 작업자 진입 금지 + 신호수 + 무전기 통신"
      ]
    },
    {
      "key": "f_4_붕괴위험_예방_안전대책",
      "label": "붕괴위험 예방 안전대책",
      "source": "산안기준규칙 제38조 + 별표 4 11호",
      "inputGuide": "지반·구조물 붕괴 예방 대책.",
      "examples": [
        "지반 다짐도 확인 + 작업 중량 < 지반 지지력 / 인접 구조물 균열 점검"
      ]
    }
  ],
  "reviewRules": [
    {
      "rule": "5대 위험 모두 안전대책 작성",
      "severity": "manual_review",
      "legalBasis": "annex:기준규칙:별표4-11호"
    },
    {
      "rule": "근로자 통지 (제38조 ②)",
      "severity": "manual_review",
      "legalBasis": "art:기준규칙:38"
    }
  ],
  "sections": [
    {
      "title": "1. 문서 메타",
      "legalSource": "공통",
      "fields": [
        {
          "key": "documentNumber",
          "label": "문서번호",
