  "docId": "work_plan_electric_work",
  "title": "전기작업 계획서",
  "description": "전기작업 (50V 초과 또는 250VA 초과) 작업 전 (별표 4 5호)",
  "cycle": "cyc:ad_hoc",
  "trigger": "50V 초과 전기작업 전",
  "applicableWhen": {
    "workType": "electric_work_50v_plus",
    "voltageGte": 50
  },
  "legalBasis": [
    "art:기준규칙:38",
    "annex:기준규칙:별표4-5호",
    "art:기준규칙:301",
    "art:기준규칙:319"
  ],
  "requiredFields": [
    {
      "key": "purpose",
      "label": "전기작업 목적·내용",
      "source": "산안기준규칙 제38조 + 별표 4 5호",
      "inputGuide": "전기작업 목적 + 작업 내용.",
      "examples": [
        "저압 분전반 신규 설치 / 200A × 2개소 / 활선 주변 작업"
      ]
    },
    {
      "key": "qualifications",
      "label": "근로자 자격·적정 인원",
      "source": "산안기준규칙 제38조 + 별표 4 5호",
      "inputGuide": "전기작업 자격자 (전기기능사 이상) + 적정 인원.",
      "examples": [
        "전기기사 1명 + 전기기능사 2명 + 보조 1명 (총 4명)"
      ]
    },
    {
      "key": "f_2_작업_범위_작업책임자_",
      "label": "작업 범위·작업책임자 임명·전격·섬락 보호구 착용",
      "source": "산안기준규칙 제38조 + 별표 4 5호",
      "inputGuide": "작업 범위 + 작업책임자 + 보호구 (절연장갑·절연화·헬멧).",
      "examples": [
        "작업범위: A동 1층 분전반 / 책임자: 김전기 (전기기사) / 절연장갑 7kV급 + 절연화 + 절연 헬멧"
      ]
    }
  ],
  "reviewRules": [
    {
      "rule": "작업계획 작성",
      "severity": "manual_review",
      "legalBasis": "annex:기준규칙:별표4-5호"
    },
    {
      "rule": "근로자 통지 (제38조 ②)",
      "severity": "manual_review",
      "legalBasis": "art:기준규칙:38"
    }
  ],
  "sections": [
    {
      "title": "1. 문서 메타",
      "legalSource": "공통",
      "fields": [
        {
          "key": "documentNumber",
          "label": "문서번호",
          "required": true,
          "inputGuide": "현장 자체 일련번호 (DOC-YYMMDD-NN).",
          "examples": [
            "DOC-260429-01"
          ],
          "checkPoints": []
        },
        {
          "key": "siteName",
          "label": "사업장 / 현장명",
          "required": true,
          "inputGuide": "사업장 정식 명칭.",
          "examples": [
            "황룡건설(주) 삼성동 현장"
          ],
          "checkPoints": []
        },
        {
          "key": "compileDate",
          "label": "작성 일자",
          "required": true,
          "inputGuide": "YYYY-MM-DD.",
          "examples": [
            "2026-04-29"
          ],
          "checkPoints": []
        },
        {
          "key": "compiler",
          "label": "작성자 (안전관리자)",
          "required": true,
          "inputGuide": "성명·직책.",
          "examples": [
            "김안전 (안전관리자)"
          ],
          "checkPoints": []
        }
      ]
    },
    {
      "title": "2. 전기작업 계획서 (별표 4 5호)",
      "legalSource": "산안기준규칙 제38조 + 별표 4 5호 + 제301조 + 제319조",
      "fields": [
        {
          "key": "workScope",
          "label": "작업 범위",
          "required": true,
          "inputGuide": "활선·정전·근접 작업.",
          "examples": [
            "분전반 정비 (380V 정전작업)"
          ],
          "checkPoints": []
        },
        {
          "key": "voltageLevel",
          "label": "전압 등급",
          "required": true,
          "inputGuide": "저압·고압·특고압.",
          "examples": [
            "저압 380V 3상"
          ],
          "checkPoints": []
        },
        {
          "key": "isolationProcedure",
          "label": "차단·잠금 절차 (LOTO)",
          "required": true,
          "inputGuide": "제319조(정전전로에서의 전기작업) 잠금·표지 절차. 정전 확인 → 잠금 → 표지 → 작업.",
          "examples": [
            "1) 메인 차단 OFF, 2) LOTO 자물쇠 + 표지, 3) 무전압 검전, 4) 작업"
          ],
          "checkPoints": []
        },
        {
          "key": "qualifiedWorkers",
          "label": "자격 작업자",
          "required": true,
          "inputGuide": "전기기능사 이상 자격.",
          "examples": [
            "박전기 (전기기사) + 김전기 (전기기능사)"
          ],
          "checkPoints": []
        },
        {
          "key": "insulationPPE",
          "label": "절연 보호구",
          "required": true,
          "inputGuide": "절연장갑·절연화·절연매트.",
          "examples": [
            "7kV 절연장갑·절연화 + 절연매트"
          ],
          "checkPoints": []
        }
      ]
    },
    {
      "title": "결재선",
      "legalSource": "공통",
      "fields": [
        {
          "key": "compiler_sign",
          "label": "작성자 서명",
          "required": true,
          "inputGuide": "성명·서명.",
          "examples": [
            "김안전 (서명)"
          ],
          "checkPoints": []
        },
        {
          "key": "supervisor_sign",
          "label": "관리감독자 서명",
          "required": true,
          "inputGuide": "성명·서명.",
          "examples": [
            "박감독 (서명)"
          ],
          "checkPoints": []
        },
        {
          "key": "principal_sign",
          "label": "사업주/안전보건관리책임자 서명",
          "required": true,
          "inputGuide": "현장소장 서명.",
          "examples": [
            "황룡 (현장소장, 서명)"
          ],
          "checkPoints": []
        }
      ]
    }
  ],
