{
  "@context": "../../context.jsonld",
  "@id": "doc:monthly/safety_health_mgmt_cost_plan",
  "@type": [
    "Document",
    "DigitalDocument"
  ],
  "docId": "safety_health_mgmt_cost_plan",
  "title": "산업안전보건관리비 계획·집행·정산",
  "description": "건설공사 산업안전보건관리비 (계상·집행·정산) 사용계획·내역서. 산안법 제72조 + 건설업 산업안전보건관리비 계상 및 사용기준 (고용노동부 고시 제2025-11호, 2025-02-12 시행).",
  "cycle": "cyc:monthly",
  "trigger": "공사 착공 시 (계획) + 매월 (집행) + 준공 시 (정산)",
  "legalBasis": [
    "art:산안법:72",
    "art:산안법시행규칙:88",
    "art:산안법시행규칙:89"
  ],
  "officialFormSpec": {
    "formId": "moel_safety_health_cost_plan",
    "officialName": "건설업 산업안전보건관리비 계상 및 사용기준 (고용노동부 고시 제2025-11호) 별지 제1호서식 산업안전보건관리비 사용내역서",
    "formMatchType": "고용노동부 고시 별표 1(계상기준표) + 별지 제1호서식(사용내역서) 매핑",
    "license": "공공누리 - 출처 고용노동부"
  },
  "sections": [
    {
      "title": "1. 공사 정보",
      "legalSource": "고시 제3조 (대상 공사)",
      "fields": [
        {
          "key": "siteName",
          "label": "공사명 / 현장명",
          "required": true,
          "inputGuide": "공사 정식 명칭.",
          "examples": [
            "황룡건설(주) 삼성동 ○○공동주택 신축공사"
          ],
          "checkPoints": []
        },
        {
          "key": "contractAmount",
          "label": "도급금액 (계약금액)",
          "required": true,
          "inputGuide": "총 공사금액 (부가세 별도). 2천만원 미만은 적용 제외.",
          "examples": [
            "35억원 (3,500,000,000원, 부가세 별도)"
          ],
          "checkPoints": [
            "2천만원 이상 공사 적용"
          ]
        },
        {
          "key": "contractPeriod",
          "label": "공사 기간",
          "required": true,
          "inputGuide": "착공일 ~ 준공예정일.",
          "examples": [
            "2026-03-01 ~ 2026-09-30 (7개월)"
          ],
          "checkPoints": []
        },
        {
          "key": "constructionType",
          "label": "공사 종류",
          "required": true,
          "inputGuide": "건축·토목·전기·통신·기계 등.",
          "examples": [
            "건축 (공동주택 신축)"
          ],
          "checkPoints": []
        },
        {
          "key": "constructionScale",
          "label": "공사 규모 (연면적·층수·구조)",
          "required": true,
          "inputGuide": "연면적·층수·구조 형식.",
          "examples": [
            "연면적 5,800㎡, 지하 1층 + 지상 7층, 철근콘크리트 라멘조"
          ],
          "checkPoints": []
        }
      ]
    },
    {
      "title": "2. 안전보건관리비 계상",
      "legalSource": "산안법 제72조 ① + 고시 제4조 · 별표 1 (공사종류 및 규모별 계상기준표)",
      "fields": [
        {
          "key": "calcBaseAmount",
          "label": "계상 대상액 (직접재료비 + 간접재료비 + 직접노무비)",
          "required": true,
          "inputGuide": "공사원가계산서의 직접재료비·간접재료비·직접노무비 합계(발주자가 재료를 제공하면 그 재료비 포함). 도급금액과 다름. 대상액이 명확하지 않으면 총공사금액의 10분의 7 (고시 제2조제1항제2호·제4조제1항제3호).",
          "examples": [
            "3,200,000,000원 (직접재료비 2,000M + 간접재료비 200M + 직접노무비 1,000M)"
          ],
          "checkPoints": []
        },
        {
          "key": "applicableRate",
          "label": "계상 요율 (%)",
          "required": true,
          "inputGuide": "고시 별표 1 공사종류(건축·토목·중건설·특수건설)와 대상액 구간별 비율. 예) 건축공사: 5억 미만 3.11% / 5억~50억 2.28% + 기초액 4,325,000원 / 50억 이상 2.37% (보건관리자 선임 대상 2.64%).",
          "examples": [
            "2.28% + 기초액 4,325,000원 (건축공사, 대상액 5억 이상 50억 미만)"
          ],
          "checkPoints": [
            "공사종류(별표 5 예시표)·대상액 구간별 요율 정확 적용"
          ]
        },
        {
          "key": "totalCost",
          "label": "안전보건관리비 총액",
          "required": true,
          "inputGuide": "계상액 = 대상액 × 요율 (대상액 5억 이상 50억 미만은 + 기초액). 발주자 재료 제공 시 제4조제1항 단서 비교.",
          "examples": [
            "77,285,000원 (3,200,000,000 × 2.28% + 4,325,000)"
          ],
          "checkPoints": []
        },
        {
          "key": "additionalCost",
          "label": "설계변경 조정 계상 (해당 시)",
          "required": false,
          "optional": true,
          "inputGuide": "설계변경으로 대상액이 바뀌면 별표 1의3 에 따라 조정 계상: 설계변경 전 관리비 × 대상액 증감 비율. 공사금액이 800억 원 이상으로 증액되면 증액된 대상액으로 재계상 (고시 제4조제5항).",
          "examples": [
            "[해당없음]",
            "대상액 10% 증액 → 77,285,000 × 10% = 7,728,500원 증액"
          ],
          "checkPoints": []
        }
      ]
    },
    {
      "title": "3. 사용 항목 / 계획 (9개 항목 — 별지 제1호서식)",
      "legalSource": "고시 제7조제1항 (사용기준 9호) · 별지 제1호서식 (사용내역서 항목)",
      "fields": [
        {
          "key": "item1_safetyManager",
          "label": "1. 안전·보건관리자 임금 등",
          "required": true,
          "inputGuide": "전담 안전·보건관리자 임금·출장비 전액(비전담은 2분의 1), 작업지휘자·유도자·신호자 임금, 별표 1의2 작업 관리감독자 업무수당(임금의 10분의 1 이내). 선임 보고일부터 발생한 비용 (고시 제7조제1항제1호).",
          "examples": [
            "전담 안전관리자 1명 × 7개월 × 4,500,000원 = 31,500,000원"
          ],
          "checkPoints": []
        },
        {
          "key": "item5_safetyFacility",
          "label": "2. 안전시설비 등",
          "required": true,
          "inputGuide": "안전난간·추락방호망·안전대 부착설비·방호장치 등 구입·임대·설치, 스마트 안전장비 구입·임대(계상액 총액의 10분의 2 이내), 화재위험작업 소화기 (고시 제7조제1항제2호).",
          "examples": [
            "추락방호망 800㎡ × 8,500 + 낙하물방지망 1,200㎡ × 7,500 = 15,800,000원",
            "스마트 안전모 30개 × 250,000 = 7,500,000원 (스마트 안전장비 — 총액의 10분의 2 이내)"
          ],
          "checkPoints": [
            "스마트 안전장비 구입·임대 비용은 계상액 총액의 10분의 2 를 넘지 않을 것"
          ]
        },
        {
          "key": "item3_ppe",
          "label": "3. 보호구 등",
          "required": true,
          "inputGuide": "보호구 구입·수리·관리, 근로자 직접 구매 보호구 보전, 안전관리자 등 업무용 피복·기기, 안전·보건관리자 현장 점검 차량 유류비·수리비·보험료 (고시 제7조제1항제3호).",
          "examples": [
            "풀하네스 안전대 30개 × 80,000 + 안전모 50개 × 25,000 + 안전화 50켤레 × 60,000 = 6,650,000원"
          ],
          "checkPoints": []
        },
        {
          "key": "item4_safetyEquipment",
          "label": "4. 안전보건진단비 등",
          "required": false,
          "optional": true,
          "inputGuide": "유해위험방지계획서 작성, 안전보건진단, 작업환경측정, 법에서 지정한 전문기관 진단·검사·지도 비용 (고시 제7조제1항제4호).",
          "examples": [
            "유해위험방지계획서 작성 1,500,000원 / [해당없음]"
          ],
          "checkPoints": []
        },
        {
          "key": "item2_safetyEducation",
          "label": "5. 안전보건교육비 등",
          "required": true,
          "inputGuide": "법 제29조~제32조 의무교육 장소 설치·운영, 산업재해 예방 목적 교육, 구조·응급처치 교육, 안전 도서·정기간행물, 안전기원 행사, 유해·위험요인 제보 근로자 격려 (고시 제7조제1항제5호).",
          "examples": [
            "월간 안전교육 7회 × 200,000 + 안전기원제 1,000,000 = 2,400,000원"
          ],
          "checkPoints": []
        },
        {
          "key": "item6_healthCheck",
          "label": "6. 근로자 건강장해예방비 등",
          "required": false,
          "optional": true,
          "inputGuide": "법령상 건강장해 예방 비용, 중대재해 목격 정신질환 치료, 감염병 확산 방지 물품, 휴게시설 온도·조명 기준 준수, 자동심장충격기(AED), 온열·한랭질환 예방 임시 휴게시설·냉난방기 임대 (고시 제7조제1항제6호).",
          "examples": [
            "특수건강진단 30명 × 80,000 = 2,400,000원",
            "폭염 대비 임시 휴게시설 임대 1,200,000원"
          ],
          "checkPoints": []
        },
        {
          "key": "item7_techSupport",
          "label": "7. 건설재해예방전문지도기관 기술지도비",
          "required": false,
          "optional": true,
          "inputGuide": "법 제73조·제74조 건설재해예방전문지도기관 지도 대가 — 자기공사자가 지급하는 비용 (고시 제7조제1항제7호).",
          "examples": [
            "[해당없음]",
            "기술지도 월 2회 × 7개월 × 300,000 = 4,200,000원 (자기공사자)"
          ],
          "checkPoints": []
        },
        {
          "key": "item8_smartSafety",
          "label": "8. 본사 전담조직 근로자 임금 등",
          "required": false,
          "optional": true,
          "inputGuide": "건설사업자가 아닌 자가 운영하는 사업의 본사 안전보건 전담조직(3명 이상) 근로자 임금·출장비 — 계상액 총액의 20분의 1 이내 (고시 제7조제1항제8호). 본사만 작성.",
          "examples": [
            "[해당없음]"
          ],
          "checkPoints": [
            "본사 전담조직 임금 등은 계상액 총액의 20분의 1 을 넘지 않을 것"
          ]
        },
        {
          "key": "item9_other",
          "label": "9. 위험성평가 등에 따른 소요비용",
          "required": false,
          "optional": true,
          "inputGuide": "위험성평가 또는 중처법 시행령 제4조제3호에 따라 산업안전보건위원회·노사협의체(없으면 안전보건협의체)가 사용하기로 결정한 개선 비용 — 계상액 총액의 100분의 15 이내 (고시 제7조제1항제9호).",
          "examples": [
            "[해당없음]",
            "위험성평가 결정 사항: 개구부 덮개 추가 설치 3,000,000원"
          ],
          "checkPoints": [
            "위험성평가 등 소요비용은 계상액 총액의 100분의 15 를 넘지 않을 것"
          ]
        }
      ]
    },
    {
      "title": "4. 월별 집행 / 정산",
      "legalSource": "고시 제7조제3항·별표 3 (공정률별 사용기준) + 제9조 (공사 시작 후 6개월마다 1회 이상 발주자·감리자 확인) + 제10조 (실행예산·사용내역서 비치)",
      "fields": [
        {
          "key": "monthlyExecution",
          "label": "월별 집행 내역 (배열)",
          "required": true,
          "inputGuide": "각 월별 [집행월·항목·금액·증빙·잔액] 5개 필드.",
          "examples": [
            [
              {
                "month": "2026-04",
                "item": "안전관리자 인건비",
                "amount": 4500000,
                "evidence": "급여명세서·이체증빙",
                "balance": 58540000
              },
              {
                "month": "2026-04",
                "item": "PPE 구입",
                "amount": 6650000,
                "evidence": "세금계산서 + 입고증빙",
                "balance": 51890000
              },
              {
                "month": "2026-04",
                "item": "안전시설 (추락방호망)",
                "amount": 6800000,
                "evidence": "세금계산서 + 시공사진",
                "balance": 45090000
              }
            ]
          ],
          "checkPoints": [
            "증빙 보존 의무"
          ]
        },
        {
          "key": "totalExecuted",
          "label": "누적 집행액",
          "required": true,
          "inputGuide": "착공일 ~ 보고일 누적 집행액.",
          "examples": [
            "17,950,000원 (착공 2026-03 ~ 2026-04)"
          ],
          "checkPoints": []
        },
        {
          "key": "executionRate",
          "label": "집행률 (%)",
          "required": true,
          "inputGuide": "누적집행액 ÷ 총액 × 100.",
          "examples": [
            "28.5% (17,950,000 / 63,040,000)"
          ],
          "checkPoints": [
            "공사진척률과 비교"
          ]
        },
        {
          "key": "remainingBalance",
          "label": "잔액",
          "required": true,
          "inputGuide": "총액 - 집행액.",
          "examples": [
            "45,090,000원"
          ],
          "checkPoints": []
        }
      ]
    },
    {
      "title": "5. 결재선",
      "legalSource": "산안법 제72조 + 고시 제10조",
      "fields": [
        {
          "key": "compilerSign",
          "label": "작성자 (안전관리자) 서명",
          "required": true,
          "inputGuide": "안전관리자 성명·서명.",
          "examples": [
            "김안전 (안전관리자, 서명)"
          ],
          "checkPoints": []
        },
        {
          "key": "supervisorSign",
          "label": "관리감독자 서명",
          "required": true,
          "inputGuide": "공사 관리감독자 서명.",
          "examples": [
            "박감독 (서명)"
          ],
          "checkPoints": []
        },
        {
          "key": "principalSign",
          "label": "사업주 / 현장소장 서명",
          "required": true,
          "inputGuide": "사업주 또는 현장소장(안전보건관리책임자) 서명.",
          "examples": [
            "황룡 (현장소장, 서명)"
          ],
          "checkPoints": []
        }
      ]
    }
  ],
  "approvalChain": [
    {
      "role": "작성자 (안전관리자)",
      "action": "계획·집행·정산 작성"
    },
    {
      "role": "관리감독자",
      "action": "검토 + 증빙 확인"
    },
    {
      "role": "사업주 / 현장소장",
      "action": "최종 승인 + 발주처 보고"
    }
  ],
  "reviewRules": [
    {
      "rule": "공사종류별 요율 정확 적용 + 계상금액",
      "severity": "blocker",
      "legalBasis": "art:산안법:72",
      "checkFields": [
        "calcBaseAmount",
        "applicableRate",
        "totalCost"
      ]
    },
    {
      "rule": "9개 사용 항목 분류 명시 (필수 항목 1·2·3·5)",
      "severity": "blocker",
      "legalBasis": "art:산안법시행규칙:88",
      "checkFields": [
        "item1_safetyManager",
        "item2_safetyEducation",
        "item3_ppe",
        "item5_safetyFacility"
      ]
