  "requiredFields": [
    {
      "key": "f_0_점검_일자",
      "label": "점검 일자",
      "source": "산안기준규칙 제42조·제43조 + KOSHA 권장",
      "inputGuide": "점검 실시일.",
      "examples": [
        "2026-04-29"
      ]
    },
    {
      "key": "inspector",
      "label": "점검자",
      "source": "산안기준규칙 제42조·제43조 + KOSHA 권장",
      "inputGuide": "작성한 사람의 성명 + 직책 + (가능 시) 자격번호.",
      "examples": [
        "홍길동 (안전관리자, 산업안전기사 자격 1234567호)",
        "김철수 (현장소장)"
      ]
    },
    {
      "key": "f_2_방호망_위치",
      "label": "방호망 위치",
      "source": "산안기준규칙 제42조·제43조 + KOSHA 권장",
      "inputGuide": "추락방호망 설치 위치 (층·구역).",
      "examples": [
        "A동 5층 단부 + B동 외부 비계"
      ]
    },
    {
      "key": "f_3_방호망_사양__망목_인",
      "label": "방호망 사양 (망목·인장강도)",
      "source": "산안기준규칙 제42조·제43조 + KOSHA 권장",
      "inputGuide": "망목 (그물코 크기) + 인장강도. KCs 기준.",
      "examples": [
        "망목 100mm × 100mm / 인장강도 235kgf 이상 (KCs 인증)"
      ]
    },
    {
      "key": "f_4_고정_상태",
      "label": "고정 상태",
      "source": "산안기준규칙 제42조·제43조 + KOSHA 권장",
      "inputGuide": "지지점 고정 상태 (지지로프·고리·체결구).",
      "examples": [
        "전 구역 정상 / 1개소 지지로프 마모 → 교체"
      ]
    },
    {
      "key": "f_5_처짐_정도",
      "label": "처짐 정도",
      "source": "산안기준규칙 제42조·제43조 + KOSHA 권장",
      "inputGuide": "방호망 처짐 (지지점 간격 1/10 이하).",
      "examples": [
        "평균 처짐 0.4m (지지점 간격 4.5m, 1/11) — 정상"
      ]
    },
    {
      "key": "f_6_결손_손상",
      "label": "결손·손상",
      "source": "산안기준규칙 제42조·제43조 + KOSHA 권장",
      "inputGuide": "망 결손·찢어짐 점검.",
      "examples": [
        "전체 정상 / 1개소 직경 5cm 손상 → 즉시 교체"
      ]
    },
    {
      "key": "f_7_낙하물_누적",
      "label": "낙하물 누적",
      "source": "산안기준규칙 제42조·제43조 + KOSHA 권장",
      "inputGuide": "망 위 낙하물 누적 점검 (즉시 제거).",
      "examples": [
        "소량 누적 → 즉시 제거 (4/29 청소 작업)"
      ]
    },
    {
      "key": "f_8_결과__적합_부적합_",
      "label": "결과 (적합/부적합)",
      "source": "산안기준규칙 제42조·제43조 + KOSHA 권장",
      "inputGuide": "적합 / 부적합 + 부적합 시 시정 사항.",
      "examples": [
        "적합"
      ]
    },
    {
      "key": "f_9_조치_내용",
      "label": "조치 내용",
      "source": "산안기준규칙 제42조·제43조 + KOSHA 권장",
      "inputGuide": "발견 위험에 대한 즉시·계획 시정조치.",
      "examples": [
        "1) 안전난간 즉시 설치 / 2) 보호구 미착용자 1명 시정 지도 / 3) 7일 내 재점검"
      ]
    }
  ],
  "reviewRules": [
    {
      "rule": "필수 — 그물코 10cm 이내 + 인장강도 검사 결과",
      "severity": "manual_review",
      "legalBasis": "art:기준규칙:44"
    },
    {
      "rule": "필수 — 충격 받은 망은 즉시 교체 또는 재시험",
      "severity": "manual_review",
      "legalBasis": "art:기준규칙:45"
    }
  ],
