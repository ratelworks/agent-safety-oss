    "doc:kosha_guide/G-36-2012",
    "doc:kosha_guide/H-26-2020",
    "doc:kosha_guide/M-89-2016"
  ],
  "requiredFields": [
    {
      "key": "f_0_점검_일자",
      "label": "점검 일자",
      "source": "산안기준규칙 제239조·제242조 + KOSHA Guide",
      "inputGuide": "점검 실시일.",
      "examples": [
        "2026-04-29"
      ]
    },
    {
      "key": "inspector",
      "label": "점검자",
      "source": "산안기준규칙 제239조·제242조 + KOSHA Guide",
      "inputGuide": "작성한 사람의 성명 + 직책 + (가능 시) 자격번호.",
      "examples": [
        "홍길동 (안전관리자, 산업안전기사 자격 1234567호)",
        "김철수 (현장소장)"
      ]
    },
    {
      "key": "f_2_소화기_위치_수량",
      "label": "소화기 위치·수량",
      "source": "산안기준규칙 제239조·제242조 + KOSHA Guide",
      "inputGuide": "현장 소화기 위치 + 수량 (층별·구역별 비치).",
      "examples": [
        "A동 각 층 4대 + 외부 6대 + 위험구역 추가 8대 (총 30대)"
      ]
    },
    {
      "key": "f_3_소화기_점검__압력_",
      "label": "소화기 점검 (압력)",
      "source": "산안기준규칙 제239조·제242조 + KOSHA Guide",
      "inputGuide": "소화기 압력 게이지 점검 (정상 영역 표시 확인).",
      "examples": [
        "전체 30대 정상 (게이지 녹색 영역) / 1대 압력 부족 → 충전"
      ]
    },
    {
      "key": "f_4_소화전_소화수조",
      "label": "소화전·소화수조",
      "source": "산안기준규칙 제239조·제242조 + KOSHA Guide",
      "inputGuide": "소화전·소화수조 위치 + 수압·수량 정상 여부.",
      "examples": [
        "소화전 6개소 (수압 정상 5kgf/㎠) + 소화수조 50톤 1개소"
      ]
    },
    {
      "key": "f_5_비상연락__119_",
      "label": "비상연락 (119)",
      "source": "산안기준규칙 제239조·제242조 + KOSHA Guide",
      "inputGuide": "비상연락망 게시 + 119 직통.",
      "examples": [
        "게시판 4개소 부착 + 안전관리자 직통 010-1234-5678"
      ]
    },
    {
      "key": "f_6_대피로_표지",
      "label": "대피로 표지",
      "source": "산안기준규칙 제239조·제242조 + KOSHA Guide",
      "inputGuide": "대피로 안내 표지 + 비상조명.",
      "examples": [
        "층마다 4개소 / 비상조명 30분 작동 확인"
      ]
    },
    {
      "key": "f_7_결과",
      "label": "결과",
      "source": "산안기준규칙 제239조·제242조 + KOSHA Guide",
      "inputGuide": "양호 / 보통 / 불량 + 특이사항.",
      "examples": [
        "양호 — 비계 안전난간 1개층 누락 → 즉시 설치 완료"
      ]
    },
    {
      "key": "f_8_조치_내용",
      "label": "조치 내용",
      "source": "산안기준규칙 제239조·제242조 + KOSHA Guide",
      "inputGuide": "발견 위험에 대한 즉시·계획 시정조치.",
      "examples": [
        "1) 안전난간 즉시 설치 / 2) 보호구 미착용자 1명 시정 지도 / 3) 7일 내 재점검"
      ]
    }
  ],
  "reviewRules": [
    {
      "rule": "필수 — 소화기 + 비상경보 + 비상조명 3종 설치 + 작동",
      "severity": "manual_review",
      "legalBasis": "art:기준규칙:236"
    },
    {
      "rule": "필수 — 화기작업 전 방화포 + 소화기 비치",
      "severity": "manual_review",
      "legalBasis": "art:기준규칙:240"
    },
    {
      "rule": "권고 — 매월 점검 사진 첨부",
      "severity": "warning",
      "legalBasis": "art:기준규칙:35"
    }
  ],
  "verificationStatus": "verified",
