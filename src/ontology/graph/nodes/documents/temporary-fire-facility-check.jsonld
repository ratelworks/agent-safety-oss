              },
              {
                "항목": "소화수조",
                "결과": "200L 충수"
              },
              {
                "항목": "피난로 폭 ≥0.9m",
                "결과": "양호"
              },
              {
                "항목": "비상조명",
                "결과": "작동"
              }
            ]
          ],
          "checkPoints": []
        },
        {
