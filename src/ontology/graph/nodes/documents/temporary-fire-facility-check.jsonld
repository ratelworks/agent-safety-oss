  "docId": "temporary_fire_facility_check",
  "title": "가설 소방시설 점검",
  "description": "건설현장 임시소방시설 (소화기·간이소화장치·비상경보·간이피난유도선·비상조명·방화포). 소방시설법 제15조 + 화재안전기준 NFSC 401-7. KOSHA C-113 취약시기 관리.",
  "cycle": "cyc:monthly",
  "trigger": "공사 착공 + 매월 정기 점검 + 화기작업 전",
  "applicableWhen": {
    "appliesTo": "applic:construction_50bn_plus",
    "scaleNotes": "건설공사 면적 5천㎡ 이상 또는 지상 11층 이상."
  },
  "legalBasis": [
    "art:기준규칙:236",
    "art:기준규칙:237",
    "art:기준규칙:238",
    "art:기준규칙:239",
    "art:기준규칙:240",
    "art:기준규칙:232",
    "art:기준규칙:428"
  ],
  "guidedBy": [
    "doc:kosha_guide/C-113-2020",
    "doc:kosha_guide/C-70-2012",
    "doc:kosha_guide/C-C-29-2026",
    "doc:kosha_guide/A-G-10-2025",
    "doc:kosha_guide/A-G-11-2025",
    "doc:kosha_guide/A-G-12-2026",
    "doc:kosha_guide/A-G-15-2026",
    "doc:kosha_guide/A-G-16-2026",
    "doc:kosha_guide/A-G-19-2026",
    "doc:kosha_guide/A-G-2-2025",
    "doc:kosha_guide/A-G-20-2026",
    "doc:kosha_guide/A-G-3-2025",
    "doc:kosha_guide/A-G-5-2025",
    "doc:kosha_guide/A-G-6-2025",
    "doc:kosha_guide/A-G-7-2025",
    "doc:kosha_guide/A-G-8-2025",
    "doc:kosha_guide/A-G-9-2025",
