  "docId": "voluntary_safety_confirmation_filing",
  "title": "자율안전확인 신고 (별지 45호)",
  "description": "산안법 제89조 자율안전확인대상 기계·기구·설비를 제조·수입한 자가 안전기준 적합 여부를 확인하여 신고. KCs(s) 마크.",
  "cycle": "cyc:ad_hoc",
  "trigger": "자율안전확인 대상 제품 제조·수입 시",
  "legalBasis": [
    "art:산안법:89",
    "art:산안법시행규칙:80"
  ],
  "verificationStatus": "verified",
  "_meta": {
    "publishedBy": "라텔웍스 + 황룡건설(주)",
    "fetchedAt": "2026-04-28",
    "licenseHint": "저작권법 제7조 비보호 (자유 인용)",
    "note": "신규 의무문서 — requiredFields/reviewRules/applicableWhen 표준 골격 채움 (Phase 2.5 wave4).",
    "verifiedAt": "2026-04-28",
    "alignedAt": "2026-04-29",
    "alignSource": "align-nodes-bulk.ts (KOSHA 권고 + 산안법 본문 기반)"
  },
  "applicableWhen": {
    "appliesTo": "applic:all_workplace",
    "scaleNotes": "자율안전확인대상 (시행령 제77조). 인증대상 외 위험기계."
  },
  "exemptedWhen": {
    "reasons": [
      "대상 외 기계",
      "수출 전용"
    ]
  },
  "requiredFields": [
    {
      "key": "applicantName",
      "label": "제조·수입자 회사명·주소",
      "source": "산안법 제89조 + 시행규칙 제80조",
      "inputGuide": "도로명 주소 우선. 지번 주소는 보조.",
      "examples": [
        "서울특별시 강남구 테헤란로 123"
      ]
    },
    {
      "key": "businessNo",
      "label": "사업자등록번호",
      "source": "산안법 제89조 + 시행규칙 제80조",
      "inputGuide": "10자리 숫자 (사업자등록번호) 또는 13자리 숫자 (법인등록번호). 하이픈 포함 표기 권장.",
      "examples": [
        "123-45-67890",
        "110111-0123456"
      ]
    },
    {
      "key": "representative",
      "label": "대표자",
      "source": "산안법 제89조 + 시행규칙 제80조",
      "inputGuide": "법인등기부등본 상의 대표자 성명. 외국인은 영문 + 한글 병기.",
      "examples": [
        "황 룡",
        "홍길동",
        "John Smith (존 스미스)"
      ]
    },
    {
      "key": "productCategory",
      "label": "자율안전확인 21종 분류",
      "source": "산안법 제89조 + 시행령 제77조 (21종)",
      "inputGuide": "자율안전확인대상 기계·기구 21종 (산안법 제89조 + 시행령 제77조).",
      "examples": [
        "연삭기 (제1호 가목)"
      ]
    },
    {
      "key": "productName",
      "label": "제품명·모델·규격",
      "source": "산안법 제89조 + 시행령 제77조 (21종)",
      "inputGuide": "제품명 + 모델 + 규격.",
      "examples": [
        "휴대용 연삭기 / Bosch GWS-9-100 / 정격 900W"
      ]
    },
    {
      "key": "selfTestReport",
      "label": "자율안전 시험·검사 결과",
      "source": "산안법 제89조 + 시행령 제77조 (21종)",
      "inputGuide": "양호 / 보통 / 불량 + 특이사항.",
      "examples": [
        "양호 — 비계 안전난간 1개층 누락 → 즉시 설치 완료"
      ]
    },
    {
      "key": "filingDate",
      "label": "신고 일자",
      "inputGuide": "자율안전확인 신고 접수일.",
      "examples": [
        "2026-04-29"
      ]
    },
    {
      "key": "kcsNumber",
      "label": "KCs(s) 신고번호",
      "inputGuide": "자율안전확인 신고번호 (KCs(s)-XXXX).",
      "examples": [
        "KCs(s)-AB-2026-0042"
      ]
    }
  ],
  "reviewRules": [
    {
      "rule": "필수 — 자율안전기준 적합 자체시험 결과",
      "severity": "manual_review",
