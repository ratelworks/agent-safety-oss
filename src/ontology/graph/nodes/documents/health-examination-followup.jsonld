          ],
          "checkPoints": []
        },
        {
          "key": "diagnosisFinding",
          "label": "이상 소견",
          "required": true,
          "inputGuide": "건강진단 의사 소견.",
          "examples": [
            "청력 저하 5dB 의심 → 6개월 추적관찰"
