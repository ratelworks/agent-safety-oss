  "docId": "health_examination_followup",
  "title": "건강진단 사후관리",
  "description": "산안법 제134조 건강진단 결과에 따른 작업전환·근로시간 단축·작업환경 개선 등 사후조치 기록. 제138조 질병자 근로 금지 결정 포함.",
  "cycle": "cyc:annual",
  "trigger": "건강진단 결과 확인 후",
  "legalBasis": [
    "art:산안법:134",
    "art:산안법:138",
    "art:산안법시행규칙:220"
  ],
  "verificationStatus": "verified",
  "_meta": {
    "publishedBy": "라텔웍스 + 황룡건설(주)",
    "fetchedAt": "2026-04-28",
    "licenseHint": "저작권법 제7조 비보호 (자유 인용)",
    "note": "신규 의무문서 — requiredFields/reviewRules/applicableWhen 표준 골격 채움 (Phase 2.5 wave4).",
    "verifiedAt": "2026-04-28",
    "alignedAt": "2026-04-29",
    "alignSource": "align-nodes-bulk.ts (KOSHA 권고 + 산안법 본문 기반)"
  },
  "applicableWhen": {
    "appliesTo": "applic:all_workplace",
    "scaleNotes": "건강진단 결과 D1·D2 판정 또는 특수질환 발견 시."
  },
  "exemptedWhen": {
    "reasons": [
      "A·C 판정 (정상)"
    ]
  },
  "requiredFields": [
    {
      "key": "f_0_사업장명",
      "label": "사업장명",
      "source": "산안법 제132조 + 시행규칙 제210조",
      "inputGuide": "법인등기부등본 또는 사업자등록증 상의 정식 명칭. 약칭·통칭 사용 금지.",
      "examples": [
        "황룡건설(주)",
        "(주)라텔웍스",
        "현대건설 주식회사"
      ]
    },
    {
      "key": "f_1_관리_시작일",
      "label": "관리 시작일",
      "source": "산안법 제132조 + 시행규칙 제210조",
      "inputGuide": "사후관리 개시일 (검진 결과 통보 직후).",
      "examples": [
        "2026-05-15"
      ]
    },
    {
      "key": "f_2_유소견자_명단__이니셜",
      "label": "유소견자 명단 (이니셜·연령·직무)",
      "source": "산안법 제132조 + 시행규칙 제210조",
      "inputGuide": "이니셜·연령·직무 — 개인정보 보호.",
      "examples": [
        "김ㅇㅇ (M, 45세, 철근공) / 이ㅇㅇ (M, 52세, 형틀공)"
      ]
    },
    {
      "key": "f_3_판정__D_C_등_",
      "label": "판정 (D/C 등)",
      "source": "산안법 제132조 + 시행규칙 제210조",
      "inputGuide": "산안 시행규칙 별표 7 판정.",
      "examples": [
        "D1 (직업성 진폐 의심) / C1 (요관찰)"
      ]
    },
    {
      "key": "f_4_사후조치__작업전환_근",
      "label": "사후조치 (작업전환·근로시간 단축·치료 의뢰)",
      "source": "산안법 제132조 + 시행규칙 제210조",
      "inputGuide": "판정별 사후관리 조치.",
      "examples": [
        "D1: 분진 작업 전환 + 정밀검사 의뢰 / C1: 6개월 후 재검"
      ]
    },
    {
      "key": "f_5_이행_책임자",
      "label": "이행 책임자",
      "source": "산안법 제132조 + 시행규칙 제210조",
      "inputGuide": "사후조치 이행 책임자.",
      "examples": [
        "이건강 (보건관리자)"
      ]
    },
    {
      "key": "f_6_이행_기한",
      "label": "이행 기한",
      "source": "산안법 제132조 + 시행규칙 제210조",
      "inputGuide": "이행 완료 기한.",
      "examples": [
        "2026-06-15 (D1) / 2026-11-15 (C1 재검)"
      ]
    },
    {
      "key": "f_7_추적관찰_결과",
      "label": "추적관찰 결과",
      "source": "산안법 제132조 + 시행규칙 제210조",
      "inputGuide": "양호 / 보통 / 불량 + 특이사항.",
      "examples": [
        "양호 — 비계 안전난간 1개층 누락 → 즉시 설치 완료"
      ]
    },
    {
      "key": "f_8_사업주_서명",
      "label": "사업주 서명",
      "source": "산안법 제132조 + 시행규칙 제210조",
      "inputGuide": "법인등기부등본 상의 대표자 성명. 외국인은 영문 + 한글 병기.",
      "examples": [
        "황 룡",
        "홍길동",
        "John Smith (존 스미스)"
      ]
    }
  ],
  "reviewRules": [
    {
      "rule": "필수 — 판정 결과 + 산업보건의 소견 + 사후조치",
      "severity": "manual_review",
      "legalBasis": "art:산안법:134"
    },
    {
      "rule": "필수 — D1/D2 판정 시 작업전환 또는 근로금지 결정",
      "severity": "manual_review",
      "legalBasis": "art:산안법:138"
    },
    {
      "rule": "필수 — 5년(일반)/30년(특수) 보존",
      "severity": "manual_review",
      "legalBasis": "art:산안법시행규칙:220"
    }
  ],
  "guidedBy": [
    "doc:kosha_guide/H-4-2021",
    "doc:kosha_guide/H-50-2021"
  ],
  "appliesToActivities": [
    "activity:general_workplace_safety",
    "activity:asbestos_removal"
  ],
  "sections": [
    {
      "title": "1. 문서 메타",
      "legalSource": "공통",
      "fields": [
        {
          "key": "documentNumber",
          "label": "문서번호",
          "required": true,
          "inputGuide": "현장 자체 일련번호 (DOC-YYMMDD-NN).",
