          "label": "작성 일자",
          "required": true,
          "inputGuide": "YYYY-MM-DD.",
          "examples": [
            "2026-04-29"
          ],
          "checkPoints": []
        },
        {
          "key": "compiler",
          "label": "작성자 (안전관리자)",
