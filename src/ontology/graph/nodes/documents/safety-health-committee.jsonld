            "2026-04-29 14:00~15:30"
          ],
          "checkPoints": []
        },
        {
          "key": "members",
          "label": "위원 (사용자·근로자 동수)",
          "required": true,
          "inputGuide": "산안법 제24조 ② 위원 구성.",
          "examples": [
