        {
          "key": "agenda",
          "label": "심의·의결 사항",
          "required": true,
          "inputGuide": "산안법 제24조 ③ 8개 항목.",
          "examples": [
            "1) 산재예방계획 / 2) 안전보건관리규정 / 3) 위험성평가 / 4) 산재 발생 보고 / 5) 안전보건관리비 / 6) 도급사업"
          ],
          "checkPoints": []
        },
        {
          "key": "decisions",
          "label": "의결 사항",
          "required": true,
          "inputGuide": "위원회 결정.",
          "examples": [
            "1) 분기 위험성평가 강화 / 2) 산재예방 교육 추가"
          ],
          "checkPoints": []
        },
        {
          "key": "recordKeeping",
          "label": "회의록 보존 (3년)",
          "required": true,
          "inputGuide": "산안법 제164조.",
          "examples": [
