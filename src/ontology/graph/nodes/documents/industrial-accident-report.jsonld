  "reviewRules": [
    {
      "rule": "필수 — Ⅰ 사업장 정보 (산재관리번호·사업장명·근로자수·업종·소재지)",
      "severity": "blocker",
      "legalBasis": "art:산안법시행규칙:73",
      "checkFields": [
        "industryCode",
        "siteName",
        "totalWorkforce",
        "industry",
        "address"
      ]
    },
    {
      "rule": "필수 — Ⅱ 재해자 정보 (성명·주민번호·국적·직업·고용형태·근무형태·상해종류·휴업일수)",
      "severity": "blocker",
      "legalBasis": "art:산안법시행규칙:73",
      "checkFields": [
        "injuredName",
        "injuredId",
        "injuredOccupation",
        "employmentType",
        "workForm",
        "injuryType",
        "injuryPart"
      ]
    },
    {
      "rule": "필수 — Ⅲ 재해발생 개요·원인 (발생일시·장소·작업유형·당시상황·원인 4분류)",
      "severity": "blocker",
      "legalBasis": "art:산안법시행규칙:73",
      "checkFields": [
        "occurrenceDate",
        "occurrenceLocation",
        "workTypeAtAccident",
        "circumstancesAtAccident",
        "accidentCause"
      ]
    },
    {
      "rule": "필수 — Ⅳ 재발방지 계획",
      "severity": "blocker",
      "legalBasis": "art:산안법시행규칙:73",
      "checkFields": [
        "preventionPlan"
      ]
