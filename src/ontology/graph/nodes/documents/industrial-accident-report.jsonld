{
  "@context": "../../context.jsonld",
  "@id": "doc:ad_hoc/industrial_accident_report",
  "@type": [
    "Document",
    "DigitalDocument"
  ],
  "docId": "industrial_accident_report",
  "title": "산업재해조사표 (별지 30호)",
  "alternativeNames": [
    "산재조사표",
    "별지 제30호서식"
  ],
  "description": "산업재해(휴업 3일 이상 또는 사망)가 발생한 경우 시행규칙 제73조 에 따라 1개월 이내 관할 지방고용노동관서에 제출하는 법정 보고서. 본 노드는 산안법 시행규칙 [별지 제30호서식] 본문을 1:1로 매핑한다 (kordoc parse_form 검증, 2026-04-29).",
  "cycle": "cyc:ad_hoc",
  "trigger": "산업재해(휴업 3일 이상 또는 사망)가 발생한 경우 시행규칙 제73조 에 따라 1개월 이내 관할 지방고용노동관서에 제출. 중대재해는 제57조 에 따라 즉시 보고.",
  "applicableWhen": {
    "appliesTo": "applic:all_workplace",
    "scaleNotes": "중대재해 (사망·동시 부상자 2명 이상 등)는 제54조 즉시 보고 별도. 제73조 산업재해조사표는 1개월 내."
  },
  "exemptedWhen": {},
  "requiredFields": [
    {
      "key": "industryCode",
