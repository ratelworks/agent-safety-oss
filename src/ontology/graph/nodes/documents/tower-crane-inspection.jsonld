  "docId": "tower_crane_inspection",
  "title": "타워크레인 점검",
  "description": "기준규칙 제142조 타워크레인 안전. 운전 시작 전 일일점검 + 강풍 후 + 정기점검(매월). KOSHA Guide C-21 권장 양식.",
  "cycle": "cyc:daily",
  "trigger": "운전 시작 전 매일 + 강풍 10m/s 이상 후 + 매월 정기점검",
  "applicableWhen": {
    "appliesTo": "applic:all_workplace",
    "scaleNotes": "타워크레인 사용 모든 건설현장."
  },
  "legalBasis": [
    "art:기준규칙:142",
    "annex:기준규칙:별표4-1호",
    "art:산안법:93",
    "art:기준규칙:134",
    "art:기준규칙:135",
    "art:기준규칙:40",
    "art:기준규칙:47"
  ],
  "guidedBy": [
    "doc:kosha_guide/D-C-10-2026",
    "doc:kosha_guide/M-82-2011",
    "doc:kosha_guide/M-89-2016",
    "doc:kosha_guide/M-91-2012"
  ],
  "requiredFields": [
    {
      "key": "f_0_점검_일자",
      "label": "점검 일자",
      "source": "산안기준규칙 제142조 + KOSHA Guide",
      "inputGuide": "점검 실시일.",
      "examples": [
        "2026-04-29"
      ]
    },
    {
      "key": "f_1_점검자",
      "label": "점검자",
      "source": "산안기준규칙 제142조 + KOSHA Guide",
      "inputGuide": "작성한 사람의 성명 + 직책 + (가능 시) 자격번호.",
      "examples": [
        "홍길동 (안전관리자, 산업안전기사 자격 1234567호)",
        "김철수 (현장소장)"
      ]
    },
    {
      "key": "f_2_크레인_종류_정격하중",
      "label": "크레인 종류·정격하중",
      "source": "산안기준규칙 제142조 + KOSHA Guide",
      "inputGuide": "타워크레인 모델 + 정격하중.",
      "examples": [
        "TC-7030 / 정격하중 6톤 (반경 70m)"
      ]
    },
    {
      "key": "f_3_마스트_붐_점검",
      "label": "마스트·붐 점검",
      "source": "산안기준규칙 제142조 + KOSHA Guide",
      "inputGuide": "마스트·붐 변형·균열·체결 상태.",
      "examples": [
        "변형·균열 없음 / 체결 볼트 토크 확인 정상"
      ]
    },
    {
      "key": "f_4_와이어로프",
      "label": "와이어로프",
      "source": "산안기준규칙 제142조 + KOSHA Guide",
      "inputGuide": "와이어로프 마모·소선절단·킹크.",
      "examples": [
        "마모 5% 이내 (한도 7%) / 소선절단 1소선 (한도 10%) / 킹크 없음"
      ]
    },
    {
      "key": "f_5_안전장치__과부하_풍속",
      "label": "안전장치 (과부하·풍속경보)",
      "source": "산안기준규칙 제142조 + KOSHA Guide",
      "inputGuide": "과부하방지·풍속경보·권과방지 작동 확인.",
      "examples": [
        "전 장치 정상 작동 (과부하 모의시험 / 풍속경보 14m/s)"
      ]
    },
    {
      "key": "f_6_전기_시스템",
      "label": "전기 시스템",
      "source": "산안기준규칙 제142조 + KOSHA Guide",
      "inputGuide": "전기 제어반·접지·절연·비상정지.",
      "examples": [
        "절연 1MΩ 이상 / 접지 5Ω 이하 / 비상정지 정상"
      ]
    },
    {
      "key": "f_7_결과",
      "label": "결과",
      "source": "산안기준규칙 제142조 + KOSHA Guide",
      "inputGuide": "양호 / 보통 / 불량 + 특이사항.",
      "examples": [
        "양호 — 비계 안전난간 1개층 누락 → 즉시 설치 완료"
      ]
    },
    {
      "key": "f_8_조치_내용",
      "label": "조치 내용",
      "source": "산안기준규칙 제142조 + KOSHA Guide",
      "inputGuide": "발견 위험에 대한 즉시·계획 시정조치.",
      "examples": [
        "1) 안전난간 즉시 설치 / 2) 보호구 미착용자 1명 시정 지도 / 3) 7일 내 재점검"
      ]
    }
  ],
