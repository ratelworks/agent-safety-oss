  "docId": "safety_inspection_application",
  "title": "안전검사 신청 (별지 48호)",
  "description": "산안법 제93조 안전검사 대상 기계·기구(프레스·전단기·크레인·리프트·압력용기 등) 사용사업주가 정기적으로 받는 검사. 합격 표시(검사필증) 부착.",
  "cycle": "cyc:ad_hoc",
  "trigger": "검사주기 도래 시 (대상별 1~3년)",
  "legalBasis": [
    "art:산안법:93",
    "art:산안법시행규칙:86"
  ],
  "verificationStatus": "verified",
  "_meta": {
    "publishedBy": "라텔웍스 + 황룡건설(주)",
    "fetchedAt": "2026-04-28",
    "licenseHint": "저작권법 제7조 비보호 (자유 인용)",
    "note": "신규 의무문서 — requiredFields/reviewRules/applicableWhen 표준 골격 채움 (Phase 2.5 wave4).",
    "verifiedAt": "2026-04-28",
    "alignedAt": "2026-04-29",
    "alignSource": "align-nodes-bulk.ts (KOSHA 권고 + 산안법 본문 기반)"
  },
  "applicableWhen": {
    "appliesTo": "applic:all_workplace",
    "scaleNotes": "안전검사대상(프레스·전단기·크레인·리프트·압력용기 등) 사용사업주. 검사주기 1~3년."
  },
  "exemptedWhen": {
    "reasons": [
      "대상 외 기계",
      "사용 종료 신고 후"
    ]
  },
  "requiredFields": [
    {
      "key": "applicantName",
      "label": "사용 사업주 회사명·소재지",
      "source": "산안법 제93조 + 시행규칙 제86조",
      "inputGuide": "사업장·현장 도로명 주소.",
      "examples": [
        "서울특별시 강남구 삼성로 456"
      ]
    },
    {
      "key": "siteAddress",
      "label": "검사 대상 사업장",
      "source": "산안법 제93조 + 시행규칙 제86조",
      "inputGuide": "본 안전검사 대상 사업장.",
      "examples": [
        "황룡건설(주) 삼성동 신축공사 현장"
      ]
    },
    {
      "key": "representative",
      "label": "대표자·안전관리자",
      "source": "산안법 제93조 + 시행규칙 제86조",
      "inputGuide": "대표자 + 안전관리자 성명.",
      "examples": [
        "대표 황룡 / 안전관리자 김안전 (산업안전기사)"
      ]
    },
    {
      "key": "machineCategory",
      "label": "안전검사 11종 분류",
      "source": "산안법 제93조 + 시행령 제78조 (11종)",
      "inputGuide": "산안법 제93조 + 시행령 제78조 — 안전검사대상 11종.",
      "examples": [
        "타워크레인 (제1호)"
      ]
    },
    {
      "key": "machineDetail",
      "label": "기계명·제조사·정격",
      "source": "산안법 제93조 + 시행령 제78조 (11종)",
      "inputGuide": "대상 기계명 + 제조사 + 정격.",
      "examples": [
        "타워크레인 TC-7030 / (주)동양크레인 / 정격하중 6톤"
      ]
    },
    {
      "key": "installDate",
      "label": "설치 일자·사용 기간",
      "source": "산안법 제93조 + 시행령 제78조 (11종)",
      "inputGuide": "설치일 + 사용 시작·종료.",
      "examples": [
        "2026-04-01 설치 / 2026-04~2027-08 (16개월 사용 예정)"
      ]
    },
    {
      "key": "inspectionDate",
      "label": "검사 일자·기관",
      "inputGuide": "안전검사 실시일 + 검사기관.",
      "examples": [
        "2026-04-25 / 한국산업안전보건공단"
      ]
    },
    {
      "key": "result",
      "label": "결과 (합격/부적합)",
      "inputGuide": "양호 / 보통 / 불량 + 특이사항.",
      "examples": [
        "양호 — 비계 안전난간 1개층 누락 → 즉시 설치 완료"
      ]
    },
    {
      "key": "certificateNo",
      "label": "검사필증 번호",
      "inputGuide": "안전검사필증 발급 번호.",
      "examples": [
        "SI-2026-04-0042"
      ]
    },
    {
      "key": "nextInspection",
      "label": "차기 검사 예정일",
      "inputGuide": "다음 안전검사 예정일 (장비별 주기 — 타워크레인 6개월).",
      "examples": [
        "2026-10-25"
      ]
    }
  ],
  "reviewRules": [
    {
      "rule": "필수 — 검사대상 식별 + 검사기관 + 결과",
      "severity": "manual_review",
      "legalBasis": "art:산안법:93"
    },
    {
      "rule": "필수 — 검사필증 부착 + 다음 검사일 명시",
      "severity": "manual_review",
      "legalBasis": "art:산안법시행규칙:86"
    }
