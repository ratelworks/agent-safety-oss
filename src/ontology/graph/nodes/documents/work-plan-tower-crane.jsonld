  ],
  "requiredFields": [
    {
      "key": "f_0_풍속",
      "label": "풍속",
      "source": "산안기준규칙 제38조 + 별표 4 1호",
      "inputGuide": "풍속 작업 한도 (15m/s 이상 작업 중지).",
      "examples": [
        "작업 한도 10m/s / 설치·해체 한도 15m/s / 풍속계 실시간 계측"
      ]
    },
    {
      "key": "craneType",
      "label": "타워크레인 종류·형식",
      "source": "산안기준규칙 제38조 + 별표 4 1호",
      "inputGuide": "타워크레인 종류 (T형·러핑형·셀프크라이밍) + 모델.",
      "examples": [
        "T형 / TC-7030 (자립고 70m, 정격 6톤)"
      ]
    },
    {
      "key": "assemblyOrder",
      "label": "설치·조립·해체 순서",
      "source": "산안기준규칙 제38조 + 별표 4 1호",
      "inputGuide": "단계별 설치·조립·해체 순서.",
      "examples": [
        "1) 기초 설치 / 2) 마스트 단계별 인양 / 3) 운전실 / 4) 붐 / 5) 시운전"
      ]
    },
    {
      "key": "tools",
      "label": "작업도구·장비·가설설비·방호설비",
      "source": "산안기준규칙 제38조 + 별표 4 1호",
      "inputGuide": "도구·보조 장비·가설설비·방호설비.",
      "examples": [
        "이동식크레인 100톤 (조립 보조) + 안전대 + 방호망 + 신호수"
      ]
    },
    {
      "key": "personnel",
      "label": "작업인원 구성·역할 범위",
      "source": "산안기준규칙 제38조 + 별표 4 1호",
      "inputGuide": "작업 인원 구성 + 역할 분담.",
      "examples": [
        "타워크레인 기사 1명 + 신호수 2명 + 보조 작업자 4명 + 관리감독자 1명"
      ]
    },
    {
      "key": "f_5_지지방법",
      "label": "지지방법",
      "source": "산안기준규칙 제38조 + 별표 4 1호",
      "inputGuide": "지지대 구조 + 벽지지·자립지지.",
      "examples": [
        "벽지지 (3개층마다, 30m 간격) / 지지대 H-300 강재"
      ]
    }
  ],
  "reviewRules": [
    {
