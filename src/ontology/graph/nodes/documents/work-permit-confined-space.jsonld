  "docId": "work_permit_confined_space",
  "title": "밀폐공간 작업허가서",
  "description": "밀폐공간(맨홀·탱크·배수로·터널·배관 등) 작업 시 산소·유해가스·질식 방지 안전작업허가서. 산안기준규칙 제619조 ② 의무, KOSHA-안전작업허가지침-P94 양식 기반.",
  "cycle": "cyc:ad_hoc",
  "trigger": "밀폐공간 진입 작업 전 (매 작업마다 발급)",
  "legalBasis": [
    "art:기준규칙:619",
    "art:기준규칙:620",
    "art:기준규칙:621",
    "art:기준규칙:622",
    "art:기준규칙:623",
    "art:기준규칙:624",
    "art:기준규칙:625",
    "art:기준규칙:626",
    "art:기준규칙:627",
    "art:기준규칙:618"
  ],
  "officialFormSpec": {
    "formId": "kosha_p94_confined_space",
    "officialName": "KOSHA 안전작업허가지침 (P-94) 붙임1 - 안전작업 허가서 (밀폐공간작업)",
    "formFile": "KOSHA-안전작업허가지침-P94.pdf",
    "formMatchType": "통합양식 일부 (화기·밀폐공간·중장비 통합 중 밀폐공간 부분)",
    "license": "공공누리 - 출처 KOSHA"
  },
  "sections": [
    {
      "title": "1. 작업 정보",
      "legalSource": "KOSHA P-94 양식 헤더",
      "fields": [
        {
          "key": "permitNumber",
          "label": "허가서 번호",
          "required": true,
          "inputGuide": "현장 자체 부여 일련번호. 양식: 'PERMIT-CS-YYMMDD-NN'. 작업장 비치 + 사본 1년 보존.",
          "examples": [
            "PERMIT-CS-260429-01"
          ],
          "checkPoints": [
            "중복 발급 금지",
            "현장 비치"
          ]
        },
        {
          "key": "department",
          "label": "부 서 명",
          "required": true,
          "inputGuide": "허가 발급 부서명 (현장 안전관리부 / 발주부서).",
          "examples": [
            "황룡건설(주) 삼성동 현장 안전관리팀"
          ],
          "checkPoints": []
        },
        {
          "key": "applicant",
          "label": "신 청 인",
          "required": true,
          "inputGuide": "작업을 수행하는 수급업체 또는 자체인력의 작업책임자 성명.",
          "examples": [
            "박감독 (작업반장)"
          ],
          "checkPoints": []
        },
        {
          "key": "contractorName",
          "label": "수 급 업 체 명",
          "required": false,
          "optional": true,
          "inputGuide": "도급 작업 시 수급업체명. 자체 작업 시 비워두거나 '자체작업'.",
          "examples": [
            "우송설비(주)",
            "자체작업"
          ],
          "checkPoints": []
        },
        {
          "key": "workName",
          "label": "작 업 명",
          "required": true,
          "inputGuide": "구체적 작업명. 추상명사 금지.",
          "examples": [
            "B1 집수정 청소 작업",
            "지하 1층 오수받이 점검작업"
          ],
          "checkPoints": []
        },
        {
          "key": "workContent",
          "label": "작 업 내 용",
          "required": true,
          "inputGuide": "작업 절차·범위·방법을 1~2문장으로. 누가 어디서 무엇을 어떻게 하는지.",
          "examples": [
            "B1 집수정(가로 2m × 세로 2m × 깊이 3m)에 진입하여 슬러지 제거 후 펌프 점검. 진입자 1명, 외부 감시자 2명 배치."
          ],
          "checkPoints": []
        },
        {
          "key": "workLocation",
          "label": "작업 장소 (밀폐공간 위치)",
          "required": true,
          "inputGuide": "동·층·실내 위치 + 밀폐공간 종류 (맨홀/탱크/배수로/배관/터널 등).",
          "examples": [
            "A동 지하 1층 기계실 집수정 1번 (별표 18 제2호)"
          ],
          "checkPoints": [
            "산안기준규칙 별표 18 해당 여부 확인"
          ]
        },
        {
          "key": "workStartTime",
          "label": "작 업 시 간 (시작)",
          "required": true,
          "inputGuide": "작업 개시 일시 (YYYY-MM-DD HH:MM). 허가 유효기간은 이 시각부터.",
          "examples": [
            "2026-04-29 09:00"
          ],
          "checkPoints": []
        },
        {
          "key": "workEndTime",
          "label": "완 료 시 간 (예정)",
          "required": true,
          "inputGuide": "작업 종료 예정 일시. 유효기간 초과 시 재발급 필요.",
          "examples": [
            "2026-04-29 12:00"
          ],
          "checkPoints": [
            "유효기간은 허가 시간에 한함"
          ]
        },
        {
          "key": "workerCount",
          "label": "작 업 자 / 인 원",
          "required": true,
          "inputGuide": "진입자·감시자 인원 합계 + 명단(별첨 가능).",
          "examples": [
            "진입 1명 + 외부 감시 2명 = 3명"
          ],
          "checkPoints": [
            "감시자 1명 이상 필수 (제625조 ①)"
          ]
        }
      ]
    },
    {
      "title": "2. 가스 / 산소 농도 측정 (밀폐공간 의무)",
      "legalSource": "산안기준규칙 제619조 ② / 제624조 / KOSHA P-94 5.3.1.3",
      "fields": [
        {
          "key": "oxygenLevel",
          "label": "산 소 농 도 (적정 18% 이상 23.5% 미만)",
          "required": true,
          "inputGuide": "디지털 산소측정기로 측정. 18% 미만이면 작업 금지·환기 후 재측정. 23.5% 이상도 화재위험으로 작업 금지.",
          "examples": [
            "20.9%"
          ],
          "checkPoints": [
            "18% 미만: 작업 금지",
            "23.5% 이상: 작업 금지"
          ]
        },
        {
          "key": "h2sLevel",
          "label": "황화수소 (10 ppm 미만)",
          "required": true,
          "inputGuide": "오수·하수·발효 공간 필수. 10ppm 이상이면 즉시 환기·작업 금지.",
          "examples": [
            "0 ppm"
          ],
          "checkPoints": [
            "10ppm 이상: 작업 금지"
          ]
        },
        {
          "key": "coLevel",
          "label": "일산화탄소 (30 ppm 미만)",
          "required": true,
          "inputGuide": "용접·차량 배기 등 연소 발생 공간 필수. 30ppm 이상이면 즉시 작업 금지.",
          "examples": [
            "0 ppm"
          ],
          "checkPoints": [
            "30ppm 이상: 작업 금지"
          ]
        },
        {
          "key": "lelLevel",
          "label": "가연성가스 LEL (10% 미만)",
          "required": false,
          "optional": true,
          "inputGuide": "가연성가스(메탄·LPG 등) 누출 가능 공간만. 10% 이상 시 작업 금지·환기 + 방폭공구 사용.",
          "examples": [
            "0% LEL"
          ],
          "checkPoints": [
            "10% LEL 이상: 작업 금지 + 환기"
          ]
        },
        {
          "key": "measureTime",
          "label": "측 정 시 각",
          "required": true,
          "inputGuide": "작업 직전 측정 시각. 작업 중 1시간마다 또는 환기 정지 시 재측정.",
          "examples": [
            "2026-04-29 08:50 / 09:50 / 10:50"
          ],
          "checkPoints": [
            "1시간 주기 재측정 권장"
          ]
        },
        {
          "key": "measurer",
          "label": "측 정 자",
          "required": true,
          "inputGuide": "산소·유해가스 측정 교육 이수자 성명·자격.",
          "examples": [
            "박감독 (밀폐공간작업프로그램 교육이수, 2026-03)"
          ],
          "checkPoints": []
        }
      ]
    },
    {
      "title": "3. 공통 안전조치 점검 (P-94 5.1)",
      "legalSource": "KOSHA P-94 5.1 허가 전 공통 점검사항",
      "fields": [
        {
          "key": "common1_ppe",
          "label": "1. 규정된 복장 및 보호구 착용 확인",
