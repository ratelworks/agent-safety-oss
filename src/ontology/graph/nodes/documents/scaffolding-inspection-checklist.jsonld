{
  "@context": "../../context.jsonld",
  "@id": "doc:weekly/scaffolding_inspection_checklist",
  "@type": [
    "Document",
    "DigitalDocument"
  ],
  "docId": "scaffolding_inspection_checklist",
  "title": "비계 점검표",
  "alternativeNames": [
    "비계 점검일지",
    "Scaffolding Daily Check"
  ],
  "description": "기준규칙 제59조~제71조 비계 작업 시 매일·강풍·강우 후 안전점검. 강관비계·시스템비계·달비계·말비계·이동식비계 구분. KOSHA Guide C-30·C-D-1 권장 양식.",
  "cycle": "cyc:weekly",
  "trigger": "비계 설치·해체·변경 시 + 매일 작업 시작 전 + 강풍(10m/s 이상)·강우(우중) 작업 후",
  "applicableWhen": {
    "appliesTo": "applic:all_workplace",
    "scaleNotes": "비계 사용 모든 건설현장."
  },
  "exemptedWhen": {
    "reasons": [
      "비계 미사용 (지상 1.5m 미만 작업)"
    ]
  },
  "legalBasis": [
    "art:기준규칙:59",
    "art:기준규칙:60",
    "art:기준규칙:62",
    "art:기준규칙:63",
    "art:기준규칙:65",
    "art:기준규칙:67",
    "art:기준규칙:71",
    "art:기준규칙:13",
    "art:기준규칙:55",
    "art:기준규칙:56",
    "art:기준규칙:57",
    "art:기준규칙:58",
    "art:기준규칙:72",
    "art:기준규칙:73"
  ],
  "guidedBy": [
    "doc:kosha_guide/D-C-7-2026",
    "doc:kosha_guide/C-11-2012",
    "doc:kosha_guide/C-74-2015",
    "doc:kosha_guide/D-C-14-2026",
    "doc:kosha_guide/D-C-8-2026",
    "doc:kosha_guide/A-G-2-2025",
    "doc:kosha_guide/A-G-4-2025",
    "doc:kosha_guide/X-44-2016",
    "doc:kosha_guide/M-155-2023"
  ],
  "requiredFields": [
    {
      "key": "f_0_점검_일자",
      "label": "점검 일자",
      "source": "산안기준규칙 제54조·제56조 + KOSHA Guide",
      "inputGuide": "점검 실시일.",
      "examples": [
        "2026-04-29"
      ]
    },
    {
      "key": "f_1_점검자",
      "label": "점검자",
      "source": "산안기준규칙 제54조·제56조 + KOSHA Guide",
      "inputGuide": "작성한 사람의 성명 + 직책 + (가능 시) 자격번호.",
      "examples": [
        "홍길동 (안전관리자, 산업안전기사 자격 1234567호)",
        "김철수 (현장소장)"
      ]
    },
    {
      "key": "f_2_비계_위치",
      "label": "비계 위치",
      "source": "산안기준규칙 제54조·제56조 + KOSHA Guide",
      "inputGuide": "비계 설치 위치 (동·층·구역).",
      "examples": [
        "A동 외부 1~5층 / B동 내부 시스템비계"
      ]
    },
    {
      "key": "f_3_결합부_점검",
      "label": "결합부 점검",
      "source": "산안기준규칙 제54조·제56조 + KOSHA Guide",
      "inputGuide": "이음·체결 부재 (클램프·핀) 정상 체결.",
      "examples": [
        "전 구역 정상 (체결 토크 확인) / 2개소 클램프 풀림 → 즉시 조임"
      ]
    },
    {
      "key": "f_4_발판_상태",
      "label": "발판 상태",
      "source": "산안기준규칙 제54조·제56조 + KOSHA Guide",
      "inputGuide": "비계 발판 균열·휨·미끄럼.",
      "examples": [
        "발판 정상 / 1개소 균열 → 교체 (4/29)"
      ]
    },
    {
      "key": "f_5_안전난간",
      "label": "안전난간",
      "source": "산안기준규칙 제54조·제56조 + KOSHA Guide",
      "inputGuide": "안전난간 높이 (0.9m 이상) + 중간대 + 발끝막이판.",
      "examples": [
        "상부 1.0m + 중간대 0.5m + 발끝막이판 0.1m / 정상"
      ]
    },
    {
      "key": "f_6_벽_연결재",
      "label": "벽 연결재",
      "source": "산안기준규칙 제54조·제56조 + KOSHA Guide",
      "inputGuide": "벽 연결재 간격 (수직 5m·수평 5.5m 이내).",
      "examples": [
        "수직 4.5m / 수평 5.0m / 정상"
      ]
    },
    {
      "key": "f_7_비계_가설계산서",
      "label": "비계 가설계산서",
      "source": "산안기준규칙 제54조·제56조 + KOSHA Guide",
      "inputGuide": "비계 구조 안전성 계산서 (작업하중·풍하중).",
      "examples": [
        "시스템비계 가설계산서 (작업하중 250kgf/㎡, 풍속 30m/s) 첨부"
      ]
    },
    {
      "key": "f_8_결과",
      "label": "결과",
      "source": "산안기준규칙 제54조·제56조 + KOSHA Guide",
      "inputGuide": "양호 / 보통 / 불량 + 특이사항.",
      "examples": [
        "양호 — 비계 안전난간 1개층 누락 → 즉시 설치 완료"
      ]
    },
    {
      "key": "f_9_조치_내용",
      "label": "조치 내용",
      "source": "산안기준규칙 제54조·제56조 + KOSHA Guide",
      "inputGuide": "발견 위험에 대한 즉시·계획 시정조치.",
      "examples": [
        "1) 안전난간 즉시 설치 / 2) 보호구 미착용자 1명 시정 지도 / 3) 7일 내 재점검"
      ]
    }
  ],
  "reviewRules": [
    {
      "rule": "필수 — 안전난간 + 작업발판 + 벽연결 3종 점검",
      "severity": "manual_review",
      "legalBasis": "art:기준규칙:59"
    },
    {
      "rule": "필수 — 적재하중 표시 + 초과 시 작업 중지",
      "severity": "manual_review",
      "legalBasis": "art:기준규칙:62"
    },
    {
      "rule": "필수 — 강풍 10m/s 또는 강우 시 작업 중지",
      "severity": "manual_review",
      "legalBasis": "art:기준규칙:38"
    },
    {
      "rule": "권고 — 점검 사진 첨부 (요주의 부위)",
      "severity": "warning",
      "legalBasis": "art:기준규칙:35"
    }
  ],
  "verificationStatus": "verified",
  "_meta": {
    "publishedBy": "라텔웍스 + 황룡건설(주)",
    "fetchedAt": "2026-04-28",
    "licenseHint": "저작권법 제7조 비보호 (자유 인용)",
    "scope": "construction",
    "note": "건설안전 특화 의무문서 (Phase 3 wave1 — 기준규칙 + KCS + KOSHA C 시리즈 권장 양식 통합).",
    "alignedAt": "2026-04-29",
    "alignSource": "align-nodes-bulk.ts (KOSHA 권고 + 산안법 본문 기반)"
  },
  "searchKeywords": [
    "비계 점검표",
    "비계 안전점검"
  ],
  "hasHazard": [
    "hazard:fall_from_height",
    "hazard:fall_object",
    "hazard:falling_object"
  ],
  "appliesToActivities": [
    "activity:scaffolding_assembly"
  ],
  "sections": [
    {
      "title": "1. 문서 메타",
      "legalSource": "공통",
      "fields": [
        {
          "key": "documentNumber",
          "label": "문서번호",
          "required": true,
          "inputGuide": "현장 자체 일련번호 (DOC-YYMMDD-NN).",
          "examples": [
            "DOC-260429-01"
          ],
          "checkPoints": []
        },
        {
          "key": "siteName",
          "label": "사업장 / 현장명",
          "required": true,
          "inputGuide": "사업장 정식 명칭.",
          "examples": [
            "황룡건설(주) 삼성동 현장"
          ],
          "checkPoints": []
        },
        {
          "key": "compileDate",
          "label": "작성 일자",
          "required": true,
          "inputGuide": "YYYY-MM-DD.",
          "examples": [
            "2026-04-29"
          ],
          "checkPoints": []
        },
        {
          "key": "compiler",
          "label": "작성자 (안전관리자)",
          "required": true,
          "inputGuide": "성명·직책.",
          "examples": [
            "김안전 (안전관리자)"
          ],
          "checkPoints": []
        }
      ]
    },
    {
      "title": "2. 비계 점검표",
      "legalSource": "산안기준규칙 제57조·제60조",
      "fields": [
        {
          "key": "inspectionDate",
          "label": "점검 일시",
          "required": true,
          "inputGuide": "매주 + 강풍·강우 후 + 7일 이상 정지 후.",
          "examples": [
            "2026-04-29 16:00 (정기 매주 + 강풍 후)"
          ],
          "checkPoints": []
        },
        {
          "key": "inspector",
          "label": "점검자",
          "required": true,
          "inputGuide": "비계 작업지휘자.",
          "examples": [
            "박감독 (시스템비계 자격)"
          ],
          "checkPoints": []
        },
        {
          "key": "scaffoldType",
          "label": "비계 종류·규격",
          "required": true,
          "inputGuide": "강관·시스템·외부·내부 비계 + 높이.",
          "examples": [
            "시스템비계 H18m × 외부 둘레"
          ],
          "checkPoints": []
        },
        {
          "key": "checkItems",
          "label": "점검 항목 (제57조 6항)",
          "required": true,
          "inputGuide": "발판·난간·이음·연결·도르래·기둥.",
          "examples": [
            [
              {
                "항목": "발판 폭 ≥40cm",
                "결과": "양호"
              },
              {
                "항목": "안전난간 상부 90~120cm",
                "결과": "양호"
              },
              {
                "항목": "수직재 이음",
                "결과": "양호"
              },
              {
                "항목": "가새",
                "결과": "양호"
              },
              {
                "항목": "기초·받침",
                "결과": "양호"
              },
              {
                "항목": "고정·결속",
                "결과": "양호"
              }
            ]
          ],
          "checkPoints": []
        },
        {
          "key": "corrections",
          "label": "이상 발견·조치",
          "required": false,
          "optional": true,
          "inputGuide": "미흡 시 즉시 조치.",
          "examples": [
            "[해당없음]"
          ],
          "checkPoints": []
        }
      ]
    },
    {
      "title": "결재선",
      "legalSource": "공통",
      "fields": [
        {
          "key": "compiler_sign",
          "label": "작성자 서명",
          "required": true,
          "inputGuide": "성명·서명.",
          "examples": [
            "김안전 (서명)"
          ],
          "checkPoints": []
        },
        {
          "key": "supervisor_sign",
          "label": "관리감독자 서명",
          "required": true,
          "inputGuide": "성명·서명.",
          "examples": [
            "박감독 (서명)"
          ],
          "checkPoints": []
        },
        {
          "key": "principal_sign",
          "label": "사업주/안전보건관리책임자 서명",
          "required": true,
          "inputGuide": "현장소장 서명.",
          "examples": [
