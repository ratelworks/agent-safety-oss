  "docId": "temporary_electric_inspection",
  "title": "가설전기 점검",
  "description": "기준규칙 제301조~제305조 전기작업 + 가설전기 안전. 분전반·접지·누전차단기·가설배선 점검. KOSHA Guide C-G-32 권장.",
  "cycle": "cyc:weekly",
  "trigger": "가설전기 설치 + 매주 정기점검 + 강우 후",
  "applicableWhen": {
    "appliesTo": "applic:all_workplace",
    "scaleNotes": "건설현장 가설전기 사용 모든 현장."
  },
  "legalBasis": [
    "art:기준규칙:301",
    "art:기준규칙:302",
    "art:기준규칙:303",
    "art:기준규칙:304",
    "art:기준규칙:305",
    "art:기준규칙:319",
    "art:기준규칙:306",
    "art:기준규칙:318"
  ],
  "requiredFields": [
    {
      "key": "f_0_점검_일자",
      "label": "점검 일자",
      "source": "산안기준규칙 제301조~제312조 + KOSHA Guide",
      "inputGuide": "점검 실시일.",
      "examples": [
        "2026-04-29"
      ]
    },
    {
      "key": "f_1_점검자",
      "label": "점검자",
      "source": "산안기준규칙 제301조~제312조 + KOSHA Guide",
      "inputGuide": "작성한 사람의 성명 + 직책 + (가능 시) 자격번호.",
      "examples": [
        "홍길동 (안전관리자, 산업안전기사 자격 1234567호)",
        "김철수 (현장소장)"
      ]
    },
    {
      "key": "f_2_가설전기_위치",
      "label": "가설전기 위치",
      "source": "산안기준규칙 제301조~제312조 + KOSHA Guide",
      "inputGuide": "동·층·구역별 가설전기 분전반 위치.",
      "examples": [
        "A동 각 층 분전반 + 외부 임시 분전반 2개소"
      ]
    },
    {
      "key": "f_3_누전차단기_작동",
      "label": "누전차단기 작동",
      "source": "산안기준규칙 제301조~제312조 + KOSHA Guide",
      "inputGuide": "누전차단기 작동 시험 (테스트 버튼 정상).",
      "examples": [
        "전체 정상 작동 (테스트 버튼 트립 확인)"
      ]
    },
    {
      "key": "f_4_접지_상태",
      "label": "접지 상태",
      "source": "산안기준규칙 제301조~제312조 + KOSHA Guide",
      "inputGuide": "접지 저항 측정 (10Ω 이하).",
      "examples": [
        "평균 5.2Ω (10Ω 이하 합격)"
      ]
    },
    {
      "key": "f_5_절연_저항",
      "label": "절연 저항",
      "source": "산안기준규칙 제301조~제312조 + KOSHA Guide",
      "inputGuide": "절연저항계 측정 (1MΩ 이상).",
      "examples": [
        "전 회로 1MΩ 이상 (정상)"
      ]
    },
    {
      "key": "f_6_분전반",
      "label": "분전반",
      "source": "산안기준규칙 제301조~제312조 + KOSHA Guide",
      "inputGuide": "분전반 외함·문 잠금 + 누설 점검.",
      "examples": [
        "외함 잠금 + 누설 없음 / 1개소 문 손상 → 교체"
      ]
    },
    {
      "key": "f_7_케이블_손상",
      "label": "케이블 손상",
      "source": "산안기준규칙 제301조~제312조 + KOSHA Guide",
      "inputGuide": "전기 케이블 피복 손상·짓밟힘 점검.",
      "examples": [
        "1개소 피복 손상 발견 → 교체 (4/29)"
      ]
    },
    {
      "key": "f_8_결과",
      "label": "결과",
      "source": "산안기준규칙 제301조~제312조 + KOSHA Guide",
      "inputGuide": "양호 / 보통 / 불량 + 특이사항.",
      "examples": [
        "양호 — 비계 안전난간 1개층 누락 → 즉시 설치 완료"
      ]
    },
    {
      "key": "f_9_조치_내용",
      "label": "조치 내용",
      "source": "산안기준규칙 제301조~제312조 + KOSHA Guide",
      "inputGuide": "발견 위험에 대한 즉시·계획 시정조치.",
      "examples": [
        "1) 안전난간 즉시 설치 / 2) 보호구 미착용자 1명 시정 지도 / 3) 7일 내 재점검"
      ]
    }
  ],
  "reviewRules": [
    {
      "rule": "필수 — 누전차단기 작동 + 매주 시험",
      "severity": "manual_review",
      "legalBasis": "art:기준규칙:304"
    },
    {
      "rule": "필수 — 접지저항 100Ω 이하",
      "severity": "manual_review",
      "legalBasis": "art:기준규칙:302"
    },
    {
      "rule": "필수 — 강우 후 즉시 점검 + 옥외 방수",
      "severity": "manual_review",
      "legalBasis": "art:기준규칙:301"
    },
    {
      "rule": "필수 — 활선 작업 시 LOTO + 검전 후 작업",
      "severity": "manual_review",
      "legalBasis": "art:기준규칙:319"
    }
  ],
