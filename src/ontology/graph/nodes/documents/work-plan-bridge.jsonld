  ],
  "docId": "work_plan_bridge",
  "title": "교량 작업계획서",
  "description": "교량 (높이 5m 이상 또는 지간 30m 이상 금속·콘크리트) 설치·해체·변경 (별표 4 8호)",
  "cycle": "cyc:ad_hoc",
  "trigger": "교량 설치·해체·변경 작업 전",
  "applicableWhen": {
    "workType": "bridge_5m_30m",
    "heightGte": 5,
    "spanGte": 30
  },
  "legalBasis": [
    "art:기준규칙:38",
    "annex:기준규칙:별표4-8호",
    "art:기준규칙:367",
    "art:기준규칙:369"
  ],
  "requiredFields": [
    {
      "key": "f_0_작업_방법_및_순서",
      "label": "작업 방법 및 순서",
      "source": "산안기준규칙 제38조 + 별표 4 8호",
      "inputGuide": "교량 가설 작업 방법 + 단계별 순서.",
      "examples": [
        "1) 기초 설치 / 2) 거푸집·동바리 / 3) 철근 배근 / 4) 콘크리트 타설 / 5) 양생"
      ]
    },
    {
      "key": "f_1_부재의_낙하_전도_또는",
      "label": "부재의 낙하·전도 또는 붕괴 방지 방법",
      "source": "산안기준규칙 제38조 + 별표 4 8호",
      "inputGuide": "부재 낙하·전도·붕괴 방지 조치.",
      "examples": [
        "크레인 양중 시 두 줄 걸이 + 신호수 / 임시 지지대 + 거푸집 검사"
      ]
    },
    {
      "key": "fallSafety",
      "label": "근로자 추락 위험 방지 안전조치",
      "source": "산안기준규칙 제38조 + 별표 4 8호",
      "inputGuide": "감소대책. 제거 → 대체 → 공학적 → 관리적 → 보호구 순.",
      "examples": [
        "1) 안전난간 설치 (공학적) / 2) 작업구역 통제 (관리적) / 3) 안전대 착용 (보호구)"
      ]
    },
    {
      "key": "f_3_가설_철구조물의_설치_",
      "label": "가설 철구조물의 설치·사용·해체 시 안전성 검토 방법",
      "source": "산안기준규칙 제38조 + 별표 4 8호",
      "inputGuide": "가설 철구조물 안전성 검토 방법 (구조계산·검사).",
      "examples": [
        "구조기술사 구조계산 + 설치 후 정밀 검사 + 사용 중 일일 점검"
      ]
    },
    {
      "key": "f_4_사용하는_기계등의_종류",
      "label": "사용하는 기계등의 종류 및 성능",
      "source": "산안기준규칙 제38조 + 별표 4 8호",
      "inputGuide": "사용 기계 + 성능 (정격하중·인양능력).",
      "examples": [
        "타워크레인 TC-7030 (정격 6톤) + 이동식크레인 200톤 + 콘크리트펌프카 60m"
      ]
    },
    {
      "key": "supervisor",
      "label": "작업지휘자 배치계획",
      "source": "산안기준규칙 제38조 + 별표 4 8호",
      "inputGuide": "감리 회사명 + 책임감리원 성명 + 자격번호.",
      "examples": [
        "(주)도화엔지니어링 / 김감리 (건축사 1234호)"
      ]
    }
  ],
  "reviewRules": [
    {
      "rule": "작업계획 6항목 작성",
      "severity": "manual_review",
      "legalBasis": "annex:기준규칙:별표4-8호"
    },
    {
      "rule": "근로자 통지 (제38조 ②)",
      "severity": "manual_review",
      "legalBasis": "art:기준규칙:38"
    }
  ],
  "sections": [
    {
      "title": "1. 문서 메타",
      "legalSource": "공통",
      "fields": [
        {
          "key": "documentNumber",
          "label": "문서번호",
          "required": true,
