  "docId": "risk_assessment_procedure",
  "title": "위험성평가 절차서",
  "description": "위험성평가 효과적 실시 위한 사업장 규정 (위험성평가 고시 제6조)",
  "cycle": "cyc:annual",
  "legalBasis": [
    "art:위험성평가-고시:6",
    "art:산안법시행규칙:37",
    "art:산안법시행규칙:37의2",
    "art:산안법시행규칙:37의3",
    "art:산안법시행규칙:37의4",
    "art:위험성평가-고시:19",
    "art:위험성평가-고시:11",
    "art:위험성평가-고시:8",
    "art:위험성평가-고시:17",
    "art:위험성평가-고시:21"
  ],
  "requiredFields": [
    {
      "key": "method",
      "label": "1. 평가의 목적 및 방법",
      "source": "위험성평가 고시 제19조제1호 · 제9조",
      "inputGuide": "평가의 목적과 활용할 기법(고시 §9 — 빈도·강도법, 체크리스트법, 위험성 수준 3단계 판단법, 핵심 요인 기술법 등)과 평가 대상 범위.",
      "examples": [
        "빈도(1~5) × 강도(1~4) 매트릭스, 위험도 12 이상 우선조치",
        "전 공정(굴착·골조·마감) + 비정형(긴급보수·청소)"
      ]
    },
    {
      "key": "team",
      "label": "2. 평가담당자 및 책임자의 역할",
      "source": "위험성평가 고시 제19조제2호 · 제8조",
      "inputGuide": "실시를 총괄·관리하는 사람(사업주·안전보건관리책임자 등), 관리감독자(요인 파악·개선대책 이행 참여), 안전관리자·보건관리자(기술적 보좌·지도 조언), 기계·설비 전문가 참여(고시 §8).",
      "examples": [
        "사업주 1, 관리감독자 2, 작업자대표 3, 안전관리자 1"
      ]
    },
    {
      "key": "cycle",
      "label": "3. 평가 시기",
      "source": "위험성평가 고시 제19조제3호 · 제13조~제16조",
      "inputGuide": "최초(작업을 시작하기 전까지) · 정기(최초평가 연도의 다음 연도부터 매년 1회 이상) · 수시(관련 작업을 시작하기 전까지) · 상시평가를 택하면 매월·매주·매 작업일 (시행규칙 §37 ②, 고시 §13~§16).",
      "examples": [
        "최초 착공 전 / 정기 매년 12월 / 수시 공정·장비 변경 시 작업 전 / 상시 매월 둘째 주·매주 월요일·매 작업일 TBM"
      ]
    },
    {
      "key": "workerParticipation",
      "label": "4. 근로자 및 근로자대표의 참여 방법",
      "source": "위험성평가 고시 제19조제4호 · 제6조·제7조 · 시행규칙 제37조의2",
      "inputGuide": "해당 작업에 실제 종사하는 근로자를 요인 파악·위험성 결정·개선대책 수립·이행 후 확인에 참여시키는 방법(사업장 순회 점검 원칙), 근로자대표가 요구할 때의 참여 협의 방법(고시 §6·§7).",
      "examples": [
        "TBM에서 5분 의견청취, 월 1회 협의회"
      ]
    },
    {
      "key": "sharingMethod",
      "label": "5. 근로자에 대한 공유 방법",
      "source": "위험성평가 고시 제19조제5호 · 제17조 · 시행규칙 제37조의3",
      "inputGuide": "실시 전 일정·실시 후 결과를 알리는 방법 — 안전보건교육·설명회·게시·문서·작업 전 안전점검회의·전자적 방법 중 하나 이상, 신규 채용·작업 변경 근로자는 작업 시작 전 공유(고시 §17).",
      "examples": [
        "실시 일정: 현장 게시판 + 카카오 알림 / 결과: 정기교육 + 게시 + TBM, 신규 채용자는 채용 시 교육에서 공유"
      ]
    },
    {
      "key": "recordMethod",
      "label": "6. 결과의 기록·보존 방법",
      "source": "위험성평가 고시 제19조제6호 · 제21조 · 시행규칙 제37조의4",
      "inputGuide": "기록 항목(실시 시기·담당자·참여 근로자·근로자대표·결과 4가지)과 보존 3년(개선대책 수립 완료 다음 날부터), 전자문서 보존 여부(시행규칙 §37의4, 고시 §21).",
      "examples": [
        "전자문서(현장 공유 드라이브) + 출력본 사무실 보관, 개선대책 수립 완료 다음 날부터 3년"
      ]
    },
    {
      "key": "riskCriteria",
      "label": "위험성 수준 판단 기준과 허용 가능한 위험성 수준 (법령 기준 이상)",
      "source": "위험성평가 고시 제11조제1항",
      "inputGuide": "위험성을 결정할 때 쓸 판단 기준과 허용 가능한 수준을 미리 정한다(고시 §11 ①). 위험성 결정은 이 기준으로 한다(§11 ②).",
      "examples": [
        "빈도(1~5)×강도(1~4), 8 이하 허용 가능 / 9~12 개선 후 작업 / 15 이상 작업 중지"
      ]
    }
  ],
  "reviewRules": [
    {
      "rule": "실시규정 6개 항목(목적 및 방법·담당자 및 책임자 역할·평가 시기·근로자 및 근로자대표 참여 방법·공유 방법·기록·보존 방법)을 모두 적었다",
      "severity": "blocker",
      "legalBasis": "art:위험성평가-고시:19",
      "checkFields": [
        "method",
        "team",
        "cycle",
        "workerParticipation",
        "sharingMethod",
        "recordMethod"
      ]
    },
    {
      "rule": "위험성 수준 판단 기준과 허용 가능한 수준을 정했다",
      "severity": "blocker",
      "legalBasis": "art:위험성평가-고시:11",
      "checkFields": [
        "riskCriteria"
      ]
    }
  ],
