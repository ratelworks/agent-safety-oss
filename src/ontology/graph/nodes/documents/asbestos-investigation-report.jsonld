{
  "@context": "../../context.jsonld",
  "@id": "doc:ad_hoc/asbestos_investigation_report",
  "@type": [
    "Document",
    "DigitalDocument"
  ],
  "docId": "asbestos_investigation_report",
  "title": "석면조사 결과서",
  "description": "산안법 제142조 건축물·설비 철거·해체 전 석면 함유 여부 조사. 일반석면조사 + 기관석면조사(50㎡ 이상). 석면지도 작성·해체작업계획 첨부.",
  "cycle": "cyc:ad_hoc",
  "trigger": "건축물·설비 철거·해체 착수 전",
  "legalBasis": [
    "art:산안법:142",
    "art:산안법:119",
    "art:산안법:122",
    "art:기준규칙:574"
  ],
  "verificationStatus": "verified",
  "_meta": {
    "publishedBy": "라텔웍스 + 황룡건설(주)",
    "fetchedAt": "2026-04-28",
    "licenseHint": "저작권법 제7조 비보호 (자유 인용)",
    "note": "신규 의무문서 — requiredFields/reviewRules/applicableWhen 표준 골격 채움 (Phase 2.5 wave4).",
    "verifiedAt": "2026-04-28",
    "alignedAt": "2026-04-29",
    "alignSource": "align-nodes-bulk.ts (KOSHA 권고 + 산안법 본문 기반)"
  },
  "applicableWhen": {
    "appliesTo": "applic:all_workplace",
    "scaleNotes": "건축물·설비 철거·해체 전. 50㎡ 이상 건축물·15㎡ 이상 단열재 → 기관석면조사."
  },
  "exemptedWhen": {
    "reasons": [
      "1995년 이후 신축 + 무석면 인증",
      "철거·해체 미시행"
    ]
  },
  "requiredFields": [
    {
      "key": "buildingInfo",
      "label": "건축물·설비 정보 (소유주·면적·연도)",
      "source": "산안법 제142조 + 시행규칙 제175조 (50㎡↑ 기관조사 의무)",
      "inputGuide": "소유주·면적(연면적/대지면적)·준공연도·구조(철콘/철골/조적)·층수.",
      "examples": [
        "황룡개발(주) / 연면적 5,000㎡ 대지 1,200㎡ / 1985년 준공 / 철근콘크리트조 지상 5층 지하 1층"
      ]
    },
    {
      "key": "investigationDate",
      "label": "조사 일자",
      "source": "산안법 제142조 + 시행규칙 제175조 (50㎡↑ 기관조사 의무)",
      "inputGuide": "석면조사 실시일.",
      "examples": [
        "2026-04-29"
      ]
    },
    {
      "key": "investigator",
      "label": "조사기관·자격",
      "source": "산안법 제142조 + 시행규칙 제175조 (50㎡↑ 기관조사 의무)",
      "inputGuide": "고용노동부 등록 석면조사기관 + 석면조사기관 등록번호 + 책임조사자 자격번호.",
      "examples": [
        "(주)석면조사기관OO (등록 제2024-0001호) / 책임 김OO (석면조사기사 1234호)"
      ]
    },
    {
      "key": "investigationType",
      "label": "일반조사 / 기관조사",
      "source": "산안법 제142조 + 시행규칙 제175조 (50㎡↑ 기관조사 의무)",
      "inputGuide": "일반석면조사 (자체) / 기관석면조사 (지정기관) — 산안법 제119조.",
      "examples": [
        "기관조사 (한국산업안전보건공단)"
      ]
    },
    {
      "key": "samplingPoint",
      "label": "시료 채취 지점·점수",
      "inputGuide": "시료 채취 지점 명시 + 채취 점수 (KOSHA 가이드 기준 면적·재료별).",
      "examples": [
        "1) 천정재 5점 / 2) 바닥재 3점 / 3) 단열재 4점 (총 12점)"
      ]
    },
    {
      "key": "analysisResult",
      "label": "분석 결과 (석면 함유 여부·종류·함유율)",
      "inputGuide": "PLM/PCM 분석 결과. 석면 종류 (백석면·청석면·갈석면) + 함유율(%).",
      "examples": [
        "1) 천정재 백석면 5% (함유) / 2) 바닥재 미함유 / 3) 단열재 갈석면 8% (함유)"
      ]
    },
    {
      "key": "asbestosMap",
      "label": "석면지도 (위치·면적)",
      "inputGuide": "석면 함유 자재 위치 + 면적 도면.",
      "examples": [
        "지하 1층 천정재 320㎡ + 3층 단열재 180㎡ (석면지도 첨부)"
      ]
    },
    {
      "key": "demolitionPlan",
      "label": "해체 작업계획 (석면 함유 시)",
      "inputGuide": "석면 해체·제거 작업계획 (격리·습식·공기 측정·폐기물).",
      "examples": [
        "격리 (이중차단막) + 습식 작업 + 공기 측정 (4시간 간격) + 지정폐기물 처리"
      ]
    },
    {
      "key": "workerNotification",
      "label": "근로자 통지",
      "inputGuide": "석면 함유 사실 근로자 통지 (산안법 제123조).",
      "examples": [
        "전체 근로자 게시판 통지 + 안전교육 30분 (4/30)"
      ]
    }
  ],
  "reviewRules": [
    {
      "rule": "필수 — 50㎡ 이상 건축물 → 기관석면조사 의무",
      "severity": "manual_review",
      "legalBasis": "art:산안법:142"
    },
    {
      "rule": "필수 — 시료 분석 결과 + 석면지도",
      "severity": "manual_review",
      "legalBasis": "art:산안법:119"
    },
    {
      "rule": "필수 — 석면 함유 시 해체작업계획서 연계",
      "severity": "manual_review",
      "legalBasis": "art:산안법:122"
    }
  ],
  "searchKeywords": [
    "석면조사 결과서",
    "기관석면조사",
    "일반석면조사"
  ],
  "references": [
