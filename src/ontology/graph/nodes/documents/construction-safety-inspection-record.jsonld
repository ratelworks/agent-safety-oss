  ],
  "docId": "construction_safety_inspection_record",
  "title": "건설공사 안전점검 결과 (건진법)",
  "description": "건설공사 안전점검 결과 (건진법) - 건진법:62:5 (자동 생성 스켈레톤. 후속 양식 정합 필요).",
  "cycle": "cyc:quarterly",
  "trigger": "분기",
  "legalBasis": [
    "art:건진법:62:5",
    "art:건진법:62"
  ],
  "officialFormSpec": {
    "formId": "auto_skeleton_construction_safety_inspection_record",
    "officialName": "건설공사 안전점검 결과 (건진법) (국토부 / CSI)",
    "formMatchType": "스켈레톤 자동 생성 — 양식 정합 후속 필요",
    "license": "공공누리 + 황룡건설(주) + ㈜라텔웍스"
  },
  "sections": [
    {
      "title": "1. 문서 메타",
      "legalSource": "공통",
      "fields": [
        {
          "key": "documentNumber",
          "label": "문서번호",
          "required": true,
          "inputGuide": "현장 자체 일련번호 (DOC-YYMMDD-NN).",
          "examples": [
            "DOC-260429-01"
          ],
          "checkPoints": []
        },
        {
          "key": "siteName",
          "label": "사업장 / 현장명",
          "required": true,
          "inputGuide": "사업장 정식 명칭.",
          "examples": [
            "황룡건설(주) 삼성동 현장"
          ],
          "checkPoints": []
        },
        {
          "key": "compileDate",
          "label": "작성 일자",
          "required": true,
          "inputGuide": "YYYY-MM-DD.",
          "examples": [
            "2026-04-29"
          ],
          "checkPoints": []
        },
        {
          "key": "compiler",
          "label": "작성자 (안전관리자)",
          "required": true,
          "inputGuide": "성명·직책.",
          "examples": [
            "김안전 (안전관리자)"
          ],
          "checkPoints": []
        }
      ]
    },
    {
      "title": "2. 건설공사 안전점검 결과",
      "legalSource": "건진법 제62조 ⑤ + 시행령 제100조",
      "fields": [
        {
          "key": "inspectionType",
          "label": "점검 종류",
          "required": true,
          "inputGuide": "건진법 §62:5 SSoT 5종: 자체점검(매일 — 공사기간 중) / 정기안전점검(시행규칙 §59 별표 8 주기) / 정밀안전점검(정기 결과 필요시) / 초기점검(안전관리계획 수립 대상 공사 완료 직전) / 공사재개 전 안전점검(1년 이상 중단 후 재개 시).",
          "examples": [
            "자체점검 (분기 누적 요약)",
            "정기안전점검 (분기 정기)"
          ],
          "checkPoints": []
        },
        {
          "key": "inspectionDate",
          "label": "점검 일자",
          "required": true,
          "inputGuide": "점검 시기.",
          "examples": [
            "2026-04-29"
          ],
          "checkPoints": []
        },
        {
          "key": "inspectors",
          "label": "점검자",
          "required": true,
          "inputGuide": "안전관리자 + 시공책임자 + 발주처.",
          "examples": [
            "김안전 (안전관리자), 박감독 (시공), 이발주 (발주처)"
          ],
          "checkPoints": []
        },
        {
          "key": "findings",
          "label": "점검 결과",
          "required": true,
          "inputGuide": "안전관리계획 이행도 + 미흡 사항.",
          "examples": [
            "1) 흙막이 계측 양호, 2) 추락방호망 1개층 누락 → 즉시 설치"
          ],
          "checkPoints": []
        },
        {
          "key": "reportToMOLIT",
          "label": "국토부 보고",
          "required": false,
          "optional": true,
          "inputGuide": "종합점검 결과는 국토부 CSI에 보고.",
          "examples": [
            "[해당없음] 자체점검",
            "2026-Q4 종합점검 결과 CSI 등록 예정"
          ],
          "checkPoints": []
        }
      ]
    },
    {
      "title": "결재선",
      "legalSource": "공통",
      "fields": [
        {
          "key": "compiler_sign",
          "label": "작성자 서명",
          "required": true,
          "inputGuide": "성명·서명.",
          "examples": [
            "김안전 (서명)"
          ],
          "checkPoints": []
        },
        {
          "key": "supervisor_sign",
          "label": "관리감독자 서명",
          "required": true,
          "inputGuide": "성명·서명.",
          "examples": [
            "박감독 (서명)"
          ],
          "checkPoints": []
        },
        {
          "key": "principal_sign",
          "label": "사업주/안전보건관리책임자 서명",
          "required": true,
          "inputGuide": "현장소장 서명.",
          "examples": [
            "황룡 (현장소장, 서명)"
          ],
          "checkPoints": []
        }
      ]
    }
  ],
  "approvalChain": [
    {
      "role": "작성자 (안전관리자)",
      "action": "기안"
    },
    {
      "role": "관리감독자",
      "action": "검토"
    },
    {
      "role": "사업주 / 안전보건관리책임자",
      "action": "최종 승인"
    }
  ],
  "reviewRules": [
    {
      "rule": "문서 메타 (사업장명·작성일자·작성자) 명시",
      "severity": "blocker",
      "legalBasis": "art:건진법:62:5",
      "checkFields": [
        "siteName",
        "compileDate",
        "compiler"
      ]
    },
    {
      "rule": "사업주 + 안전관리자 서명",
      "severity": "blocker",
      "legalBasis": "art:건진법:62:5",
      "checkFields": [
        "compiler_sign",
        "principal_sign"
      ]
    }
  ],
  "retention": "공사 완료시까지",
  "guidedBy": [
    "doc:kosha_guide/D-C-12-2026",
