  "docId": "honorary_safety_supervisor_appointment",
  "title": "명예산업안전감독관 위촉",
  "description": "산안법 제23조 명예산업안전감독관 위촉. 근로자단체·사업주단체·산업재해 예방 관련 전문단체 추천. 임기 2년·갱신 가능.",
  "cycle": "cyc:ad_hoc",
  "trigger": "명예감독관 위촉·갱신 시",
  "legalBasis": [
    "art:산안법:23",
    "art:산안법시행령:32"
  ],
  "verificationStatus": "verified",
  "_meta": {
    "publishedBy": "라텔웍스 + 황룡건설(주)",
    "fetchedAt": "2026-04-28",
    "licenseHint": "저작권법 제7조 비보호 (자유 인용)",
    "note": "신규 의무문서 — requiredFields/reviewRules/applicableWhen 표준 골격 채움 (Phase 2.5 wave4).",
    "verifiedAt": "2026-04-28",
    "alignedAt": "2026-04-29",
    "alignSource": "align-nodes-bulk.ts (KOSHA 권고 + 산안법 본문 기반)"
  },
  "applicableWhen": {
    "appliesTo": "applic:all_workplace",
    "scaleNotes": "고용노동부장관 위촉. 근로자단체·사업주단체 추천."
  },
  "exemptedWhen": {
    "reasons": [
      "위촉 명령 없음 (자율 위촉 아님)"
    ]
  },
  "requiredFields": [
    {
      "key": "f_0_사업장명",
      "label": "사업장명",
      "source": "산안법 제23조 + 시행령 제32조",
      "inputGuide": "법인등기부등본 또는 사업자등록증 상의 정식 명칭. 약칭·통칭 사용 금지.",
      "examples": [
        "황룡건설(주)",
        "(주)라텔웍스",
        "현대건설 주식회사"
      ]
    },
    {
      "key": "appointmentDate",
      "label": "위촉 일자",
      "source": "산안법 제23조 + 시행령 제32조",
      "inputGuide": "명예산업안전감독관 위촉 일자.",
      "examples": [
        "2026-04-01"
      ]
    },
    {
      "key": "f_2_위촉_대상__성명_소속",
      "label": "위촉 대상 (성명·소속·직책)",
      "source": "산안법 제23조 + 시행령 제32조",
      "inputGuide": "위촉 대상 성명 + 소속 + 직책. 근로자 중 선출 (산안법 제23조).",
      "examples": [
        "이작업 (황룡건설(주) 철근반장, 근로자대표)"
      ]
    },
    {
      "key": "f_3_활동_범위",
      "label": "활동 범위",
      "source": "산안법 제23조 + 시행령 제32조",
      "inputGuide": "명예산업안전감독관 활동 범위 (점검·신고·교육 참여).",
      "examples": [
        "주 1회 사업장 순회 점검 + 위험요인 신고 + 안전교육 강사 보조"
      ]
    },
    {
      "key": "f_4_임기",
      "label": "임기",
      "source": "산안법 제23조 + 시행령 제32조",
      "inputGuide": "위촉 기간. 시작일 ~ 종료일 (보통 1년 또는 2년).",
      "examples": [
        "2026-04-01 ~ 2027-03-31 (1년)"
      ]
    },
    {
      "key": "f_5_사업주_서명",
      "label": "사업주 서명",
      "source": "산안법 제23조 + 시행령 제32조",
      "inputGuide": "법인등기부등본 상의 대표자 성명. 외국인은 영문 + 한글 병기.",
      "examples": [
        "황 룡",
        "홍길동",
        "John Smith (존 스미스)"
      ]
    }
  ],
  "reviewRules": [
    {
      "rule": "필수 — 위촉장 + 추천 단체 명시",
      "severity": "manual_review",
      "legalBasis": "art:산안법:23"
    },
    {
      "rule": "필수 — 임기 2년 + 갱신 절차",
      "severity": "manual_review",
      "legalBasis": "art:산안법시행령:32"
    }
  ],
  "references": [
    "annex:산안법시행규칙:서식90의2",
