  "docId": "work_plan_excavation",
  "title": "굴착 작업계획서",
  "alternativeNames": [
    "굴착 작업계획서",
    "토공사 작업계획서"
  ],
  "description": "굴착면 높이 2m 이상의 굴착작업 시작 전 사업주가 작성·근로자에게 통지해야 하는 작업계획서. 산업안전보건기준에 관한 규칙 제38조 및 별표 4 제6호 근거.",
  "cycle": "cyc:ad_hoc",
  "trigger": "굴착면 높이 2m 이상 굴착작업 시작 전",
  "legalBasis": [
    "art:기준규칙:38",
    "annex:기준규칙:별표4-6호"
  ],
  "applicableWhen": {
    "workType": "excavation",
    "depthGte": 2,
    "depthUnit": "m"
  },
  "exemptedWhen": {
    "depthLt": 2,
    "note": "굴착면 2m 미만은 제38조 미적용 (단 위험성평가는 별도 의무)"
  },
  "requiredFields": [
    {
      "key": "preSurvey_shape",
      "label": "사전조사 가. 형상ㆍ지질 및 지층의 상태",
      "source": "산업안전보건기준에 관한 규칙 별표 4 제6호 사전조사 내용",
      "inputGuide": "굴착 형상·지반 종류. (별표 4 원문 항목: 사전조사 가. 형상ㆍ지질 및 지층의 상태)",
      "examples": [
        "굴착 8m × 30m × 30m, 화강풍화토 + 풍화암",
        "상부 풍화토 3m + 풍화암 2m + 연암 5m (지질조사보고서 첨부)"
      ]
    },
    {
      "key": "preSurvey_crack",
      "label": "사전조사 나. 균열ㆍ함수(含水) ㆍ용수 및 동결의 유무 또는 상태",
      "source": "산업안전보건기준에 관한 규칙 별표 4 제6호 사전조사 내용",
      "inputGuide": "기존 균열·지하수. (별표 4 원문 항목: 사전조사 나. 균열ㆍ함수(含水) ㆍ용수 및 동결의 유무 또는 상태)",
      "examples": [
        "인접 건물 균열 없음, 지하수위 GL-6m",
        "굴착부 GL-3m 지하수 용출 / 균열 없음 / 동결 미발생"
      ]
    },
    {
      "key": "preSurvey_buried",
      "label": "사전조사 다. 매설물 등의 유무 또는 상태",
      "source": "산업안전보건기준에 관한 규칙 별표 4 제6호 사전조사 내용",
      "inputGuide": "가스·전기·수도·통신 매설. (별표 4 원문 항목: 사전조사 다. 매설물 등의 유무 또는 상태)",
      "examples": [
        "도시가스 GL-1.5m, 한전 22.9kV GL-2.0m, 상수도 GL-1.0m",
        "전면 도로 GL-1.5m 도시가스 (Φ200) / GL-2m 통신 / GL-3m 상수도"
      ]
    },
    {
      "key": "preSurvey_groundwater",
      "label": "사전조사 라. 지반의 지하수위 상태",
      "source": "산업안전보건기준에 관한 규칙 별표 4 제6호 사전조사 내용",
      "inputGuide": "굴착부 지하수위 + 강우 시 변동. (별표 4 원문 항목: 사전조사 라. 지반의 지하수위 상태)",
      "examples": [
        "평상시 GL-3m / 강우 시 GL-1.5m (계측 기준 1주 단위)"
      ]
    },
    {
      "key": "plan_method",
      "label": "가. 굴착방법 및 순서, 토사등 반출 방법",
      "source": "산업안전보건기준에 관한 규칙 별표 4 제6호 작업계획서 내용 가목",
      "inputGuide": "기계·인력 + 단계별 깊이. (별표 4 원문 항목: 굴착방법 및 순서, 토사등 반출 방법)",
      "examples": [
        "1단계 GL-3m (오픈컷) → 2단계 -8m (흙막이)"
      ]
    },
    {
      "key": "plan_workers",
      "label": "나. 필요한 인원 및 장비 사용계획",
      "source": "산업안전보건기준에 관한 규칙 별표 4 제6호 작업계획서 내용 나목",
      "inputGuide": "근로자 수·자격. (별표 4 원문 항목: 필요한 인원 및 장비 사용계획)",
      "examples": [
        "굴착작업자 8명 + 신호수 1명 + 작업지휘자 1명",
        "굴삭기 운전 2명 + 신호수 2명 + 작업자 6명 / 굴삭기 안전검사필증 첨부"
      ]
    },
    {
      "key": "plan_protection",
      "label": "다. 매설물 등에 대한 이설ㆍ보호대책",
      "source": "산업안전보건기준에 관한 규칙 별표 4 제6호 작업계획서 내용 다목",
      "inputGuide": "노출·이설·보호. (별표 4 원문 항목: 매설물 등에 대한 이설ㆍ보호대책)",
      "examples": [
        "가스: 보호 박스 + 도시가스공사 입회"
      ]
    },
    {
      "key": "plan_signal",
      "label": "라. 사업장 내 연락방법 및 신호방법",
      "source": "산업안전보건기준에 관한 규칙 별표 4 제6호 작업계획서 내용 라목",
      "inputGuide": "신호수·통신. (별표 4 원문 항목: 사업장 내 연락방법 및 신호방법)",
      "examples": [
        "신호수 1명 + 무전기 Ch5"
      ]
    },
    {
      "key": "plan_shoring",
      "label": "마. 흙막이 지보공 설치방법 및 계측계획",
      "source": "산업안전보건기준에 관한 규칙 별표 4 제6호 작업계획서 내용 마목",
      "inputGuide": "공법·구조. (별표 4 원문 항목: 흙막이 지보공 설치방법 및 계측계획)",
      "examples": [
        "H-300 + 어스앵커 2단 (PS75kN/1개)"
      ]
    },
    {
      "key": "plan_director",
      "label": "바. 작업지휘자의 배치계획",
      "source": "산업안전보건기준에 관한 규칙 별표 4 제6호 작업계획서 내용 바목",
      "inputGuide": "건설안전기사 이상. (별표 4 원문 항목: 작업지휘자의 배치계획)",
      "examples": [
        "박감독 (건설안전기사)"
      ]
    },
    {
      "key": "plan_other",
      "label": "사. 그 밖에 안전ㆍ보건에 관련된 사항",
      "source": "산업안전보건기준에 관한 규칙 별표 4 제6호 작업계획서 내용 사목",
      "inputGuide": "별표 4 원문 항목을 이 작업에서 어떻게 하는지 구체적으로 적는다: 그 밖에 안전ㆍ보건에 관련된 사항",
      "examples": []
    },
    {
      "key": "notifiedToWorkers",
      "label": "작업계획서 내용을 해당 근로자에게 알림 (안전보건규칙 제38조제2항)",
      "source": "산업안전보건기준에 관한 규칙 제38조제2항",
      "inputGuide": "작성한 작업계획서의 내용을 해당 근로자에게 알렸는지와 그 방법·일시를 적는다.",
      "examples": [
        "작업 전 TBM 에서 작업계획서 내용 설명 (2026-03-02 07:30, 참석 12명 서명)"
      ]
    }
  ],
