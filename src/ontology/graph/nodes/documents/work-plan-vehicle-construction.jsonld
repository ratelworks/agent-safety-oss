    "art:기준규칙:207",
    "art:기준규칙:210"
  ],
  "requiredFields": [
    {
      "key": "f_0_굴러떨어짐_지반_침하_",
      "label": "굴러떨어짐·지반 침하 위험",
      "source": "산안기준규칙 제38조 + 별표 4 3호",
      "inputGuide": "차량계 건설기계 굴러떨어짐·지반 침하 위험 + 대책.",
      "examples": [
        "단부 안전난간 + 지반 다짐도 검사 + 강판 받침대"
      ]
    },
    {
      "key": "machineType",
      "label": "차량계 건설기계 종류·성능",
      "source": "산안기준규칙 제38조 + 별표 4 3호",
      "inputGuide": "사용 건설기계 종류 + 성능.",
      "examples": [
        "굴삭기 22톤 (Volvo EC220) + 덤프트럭 15톤 + 콘크리트펌프카 60m"
      ]
    },
    {
      "key": "f_2_운행_경로",
      "label": "운행 경로",
      "source": "산안기준규칙 제38조 + 별표 4 3호",
      "inputGuide": "운행 경로 (도면 첨부).",
      "examples": [
        "정문 → 작업장 → 야적장 (단방향, 우회전 우선)"
      ]
    },
    {
      "key": "method",
      "label": "작업방법",
      "source": "산안기준규칙 제38조 + 별표 4 3호",
      "inputGuide": "작업 방법 + 안전조치.",
      "examples": [
        "굴착 1:1.5 안전기울기 + 신호수 1명 + 작업반경 출입 통제"
      ]
    }
  ],
  "reviewRules": [
    {
      "rule": "사전조사·작업계획 모두 작성",
      "severity": "manual_review",
      "legalBasis": "annex:기준규칙:별표4-3호"
