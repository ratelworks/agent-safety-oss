  "docId": "work_plan_vehicle_construction",
  "title": "차량계 건설기계 작업계획서",
  "description": "굴삭기·로더·불도저 등 차량계 건설기계 사용 작업 (별표 4 3호)",
  "cycle": "cyc:ad_hoc",
  "trigger": "차량계 건설기계 사용 작업 전",
  "applicableWhen": {
    "workType": "vehicle_construction"
  },
  "legalBasis": [
    "art:기준규칙:38",
    "annex:기준규칙:별표4-3호",
    "art:기준규칙:207",
    "art:기준규칙:210"
  ],
  "requiredFields": [
    {
      "key": "terrainSurvey",
      "label": "사전조사 — 해당 기계의 굴러 떨어짐, 지반의 붕괴 등으로 인한 근로자의 위험을 방지하기 위한 해당 작업장소의 지형 및 지반상태",
      "source": "산업안전보건기준에 관한 규칙 별표 4 제3호 사전조사 내용",
      "inputGuide": "차량계 건설기계 굴러떨어짐·지반 침하 위험 + 대책. (별표 4 원문 항목: 해당 기계의 굴러 떨어짐, 지반의 붕괴 등으로 인한 근로자의 위험을 방지하기 위한 해당 작업장소의 지형 및 지반상태)",
      "examples": [
        "단부 안전난간 + 지반 다짐도 검사 + 강판 받침대"
      ]
    },
    {
      "key": "machineList",
      "label": "가. 사용하는 차량계 건설기계의 종류 및 성능",
      "source": "산업안전보건기준에 관한 규칙 별표 4 제3호 작업계획서 내용 가목",
      "inputGuide": "사용 건설기계 종류 + 성능. (별표 4 원문 항목: 사용하는 차량계 건설기계의 종류 및 성능)",
      "examples": [
        "굴삭기 22톤 (Volvo EC220) + 덤프트럭 15톤 + 콘크리트펌프카 60m",
        "굴삭기 0.7m³ × 2대, 덤프트럭 25톤 × 3대"
      ]
    },
    {
      "key": "trafficPlan",
      "label": "나. 차량계 건설기계의 운행경로",
      "source": "산업안전보건기준에 관한 규칙 별표 4 제3호 작업계획서 내용 나목",
      "inputGuide": "운행 경로 (도면 첨부). (별표 4 원문 항목: 차량계 건설기계의 운행경로)",
      "examples": [
        "정문 → 작업장 → 야적장 (단방향, 우회전 우선)",
        "진입 정문 → 굴착장 → 사토장 / 출구 후문 (편도 2차로)"
      ]
    },
    {
      "key": "method",
      "label": "다. 차량계 건설기계에 의한 작업방법",
      "source": "산업안전보건기준에 관한 규칙 별표 4 제3호 작업계획서 내용 다목",
      "inputGuide": "작업 방법 + 안전조치. (별표 4 원문 항목: 차량계 건설기계에 의한 작업방법)",
      "examples": [
        "굴착 1:1.5 안전기울기 + 신호수 1명 + 작업반경 출입 통제"
      ]
    },
    {
      "key": "notifiedToWorkers",
      "label": "작업계획서 내용을 해당 근로자에게 알림 (안전보건규칙 제38조제2항)",
      "source": "산업안전보건기준에 관한 규칙 제38조제2항",
      "inputGuide": "작성한 작업계획서의 내용을 해당 근로자에게 알렸는지와 그 방법·일시를 적는다.",
      "examples": [
        "작업 전 TBM 에서 작업계획서 내용 설명 (2026-03-02 07:30, 참석 12명 서명)"
      ]
    }
  ],
  "reviewRules": [
    {
      "rule": "별표 4 제3호의 사전조사 내용과 작업계획서 내용(가~다목)을 모두 적었다",
      "severity": "blocker",
      "legalBasis": "annex:기준규칙:별표4-3호",
      "checkFields": [
        "terrainSurvey",
        "machineList",
