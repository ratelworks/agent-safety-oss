  "requiredFields": [
    {
      "key": "f_0_점검_일자",
      "label": "점검 일자",
      "source": "산안기준규칙 제32조 + KOSHA 권장",
      "inputGuide": "점검 실시일.",
      "examples": [
        "2026-04-29"
      ]
    },
    {
      "key": "inspector",
      "label": "점검자",
      "source": "산안기준규칙 제32조 + KOSHA 권장",
      "inputGuide": "작성한 사람의 성명 + 직책 + (가능 시) 자격번호.",
      "examples": [
        "홍길동 (안전관리자, 산업안전기사 자격 1234567호)",
        "김철수 (현장소장)"
      ]
    },
    {
      "key": "f_2_안전대_종류__벨트식_",
      "label": "안전대 종류 (벨트식·그네식)",
      "source": "산안기준규칙 제32조 + KOSHA 권장",
      "inputGuide": "지급 수량·규격·인증.",
      "examples": [
        "12개 (풀하네스 전체식, KCs 인증)"
      ]
    },
    {
      "key": "f_3_KCs_인증_번호",
      "label": "KCs 인증 번호",
      "source": "산안기준규칙 제32조 + KOSHA 권장",
      "inputGuide": "안전대 KCs 인증 번호.",
      "examples": [
        "KCs-PPE-2025-A012"
      ]
    },
    {
      "key": "f_4_벨트_D링_후크_랜야드",
      "label": "벨트·D링·후크·랜야드 점검",
      "source": "산안기준규칙 제32조 + KOSHA 권장",
      "inputGuide": "주요 부속 점검.",
      "examples": [
        "벨트 정상 / D링 변형 없음 / 후크 게이트 작동 정상 / 랜야드 마모 5%"
      ]
    },
    {
      "key": "f_5_내구성_점검",
      "label": "내구성 점검",
      "source": "산안기준규칙 제32조 + KOSHA 권장",
      "inputGuide": "제조일자 기준 내구연한 (보통 3년) 도래 여부.",
      "examples": [
        "제조 2024-08 (사용 1.7년 / 한도 3년 미도래)"
      ]
    },
    {
      "key": "f_6_충격흡수장치",
      "label": "충격흡수장치",
      "source": "산안기준규칙 제32조 + KOSHA 권장",
      "inputGuide": "충격흡수장치 (랜야드) 정상 + 발동 흔적 없음.",
      "examples": [
        "미발동 정상 (찢어짐·신축 흔적 없음)"
      ]
    },
    {
      "key": "f_7_결손_손상_여부",
      "label": "결손·손상 여부",
      "source": "산안기준규칙 제32조 + KOSHA 권장",
      "inputGuide": "전체 부속 결손·손상 여부.",
      "examples": [
        "이상 없음 (12개 전수)"
      ]
    },
    {
      "key": "f_8_결과__적합_부적합_",
      "label": "결과 (적합/부적합)",
      "source": "산안기준규칙 제32조 + KOSHA 권장",
      "inputGuide": "적합 / 부적합 + 부적합 시 시정 사항.",
      "examples": [
        "적합"
      ]
    },
    {
      "key": "f_9_조치_내용",
      "label": "조치 내용",
      "source": "산안기준규칙 제32조 + KOSHA 권장",
      "inputGuide": "발견 위험에 대한 즉시·계획 시정조치.",
      "examples": [
        "1) 안전난간 즉시 설치 / 2) 보호구 미착용자 1명 시정 지도 / 3) 7일 내 재점검"
      ]
    }
  ],
