  "docId": "signaler_appointment",
  "title": "신호수 지정서",
  "description": "기준규칙 제40조 + 제142조 크레인·차량계 건설기계 신호수 지정. 교육 8시간 이상 이수 + 신호기·무전기 지급.",
  "cycle": "cyc:ad_hoc",
  "trigger": "건설기계·크레인·중량물 인양 작업 시작 전",
  "applicableWhen": {
    "appliesTo": "applic:all_workplace",
    "scaleNotes": "크레인·타워크레인·중량물 인양·차량계 건설기계 사용 작업."
  },
  "legalBasis": [
    "art:기준규칙:40",
    "art:기준규칙:142",
    "art:기준규칙:79"
  ],
  "requiredFields": [
    {
      "key": "f_0_사업장명",
      "label": "사업장명",
      "source": "산안기준규칙 제40조·제142조",
      "inputGuide": "법인등기부등본 또는 사업자등록증 상의 정식 명칭. 약칭·통칭 사용 금지.",
      "examples": [
        "황룡건설(주)",
        "(주)라텔웍스",
        "현대건설 주식회사"
      ]
    },
    {
      "key": "f_1_현장명",
      "label": "현장명",
      "source": "산안기준규칙 제40조·제142조",
      "inputGuide": "발주처 계약서 상의 공식 공사명. 약식 표기 금지.",
      "examples": [
        "서울특별시 OO구 OO동 신축공사",
        "OO지구 도시개발사업 1공구 토목공사"
      ]
    },
    {
      "key": "f_2_지정_일자",
      "label": "지정 일자",
      "source": "산안기준규칙 제40조·제142조",
      "inputGuide": "신호수 지정일.",
      "examples": [
        "2026-04-29"
      ]
    },
    {
      "key": "f_3_신호수__성명_자격_",
      "label": "신호수 (성명·자격)",
      "source": "산안기준규칙 제40조·제142조",
      "inputGuide": "신호수 성명 + 자격 (산안기준규칙 제40조 신호수 자격).",
      "examples": [
        "이신호 (산안기준규칙 제40조 신호수 자격)"
      ]
    },
    {
      "key": "f_4_담당_작업__양중_차량",
      "label": "담당 작업 (양중·차량계 등)",
      "source": "산안기준규칙 제40조·제142조",
      "inputGuide": "본 양식 작성·관리 책임자.",
      "examples": [
        "김안전 (안전관리자)"
      ]
    },
    {
      "key": "f_5_지정_사유",
      "label": "지정 사유",
      "source": "산안기준규칙 제40조·제142조",
      "inputGuide": "신호수 배치 사유 (양중·차량계 건설기계 등).",
      "examples": [
        "타워크레인 양중 작업 시 시야 간섭 + 차량계 건설기계 후진 시 사각"
      ]
    },
    {
      "key": "f_6_사업주_서명",
      "label": "사업주 서명",
      "source": "산안기준규칙 제40조·제142조",
      "inputGuide": "법인등기부등본 상의 대표자 성명. 외국인은 영문 + 한글 병기.",
      "examples": [
        "황 룡",
        "홍길동",
        "John Smith (존 스미스)"
      ]
    }
  ],
  "reviewRules": [
    {
      "rule": "필수 — 신호수 8시간 교육 이수증 첨부",
      "severity": "manual_review",
      "legalBasis": "art:산안법:29"
