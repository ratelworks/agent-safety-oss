  "title": "유해·위험방지계획서 (건설)",
  "description": "대상 건설공사(시행령 제42조 ③) 유해위험방지계획서 (산안법 제42조 3호)",
  "cycle": "cyc:ad_hoc",
  "legalBasis": [
    "art:산안법:42",
    "art:산안법시행령:42"
  ],
  "requiredFields": [
    {
      "key": "f_0_사업장명",
      "label": "사업장명",
      "source": "산안법 제42조 + 시행령 제42의3조",
      "inputGuide": "법인등기부등본 또는 사업자등록증 상의 정식 명칭. 약칭·통칭 사용 금지.",
      "examples": [
        "황룡건설(주)",
        "(주)라텔웍스",
        "현대건설 주식회사"
      ]
    },
    {
      "key": "f_1_공사_종류_규모",
      "label": "공사 종류·규모",
      "source": "산안법 제42조 + 시행령 제42의3조",
      "inputGuide": "공사 분류 + 연면적·공사금액·층수.",
      "examples": [
        "건축 — 연면적 12,000㎡, 지하 3·지상 15층, 공사금액 320억"
      ]
    },
    {
      "key": "f_2_착공_예정일",
      "label": "착공 예정일",
      "source": "산안법 제42조 + 시행령 제42의3조",
      "inputGuide": "착공 신고 기준일.",
      "examples": [
        "2026-03-01"
      ]
    },
    {
      "key": "f_3_유해_위험요인",
      "label": "유해·위험요인",
      "source": "산안법 제42조 + 시행령 제42의3조",
      "inputGuide": "발견·예상 유해·위험요인. KRAS 7방법 적용.",
      "examples": [
        "1) 추락 (2m 이상 단부) / 2) 협착 (양중 하부) / 3) 화재 (용접 불꽃)"
      ]
    },
    {
      "key": "f_4_공정별_안전대책",
      "label": "공정별 안전대책",
      "source": "산안법 제42조 + 시행령 제42의3조",
      "inputGuide": "공정별 위험요인 + 감소대책.",
      "examples": [
        "골조: 추락 방호망 / 외장: 비계 안전난간 / 설비: LOTO 절차"
      ]
    },
    {
      "key": "f_5_흙막이_거푸집_해체_등",
      "label": "흙막이·거푸집·해체 등 위험공종 별도 계획",
      "source": "산안법 제42조 + 시행령 제42의3조",
      "inputGuide": "위험공종별 별도 작업계획서 첨부.",
      "examples": [
        "흙막이 (work_plan_excavation) + 거푸집동바리 (work_plan_formwork) + 해체 (work_plan_demolition)"
      ]
    },
    {
      "key": "f_6_관리책임자",
      "label": "관리책임자",
      "source": "산안법 제42조 + 시행령 제42의3조",
      "inputGuide": "법령상 책임 보유자 (안전보건관리책임자·관리감독자 등).",
      "examples": [
        "김안전 (안전보건관리책임자)"
      ]
    },
    {
      "key": "f_7_공단_제출일",
      "label": "공단 제출일",
      "source": "산안법 제42조 + 시행령 제42의3조",
      "inputGuide": "한국산업안전보건공단 제출일 (착공 30일 전).",
      "examples": [
        "2026-02-01 (착공 2026-03-01 기준 30일 전)"
      ]
    }
  ],
  "reviewRules": [
    {
      "rule": "자격자 의견 첨부",
      "severity": "manual_review",
      "legalBasis": "art:산안법:42"
