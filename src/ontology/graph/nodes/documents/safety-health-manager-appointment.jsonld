{
  "@context": "../../context.jsonld",
  "@id": "doc:on_appointment/safety_health_manager_appointment",
  "@type": [
    "Document",
    "DigitalDocument"
  ],
  "docId": "safety_health_manager_appointment",
  "title": "안전보건관리체제 지정·선임 보고",
  "alternativeNames": [
    "선임 보고서",
    "안전관리자 선임 보고서"
  ],
  "description": "산안법 제17조(안전관리자)·제18조(보건관리자)·제22조(산업보건의)에 따라 사업주가 선임·교체·해임·증원·교체임명 시 14일 이내 관할 지방고용노동관서에 제출하는 법정 보고서. 일반업종(시행규칙 별지 양식)과 건설업(시행규칙 별지 양식) 2종.",
  "cycle": "cyc:on_appointment",
  "trigger": "안전관리자/보건관리자/산업보건의 선임·교체·해임 시 14일 내 보고 (시행규칙 제11조 — 선임 등 보고).",
  "applicableWhen": {
    "appliesTo": "applic:50_workers_or_construction",
    "scaleNotes": "안전관리자 선임 의무: 50인 이상 또는 공사금액 50억 이상. 보건관리자: 50인 이상. 산업보건의: 50인 이상."
  },
  "exemptedWhen": {
    "note": "50인 미만 + 공사금액 50억 미만 시 안전관리자 선임 면제 (안전보건관리책임자·관리감독자는 별도 의무)."
  },
  "requiredFields": [
    {
      "key": "siteName",
      "label": "사업장명",
      "source": "공식 양식 — 사업체",
      "inputGuide": "법인등기부등본 또는 사업자등록증 상의 정식 명칭. 약칭·통칭 사용 금지.",
      "examples": [
        "황룡건설(주)",
        "(주)라텔웍스",
        "현대건설 주식회사"
      ]
    },
    {
      "key": "address",
      "label": "소재지",
      "source": "공식 양식 — 사업체",
      "inputGuide": "도로명주소 우선. 지번주소 병기 가능. 우편번호 포함 권장.",
      "examples": [
        "서울특별시 강남구 테헤란로 123 (12345)",
        "경기도 성남시 분당구 판교역로 456 (13494)"
      ]
    },
    {
      "key": "ownerName",
      "label": "사업주 또는 대표자",
      "source": "공식 양식 — 사업체 / 보고인",
      "inputGuide": "법인 대표 또는 위임받은 안전보건책임자.",
      "examples": [
        "황한일 (대표)"
      ]
    },
    {
      "key": "phone",
      "label": "전화번호",
      "source": "공식 양식 — 사업체",
      "inputGuide": "유선 또는 모바일 번호. 공식 24시간 연락 가능 번호 권장.",
      "examples": [
        "02-1234-5678",
        "010-1234-5678"
      ]
    },
    {
      "key": "siteName_construction",
      "label": "현장명",
      "source": "공식 양식 (건설업) — 현장개요",
      "inputGuide": "발주처 계약서 상의 공식 공사명. 약식 표기 금지.",
      "examples": [
        "서울특별시 OO구 OO동 신축공사",
        "OO지구 도시개발사업 1공구 토목공사"
      ]
    },
    {
      "key": "developer",
      "label": "발주자 또는 도급인",
      "source": "공식 양식 (건설업) — 현장개요",
      "inputGuide": "발주처 명칭.",
      "examples": [
        "서울특별시 강남구청"
      ]
    },
    {
      "key": "constructionPeriod",
      "label": "공사기간",
      "source": "공식 양식 (건설업) — 현장개요",
      "inputGuide": "YYYY-MM-DD ~ YYYY-MM-DD 형식. 도급계약서 또는 작업계획서 상의 기간.",
      "examples": [
        "2026-03-01 ~ 2027-12-31",
        "2026-04-01 ~ 2026-04-30"
      ]
    },
    {
      "key": "constructionAmount",
      "label": "공사금액(상시근로자 수)",
      "source": "공식 양식 (건설업) — 현장개요",
      "inputGuide": "공사 도급금액 (원) 또는 상시근로자 수 — 산안법 시행령 제13조~17 선임 기준.",
      "examples": [
        "320억원 (상시근로자 52명)"
      ]
    },
