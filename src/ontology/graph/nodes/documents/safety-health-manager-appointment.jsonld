  "reviewRules": [
    {
      "rule": "필수 — 사업장 정보 (사업장명·소재지·사업주·전화)",
      "severity": "blocker",
      "checkFields": [
        "siteName",
        "address",
        "ownerName"
      ]
    },
    {
      "rule": "필수 — 1인 이상 선임자 (안전관리자·보건관리자·산업보건의 중 해당 직책)",
      "severity": "manual_review"
    },
    {
      "rule": "필수 — 선임자 자격/면허번호 (시행령 별표 4·5·6 자격 충족)",
      "severity": "manual_review"
    },
    {
      "rule": "필수 — 14일 이내 제출 (시행규칙 제11조 — 안전관리자 등의 선임 등 보고)",
      "severity": "manual_review",
      "legalBasis": "art:산안법시행규칙:11"
    },
    {
      "rule": "필수 — 사업주 서명·날인",
      "severity": "blocker",
      "checkFields": [
        "reporterSignature"
      ]
    },
    {
      "rule": "건설업 — 현장명·발주자·공사금액·공사기간·상시근로자 수 추가 작성",
      "severity": "warning",
      "checkFields": [
        "siteName_construction",
        "developer",
        "constructionAmount",
        "constructionPeriod"
      ]
    },
    {
      "rule": "사람 검토 — 자격증 사본 첨부 (발급기관 + 발급일자 확인)",
      "severity": "manual_review"
    }
  ],
  "retention": "선임은 사업 운영 동안 유지 + 변경 시 갱신 (시행규칙 제11조). 문서 보존 5년 권장 (산안법 제164조).",
  "standardForm": {
    "source": "산업안전보건법 시행규칙 [별지 양식] — 안전관리자·보건관리자·산업보건의 선임 등 보고서 (일반업종) / 건설업 별도 양식",
    "sourceUrl": "https://www.moel.go.kr/local/seoulseobu/info/dataroom/view.do?bbs_seq=20200100799",
    "downloadHwpGeneral": "https://www.moel.go.kr/local/seoulseobu/common/downloadFile.do?file_seq=20200101245&bbs_seq=20200100799&bbs_id=LOCAL5",
    "downloadHwpConstruction": "https://www.moel.go.kr/local/seoulseobu/common/downloadFile.do?file_seq=20200101246&bbs_seq=20200100799&bbs_id=LOCAL5",
