  ],
  "docId": "msds_education_log",
  "title": "MSDS 교육 일지",
  "alternativeNames": [
    "물질안전보건자료 교육일지",
    "화학물질 취급 교육"
  ],
  "description": "산안법 제115조 + 시행규칙 제169조에 따라 사업주가 대상화학물질을 취급하는 근로자에게 실시한 MSDS 교육 기록. 취급 시작 전·내용 변경 시·신규 채용 시 의무. 일반 안전보건교육일지와 별도 작성 권장 (화학물질별 명확한 입증).",
  "cycle": "cyc:as_needed",
  "trigger": "대상화학물질 취급 시작 전, 작업내용 변경 시, 신규 채용 시 (시행규칙 제169조).",
  "applicableWhen": {
    "appliesTo": "applic:chemicals_handling",
    "scaleNotes": "대상화학물질 취급하는 모든 사업장. 50억 미만 건설현장도 동일 적용 (도장·방수·용접·접착 등 화학물질 사용 시)."
  },
  "exemptedWhen": {},
  "requiredFields": [
    {
      "key": "educationDate",
      "label": "교육 일시",
      "source": "시행규칙 제169조",
      "inputGuide": "교육 실시 일시.",
      "examples": [
        "2026-04-29 14:00 ~ 15:30"
      ]
    },
    {
      "key": "chemicalName",
      "label": "대상 화학물질명·CAS·MSDS 번호",
      "source": "산안법 제115조 + 시행규칙 제169조",
      "inputGuide": "대상 화학물질명 + CAS 번호 + MSDS 번호.",
      "examples": [
        "톨루엔 (CAS 108-88-3, MSDS-2026-A012)"
      ]
    },
    {
      "key": "educationTrigger",
      "label": "교육 사유 (취급 시작 전 / 변경 시 / 신규 채용)",
      "source": "시행규칙 제169조 ①",
      "inputGuide": "산안법 제114조 — 취급 시작 전·MSDS 변경 시·신규 채용 시.",
      "examples": [
        "취급 시작 전 (4/30 톨루엔 신규 도입)"
      ]
    },
    {
      "key": "trainerName",
      "label": "교육실시자 성명·자격",
      "source": "시행규칙 제169조",
      "inputGuide": "산업안전기사·산업안전산업기사·안전관리자 자격증 등.",
      "examples": [
        "산업안전기사 (한국산업인력공단, 2018-09 발급)"
      ]
    },
    {
      "key": "trainingPlace",
      "label": "교육실시장소",
      "source": "시행규칙 제169조",
      "inputGuide": "교육 실시 장소.",
      "examples": [
        "황룡건설(주) 삼성동 현장 안전교육실"
      ]
    },
    {
      "key": "subjects",
      "label": "교육과목 (시행규칙 제169조 ② 1~6호)",
      "source": "시행규칙 제169조 ②",
      "inputGuide": "법정 의무 교육 과목명.",
      "examples": [
        "산업안전보건법 정기교육 (관리감독자 16시간)"
      ]
    },
    {
      "key": "duration",
      "label": "교육시간",
      "source": "시행규칙 제169조 — 시간 명시 없음, 통상 1시간 이상",
      "inputGuide": "산안법 제29조 정기교육 분기당 6시간 (사무직 3시간) / 신규 8시간 / 작업변경 2시간 / 특별 16시간 이상.",
      "examples": [
        "정기교육 6시간 (분기) / 신규채용 8시간 / 화기작업 특별교육 16시간"
      ]
    },
    {
      "key": "participantsList",
      "label": "참석자 명단·서명 (대상 화학물질 취급자 전원)",
      "source": "시행규칙 제169조",
      "inputGuide": "대상 화학물질 취급자 전원 자필 서명. 외국인은 모국어 병기.",
      "examples": [
        "박작업 (자필) / 이작업 (자필) / NGUYEN VAN A (베트남어, 자필)"
      ]
    },
    {
      "key": "approvalChain",
      "label": "결재선",
      "source": "행정",
      "inputGuide": "작성 → 검토 → 승인 순. 직책 + 성명 + 서명.",
      "examples": [
        "작성: 김안전 / 검토: 박감독 / 승인: 황룡"
      ]
    }
  ],
