    },
    {
      "rule": "필수 — 9개 세부의무 (시행령 제4조) 이행 evidence",
      "severity": "manual_review",
      "legalBasis": "art:중처법시행령:4"
    },
    {
      "rule": "필수 — 미이행 + 보완조치 + 책임자·기한",
      "severity": "manual_review"
    },
    {
      "rule": "필수 — 도급·용역 안전보건 확보 (시행령 제4조 8호)",
      "severity": "manual_review",
      "legalBasis": "art:중처법:5"
    },
    {
      "rule": "필수 — 보관 5년 (시행령 제13조)",
      "severity": "manual_review"
    }
  ],
  "retention": "5년 (중처법 시행령 제13조)",
