{
  "@context": "../../context.jsonld",
  "@id": "doc:semi_annual/severe_accident_compliance",
  "@type": [
    "Document",
    "DigitalDocument"
  ],
  "docId": "severe_accident_compliance",
  "title": "중대재해 안전보건확보 이행계획",
  "alternativeNames": [
    "중처법 이행 기록",
    "안전보건확보의무 점검 기록"
  ],
  "description": "중처법 제4조 ① 1~4호 + 시행령 제4조 1~9호의 9가지 안전보건관리체계 구축·이행 의무에 대한 기록. 5인 이상 + 50억 미만 건설업도 2024-01-27부터 적용. 사망자 발생 시 1년 이상 징역 또는 10억원 이하 벌금. 본 노드는 시행령 제4조 본문과 1:1 매핑.",
  "cycle": "cyc:semi_annual",
  "trigger": "경영책임자 등의 안전보건확보의무 (중처법 제4조) 와 도급·용역 안전보건 확보의무 (제5조) 의 이행 상황을 반기 1회 이상 점검하고 결과·미이행 시 시정조치를 기록. 중대재해 발생 시 형사 책임 방어의 핵심 증빙.",
  "applicableWhen": {
    "appliesTo": "applic:five_persons_or_more",
    "scaleNotes": "건설업은 발주자·도급인·수급인 모두 제5조 적용. 50억 미만 건설현장도 적용."
  },
  "exemptedWhen": {
    "reasons": [
      "5인 미만 사업장 — 중처법 제3조 적용 제외",
      "소상공인 일부 — 시행령 제13조 보관 의무 제외"
    ]
  },
  "requiredFields": [
    {
      "key": "duty_1_safety_health_policy",
      "label": "1. 안전보건 목표와 경영방침의 설정",
      "source": "중처법 시행령 제4조",
      "inputGuide": "중처법 시행령 제4조 1호 — 안전보건 목표·경영방침 수립 + 대표 서명.",
      "examples": [
        "\"중대재해 0, 위험성평가 100%, 종사자 의견 청취\" (대표 서명, 2026-01-02)"
      ]
    },
    {
      "key": "duty_2_dedicated_org",
      "label": "2. 안전보건 업무를 총괄·관리하는 전담 조직 설치",
      "source": "중처법 시행령 제4조",
      "inputGuide": "제4조 2호 — 상시근로자 500명 이상 또는 시공능력 200위 이내 건설사 의무 (전담 조직 + 책임자).",
      "examples": [
        "안전보건경영실 (전담 5명, 실장 김안전 / 직속 보고: 대표)"
      ]
    },
    {
      "key": "duty_3_hazard_identification",
      "label": "3. 유해·위험요인 확인·개선 업무 절차 마련 및 점검",
      "source": "중처법 시행령 제4조",
      "inputGuide": "제4조 3호 — 위험성평가 절차 마련 + 반기 1회 이상 점검.",
      "examples": [
        "위험성평가 절차서 v2.0 + 반기 점검 (2026-06, 12) — 결과 보고서 첨부"
      ]
    },
    {
      "key": "duty_4_budget",
      "label": "4. 예산 편성·집행",
      "source": "중처법 시행령 제4조",
      "inputGuide": "제4조 4호 — 안전보건 예산 편성 + 집행 (필요 인력·시설·장비).",
      "examples": [
        "연 8,500만원 편성 + 분기 집행 점검 + 부족 시 추가 (2026-2분기 1,200만원 추가)"
      ]
    },
    {
      "key": "duty_5_responsible_persons",
      "label": "5. 안전보건관리책임자·관리감독자·안전보건총괄책임자의 업무수행 평가 및 반기 1회 점검",
      "source": "중처법 시행령 제4조",
      "inputGuide": "제4조 5호 — 직무 수행 평가 기준 + 반기 1회 점검.",
      "examples": [
        "평가 기준서 v1.0 (위험성평가·교육·점검 KPI) + 반기 평가 (2026-06, 12)"
      ]
    },
    {
      "key": "duty_6_safety_managers",
      "label": "6. 안전관리자·보건관리자·산업보건의·안전보건관리담당자 배치",
      "source": "중처법 시행령 제4조",
      "inputGuide": "제4조 6호 — 법정 인력 배치 + 자격·인원 충족.",
      "examples": [
        "안전관리자 2명 (산업안전기사·안전기능장) / 보건관리자 1명 / 산업보건의 위촉 (월 1회)"
      ]
    },
    {
      "key": "duty_7_worker_voice",
      "label": "7. 종사자 의견 청취 절차 마련 및 반기 1회 점검",
      "source": "중처법 시행령 제4조",
      "inputGuide": "제4조 7호 — 종사자 의견 청취 절차 + 반기 1회 점검.",
      "examples": [
        "익명 신고함 + 안전보건위원회 분기 + 모바일 의견 수렴 (반기 점검 2026-06, 12)"
      ]
    },
    {
      "key": "duty_8_emergency_manual",
      "label": "8. 재해 발생 대응 매뉴얼 마련 및 반기 1회 점검",
      "source": "중처법 시행령 제4조",
      "inputGuide": "제4조 8호 — 중대재해 발생 시 대응 매뉴얼 + 반기 1회 점검.",
      "examples": [
        "중대재해 대응 매뉴얼 v3.0 (즉시보고·119·고용노동부·언론) + 반기 모의훈련 (2026-06, 12)"
      ]
    },
    {
      "key": "duty_9_subcontract_evaluation",
      "label": "9. 도급·용역·위탁 시 산업재해 예방 조치 능력·기술 평가기준·절차 마련",
      "source": "중처법 시행령 제4조",
      "inputGuide": "제4조 9호 — 도급 시 수급인 평가 기준·절차 마련.",
      "examples": [
        "수급인 안전보건 평가표 v2.0 (재해율·자격·실적·인증) + 입찰 시 의무 첨부"
      ]
    }
  ],
  "reviewRules": [
    {
      "rule": "필수 — 점검 기간 (반기 1회 이상)",
      "severity": "manual_review",
      "legalBasis": "art:중처법시행령:5"
    },
