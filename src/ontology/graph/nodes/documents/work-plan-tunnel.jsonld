  "title": "터널 작업계획서",
  "description": "터널굴착작업 (별표 4 7호)",
  "cycle": "cyc:ad_hoc",
  "trigger": "터널굴착 작업 전",
  "applicableWhen": {
    "workType": "tunnel_excavation"
  },
  "legalBasis": [
    "art:기준규칙:38",
    "annex:기준규칙:별표4-7호",
    "art:기준규칙:351",
    "art:기준규칙:352",
    "art:기준규칙:367"
  ],
  "requiredFields": [
    {
      "key": "f_0_보링_등_적절한_방법으",
      "label": "보링 등 적절한 방법으로 낙반·출수 및 가스폭발 위험 방지",
      "source": "산안기준규칙 제38조 + 별표 4 7호",
      "inputGuide": "터널 굴착 전 사전조사 (보링·물리탐사).",
      "examples": [
        "보링 5공 + 전기탐사 / 낙반 가능 구간 록볼트 / 출수 2개소 차수 / 가스 농도 측정 일 4회"
      ]
    },
    {
      "key": "method",
      "label": "굴착 방법",
      "source": "산안기준규칙 제38조 + 별표 4 7호",
      "inputGuide": "굴착 공법 (NATM·TBM·발파·기계).",
      "examples": [
        "NATM 발파 + 록볼트 + 숏크리트 (쉘 두께 250mm)"
      ]
    },
    {
      "key": "f_2_터널지보공_및_복공의_",
      "label": "터널지보공 및 복공의 시공방법과 용수의 처리방법",
      "source": "산안기준규칙 제38조 + 별표 4 7호",
      "inputGuide": "지보공·복공 시공 + 용수 처리.",
      "examples": [
        "1차 지보 (강아치 + 록볼트 + 숏크리트) / 2차 복공 (콘크리트 라이닝) / 용수 → 측구 + 펌프 배수"
      ]
    },
    {
      "key": "ventilation",
      "label": "환기 또는 조명시설을 설치할 때에는 그 방법",
      "source": "산안기준규칙 제38조 + 별표 4 7호",
      "inputGuide": "환기·조명 시설 + 작동 방법.",
      "examples": [
        "환기 (송풍기 22kW + 환기덕트 Φ800) / 조명 (LED 50W × 50m 간격)"
      ]
    }
  ],
  "reviewRules": [
    {
      "rule": "사전조사·작업계획 작성",
      "severity": "manual_review",
      "legalBasis": "annex:기준규칙:별표4-7호"
    },
    {
      "rule": "근로자 통지 (제38조 ②)",
      "severity": "manual_review",
      "legalBasis": "art:기준규칙:38"
    }
  ],
  "sections": [
    {
      "title": "1. 문서 메타",
      "legalSource": "공통",
      "fields": [
        {
          "key": "documentNumber",
          "label": "문서번호",
