  "docId": "work_plan_tunnel",
  "title": "터널 작업계획서",
  "description": "터널굴착작업 (별표 4 7호)",
  "cycle": "cyc:ad_hoc",
  "trigger": "터널굴착 작업 전",
  "applicableWhen": {
    "workType": "tunnel_excavation"
  },
  "legalBasis": [
    "art:기준규칙:38",
    "annex:기준규칙:별표4-7호",
    "art:기준규칙:351",
    "art:기준규칙:352",
    "art:기준규칙:367"
  ],
  "requiredFields": [
    {
      "key": "boringSurvey",
      "label": "사전조사 — 보링(boring) 등 적절한 방법으로 낙반ㆍ출수(出水) 및 가스폭발 등으로 인한 근로자의 위험을 방지하기 위하여 미리 지형ㆍ지질 및 지층상태를 조사",
      "source": "산업안전보건기준에 관한 규칙 별표 4 제7호 사전조사 내용",
      "inputGuide": "터널 굴착 전 사전조사 (보링·물리탐사). (별표 4 원문 항목: 보링(boring) 등 적절한 방법으로 낙반ㆍ출수(出水) 및 가스폭발 등으로 인한 근로자의 위험을 방지하기 위하여 미리 지형ㆍ지질 및 지층상태를 조사)",
      "examples": [
        "보링 5공 + 전기탐사 / 낙반 가능 구간 록볼트 / 출수 2개소 차수 / 가스 농도 측정 일 4회"
      ]
    },
    {
      "key": "excavationMethod",
      "label": "가. 굴착의 방법",
      "source": "산업안전보건기준에 관한 규칙 별표 4 제7호 작업계획서 내용 가목",
      "inputGuide": "굴착 공법 (NATM·TBM·발파·기계). (별표 4 원문 항목: 굴착의 방법)",
      "examples": [
        "NATM 발파 + 록볼트 + 숏크리트 (쉘 두께 250mm)",
        "NATM 공법, 발파 + 숏크리트"
      ]
    },
    {
      "key": "supportAndWater",
      "label": "나. 터널지보공 및 복공(覆工)의 시공방법과 용수(湧水)의 처리방법",
      "source": "산업안전보건기준에 관한 규칙 별표 4 제7호 작업계획서 내용 나목",
      "inputGuide": "강지보·록볼트·배수. (별표 4 원문 항목: 터널지보공 및 복공(覆工)의 시공방법과 용수(湧水)의 처리방법)",
      "examples": [
        "강지보 + 록볼트 6m × 4본/m + 배수공"
      ]
    },
    {
      "key": "ventilation",
      "label": "다. 환기 또는 조명시설을 설치할 때에는 그 방법",
      "source": "산업안전보건기준에 관한 규칙 별표 4 제7호 작업계획서 내용 다목",
      "inputGuide": "송기·배기 + CO·NO₂ 측정. (별표 4 원문 항목: 환기 또는 조명시설을 설치할 때에는 그 방법)",
      "examples": [
        "송풍기 1500CMH + 배기, 가스측정기 상시"
      ]
    },
    {
      "key": "notifiedToWorkers",
      "label": "작업계획서 내용을 해당 근로자에게 알림 (안전보건규칙 제38조제2항)",
      "source": "산업안전보건기준에 관한 규칙 제38조제2항",
      "inputGuide": "작성한 작업계획서의 내용을 해당 근로자에게 알렸는지와 그 방법·일시를 적는다.",
      "examples": [
        "작업 전 TBM 에서 작업계획서 내용 설명 (2026-03-02 07:30, 참석 12명 서명)"
      ]
    }
  ],
  "reviewRules": [
    {
      "rule": "별표 4 제7호의 사전조사 내용과 작업계획서 내용(가~다목)을 모두 적었다",
      "severity": "blocker",
      "legalBasis": "annex:기준규칙:별표4-7호",
      "checkFields": [
        "boringSurvey",
        "excavationMethod",
        "supportAndWater",
        "ventilation"
      ]
    },
    {
      "rule": "작업계획서 내용을 해당 근로자에게 알렸다 (제38조제2항)",
      "severity": "blocker",
      "legalBasis": "art:기준규칙:38",
      "checkFields": [
        "notifiedToWorkers"
      ]
    }
  ],
