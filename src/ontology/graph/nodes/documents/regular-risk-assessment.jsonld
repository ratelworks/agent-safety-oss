  "docId": "regular_risk_assessment",
  "title": "정기 위험성평가 (연 1회)",
  "alternativeNames": [
    "정기평가",
    "연간 적정성 재검토"
  ],
  "description": "최초평가 결과의 적정성을 1년마다 재검토. 변동된 기계·인력·지식·감소대책 유효성을 종합 평가하여 허용 가능하지 않은 위험성에 대해 제12조 감소대책을 재수립.",
  "cycle": "cyc:annual",
  "trigger": "최초평가 결과의 적정성을 1년마다 재검토. 변동된 기계·인력·지식·감소대책 유효성을 종합 평가하여 허용 가능하지 않은 위험성에 대해 제12조 감소대책을 재수립.",
  "applicableWhen": {
    "appliesTo": "applic:all_workplace",
    "appliesToNote": "최초평가 실시 후 1년 경과 사업장 (상시평가 미선택 시)",
    "scaleNotes": "1년마다 재검토. 미실시 시 제36조 위반 — 과태료."
  },
  "exemptedWhen": {
    "reasons": [
      "상시평가 선택 + 제15조 ④ 1·2·3호 모두 이행 사업장 (수시·정기 평가 갈음 효과)"
    ]
  },
  "requiredFields": [
    {
      "key": "f_0_사업장_정보",
      "label": "사업장 정보",
      "source": "위험성평가 고시 제15조 ③",
      "inputGuide": "사업장명·소재지·업종(KSIC)·상시근로자수·산재보험 사업장관리번호 통합 표기.",
      "examples": [
        "황룡건설(주) / 서울 강남구 테헤란로 123 / 41122 종합건설업 / 35명 / 산재 1234567890"
      ]
    },
    {
      "key": "f_1_사업장명",
      "label": "사업장명",
      "source": "위험성평가 고시 제15조 ③",
      "inputGuide": "법인등기부등본 또는 사업자등록증 상의 정식 명칭. 약칭·통칭 사용 금지.",
      "examples": [
        "황룡건설(주)",
        "(주)라텔웍스",
        "현대건설 주식회사"
      ]
    },
    {
      "key": "date",
      "label": "평가 실시일",
      "source": "위험성평가 고시 제15조 ③",
      "inputGuide": "YYYY-MM-DD 형식. 작성·점검·평가 실제 시행 일자.",
      "examples": [
        "2026-04-29",
        "2026-05-15"
      ]
    },
    {
      "key": "f_3_평가자",
      "label": "평가자",
      "source": "위험성평가 고시 제15조 ③",
      "inputGuide": "평가 수행자 직책 + 성명 + 자격.",
      "examples": [
        "김안전 (안전관리자, 산업안전기사)"
      ]
    },
    {
      "key": "f_4_기계_기구_설비_성능_",
      "label": "기계·기구·설비 성능 저하",
      "source": "위험성평가 고시 제15조 ③",
      "inputGuide": "정기 평가 대상 — 기계·기구·설비 성능 저하 여부.",
      "examples": [
        "타워크레인 와이어로프 마모 5% (한도 7%) — 6월 교체 예정"
      ]
    },
    {
      "key": "f_5_근로자_교체_지식_경험",
      "label": "근로자 교체 지식·경험 변화",
      "source": "위험성평가 고시 제15조 ③",
      "inputGuide": "근로자 교체·신규 채용으로 인한 지식·경험 변화.",
      "examples": [
        "신규 외국인 4명 채용 (베트남) — 모국어 안전교육 + 멘토 배정"
      ]
    },
    {
      "key": "f_6_안전_보건_새로운_지식",
      "label": "안전·보건 새로운 지식",
      "source": "위험성평가 고시 제15조 ③",
      "inputGuide": "안전보건 신규 지식·기술·기준 반영.",
      "examples": [
        "스마트 안전장비 (AI 영상분석) 도입 검토 / 산안기준규칙 제38조 별표4 개정 반영"
      ]
    },
    {
      "key": "f_7_감소대책_유효성",
      "label": "감소대책 유효성",
      "source": "위험성평가 고시 제15조 ③",
      "inputGuide": "기존 감소대책 유효성 평가.",
      "examples": [
        "추락 안전난간 효과적 (재해 0건) / 화재 감시자 배치 효과적 / 협착 신호수 효과적"
      ]
    },
    {
      "key": "f_8_유해_위험요인_파악",
      "label": "유해·위험요인 파악",
      "source": "위험성평가 고시 제15조 ③",
      "inputGuide": "KRAS 7방법 중 1개로 작업·공정·기계·물질별 유해·위험요인 식별. 외부 자료(사고사례/MSDS/KOSHA Guide) 반영.",
      "examples": [
        "고소작업: 추락(난간 미설치) / 자재 낙하(출입통제 부재)",
        "용접: 화재·폭발(가연물 인근) / 일산화탄소 노출(밀폐공간)"
      ]
    },
    {
      "key": "f_9_위험성_결정",
      "label": "위험성 결정",
      "source": "위험성평가 고시 제15조 ③",
      "inputGuide": "위험성평가 고시 제7조 KRAS 7방법으로 빈도×강도 산출. 결과는 무시가능/허용가능/즉시개선/작업중지 4단계 결정.",
      "examples": [
        "빈도 3 (월1회) × 강도 4 (사망) = 위험성 12 → 즉시개선",
        "빈도 1 × 강도 2 = 2 → 무시가능"
      ]
    },
    {
      "key": "f_10_위험성_감소대책",
      "label": "위험성 감소대책",
      "source": "위험성평가 고시 제15조 ③",
      "inputGuide": "감소대책 우선순위 (제거 → 대체 → 공학적 대책 → 관리적 대책 → 개인보호구) 적용. 비용·실행가능성 함께 평가.",
      "examples": [
        "E: 추락 위험 작업 자체 제거 / S: 안전성 높은 대체 설비 / E: 안전난간·추락방지망 / A: 작업절차서·교육 / PPE: 안전대"
      ]
    }
  ],
  "reviewRules": [
    {
      "rule": "필수 — 재검토 일자 (1년 내)",
