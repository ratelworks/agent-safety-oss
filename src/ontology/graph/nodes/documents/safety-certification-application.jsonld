  "docId": "safety_certification_application",
  "title": "안전인증 신청 (별지 42호)",
  "description": "산안법 제83조 안전인증대상 기계·기구·방호장치·보호구 제조·수입 시 안전인증 신청. KCs 마크 부착 근거.",
  "cycle": "cyc:ad_hoc",
  "trigger": "인증대상 제품 제조·수입 시",
  "legalBasis": [
    "art:산안법:83",
    "art:산안법시행규칙:74",
    "art:산안법:80"
  ],
  "verificationStatus": "verified",
  "_meta": {
    "publishedBy": "라텔웍스 + 황룡건설(주)",
    "fetchedAt": "2026-04-28",
    "licenseHint": "저작권법 제7조 비보호 (자유 인용)",
    "note": "신규 의무문서 — requiredFields/reviewRules/applicableWhen 표준 골격 채움 (Phase 2.5 wave4).",
