  },
  "applicableWhen": {
    "appliesTo": "applic:all_workplace",
    "scaleNotes": "안전인증대상 9종(프레스·전단기·크레인·리프트·압력용기·롤러기·사출성형기·고소작업대·곤돌라) + 방호장치·보호구 제조·수입자."
  },
  "exemptedWhen": {
    "reasons": [
      "인증대상 외 기계",
      "수출 전용 (국내 사용 X)"
    ]
  },
  "requiredFields": [
    {
      "key": "applicantName",
      "label": "제조·수입자 회사명·주소",
      "source": "산안법 제83조 + 시행규칙 제74조",
      "inputGuide": "도로명 주소 우선. 지번 주소는 보조.",
      "examples": [
        "서울특별시 강남구 테헤란로 123"
      ]
    },
    {
      "key": "businessNo",
      "label": "사업자등록번호",
      "source": "산안법 제83조 + 시행규칙 제74조",
      "inputGuide": "10자리 숫자 (사업자등록번호) 또는 13자리 숫자 (법인등록번호). 하이픈 포함 표기 권장.",
      "examples": [
        "123-45-67890",
        "110111-0123456"
      ]
    },
    {
      "key": "representative",
      "label": "대표자 성명",
      "source": "산안법 제83조 + 시행규칙 제74조",
      "inputGuide": "법인등기부등본 상의 대표자 성명. 외국인은 영문 + 한글 병기.",
      "examples": [
        "황 룡",
        "홍길동",
        "John Smith (존 스미스)"
      ]
    },
    {
      "key": "contact",
      "label": "연락처 (24시간)",
      "source": "산안법 제83조 + 시행규칙 제74조",
      "inputGuide": "본인 휴대전화. 010-XXXX-XXXX.",
      "examples": [
        "010-1234-5678"
      ]
    },
    {
      "key": "productCategory",
      "label": "안전인증 13종 분류",
      "source": "산안법 제80조 + 시행령 제74조 + 별표 21 (13종)",
      "inputGuide": "안전인증대상 13종 분류 (산안법 제84조 + 시행령 제74조).",
      "examples": [
        "크레인 (제2호 가목)"
      ]
    },
    {
      "key": "productName",
      "label": "제품명·모델",
      "source": "산안법 제80조 + 시행령 제74조 + 별표 21 (13종)",
      "inputGuide": "인증 대상 제품 명칭 + 모델 번호.",
      "examples": [
        "타워크레인 TC-7030 (모델 #2026-A)"
      ]
    },
    {
      "key": "specifications",
      "label": "정격·규격·성능",
      "source": "산안법 제80조 + 시행령 제74조 + 별표 21 (13종)",
      "inputGuide": "정격하중·규격·성능 사양.",
      "examples": [
        "정격하중 6톤 (반경 70m) / 자립고 70m / 권상속도 80m/min"
      ]
    },
    {
      "key": "safetyDevice",
      "label": "방호장치·안전장치",
      "source": "산안법 제80조 + 시행령 제74조 + 별표 21 (13종)",
      "inputGuide": "필수 방호장치·안전장치 (권과방지·과부하방지·비상정지 등).",
      "examples": [
        "권과방지장치·과부하방지장치·비상정지·풍속계·각도지시계 (KCs 인증)"
      ]
    },
    {
      "key": "applicationDate",
      "label": "신청 일자",
      "source": "산안법 제83조 + 시행규칙 제74조",
      "inputGuide": "인증 신청 접수일.",
      "examples": [
        "2026-04-29"
      ]
    },
    {
      "key": "result",
      "label": "인증 결과 (적합/부적합)",
      "source": "산안법 제83조 + 시행규칙 제74조",
      "inputGuide": "적합 / 부적합 + 부적합 시 시정 사항.",
      "examples": [
        "적합"
      ]
    },
    {
      "key": "kcsNumber",
      "label": "KCs 인증번호",
      "source": "산안법 제83조 + 시행규칙 제74조",
      "inputGuide": "인증 발급 번호 (KCs-AB-XXXX-XXXX).",
      "examples": [
        "KCs-CR-2026-0042"
      ]
    },
    {
      "key": "validUntil",
      "label": "유효기간",
      "source": "산안법 제83조 + 시행규칙 제74조",
      "inputGuide": "인증 유효기간 (보통 3년).",
      "examples": [
        "2026-05-01 ~ 2029-04-30 (3년)"
      ]
    }
  ],
  "reviewRules": [
    {
      "rule": "필수 — 인증품목 + 모델 + 시험성적서",
