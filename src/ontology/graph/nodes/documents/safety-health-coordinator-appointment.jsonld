          "checkPoints": []
        },
        {
          "key": "duties",
          "label": "조정자 직무",
          "required": true,
          "inputGuide": "공사 간 안전보건 조정·계획 검토·점검 입회.",
          "examples": [
            "월 2회 합동점검, 분기 1회 조정회의"
          ],
          "checkPoints": []
        }
      ]
    },
    {
