  "docId": "construction_disaster_prevention_guidance",
  "title": "건설업 산재예방 기술지도",
  "description": "산안법 제73조 1~120억 원 미만 건설공사 도급인이 산업안전보건법령에 따른 자격을 가진 자(건설재해예방전문지도기관)로부터 매월 받는 지도 결과. 위험요인·개선조치 기록.",
  "cycle": "cyc:monthly",
  "trigger": "공사기간 중 매월",
  "legalBasis": [
    "art:산안법:73",
    "art:산안법시행령:59"
  ],
  "verificationStatus": "verified",
  "_meta": {
    "publishedBy": "라텔웍스 + 황룡건설(주)",
    "fetchedAt": "2026-04-28",
    "licenseHint": "저작권법 제7조 비보호 (자유 인용)",
    "note": "신규 의무문서 — requiredFields/reviewRules/applicableWhen 표준 골격 채움 (Phase 2.5 wave4).",
    "verifiedAt": "2026-04-28",
    "alignedAt": "2026-04-29",
    "alignSource": "align-nodes-bulk.ts (KOSHA 권고 + 산안법 본문 기반)"
  },
  "applicableWhen": {
    "appliesTo": "applic:construction_under_50bn",
    "scaleNotes": "1억~120억 미만 건설공사 (토목 1억~150억). 시행령 제59조."
  },
  "exemptedWhen": {
    "reasons": [
      "1억 미만 건설공사",
      "120억 이상 (자체 안전관리 의무)"
    ]
  },
  "requiredFields": [
    {
      "key": "guidanceDate",
      "label": "지도 일자·횟수 (월 1회)",
      "source": "산안법 제73조 + 시행령 제59조 (1억~120억)",
      "inputGuide": "지도 실시일 + 횟수 (월 1회 의무 — 산안법 제73조).",
      "examples": [
        "2026-04-29 / 4월 1회"
      ]
    },
    {
      "key": "guidanceAgency",
      "label": "건설재해예방전문지도기관·자격",
      "source": "산안법 제73조 + 시행령 제59조 (1억~120억)",
      "inputGuide": "산업안전기사·산업안전산업기사·안전관리자 자격증 등.",
      "examples": [
        "산업안전기사 (한국산업인력공단, 2018-09 발급)"
      ]
    },
    {
      "key": "siteName",
      "label": "건설공사명·공사규모",
      "source": "산안법 제73조 + 시행령 제59조 (1억~120억)",
      "inputGuide": "대상 공사명 + 공사규모.",
      "examples": [
        "삼성동 OO 신축공사 / 연면적 12,000㎡ / 320억"
      ]
    },
    {
      "key": "findings",
      "label": "발견 위험요인·결함",
      "inputGuide": "감소대책 우선순위 (제거→대체→공학적→관리적→보호구) 기준으로 위험 등급 표기. 즉시 시정 / 7일 내 / 시정완료 분류.",
      "examples": [
        "[즉시] 안전대 미체결 작업 발견 → 작업중지 / [7일] 가설전기 분전반 접지 부재"
      ]
    },
    {
      "key": "recommendations",
      "label": "지도·권고 사항",
      "inputGuide": "지도기관 (전문기관) 지도·권고 사항.",
      "examples": [
        "1) 비계 안전난간 보강 / 2) 외국인 근로자 모국어 안전교육 / 3) 위험성평가 기록 보완"
      ]
    },
    {
      "key": "verifiedActions",
      "label": "전월 지적사항 이행 확인",
      "inputGuide": "직전 월 지적사항 이행 결과 확인.",
      "examples": [
        "전월 3건 지적 → 2건 이행 완료 / 1건 진행 중 (5/15까지)"
      ]
    },
    {
      "key": "siteResponse",
      "label": "사업주 시정조치 계획",
      "inputGuide": "법인 대표 또는 위임받은 안전보건책임자.",
      "examples": [
        "황한일 (대표)"
      ]
    },
    {
      "key": "nextGuidance",
      "label": "차기 지도 일정",
      "inputGuide": "다음 지도 예정일.",
      "examples": [
        "2026-05-29"
      ]
    }
  ],
  "reviewRules": [
    {
      "rule": "필수 — 매월 1회 이상 지도 + 결과서",
      "severity": "manual_review",
      "legalBasis": "art:산안법:73"
