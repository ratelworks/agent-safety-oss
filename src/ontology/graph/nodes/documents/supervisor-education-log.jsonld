  "docId": "supervisor_education_log",
  "title": "관리감독자 안전보건교육 일지",
  "description": "관리감독자의 직무 수행 + 정기·신규채용·변경 시 교육 기록 (산안법 제32조 + 시행규칙 제35조)",
  "cycle": "cyc:annual",
  "trigger": "정기교육 분기 4시간(또는 연 16시간) + 신규채용 8시간 + 변경 시 2시간",
  "legalBasis": [
    "art:산안법:32",
    "art:산안법시행규칙:35"
  ],
  "requiredFields": [
    {
      "key": "f_0_교육_일시",
      "label": "교육 일시",
      "source": "산안법 제29조 + 시행규칙 별표 4",
      "inputGuide": "교육 실시 일시.",
      "examples": [
        "2026-04-29 14:00 ~ 15:30"
      ]
    },
    {
      "key": "f_1_교육_시간__연_16시",
      "label": "교육 시간 (연 16시간)",
      "source": "산안법 제29조 + 시행규칙 별표 4",
      "inputGuide": "교육 진행 시간 (시간 단위).",
      "examples": [
        "1.5"
      ]
    },
    {
      "key": "f_2_교육_장소",
      "label": "교육 장소",
      "source": "산안법 제29조 + 시행규칙 별표 4",
      "inputGuide": "교육 실시 장소.",
      "examples": [
        "현장 안전교육실"
      ]
    },
    {
      "key": "f_3_교육_강사",
      "label": "교육 강사",
      "source": "산안법 제29조 + 시행규칙 별표 4",
      "inputGuide": "강사 성명 + 자격(산업안전기사·안전관리자·KOSHA 등록 강사) + 등록번호.",
      "examples": [
        "김OO (산업안전기사 1234567호 / KOSHA 등록 강사 5678호)"
      ]
    },
    {
      "key": "f_4_교육_과목",
      "label": "교육 과목",
      "source": "산안법 제29조 + 시행규칙 별표 4",
      "inputGuide": "법정 의무 교육 과목명.",
      "examples": [
        "산업안전보건법 정기교육"
      ]
    },
    {
      "key": "f_5_교육_내용",
      "label": "교육 내용",
      "source": "산안법 제29조 + 시행규칙 별표 4",
      "inputGuide": "교육 주요 내용 (요약).",
      "examples": [
        "1) 위험성평가 결과 공유 / 2) 추락사고 사례 / 3) MSDS 신규 화학물질"
      ]
    },
    {
      "key": "f_6_관리감독자_명단_서명",
      "label": "관리감독자 명단·서명",
      "source": "산안법 제29조 + 시행규칙 별표 4",
      "inputGuide": "본인 자필 서명 또는 전자서명.",
      "examples": [
        "(자필 서명)"
      ]
    },
    {
      "key": "f_7_사업주_결재",
      "label": "사업주 결재",
      "source": "산안법 제29조 + 시행규칙 별표 4",
      "inputGuide": "법인 대표 또는 위임받은 안전보건책임자.",
      "examples": [
        "황한일 (대표)"
      ]
    }
  ],
  "reviewRules": [
    {
      "rule": "직무 7항목 모두 수행 기록",
