  "verificationStatus": "verified",
  "_meta": {
    "publishedBy": "황룡건설(주) + ㈜라텔웍스",
    "legalBasisRefs": [
      {
        "law": "산업안전보건법",
        "article": "§36",
        "text": "위험성평가 의무"
      },
      {
        "law": "위험성평가 고시 (제2024-76호)",
        "article": "§15 제4항 제3호",
        "text": "매 작업일마다 작업 전 안전점검회의를 통해 위험요인·주의사항 공유·주지"
      },
      {
        "law": "위험성평가 고시",
        "article": "§6",
        "text": "근로자 참여 의무"
      },
      {
        "law": "위험성평가 고시",
        "article": "§13",
        "text": "공유"
      }
    ],
    "writingGuide": {
      "fieldHints": {
        "잠재위험요인": "구체 시나리오. '추락' 같은 추상명사 X → '사다리 3m 작업 중 균형 상실 → 추락'",
        "대책": "감소대책 위계 (제거→대체→공학적→관리적→보호구). 행동 지시형.",
        "중점위험요인": "잠재위험요인 1~3 중 가장 중요한 1개 선정",
        "조치여부 아니오": "조치 안 됐으면 즉시 조치 + 작업중지 권고"
      },
      "commonMistakes": [
        "참석자 서명 누락 (특히 근로자 대표)",
        "위험요인을 추상명사로 작성 ('주의해야 함' 등)",
        "동일 양식 복사하지 않고 매일 다른 포맷 (감독 시 일관성 의심)",
