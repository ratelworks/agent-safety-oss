  "docId": "initial_risk_assessment",
  "title": "최초 위험성평가",
  "alternativeNames": [
    "최초평가",
    "작업 시작 전 최초평가"
  ],
  "description": "해당 사업장에서 최초로 작업을 시작하기 전까지 위험성평가의 대상이 되는 모든 유해·위험요인에 대해 실시 (시행규칙 §37 ② 1호, 2026-08-01 시행). 이후 정기·수시·상시 평가의 토대.",
  "cycle": "cyc:ad_hoc",
  "trigger": "해당 사업장에서 최초로 작업을 시작하기 전까지 위험성평가의 대상이 되는 모든 유해·위험요인에 대해 실시 (시행규칙 §37 ② 1호, 2026-08-01 시행). 이후 정기·수시·상시 평가의 토대.",
  "applicableWhen": {
    "appliesTo": "applic:all_workplace",
    "scaleNotes": "50인 미만 + 50억 미만 건설현장도 동일 적용. 단기 공사도 면제 X."
  },
  "exemptedWhen": {},
  "requiredFields": [
    {
      "key": "f_0_사업장_정보",
      "label": "사업장 정보",
      "source": "위험성평가 고시 제15조 ① + 시행규칙 제37조",
      "inputGuide": "사업장명·소재지·업종(KSIC)·상시근로자수·산재보험 사업장관리번호 통합 표기.",
      "examples": [
        "황룡건설(주) / 서울 강남구 테헤란로 123 / 41122 종합건설업 / 35명 / 산재 1234567890"
      ]
    },
    {
      "key": "f_1_사업장명",
      "label": "사업장명",
      "source": "위험성평가 고시 제15조 ① + 시행규칙 제37조",
      "inputGuide": "법인등기부등본 또는 사업자등록증 상의 정식 명칭. 약칭·통칭 사용 금지.",
      "examples": [
        "황룡건설(주)",
        "(주)라텔웍스",
        "현대건설 주식회사"
      ]
    },
    {
      "key": "date",
      "label": "평가 실시일",
      "source": "위험성평가 고시 제15조 ① + 시행규칙 제37조",
      "inputGuide": "YYYY-MM-DD 형식. 작성·점검·평가 실제 시행 일자.",
      "examples": [
        "2026-04-29",
        "2026-05-15"
      ]
    },
    {
      "key": "f_3_평가자",
      "label": "평가자",
      "source": "위험성평가 고시 제15조 ① + 시행규칙 제37조",
      "inputGuide": "평가 수행자 직책 + 성명 + 자격.",
      "examples": [
        "김안전 (안전관리자, 산업안전기사)"
      ]
    },
    {
      "key": "f_4_근로자_참여",
      "label": "근로자 참여",
      "source": "위험성평가 고시 제15조 ① + 시행규칙 제37조",
      "inputGuide": "위험성평가 시 근로자 참여 (위험성평가 고시 제6조).",
      "examples": [
        "전체 근로자 + 외국인 (베트남어 통역 동석) + 근로자대표 + 관리감독자"
      ]
    },
    {
      "key": "f_5_사전조사_안전보건정보",
      "label": "사전조사 안전보건정보",
      "source": "위험성평가 고시 제15조 ① + 시행규칙 제37조",
      "inputGuide": "사전조사 자료 (작업장·기계·설비·재료·공정·재해이력).",
      "examples": [
        "작업장 도면 / 기계 안전검사필증 / MSDS / 재해 5년 이력 / 인근 현장 사례"
      ]
    },
    {
      "key": "f_6_유해_위험요인_파악",
      "label": "유해·위험요인 파악",
      "source": "위험성평가 고시 제15조 ① + 시행규칙 제37조",
      "inputGuide": "KRAS 7방법 중 1개로 작업·공정·기계·물질별 유해·위험요인 식별. 외부 자료(사고사례/MSDS/KOSHA Guide) 반영.",
      "examples": [
        "고소작업: 추락(난간 미설치) / 자재 낙하(출입통제 부재)",
        "용접: 화재·폭발(가연물 인근) / 일산화탄소 노출(밀폐공간)"
      ]
    },
    {
      "key": "f_7_위험성_결정",
      "label": "위험성 결정",
      "source": "위험성평가 고시 제15조 ① + 시행규칙 제37조",
      "inputGuide": "위험성평가 고시 제7조 KRAS 7방법으로 빈도×강도 산출. 결과는 무시가능/허용가능/즉시개선/작업중지 4단계 결정.",
      "examples": [
        "빈도 3 (월1회) × 강도 4 (사망) = 위험성 12 → 즉시개선",
        "빈도 1 × 강도 2 = 2 → 무시가능"
      ]
    },
    {
      "key": "f_8_위험성_감소대책",
      "label": "위험성 감소대책",
      "source": "위험성평가 고시 제15조 ① + 시행규칙 제37조",
      "inputGuide": "감소대책 우선순위 (제거 → 대체 → 공학적 대책 → 관리적 대책 → 개인보호구) 적용. 비용·실행가능성 함께 평가.",
      "examples": [
        "E: 추락 위험 작업 자체 제거 / S: 안전성 높은 대체 설비 / E: 안전난간·추락방지망 / A: 작업절차서·교육 / PPE: 안전대"
      ]
    },
    {
      "key": "f_9_최초_평가_착수일",
      "label": "최초 평가 착수일",
      "source": "위험성평가 고시 제15조 ① + 시행규칙 제37조",
      "inputGuide": "사업장 최초 위험성평가 착수일 (사업 성립 후 1개월 내).",
      "examples": [
        "2026-03-15 (착공 2026-03-01)"
      ]
    },
    {
      "key": "f_10_사업_성립일",
      "label": "사업 성립일",
      "source": "위험성평가 고시 제15조 ① + 시행규칙 제37조",
      "inputGuide": "사업 성립일 (사업장 개시일).",
      "examples": [
        "2026-03-01"
      ]
    }
  ],
  "reviewRules": [
    {
      "rule": "필수 — 성립일 + 평가일 (1개월 내)",
      "severity": "manual_review",
      "legalBasis": "art:위험성평가-고시:15"
    },
    {
      "rule": "필수 — 6범주 위험요인 모두 검토",
      "severity": "manual_review",
      "legalBasis": "art:위험성평가-고시:10"
    },
    {
      "rule": "필수 — 실시규정 (이후 평가 절차)",
      "severity": "manual_review",
      "legalBasis": "art:위험성평가-고시:15"
    },
    {
      "rule": "필수 — 근로자 대표 참여·서명",
      "severity": "manual_review",
      "legalBasis": "art:위험성평가-고시:6"
    },
    {
      "rule": "권장 — 사고이력 사전조사",
      "severity": "warning"
    },
    {
      "rule": "필수 — 실시 전 위험성평가 일정을 근로자에게 고지",
      "severity": "manual_review",
      "legalBasis": "art:산안법시행규칙:37의3"
    },
    {
      "rule": "필수 — 실시 후 4개 항목(유해·위험 요인, 위험성 수준 결정 결과, 개선대책 수립 내용, 이행 결과) 공유",
      "severity": "manual_review",
      "legalBasis": "art:산안법시행규칙:37의3"
    },
    {
      "rule": "필수 — 근로자 참여는 사업장 순회 점검이 원칙",
      "severity": "manual_review",
      "legalBasis": "art:산안법시행규칙:37의2"
    },
    {
      "rule": "필수 — 기록에 참여한 근로자 및 근로자대표 포함",
      "severity": "manual_review",
      "legalBasis": "art:산안법시행규칙:37의4"
    }
  ],
  "retention": "3년 (시행규칙 §37의4 ②)",
