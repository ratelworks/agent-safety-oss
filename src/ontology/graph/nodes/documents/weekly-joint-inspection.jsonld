  "title": "합동 안전보건점검",
  "alternativeNames": [
    "주간 합동점검 회의록",
    "원·수급인 합동회의록"
  ],
  "description": "주 1회 안전보건관계자가 모여 월 단위 발굴·일 단위 TBM 결과를 공유·점검하고 이행 상황을 확인. 위험성평가 상시평가의 주단위 핵심 증빙.",
  "cycle": "cyc:weekly",
  "trigger": "주 1회 안전보건관계자가 모여 월 단위 발굴·일 단위 TBM 결과를 공유·점검하고 이행 상황을 확인. 위험성평가 상시평가의 주단위 핵심 증빙.",
  "applicableWhen": {
    "appliesTo": "applic:ongoing_assessment_selected",
    "scaleNotes": "도급 발생 시 안전보건협의체는 별도 구성 (월 1회 이상). 상시평가 주 1회 회의는 협의체와 통합 운영 가능."
  },
  "exemptedWhen": {},
  "requiredFields": [
    {
      "key": "meetingDate",
      "label": "점검 일시",
      "source": "산안법 제64조",
      "inputGuide": "점검 실시 일시.",
      "examples": [
        "2026-04-29 07:30"
      ]
    },
    {
      "key": "f_1_점검자__도급인_수급인",
      "label": "점검자 (도급인·수급인·근로자 1명)",
      "source": "산안법 제64조",
      "inputGuide": "관리감독자 또는 작업지휘자 직책 + 성명.",
      "examples": [
        "박감독 (관리감독자)"
      ]
    },
    {
      "key": "f_2_점검_대상_작업장",
      "label": "점검 대상 작업장",
      "source": "산안법 제64조",
      "inputGuide": "점검 대상 (도급인 + 수급인 작업장).",
      "examples": [
        "A동 골조작업 (황룡건설) + B동 양중작업 (광산기계) + 외부비계 (대성기업)"
      ]
    },
    {
      "key": "f_3_발견_사항",
      "label": "발견 사항",
      "source": "산안법 제64조",
      "inputGuide": "합동점검 발견 사항 — 사실 위주.",
      "examples": [
        "1) A동 단부 안전난간 누락 / 2) 양중 하부 통제선 미설치 / 3) 비계 클램프 풀림 2개소"
      ]
    },
    {
      "key": "f_4_개선_요구",
      "label": "개선 요구",
      "source": "산안법 제64조",
      "inputGuide": "개선 요구사항 + 책임자 + 기한.",
      "examples": [
        "1) 안전난간 즉시 (박감독, 당일) / 2) 통제선 설치 (광산기계, 4/30) / 3) 클램프 점검 (대성기업, 4/30)"
      ]
    },
    {
      "key": "f_5_수급인_조치_사항",
      "label": "수급인 조치 사항",
      "source": "산안법 제64조",
      "inputGuide": "도급 계약 받은 시공사.",
      "examples": [
        "황룡건설(주)"
      ]
    },
    {
      "key": "f_6_다음_점검_일자",
      "label": "다음 점검 일자",
      "source": "산안법 제64조",
      "inputGuide": "점검 실시일.",
      "examples": [
        "2026-04-29"
      ]
    }
  ],
  "reviewRules": [
    {
      "rule": "필수 — 회의일자·참석자·서명",
      "severity": "manual_review",
      "legalBasis": "art:위험성평가-고시:15"
    },
    {
      "rule": "필수 — 원·하청 안전보건관리자 모두 참석",
      "severity": "manual_review",
      "legalBasis": "art:위험성평가-고시:15",
      "legalBasisNote": "고시 제15조 ④ 2호 — 도급사업주 = 수급사업장 안전·보건관리자 포함"
    },
    {
      "rule": "필수 — 지난주 이행 상태 점검",
      "severity": "manual_review",
      "legalBasis": "art:위험성평가-고시:15"
    },
    {
      "rule": "필수 — 미이행 사항 + 책임자·기한",
      "severity": "manual_review"
    }
  ],
  "retention": "3년 (위험성평가 고시 제14조 ②) / 산안위 회의록은 2년 (산안법 제164조)",
