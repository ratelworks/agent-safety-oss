{
  "@context": "../../context.jsonld",
  "@id": "doc:daily/contractor_round_inspection_log",
  "@type": [
    "Document",
    "DigitalDocument"
  ],
  "docId": "contractor_round_inspection_log",
  "title": "작업장 순회점검 일지",
  "alternativeNames": [
    "작업장 순회점검",
    "수급인 작업장 순회"
  ],
  "description": "도급인이 자신의 사업장에서 관계수급인의 근로자가 작업할 때 실시하는 작업장 순회점검 일지. 산안법 제64조 ① 2호 + 시행규칙 제80조 ② 에 따라 건설업은 2일에 1회 이상 실시 의무. 50억 미만 도급 사업장 적용.",
  "cycle": "cyc:every_2_days",
  "trigger": "도급사업주는 관계수급인 근로자 작업 시 2일에 1회 이상 작업장 순회점검을 실시 (산안법 제64조 ① 2호, 시행규칙 제80조 ②).",
  "applicableWhen": {
    "appliesTo": "applic:contractor",
    "scaleNotes": "건설업 도급사업주는 2일에 1회 이상. 일반 도급사업주는 1주에 1회 이상."
  },
  "exemptedWhen": {},
  "requiredFields": [
    {
      "key": "inspectionDate",
      "label": "순회점검 일시",
      "source": "산안법 제64조 + 시행규칙 제80조 ②",
      "inputGuide": "순회점검 일시.",
      "examples": [
        "2026-04-29 10:00 ~ 12:00"
      ]
    },
    {
      "key": "inspector",
      "label": "점검자 성명·직위",
      "source": "법령 의무",
      "inputGuide": "관리감독자 또는 작업지휘자 직책 + 성명.",
      "examples": [
        "박감독 (관리감독자)"
      ]
    },
    {
      "key": "primaryContractor",
      "label": "도급인 사업장명",
      "source": "법령 의무",
      "inputGuide": "도급 발주 사업장.",
      "examples": [
        "황룡건설(주) 삼성동 현장"
      ]
    },
    {
      "key": "subContractor",
      "label": "관계수급인 사업장명·작업범위",
      "source": "법령 의무",
      "inputGuide": "수급·하수급 사업장.",
      "examples": [
        "광산기계(주) 양중작업팀"
      ]
    },
    {
      "key": "inspectionAreas",
      "label": "점검 대상 작업장·구간",
      "source": "법령 의무",
      "inputGuide": "점검 구역·작업장 식별.",
      "examples": [
        "A동 4층 골조작업장 + B동 외부비계"
      ]
    },
    {
      "key": "findings",
      "label": "발견 사항 (불안전 상태·행동)",
      "source": "법령 의무",
      "inputGuide": "발견된 불안전 상태·행동 — 사실 위주 서술.",
      "examples": [
        "1) 단부 안전난간 누락 (A동 4층) / 2) 안전대 미체결 1명 / 3) 안전모 끈 미체결 2명"
      ]
    },
    {
      "key": "improvementRequest",
      "label": "개선 요구 사항",
      "source": "법령 의무",
      "inputGuide": "시정 요구 항목 + 일정 + 책임자.",
      "examples": [
        "1) 안전난간 즉시 설치 (박감독, 당일) / 2) 안전대 체결 교육 (김안전, 5/1)"
      ]
    },
    {
      "key": "subContractorResponse",
      "label": "수급인 조치 사항·이행일자",
      "source": "법령 의무",
      "inputGuide": "도급 계약 받은 시공사.",
      "examples": [
        "황룡건설(주)"
      ]
    },
    {
      "key": "verifiedBy",
      "label": "이행 확인자 (도급인) 서명",
      "source": "법령 의무",
      "inputGuide": "본인 자필 서명 또는 전자서명.",
      "examples": [
        "(자필 서명)"
      ]
    },
    {
      "key": "approvalChain",
      "label": "결재선",
      "source": "행정",
      "inputGuide": "작성 → 검토 → 승인 순. 직책 + 성명 + 서명.",
      "examples": [
        "작성: 김안전 / 검토: 박감독 / 승인: 황룡"
      ]
    }
  ],
  "reviewRules": [
    {
      "rule": "필수 — 점검 일시 (2일에 1회 이상 누락 없음)",
      "severity": "blocker",
      "checkFields": [
        "inspectionDate"
      ]
    },
    {
      "rule": "필수 — 점검자 성명·직위 (도급인 측)",
      "severity": "blocker",
      "checkFields": [
        "inspector"
      ]
    },
    {
      "rule": "필수 — 발견사항·개선요구·수급인 조치 3종 모두 기재",
      "severity": "blocker",
      "checkFields": [
        "findings",
        "improvementRequest",
        "subContractorResponse"
      ]
    },
    {
      "rule": "필수 — 결재선",
      "severity": "blocker",
      "checkFields": [
        "approvalChain"
      ]
    },
    {
      "rule": "권장 — 사진 첨부 (불안전 상태 시각 입증)",
      "severity": "warning"
    },
    {
      "rule": "사람 검토 — 미이행 시 작업중지 여부",
      "severity": "manual_review"
    },
    {
      "rule": "필수 — 위반 시 제175조 500만원 과태료",
      "severity": "manual_review",
      "legalBasis": "art:산안법:175"
    }
  ],
  "retention": "3년 (산안법 제164조)",
  "standardForm": {
    "source": "산안법 제64조 + 시행규칙 제80조 ② — 도급사업 작업장 순회점검 (자체 양식)",
    "officialNote": "별지 양식 없음. 사업장 자체 양식. KOSHA 권장 항목 + 법령 의무 항목 통합.",
    "verifiedBy": "산안법 제64조 + 시행규칙 제80조 본문 1:1 매핑 (2026-04-29)"
  },
