  "verificationStatus": "verified",
  "_meta": {
    "publishedBy": "황룡건설(주) + ㈜라텔웍스",
    "legalBasisRefs": [
      {
        "law": "산업안전보건법",
        "article": "§64",
        "text": "도급에 따른 산업재해 예방조치 — 작업장 순회점검"
      },
      {
        "law": "산업안전보건법 시행규칙",
        "article": "§80",
        "text": "건설업 2일에 1회 이상, 그 외 1주에 1회 이상"
      },
      {
        "law": "산업안전보건법",
        "article": "§175",
        "text": "위반 시 500만원 과태료"
      }
    ],
    "writingGuide": {
      "fieldHints": {
        "발견사항": "불안전한 상태(예: 토류벽 미설치, 안전난간 결손) + 불안전한 행동(예: 안전대 미착용, 사각지대 진입) 모두 작성",
        "개선요구": "구체적 행동 + 이행 기한 (예: '북측 단부 안전난간 즉시 설치 / 4/30 17:00까지')",
        "수급인 조치": "수급인 측 응답 + 이행 일시 + 이행자 성명·서명"
      },
      "commonMistakes": [
        "건설업 2일 1회 누락 (1주 1회로 작성)",
        "발견사항·개선요구·조치 3종 중 일부 누락",
        "수급인 조치 확인 안 함 (도급인 책임 미이행)"
      ],
      "bestPractices": [
        "동선·구간 사전 계획 (전 구간 분할)",
        "사진·동영상 첨부",
        "위반 사항 즉시 작업중지 권고"
      ]
    },
    "examples": [
      {
        "title": "도급사업 안전보건 가이드",
        "source": "KOSHA",
        "license": "공공누리"
      }
    ],
    "createdAt": "2026-04-29",
    "createdBy": "라텔웍스 (Ratelworks Inc.) — 50억 미만 의무 매트릭스 누락 노드 신규 작성",
    "documentCategory": "register",
