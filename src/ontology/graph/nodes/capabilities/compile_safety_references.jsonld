{
  "@context": "../../context.jsonld",
  "@id": "safety:capability/compile_safety_references",
  "@type": [
    "safety:Capability",
    "prov:Plan"
  ],
  "rdfs:label": [
    {
      "@value": "문서유형·공종별 참조 자료 번들",
      "@language": "ko"
    },
    {
      "@value": "Compile Safety References",
      "@language": "en"
    }
  ],
  "description": "안전관리 법정문서의 근거, 스키마, 생성, 검토, 제출, 보관, 컨텍스트 조립을 수행하는 capability. 공종 + 문서유형(위험성평가/작업계획서/TBM/OPS/작업허가서/일일점검표) 입력 시, 해당 문서 작성에 필요한 **법령(mandatory) + KOSHA Guide(recommended) + SIF 패턴(reference) + 공종 위험요인 분석** 을 한 번에 번들해 Markdown 으로 반환. LLM 은 get_*_schema 의 필드 + 이 Reference 조합으로 문서 초안 작성.",
  "toolName": "compile_safety_references",
  "category": "safety_doc",
  "inputSchema": "safety:schema/input/compile_safety_references",
  "producesEntity": [
    "safety:ReferenceBundle"
  ],
  "maps_to_action": "safety:action/compile_safety_references",
  "_meta": {
    "created": "2026-05-03",
    "creator": "safety:agent/ratelworks"
  }
}
