{
  "@context": "../../context.jsonld",
  "@id": "safety:capability/choose_assessment_method",
  "@type": [
    "safety:Capability",
    "prov:Plan"
  ],
  "rdfs:label": [
    {
      "@value": "KRAS 위험성평가 방법 추천",
      "@language": "ko"
    },
    {
      "@value": "Choose Assessment Method",
      "@language": "en"
    }
  ],
  "description": "안전관리 법정문서의 근거, 스키마, 생성, 검토, 제출, 보관, 컨텍스트 조립을 수행하는 capability. 사업장 조건(업종·규모·평가 영역) 입력 시 가장 적합한 KRAS 위험성평가 방법을 1순위·보조로 추천. 건설업은 construction_continuous 의무, 화학물질 영역은 CHARM 우선, 직업병 영역은 산업보건평가 우선 등 KOSHA 가이드 기반 휴리스틱 적용.",
  "toolName": "choose_assessment_method",
  "category": "safety_doc",
  "inputSchema": "safety:schema/input/choose_assessment_method",
  "producesEntity": [
    "safety:MethodRecommendation"
  ],
  "maps_to_action": "safety:action/choose_assessment_method",
