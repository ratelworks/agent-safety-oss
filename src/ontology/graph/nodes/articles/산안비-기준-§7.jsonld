    "sourceUrl": "https://www.law.go.kr/행정규칙/%EA%B1%B4%EC%84%A4%EC%97%85%20%EC%82%B0%EC%97%85%EC%95%88%EC%A0%84%EB%B3%B4%EA%B1%B4%EA%B4%80%EB%A6%AC%EB%B9%84%20%EA%B3%84%EC%83%81%20%EB%B0%8F%20%EC%82%AC%EC%9A%A9%EA%B8%B0%EC%A4%80",
    "fetchedAt": "2026-11-12",
