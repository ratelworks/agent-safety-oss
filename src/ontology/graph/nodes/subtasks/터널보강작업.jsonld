          ],
          "hazard": "hazard:machine_entanglement",
          "risks": [
            {
              "statement": "지보공 조립 중 부재가 전도되거나 부재 사이에 끼임",
              "priority": "★",
              "measures": [
                {
                  "measure": "강아치지보공 조립시에는 부재운반, 부재전도, 협착 등 안전조치를 취한 후 조립작업을 한다.",
                  "controlLevel": "administrative",
                  "basis": {
                    "guide": "doc:kosha_guide/C-45-2012",
                    "section": "7.1"
                  }
                },
                {
                  "measure": "낙하물이 근로자에게 위험을 미칠 우려가 있는 경우에는 널판 등을 설치한다.",
                  "controlLevel": "engineering",
                  "basis": {
                    "article": "art:기준규칙:364",
                    "item": 4,
                    "subitem": "마"
                  }
                }
              ]
