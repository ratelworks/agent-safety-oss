          ],
          "hazard": "hazard:cave_in",
          "risks": [
            {
              "statement": "지보공 설치가 지연되어 그 사이 굴착면이 붕락",
              "priority": "★★",
              "measures": [
                {
                  "measure": "강아치지보공은 발파굴착면의 절리발달, 편암붕락 등 원지반에 불리한 파괴응력이 발생하기전에 가능한 신속히 설치한다.",
                  "controlLevel": "elimination",
                  "basis": {
                    "guide": "doc:kosha_guide/C-45-2012",
                    "section": "7.2"
                  }
                },
                {
                  "measure": "설계조건의 암반보다 구조적으로 불리한 경우에는 강아치지보공의 간격을 적절한 기준으로 축소한다.",
                  "controlLevel": "engineering",
                  "basis": {
                    "guide": "doc:kosha_guide/C-45-2012",
                    "section": "7.1"
                  }
                },
                {
                  "measure": "터널 지보공을 설치하는 장소의 지반과 관계되는 지질ㆍ지층ㆍ함수ㆍ용수ㆍ균열 및 부식의 상태와 굴착 방법에 상응하는 견고한 구조의 터널 지보공을 사용한다.",
                  "controlLevel": "engineering",
                  "basis": {
                    "article": "art:기준규칙:362"
                  }
                },
                {
                  "measure": "예상치 못했던 막장의 구조적 불안정 등과 같은 비상의 상황에 대비하여 충분한 양의 비상용 통나무와 쐐기목, 급결재, 시멘트 등을 준비해 두어야 한다.",
                  "controlLevel": "administrative",
                  "basis": {
                    "guide": "doc:kosha_guide/C-45-2012",
                    "section": "7.2"
                  }
                }
              ]
            },
            {
              "statement": "조립도 없이 또는 조립도와 다르게 조립하여 지보공이 하중을 견디지 못하고 무너짐",
              "priority": "★",
              "measures": [
                {
                  "measure": "터널 지보공을 조립하는 경우에는 미리 그 구조를 검토한 후 조립도를 작성하고, 그 조립도에 따라 조립하도록 한다.",
                  "controlLevel": "administrative",
                  "basis": {
                    "article": "art:기준규칙:363"
                  }
                },
                {
                  "measure": "조립도에는 재료의 재질, 단면규격, 설치간격 및 이음방법 등을 명시한다.",
                  "controlLevel": "administrative",
                  "basis": {
                    "article": "art:기준규칙:363"
                  }
                },
                {
                  "measure": "강아치지보공을 조립할 때에는 설계, 시방에 부합하는 조립도를 작성하고 당해 조립도에 따라 조립하여야 하며 재질기준, 설치간격, 접합볼트체결 등의 기준을 준수한다.",
                  "controlLevel": "administrative",
                  "basis": {
                    "guide": "doc:kosha_guide/C-45-2012",
                    "section": "7.1"
                  }
                },
                {
                  "measure": "터널 지보공의 재료로 변형ㆍ부식 또는 심하게 손상된 것을 사용해서는 아니 된다.",
                  "controlLevel": "substitution",
                  "basis": {
                    "article": "art:기준규칙:361"
                  }
                }
              ]
            },
            {
              "statement": "강아치 주재의 연결·쐐기 조치가 부실하여 아치작용을 못하고 붕괴",
              "priority": "★",
              "measures": [
                {
                  "measure": "주재가 아치작용을 충분히 할 수 있도록 쐐기를 박는 등 필요한 조치를 한다.",
                  "controlLevel": "engineering",
                  "basis": {
                    "article": "art:기준규칙:364",
                    "item": 4,
                    "subitem": "나"
                  }
                },
                {
                  "measure": "연결볼트 및 띠장 등을 사용하여 주재 상호간을 튼튼하게 연결한다.",
                  "controlLevel": "engineering",
                  "basis": {
                    "article": "art:기준규칙:364",
                    "item": 4,
                    "subitem": "다"
                  }
                },
                {
                  "measure": "조립간격은 조립도에 따른다.",
                  "controlLevel": "administrative",
                  "basis": {
                    "article": "art:기준규칙:364",
                    "item": 4,
                    "subitem": "가"
                  }
                },
                {
                  "measure": "주재(主材)를 구성하는 1세트의 부재는 동일 평면 내에 배치한다.",
                  "controlLevel": "engineering",
                  "basis": {
                    "article": "art:기준규칙:364",
                    "item": 1
                  }
                },
                {
                  "measure": "강아치지보공의 상호연결볼트 및 연결재는 충분히 조여야 하며 용접을 금하고 덧댐판으로 볼트, 너트 구조의 접합을 실시한다.",
                  "controlLevel": "engineering",
                  "basis": {
                    "guide": "doc:kosha_guide/C-45-2012",
                    "section": "7.2"
                  }
                },
                {
                  "measure": "강아치지보공은 정해진 위치에 정확히 설치하여야 하며 건립후 그의 위치 중심, 고저차에 대하여 수시로 점검한다.",
                  "controlLevel": "administrative",
                  "basis": {
                    "guide": "doc:kosha_guide/C-45-2012",
                    "section": "7.2"
                  }
                }
              ]
            },
            {
              "statement": "지보공 기둥이 침하하여 지보공 전체가 기울어져 무너짐",
              "priority": "★",
              "measures": [
                {
                  "measure": "기둥에는 침하를 방지하기 위하여 받침목을 사용하는 등의 조치를 한다.",
                  "controlLevel": "engineering",
                  "basis": {
                    "article": "art:기준규칙:364",
                    "item": 3
                  }
                },
                {
                  "measure": "터널 등의 출입구 부분에는 받침대를 설치한다.",
                  "controlLevel": "engineering",
                  "basis": {
                    "article": "art:기준규칙:364",
                    "item": 4,
                    "subitem": "라"
                  }
                },
                {
                  "measure": "강아치 지보공 및 목재지주식 지보공 외의 터널 지보공에 대해서는 터널 등의 출입구 부분에 받침대를 설치한다.",
                  "controlLevel": "engineering",
                  "basis": {
                    "article": "art:기준규칙:364",
                    "item": 6
                  }
                },
                {
                  "measure": "강아치지보공의 설치에 있어서는 지질 및 지층의 특성에 따라 침하발생이 우려될 경우 쐐기, 앵커 등의 고정장치를 강구한다.",
                  "controlLevel": "engineering",
                  "basis": {
                    "guide": "doc:kosha_guide/C-45-2012",
                    "section": "7.2"
                  }
                },
                {
                  "measure": "강아치지보공의 받침은 목재받침을 금하고 철근류 및 양질의 콘크리트 블록 등으로 고정한다.",
                  "controlLevel": "substitution",
                  "basis": {
                    "guide": "doc:kosha_guide/C-45-2012",
                    "section": "7.2"
                  }
                }
              ]
            },
            {
              "statement": "설치된 지보공의 변형·이완을 발견하지 못해 무너짐",
              "priority": "★",
              "measures": [
                {
                  "measure": "터널 지보공을 설치한 경우에 부재의 손상ㆍ변형ㆍ부식ㆍ변위 탈락의 유무 및 상태, 부재의 긴압 정도, 부재의 접속부 및 교차부의 상태, 기둥침하의 유무 및 상태를 수시로 점검하여야 하며, 이상을 발견한 경우에는 즉시 보강하거나 보수한다.",
                  "controlLevel": "administrative",
                  "basis": {
                    "article": "art:기준규칙:366"
                  }
                },
                {
                  "measure": "강아치지보공에 변형, 부재이완, 설치간격불량 등의 이상이 있다고 인정되는 경우에는 즉시 안전하고 확실한 방법으로 보강을 한다.",
                  "controlLevel": "engineering",
                  "basis": {
                    "guide": "doc:kosha_guide/C-45-2012",
                    "section": "7.2"
                  }
                },
                {
                  "measure": "프리그라우팅 및 포아폴링 등의 보강작업시 사용되는 봉, 파이프 등에 의하여 강아치지보공이 이동하거나 뒤틀리는 것을 막아야 하며, 이 경우 설치오차는 수평거리 10cm이내로 하여야 한다.",
                  "controlLevel": "engineering",
                  "basis": {
                    "guide": "doc:kosha_guide/C-45-2012",
                    "section": "7.2"
                  }
                }
              ]
            },
            {
              "statement": "하중이 걸린 지보공 부재를 해체하여 상부가 무너짐",
              "priority": "★★",
              "measures": [
                {
                  "measure": "하중이 걸려 있는 터널 지보공의 부재를 해체하는 경우에는 해당 부재에 걸려있는 하중을 터널 거푸집 및 동바리가 받도록 조치를 한 후에 그 부재를 해체한다.",
                  "controlLevel": "engineering",
                  "basis": {
                    "article": "art:기준규칙:365"
                  }
                }
              ]
            },
            {
              "statement": "목재 지주식 지보공의 긴압·고정이 불균등하여 넘어지거나 비틀림",
              "priority": "★",
              "measures": [
                {
                  "measure": "목재의 터널 지보공은 그 터널 지보공의 각 부재의 긴압 정도가 균등하게 되도록 한다.",
                  "controlLevel": "engineering",
                  "basis": {
                    "article": "art:기준규칙:364",
                    "item": 2
                  }
                },
                {
                  "measure": "주기둥은 변위를 방지하기 위하여 쐐기 등을 사용하여 지반에 고정시킨다.",
                  "controlLevel": "engineering",
                  "basis": {
                    "article": "art:기준규칙:364",
                    "item": 5,
                    "subitem": "가"
                  }
                },
                {
                  "measure": "양끝에는 받침대를 설치한다.",
                  "controlLevel": "engineering",
                  "basis": {
                    "article": "art:기준규칙:364",
                    "item": 5,
                    "subitem": "나"
                  }
                },
                {
                  "measure": "터널 등의 목재 지주식 지보공에 세로방향의 하중이 걸림으로써 넘어지거나 비틀어질 우려가 있는 경우에는 양끝 외의 부분에도 받침대를 설치한다.",
                  "controlLevel": "engineering",
                  "basis": {
                    "article": "art:기준규칙:364",
                    "item": 5,
                    "subitem": "다"
                  }
                },
                {
                  "measure": "부재의 접속부는 꺾쇠 등으로 고정시킨다.",
                  "controlLevel": "engineering",
                  "basis": {
                    "article": "art:기준규칙:364",
                    "item": 5,
                    "subitem": "라"
                  }
                }
              ]
            }
          ]
        },
