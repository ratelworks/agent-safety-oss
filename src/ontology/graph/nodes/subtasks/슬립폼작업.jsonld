    {
      "@id": "workstep:슬립폼작업/2",
      "@type": "WorkStep",
      "stepName": "슬립 폼(슬라이딩 폼) 인양",
      "stepHazards": [
        {
          "hazardLabel": "무너짐",
          "hasHazard": "hazard:cave_in",
          "basis": [
            {
              "basisGuide": "doc:kosha_guide/D-C-8-2026",
              "guideSection": "8.3.3"
            },
            {
              "basisGuide": "doc:kosha_guide/D-C-8-2026",
              "guideSection": "8.3.4",
              "controlLevel": "administrative"
            }
          ],
          "risks": [
            {
              "@id": "workrisk:슬립폼작업/2.1",
              "@type": "WorkRisk",
              "statement": "콘크리트 경화 깊이를 확인하지 않고 슬립업하여 구조물이 무너짐",
              "priority": "★★",
              "measures": [
                {
                  "@id": "workmeasure:40da13ff0c87",
                  "@type": "WorkMeasure",
                  "measure": "슬립업 작업 전에 콘크리트의 경화 깊이를 측정하고 탈형 후 콘크리트가 부담하는 전 하중과 콘크리트가 발휘하여야 하는 압축강도, 품질, 시공조건 등을 고려하여 슬립폼의 슬립업 속도를 결정한다",
                  "controlLevel": "administrative",
                  "variant": "슬립폼",
                  "basis": {
                    "basisGuide": "doc:kosha_guide/D-C-8-2026",
                    "guideSection": "8.3.4"
                  }
                },
                {
                  "@id": "workmeasure:a413a0ea7bdd",
                  "@type": "WorkMeasure",
                  "measure": "슬립업 속도기준은 구조물의 강도와 형상에 따라 차이가 있지만 시간당 10~17cm를 기준으로 하되 기온과 콘크리트 경화속도에 따라 적절히 조절한다",
                  "controlLevel": "administrative",
                  "variant": "슬립폼",
                  "basis": {
                    "basisGuide": "doc:kosha_guide/D-C-8-2026",
                    "guideSection": "8.3.4"
                  }
                }
              ]
            },
            {
              "@id": "workrisk:슬립폼작업/2.2",
              "@type": "WorkRisk",
              "statement": "타설 높이·청결 관리 미흡으로 콘크리트가 거푸집 내부로 밀려들어가 고착됨",
              "priority": "★",
              "measures": [
                {
                  "@id": "workmeasure:9ae81361edd6",
                  "@type": "WorkMeasure",
                  "measure": "콘크리트 타설은 균일하게 20~30cm 높이로 하며, 거푸집 내부에는 콘크리트가 항상 일정 높이에 있도록 유지하고, 작업대 위에 남겨진 콘크리트가 경화되어 거푸집 내부로 밀려들어가지 않도록 작업대와 분배기는 항상 청결한 상태를 유지한다",
                  "variant": "기본",
                  "basis": {
                    "basisGuide": "doc:kosha_guide/D-C-8-2026",
                    "guideSection": "8.3.3"
                  }
                },
                {
                  "@id": "workmeasure:c91256e92ab1",
                  "@type": "WorkMeasure",
                  "measure": "콘크리트는 콘크리트 분배용 슈트를 사용하여 타설하고 콘크리트가 작업장 내에 튀지 않도록 주의하여 주입한다",
                  "variant": "기본",
                  "basis": {
                    "basisGuide": "doc:kosha_guide/D-C-8-2026",
                    "guideSection": "8.3.3"
                  }
                }
              ]
            }
          ]
        },
        {
          "hazardLabel": "부딪힘",
          "hasHazard": "hazard:struck_by",
          "basis": [
            {
              "basisGuide": "doc:kosha_guide/D-C-8-2026",
              "guideSection": "8.3.2"
            }
          ],
          "risks": [
            {
              "@id": "workrisk:슬립폼작업/2.3",
              "@type": "WorkRisk",
              "statement": "슬립업 이후 설치한 전기시설·리프트가 간섭하여 부딪힘",
              "measures": [
                {
