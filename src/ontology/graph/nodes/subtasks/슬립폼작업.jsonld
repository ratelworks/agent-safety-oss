          ],
          "risks": [
            {
              "@id": "workrisk:슬립폼작업/1.1",
              "@type": "WorkRisk",
              "statement": "구조적 안정성을 검토하지 않고 제작하여 사용 중 무너짐",
              "priority": "★",
              "measures": [
                {
                  "@id": "workmeasure:b91d3bff31ff",
                  "@type": "WorkMeasure",
                  "measure": "구조계산서 또는 제작사 인증서를 통해 하중(자중, 작업하중, 풍하중 등)에 대한 안정성을 사전에 검토한다",
                  "variant": "기본",
                  "basis": {
                    "basisGuide": "doc:kosha_guide/D-C-8-2026",
                    "guideSection": "9"
                  }
                },
                {
                  "@id": "workmeasure:0150f54d21fb",
                  "@type": "WorkMeasure",
                  "measure": "작업발판은 거푸집 및 동바리 설계기준에 따라 설계한다",
                  "variant": "기본",
                  "basis": {
                    "basisGuide": "doc:kosha_guide/D-C-8-2026",
                    "guideSection": "9"
                  }
                },
                {
                  "@id": "workmeasure:0389f016605f",
                  "@type": "WorkMeasure",
                  "measure": "접속부, 연결핀, 체결볼트 등은 전용품을 사용하고 임의 절단, 용접, 변형을 금지한다",
                  "variant": "기본",
                  "basis": {
                    "basisGuide": "doc:kosha_guide/D-C-8-2026",
                    "guideSection": "9"
                  }
                },
                {
                  "@id": "workmeasure:efddd35d73f1",
                  "@type": "WorkMeasure",
                  "measure": "슬립폼 부재 조립 시는 볼트 체결상태를 반드시 확인한다",
                  "variant": "슬립폼",
                  "basis": {
                    "basisGuide": "doc:kosha_guide/D-C-8-2026",
                    "guideSection": "8.3.2"
                  }
                }
              ]
            },
            {
              "@id": "workrisk:슬립폼작업/1.2",
              "@type": "WorkRisk",
              "statement": "슬립폼 작업계획을 경험 없는 자가 수립하거나 구조 안전성을 검토하지 않아 무너짐",
              "priority": "★",
              "measures": [
                {
                  "@id": "workmeasure:4ff4b3c49b26",
                  "@type": "WorkMeasure",
                  "measure": "공사현장의 제반 여건과 구조물의 형상을 파악한 후 슬립폼의 설치, 슬립업, 해체작업 등 단계별 안전작업 방법과 순서, 장비에 대한 안전조치 사항 등이 포함된 작업계획을 수립한다",
                  "variant": "슬립폼",
                  "basis": {
                    "basisGuide": "doc:kosha_guide/D-C-8-2026",
                    "guideSection": "8.3.1"
                  }
                },
                {
                  "@id": "workmeasure:b9ea3f726e8c",
                  "@type": "WorkMeasure",
                  "measure": "슬립폼에 작용하는 하중을 고려하여 슬립폼의 안전성 여부를 검토하여야 하며, 로드와 유압잭은 거푸집 자중, 작업하중, 장비 등에 충분한 강도를 갖도록 그 수량 및 용량을 결정한다",
                  "basis": {
                    "basisGuide": "doc:kosha_guide/D-C-8-2026",
                    "guideSection": "8.3.1"
                  }
                },
                {
                  "@id": "workmeasure:45b1071e4ecd",
                  "@type": "WorkMeasure",
                  "measure": "작업계획서는 슬립폼 공법에 풍부한 경험과 지식을 갖춘 사람이 수립하여야 하며, 공사 중 계획서의 내용이 제대로 이행되는지의 여부를 수시로 확인할 수 있도록 한다",
                  "variant": "슬립폼",
                  "basis": {
                    "basisGuide": "doc:kosha_guide/D-C-8-2026",
                    "guideSection": "8.3.1"
                  }
                },
                {
                  "@id": "workmeasure:7ff7332be909",
                  "@type": "WorkMeasure",
                  "measure": "철근 조립, 콘크리트 타설, 슬립업 등 작업공종별 투입인원 및 시기 등을 반영한 작업계획을 수립한다",
                  "variant": "슬립폼",
                  "basis": {
                    "basisGuide": "doc:kosha_guide/D-C-8-2026",
                    "guideSection": "8.3.1"
                  }
                }
              ]
            },
            {
              "@id": "workrisk:슬립폼작업/1.3",
              "@type": "WorkRisk",
              "statement": "지반·지장물을 조사하지 않아 기초가 침하하거나 지장물과 간섭함",
              "priority": "★",
              "measures": [
                {
                  "@id": "workmeasure:063734dbb80d",
                  "@type": "WorkMeasure",
                  "measure": "공사 목적구조물의 위치에 대한 지질조사 및 주변 지장물 조사를 실시하고, 슬립폼 조립에 필요한 가설전기 설치위치와 연약지반일 경우 기초 가시설 설치 등의 사항에 대한 사전 검토를 철저히 한다",
                  "variant": "슬립폼",
                  "basis": {
                    "basisGuide": "doc:kosha_guide/D-C-8-2026",
                    "guideSection": "8.3.1"
                  }
                },
                {
                  "@id": "workmeasure:e6b9a365509d",
                  "@type": "WorkMeasure",
                  "measure": "이동식 크레인을 사용하여 설치·해체 등을 하는 때에는 이동식 크레인의 전도를 방지하기 위하여 충분한 넓이와 지내력이 확보된 작업장을 형성한다",
                  "variant": "기본",
                  "basis": {
                    "basisGuide": "doc:kosha_guide/D-C-8-2026",
                    "guideSection": "8.3.1"
                  }
                },
                {
                  "@id": "workmeasure:9f2db5d744c5",
                  "@type": "WorkMeasure",
                  "measure": "구조물의 평면 배치에 따른 양중기 설치 위치를 우선 선정하고, 이에 따른 타워크레인 등의 설치계획 수립과 건설용 리프트의 설치 대수, 위치 설정 계획 등을 포함하여 수립한다",
                  "variant": "기본",
                  "basis": {
                    "basisGuide": "doc:kosha_guide/D-C-8-2026",
                    "guideSection": "8.3.1"
                  }
                }
              ]
            },
            {
              "@id": "workrisk:슬립폼작업/1.4",
              "@type": "WorkRisk",
              "statement": "정전으로 유압잭이 정지하여 슬립폼이 고착·경사됨",
