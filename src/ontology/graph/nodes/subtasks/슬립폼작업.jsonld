          "risks": [
            {
              "@id": "workrisk:슬립폼작업/1.5",
              "@type": "WorkRisk",
              "statement": "작업대 단부에 안전난간이 없어 떨어짐",
              "priority": "★★",
              "measures": [
                {
                  "@id": "workmeasure:a2c8d5ce5cd3",
                  "@type": "WorkMeasure",
                  "measure": "각 작업대 단부에는 근로자의 추락 등에 의한 위험을 방지하기 위한 안전난간을 설치하여야 하며, 안전난간대는 지름 2.7cm 이상의 금속재 파이프나 그 이상의 강도를 가진 재료로서 가장 취약한 지점에서 가장 취약한 방향으로 작용하는 100kg 이상의 하중에 견딜 수 있는 튼튼한 구조로 하고, 안전난간 하부에는 낙하물을 방지하기 위한 발끝막이판을 설치한다",
                  "controlLevel": "engineering",
                  "variant": "기본",
                  "basis": {
                    "basisGuide": "doc:kosha_guide/D-C-8-2026",
                    "guideSection": "8.3.2"
                  }
                },
                {
                  "@id": "workmeasure:89bc48fc6223",
                  "@type": "WorkMeasure",
                  "measure": "작업발판 접근을 위한 전용 계단, 사다리 또는 클라이밍타워 내 통로를 확보한다",
                  "controlLevel": "engineering",
                  "variant": "시스템폼",
