          "hazard": "hazard:struck_by_overturn",
          "risks": [
            {
              "statement": "바지선 위 크레인이 전도되거나 인양물에 근로자가 맞음",
              "priority": "★",
              "measures": [
                {
                  "measure": "바지선에서 크레인을 사용할 때는 크레인이 전도되지 않도록 바닥에 고정장치를 설치하여 반드시 고정하고 작업하여야 한다.",
                  "controlLevel": "engineering",
                  "basis": {
                    "guide": "doc:kosha_guide/C-2-2020",
                    "section": "5.4"
                  }
