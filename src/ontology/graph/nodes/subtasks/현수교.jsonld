          ],
          "risks": [
            {
              "@id": "workrisk:현수교/1.1",
              "@type": "WorkRisk",
              "statement": "앵커리지 매스콘크리트 수화열 균열로 정착부 강도가 저하",
              "priority": "★★",
              "measures": [
                {
                  "@id": "workmeasure:c7ff3785974d",
                  "@type": "WorkMeasure",
                  "measure": "구체는 매스콘크리트 구조물이므로 시공성과 온도균열 제어를 고려해서 콘크리트의 수직 및 수평 분할을 결정하여야 한다.",
                  "controlLevel": "engineering",
                  "basis": {
                    "basisGuide": "doc:kosha_guide/C-21-2011",
                    "guideSection": "6"
                  }
                },
                {
                  "@id": "workmeasure:16dc4d89f09a",
                  "@type": "WorkMeasure",
                  "measure": "사용되는 콘크리트의 배합은 원하는 강도한도내에서 가능한 단열온도 상승계수(K)가 낮은 것을 사용해야 하며, 배합이 결정되면 이에 대한 온도해석을 통해 수화열 균열을 방지하기 위해 Pipe cooling 등을 고려하여야 한다.",
                  "controlLevel": "engineering",
                  "basis": {
                    "basisGuide": "doc:kosha_guide/C-21-2011",
                    "guideSection": "6"
                  }
                },
                {
                  "@id": "workmeasure:b81d3a4bb0fe",
                  "@type": "WorkMeasure",
                  "measure": "콘크리트 타설 규모는 콘크리트 생산 및 타설 능력을 고려하여 구조물에 유해한 균열이 발생되지 않도록 계획되어야 한다.",
                  "controlLevel": "administrative",
                  "basis": {
                    "basisGuide": "doc:kosha_guide/C-21-2011",
                    "guideSection": "6"
                  }
                },
                {
                  "@id": "workmeasure:592b3e811939",
                  "@type": "WorkMeasure",
                  "measure": "수평타설 이음부에는 부착력을 높이기 위해 신콘크리트를 타설하기 전에 고압공기와 워터제트를 사용하여 반드시 레이턴스를 제거하여야 한다.",
                  "controlLevel": "administrative",
                  "basis": {
                    "basisGuide": "doc:kosha_guide/C-21-2011",
                    "guideSection": "6"
                  }
                },
                {
                  "@id": "workmeasure:7a2e3d615d1c",
                  "@type": "WorkMeasure",
                  "measure": "주케이블을 최종적으로 앵커리지에 정착시켜 주는 정착구가 PS강선축에 직각으로 고정되어 있는지를 확인하여야 한다.",
                  "controlLevel": "administrative",
                  "basis": {
                    "basisGuide": "doc:kosha_guide/C-21-2011",
                    "guideSection": "6"
                  }
                },
                {
                  "@id": "workmeasure:656c6926e600",
                  "@type": "WorkMeasure",
                  "measure": "앵커리지에 시공되는 쉬스가 설계도에 따라 정 위치에 정확하게 배치되어 있는지를 확인하여야 한다.",
                  "controlLevel": "administrative",
                  "basis": {
                    "basisGuide": "doc:kosha_guide/C-21-2011",
                    "guideSection": "6"
                  }
                },
                {
                  "@id": "workmeasure:cc8a3def9139",
                  "@type": "WorkMeasure",
                  "measure": "콘크리트 타설시 쉬스내에 콘크리트가 흘러 들어가지 않도록 쉬스단부 및 정착구 부분을 세심하게 주의를 기울여 타설하여야 한다.",
                  "controlLevel": "administrative",
                  "basis": {
                    "basisGuide": "doc:kosha_guide/C-21-2011",
                    "guideSection": "6"
                  }
                },
                {
                  "@id": "workmeasure:bf200fff5567",
                  "@type": "WorkMeasure",
                  "measure": "긴장된 강연선은 부식방지를 위해 가능한 빨리 그라우팅을 실시하여야 한다.",
                  "controlLevel": "administrative",
                  "basis": {
                    "basisGuide": "doc:kosha_guide/C-21-2011",
                    "guideSection": "6"
                  }
                }
              ]
            },
            {
              "@id": "workrisk:현수교/1.2",
              "@type": "WorkRisk",
              "statement": "강재 주탑 앵커볼트·저판 시공 불량으로 주탑이 기울어짐",
              "priority": "★",
              "measures": [
                {
                  "@id": "workmeasure:57d0fe72de5b",
                  "@type": "WorkMeasure",
                  "measure": "주탑 기초에 매설되는 앵커프레임 및 앵커볼트는 주탑의 정밀도에 직접적인 영향을 주기 때문에 정밀측량을 통해 Level을 맞추어야 한다.",
                  "controlLevel": "administrative",
                  "basis": {
                    "basisGuide": "doc:kosha_guide/C-21-2011",
                    "guideSection": "7.1"
                  }
                },
                {
                  "@id": "workmeasure:4558e8684c59",
                  "@type": "WorkMeasure",
                  "measure": "저판(Base plate)을 설치후 저면에 무수축 모르타르로 그라우팅을 실시하는데, 모의시험을 통해 충진율을 반드시 확인하여 시공하여야 한다.",
                  "controlLevel": "administrative",
                  "basis": {
                    "basisGuide": "doc:kosha_guide/C-21-2011",
                    "guideSection": "7.1"
                  }
                },
                {
                  "@id": "workmeasure:c0e9582f774a",
                  "@type": "WorkMeasure",
                  "measure": "탑기부 설치 시 앵커볼트의 나사부분이 변형되지 않도록 반드시 보호캡을 씌워야 한다.",
                  "controlLevel": "engineering",
                  "basis": {
                    "basisGuide": "doc:kosha_guide/C-21-2011",
                    "guideSection": "7.1"
                  }
                },
                {
                  "@id": "workmeasure:b44e0c4d0b57",
                  "@type": "WorkMeasure",
                  "measure": "단블럭을 조립하여 대블럭을 제작하는 경우 단블럭간의 Metal Touch 등을 통해 주탑의 연직도를 확보하여야 한다.",
                  "controlLevel": "administrative",
                  "basis": {
                    "basisGuide": "doc:kosha_guide/C-21-2011",
                    "guideSection": "7.1"
                  }
                },
                {
                  "@id": "workmeasure:9c2fd381f7a8",
                  "@type": "WorkMeasure",
                  "measure": "단블럭 제작 시 주탑의 연직도 확보를 위해 상하단 블록의 높이 차이가 최소화될 수 있도록 하여야 한다.",
                  "controlLevel": "administrative",
                  "basis": {
                    "basisGuide": "doc:kosha_guide/C-21-2011",
                    "guideSection": "7.1"
                  }
                },
                {
                  "@id": "workmeasure:df2eb9bbb950",
                  "@type": "WorkMeasure",
                  "measure": "단블럭 제작 시 용접은 다양한 용접방법을 적용하여 용접변형을 최소화하여야 한다.",
                  "controlLevel": "administrative",
                  "basis": {
                    "basisGuide": "doc:kosha_guide/C-21-2011",
                    "guideSection": "7.1"
                  }
                },
                {
                  "@id": "workmeasure:5457e03bc204",
                  "@type": "WorkMeasure",
                  "measure": "대블럭을 제작하기 위한 단블럭은 설계도면의 제작순서에 따라 제작하여야 한다.",
                  "controlLevel": "administrative",
                  "basis": {
                    "basisGuide": "doc:kosha_guide/C-21-2011",
                    "guideSection": "7.1"
                  }
                },
                {
                  "@id": "workmeasure:313def3ca71d",
                  "@type": "WorkMeasure",
                  "measure": "대블럭간의 볼트체결시 근로자에 대한 사전교육을 통해 와셔(Washer)의 방향이 올바로 시공될 수 있도록 하여야 한다.",
                  "controlLevel": "administrative",
                  "basis": {
                    "basisGuide": "doc:kosha_guide/C-21-2011",
                    "guideSection": "7.1"
                  }
                }
              ]
            }
          ]
