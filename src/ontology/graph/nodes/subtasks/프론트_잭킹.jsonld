          ],
          "risks": [
            {
              "@id": "workrisk:프론트_잭킹/4.5",
              "@type": "WorkRisk",
              "statement": "선단슈 우각부 용접 불량·페이스잭 부적합으로 견인 중 변형·함몰",
              "priority": "★★",
              "measures": [
                {
                  "@id": "workmeasure:bce2d08c3488",
                  "@type": "WorkMeasure",
                  "measure": "선단슈 각 부분의 연결이 잘 되었는지 확인하고, 특히 우각부는 변형에 취약하므로 용접상태를 주의깊게 점검하여야 하며 우각부에 미흡한 점이 있을 때에는 L형강으로 보강하여 견인중에 변형이 없도록 한다.",
                  "controlLevel": "engineering",
                  "basis": {
                    "basisGuide": "doc:kosha_guide/C-81-2013",
                    "guideSection": "5.7"
                  }
                },
                {
                  "@id": "workmeasure:8daa42c43e1d",
                  "@type": "WorkMeasure",
                  "measure": "페이스 잭(face jack)은 막장의 비탈면에 적합하도록 설치하여 굴착·견인 중에 무리가 없도록 하여야 하므로 이에 대한 사전 점검을 실시하여 적합한 위치에 정착되도록 한다.",
                  "controlLevel": "administrative",
                  "basis": {
                    "basisGuide": "doc:kosha_guide/C-81-2013",
                    "guideSection": "5.7"
                  }
                },
                {
                  "@id": "workmeasure:977370600d4f",
                  "@type": "WorkMeasure",
                  "measure": "방향과 수평의 보정 검측은 반드시 매 스트로크마다 행하며 검측결과 뒤틀림 징후가 확인되었을 시 즉시 그 원인을 조사하여 제거하여야 하고 보정은 신속히 처리하여 구조물에 균열이 발생하지 않도록 하여야 한다.",
                  "controlLevel": "administrative",
                  "basis": {
                    "basisGuide": "doc:kosha_guide/C-81-2013",
                    "guideSection": "5.7"
                  }
                }
              ]
            },
            {
              "@id": "workrisk:프론트_잭킹/4.6",
              "@type": "WorkRisk",
              "statement": "굴착 순서를 어겨 흙막이 해체 전 굴착하여 붕괴",
              "priority": "★",
              "measures": [
                {
                  "@id": "workmeasure:303b78555236",
                  "@type": "WorkMeasure",
                  "measure": "굴착은 흙막이공을 해체하고 선단슈가 견인에 의하여 지중에 소정의 심도까지 도달한 후에 행한다.",
                  "controlLevel": "administrative",
                  "basis": {
                    "basisGuide": "doc:kosha_guide/C-81-2013",
                    "guideSection": "5.7"
                  }
                },
                {
                  "@id": "workmeasure:e27eefcf971d",
                  "@type": "WorkMeasure",
                  "measure": "토질이 견고하거나 장애물이 있어서 선단슈 관입에 지장을 줄 경우는 선굴 또는 예측된 장애물을 제거하도록 하여야 하나 안전을 충분히 검토하여 굴착방법, 범위를 결정하거나 또는 장해물 제거 후의 대책을 강구한다.",
                  "controlLevel": "administrative",
                  "basis": {
                    "basisGuide": "doc:kosha_guide/C-81-2013",
                    "guideSection": "5.7"
                  }
                },
                {
                  "@id": "workmeasure:5c62c7dd5055",
                  "@type": "WorkMeasure",
                  "measure": "굴착부에는 반드시 굴착 관리감독자를 지정하고, 관리감독자는 토질 변화에 주의를 하여 신속한 변화에 따른 굴착방법을 관계기관과 협의하여 변경하도록 하여야 한다.",
                  "controlLevel": "administrative",
                  "basis": {
                    "basisGuide": "doc:kosha_guide/C-81-2013",
                    "guideSection": "5.7"
                  }
                }
              ]
            },
            {
              "@id": "workrisk:프론트_잭킹/4.7",
              "@type": "WorkRisk",
              "statement": "견인 중 궤도가 변위되어 열차 운행 사고",
              "priority": "★",
              "measures": [
                {
                  "@id": "workmeasure:9ff0d024e711",
                  "@type": "WorkMeasure",
                  "measure": "구조물을 견인하여 지중관입을 시작한 이후부터 굴진작업은 운행 중인 철도궤도변형을 최소화 할 수 있도록 하고 관계 전문가를 궤도상에 상주시켜 궤도보수의 4원칙(궤도간격, 수준측정, 고저측정, 궤도방향)을 실시한다.",
                  "controlLevel": "administrative",
                  "basis": {
                    "basisGuide": "doc:kosha_guide/C-81-2013",
                    "guideSection": "5.7"
                  }
                },
                {
                  "@id": "workmeasure:c5a052e1bf52",
                  "@type": "WorkMeasure",
                  "measure": "시공 시 강관과 철도 궤도에 설정해 둔 기준점을 측정하여 변위의 조기 발견과 동시에 파이프 루프의 수평이동을 측정을 하여 변위 상태를 지속적으로 감시한다.",
                  "controlLevel": "administrative",
                  "basis": {
                    "basisGuide": "doc:kosha_guide/C-81-2013",
                    "guideSection": "5.7"
                  }
                },
                {
                  "@id": "workmeasure:f4c2f23bd95c",
                  "@type": "WorkMeasure",
                  "measure": "공사의 안전성 및 합리적 관리를 위한 정보를 신속, 정확하게 수집하기 위해서 체계적이고 효율적인 계측계획이 사전에 수립되어야 하고 발진·도달기지의 흙막이 지보공, 반력벽, 파이프 루프 등의 중점 검토해야 하는 장소에 계측장비를 설치하여야 한다.",
                  "controlLevel": "administrative",
                  "basis": {
                    "basisGuide": "doc:kosha_guide/C-81-2013",
                    "guideSection": "4"
                  }
                }
              ]
            },
            {
              "@id": "workrisk:프론트_잭킹/4.8",
              "@type": "WorkRisk",
              "statement": "구조물 강도 부족으로 견인 중 파단",
              "priority": "★",
              "measures": [
                {
                  "@id": "workmeasure:062509409b59",
                  "@type": "WorkMeasure",
                  "measure": "견인되는 구조물은 PS 강연선에 의하여 견인되므로 충분한 콘크리트 강도를 확보하여야 하며 선단슈는 견인구체와 일체가 되도록 설치한다.",
                  "controlLevel": "engineering",
                  "basis": {
                    "basisGuide": "doc:kosha_guide/C-81-2013",
                    "guideSection": "5.6"
                  }
                },
                {
                  "@id": "workmeasure:b522de1dcea4",
                  "@type": "WorkMeasure",
                  "measure": "구조물 시공계획서에는 거푸집, 동바리 구조 검토에 의한 조립도 작성 및 해체 시기, 콘크리트 타설 순서 및 방법 등을 상세히 기재해야 한다.",
                  "controlLevel": "administrative",
                  "basis": {
                    "basisGuide": "doc:kosha_guide/C-81-2013",
                    "guideSection": "5.6"
                  }
                },
                {
                  "@id": "workmeasure:7e048d083e64",
                  "@type": "WorkMeasure",
                  "measure": "쉬스관은 편심이 없게 구조물 콘크리트 벽의 중심에 정확히 배치하고 별도의 받침용 철근을 종방향 철근에 결속시켜 견고히 연결한다.",
                  "controlLevel": "engineering",
                  "basis": {
                    "basisGuide": "doc:kosha_guide/C-81-2013",
                    "guideSection": "5.6"
                  }
                },
                {
                  "@id": "workmeasure:a19e3c6c721c",
                  "@type": "WorkMeasure",
                  "measure": "설계 또는 시공계획에서 정해져 있지 않는 시공이음을 두려는 경우는 구조물의 강도와 외관을 해치지 않도록 위치, 방향 및 시공방법을 정해야 한다.",
                  "controlLevel": "administrative",
                  "basis": {
                    "basisGuide": "doc:kosha_guide/C-81-2013",
                    "guideSection": "5.6"
                  }
                },
                {
                  "@id": "workmeasure:dea64f84fb31",
                  "@type": "WorkMeasure",
                  "measure": "거푸집 단면은 축선에 대해 바른 각도를 유지하도록 정확하게 조립하며 특히 분할견인의 경우는 끌어당길 때 구조물 상호의 간격이 균일하여야 한다.",
                  "controlLevel": "engineering",
                  "basis": {
                    "basisGuide": "doc:kosha_guide/C-81-2013",
                    "guideSection": "5.6"
                  }
                },
                {
                  "@id": "workmeasure:9fc37dc98e98",
                  "@type": "WorkMeasure",
                  "measure": "거푸집의 제작은 발진대에 조립된 선단슈를 기준으로 하여 조립하여야 한다.",
                  "controlLevel": "administrative",
                  "basis": {
                    "basisGuide": "doc:kosha_guide/C-81-2013",
                    "guideSection": "5.6"
                  }
                },
                {
                  "@id": "workmeasure:f55f29eb0f50",
                  "@type": "WorkMeasure",
                  "measure": "구조물제작을 위한 발진대 및 선단슈는 똑같이 수평과 방향의 정도에 크게 영향을 미치므로 세심한 주의를 기울여 시공하여야 한다.",
                  "controlLevel": "administrative",
                  "basis": {
                    "basisGuide": "doc:kosha_guide/C-81-2013",
                    "guideSection": "5.6"
                  }
                },
                {
                  "@id": "workmeasure:65a3b95dc64d",
                  "@type": "WorkMeasure",
                  "measure": "구조물의 마찰저항은 최대한 경감할 필요가 있으므로 콘크리트표면은 충분히 평활하게 하여야 한다.",
                  "controlLevel": "engineering",
                  "basis": {
                    "basisGuide": "doc:kosha_guide/C-81-2013",
                    "guideSection": "5.6"
                  }
                }
              ]
            },
            {
              "@id": "workrisk:프론트_잭킹/4.9",
              "@type": "WorkRisk",
              "statement": "해체·되메우기 중 순서를 어겨 붕괴하거나 감전",
              "priority": "★",
              "measures": [
                {
                  "@id": "workmeasure:012a3f1bdb94",
                  "@type": "WorkMeasure",
                  "measure": "해체 작업 시에는 현장 주변상황, 해체시기ㆍ해체방법ㆍ해체순서, 해체작업에 따른 투입인력ㆍ투입장비ㆍ보조기구 사용계획, 이동식 전기기계ㆍ기구 사용에 따른 감전재해예방계획, 해체 작업용 가시설 설치계획의 작업계획을 수립하고 이를 해당 근로자에게 주지시키고 관리감독자의 작업지휘에 의하여 작업을 진행하여야 한다.",
                  "controlLevel": "administrative",
                  "basis": {
                    "basisGuide": "doc:kosha_guide/C-81-2013",
                    "guideSection": "5.8"
                  }
                },
                {
                  "@id": "workmeasure:8061aa7c8c82",
                  "@type": "WorkMeasure",
                  "measure": "되메우기는 양질의 토사를 사용하여 주변지반 및 구조물에 영향을 미치지 않도록 충분한 다짐을 실시하여 원상복구 하여야 한다.",
                  "controlLevel": "administrative",
                  "basis": {
                    "basisGuide": "doc:kosha_guide/C-81-2013",
                    "guideSection": "5.8"
                  }
                },
                {
                  "@id": "workmeasure:326edd5dd7b3",
                  "@type": "WorkMeasure",
                  "measure": "관리감독자는 사전에 근로자에게 프론트 잭킹 공법에 대한 기술과 안전교육을 실시하도록 하여야 하며 보호구의 착용상태를 항시 감시하고, 무너짐의 위험이 있다고 판단된 경우에는 작업의 중지, 관계자 이외의 자의 출입통제 등이 이루어져야 한다.",
                  "controlLevel": "administrative",
                  "basis": {
                    "basisGuide": "doc:kosha_guide/C-81-2013",
                    "guideSection": "4"
                  }
                }
              ]
            }
