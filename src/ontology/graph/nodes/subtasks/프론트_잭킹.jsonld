          "risks": [
            {
              "@id": "workrisk:프론트_잭킹/1.3",
              "@type": "WorkRisk",
              "statement": "기지 상부의 자재·토사가 굴착저면으로 떨어져 근로자가 맞음",
              "priority": "★",
              "measures": [
                {
                  "@id": "workmeasure:c1aa1ab7cac8",
                  "@type": "WorkMeasure",
                  "measure": "발진ㆍ도달기지 주변 상부에는 불필요한 토사, 자재, 공구 등이 기지 내부로 떨어지는 일이 없도록 정리 정돈하여 항상 안전하고 청결한 상태를 유지하도록 하여야 한다.",
                  "controlLevel": "administrative",
                  "basis": {
                    "basisGuide": "doc:kosha_guide/C-81-2013",
                    "guideSection": "5.1"
                  }
                },
                {
                  "@id": "workmeasure:f0d94bfa3c4b",
                  "@type": "WorkMeasure",
                  "measure": "파일 인양작업시 권상용 와이어로프 손상, 변형여부를 수시로 점검하고 파일 권상 시 빠지지 않도록 휘말아달기 또는 2줄 걸이 실시한다.",
                  "controlLevel": "administrative",
                  "basis": {
                    "basisGuide": "doc:kosha_guide/C-81-2013",
                    "guideSection": "5.1"
                  }
                }
              ]
            }
          ]
