  "steps": [
    {
      "stepName": "NTR 발진기지 설치",
      "stepHazards": [
        {
          "hazardLabel": "물체에 맞음",
          "basis": [
            {
              "guide": "doc:kosha_guide/C-88-2013",
              "section": "6.1.3",
              "controlLevel": "engineering"
            },
            {
              "guide": "doc:kosha_guide/C-88-2013",
              "section": "6.1.2",
              "controlLevel": "engineering"
            },
            {
              "guide": "doc:kosha_guide/C-88-2013",
              "section": "6.1.2",
              "controlLevel": "administrative"
            }
          ],
          "hazard": "hazard:fall_object",
          "risks": [
            {
              "statement": "반력벽 지내력·구조가 부족하여 강관 추진 반력에 파손",
              "priority": "★",
              "measures": [
                {
                  "measure": "반력벽은 해당분야 전문가의 구조검토를 통해 강관추진 시 사용되는 유압잭의 최대압력과 소요의 안전율을 고려한 설계압력에 저항할 수 있는 적절한 크기의 구조물로 설계하여야 한다.",
                  "controlLevel": "engineering",
                  "basis": {
                    "guide": "doc:kosha_guide/C-88-2013",
                    "section": "6.1.2"
                  }
                },
                {
                  "measure": "반력벽은 침하가 발생되지 않는 충분한 지내력을 가진 기초위에 설치하여야 한다.",
                  "controlLevel": "engineering",
                  "basis": {
                    "guide": "doc:kosha_guide/C-88-2013",
                    "section": "6.1.2"
                  }
                },
                {
                  "measure": "반력벽을 시공하기 전에 설계도서와 현장조건 등이 적정한 지에 대한 검토를 하여야 한다.",
                  "controlLevel": "administrative",
                  "basis": {
                    "guide": "doc:kosha_guide/C-88-2013",
                    "section": "6.1.2"
                  }
                }
              ]
            },
            {
              "statement": "추진틀이 침하·변형되어 강관이 이탈",
              "priority": "★",
              "measures": [
                {
                  "measure": "추진틀은 강관 및 유압잭 자중에 의한 침하가 발생되지 않도록 견고한 지반에 콘크리트를 타설한 기초위에 설치하여야 한다.",
                  "controlLevel": "engineering",
                  "basis": {
                    "guide": "doc:kosha_guide/C-88-2013",
                    "section": "6.1.3"
                  }
                },
                {
                  "measure": "유압잭 작동 시 수평 및 수직강도를 유지할 수 있도록 견고한 구조로 추진틀을 제작 설치하여야 한다.",
                  "controlLevel": "engineering",
                  "basis": {
                    "guide": "doc:kosha_guide/C-88-2013",
                    "section": "6.1.3"
                  }
                },
                {
                  "measure": "추진틀의 연결은 볼트 또는 용접으로 견고하게 연결하여 강관 추진 시 받침대의 변형을 방지하여야 한다.",
                  "controlLevel": "engineering",
                  "basis": {
                    "guide": "doc:kosha_guide/C-88-2013",
                    "section": "6.1.3"
                  }
                },
                {
                  "measure": "강관 추진 시 레일이 반력벽에 밀착될 수 있도록 반력벽과 레일의 공간이 발생되지 않도록 하여야 한다.",
                  "controlLevel": "engineering",
                  "basis": {
                    "guide": "doc:kosha_guide/C-88-2013",
                    "section": "6.1.3"
                  }
                }
              ]
            }
          ]
        },
        {
          "hazardLabel": "무너짐",
          "basis": [
            {
              "guide": "doc:kosha_guide/C-88-2013",
              "section": "6.1.1",
              "controlLevel": "engineering"
            },
            {
              "guide": "doc:kosha_guide/C-88-2013",
              "section": "6.1.1",
              "controlLevel": "administrative"
            },
            {
              "guide": "doc:kosha_guide/C-88-2013",
              "section": "6.1.1",
              "controlLevel": "elimination"
            },
            {
              "guide": "doc:kosha_guide/C-88-2013",
              "section": "6.1.1",
              "controlLevel": "substitution"
            }
          ],
          "hazard": "hazard:cave_in",
          "risks": [
            {
              "statement": "발진기지 흙막이가 무너져 근로자가 매몰",
              "priority": "★★",
              "measures": [
                {
                  "measure": "흙막이 가시설 설계내용이 현장조건과 부합되는지 여부에 대하여 공사중에 설계자로 하여금 확인토록 하여야 하고 이상이 있을 경우에는 적합한 대책을 수립하여야 한다.",
                  "controlLevel": "administrative",
                  "basis": {
                    "guide": "doc:kosha_guide/C-88-2013",
                    "section": "6.1.1"
                  }
                },
                {
                  "measure": "버팀대는 좌우 흙막이의 토압이 균형을 이룬 상태에서 실시하고 정확히 수평이 되도록 정밀하게 설치하여야 한다.",
                  "controlLevel": "engineering",
                  "basis": {
                    "guide": "doc:kosha_guide/C-88-2013",
                    "section": "6.1.1"
                  }
                },
                {
                  "measure": "띠장은 끊어짐이 없이 연속해서 설치하고 띠장의 이음은 원칙적으로 파일의 중심으로 전단력과 휨모멘트가 작은 곳에서 실시하여야 한다.",
                  "controlLevel": "engineering",
                  "basis": {
                    "guide": "doc:kosha_guide/C-88-2013",
                    "section": "6.1.1"
                  }
                },
                {
                  "measure": "토류판은 흙막이 벽면과 밀착되게 하고 각 토류판 사이에 틈새가 발생하지 않도록 설치하여야 한다.",
                  "controlLevel": "engineering",
                  "basis": {
                    "guide": "doc:kosha_guide/C-88-2013",
                    "section": "6.1.1"
                  }
                },
                {
                  "measure": "재사용 토류판과 이음처리가 된 토류판은 사용하지 말아야 한다.",
                  "controlLevel": "substitution",
                  "basis": {
                    "guide": "doc:kosha_guide/C-88-2013",
                    "section": "6.1.1"
                  }
                },
                {
                  "measure": "파일의 선단은 설계도서에 의거 충분한 근입깊이를 확보하여야 한다.",
                  "controlLevel": "engineering",
                  "basis": {
                    "guide": "doc:kosha_guide/C-88-2013",
                    "section": "6.1.1"
                  }
                }
              ]
            },
            {
              "statement": "천공 구멍을 방치하거나 천공 후 근입이 늦어 주변지반이 침하",
              "priority": "★",
              "measures": [
                {
                  "measure": "천공 시 주변지반의 침하 등이 발생되는 경우에는 케이싱 설치 등의 방법으로 시공하고 천공 즉시 근입시켜야 하며 천공구멍은 덮개 등으로 방호조치를 하여야 한다.",
                  "controlLevel": "elimination",
                  "basis": {
                    "guide": "doc:kosha_guide/C-88-2013",
                    "section": "6.1.1"
                  }
                },
                {
                  "measure": "파일을 설치 후 천공구멍은 양질의 토사, 모래, 소일 시멘트(Soil cement) 등으로 완전히 충진시킨 후에 후속공정을 시행하여야 한다.",
                  "controlLevel": "engineering",
                  "basis": {
                    "guide": "doc:kosha_guide/C-88-2013",
                    "section": "6.1.1"
                  }
                },
                {
                  "measure": "파일을 이음할 경우에는 응력이 최소가 되는 곳에서 하되 지중에서 동일 높이는 피하여야 한다.",
                  "controlLevel": "engineering",
                  "basis": {
                    "guide": "doc:kosha_guide/C-88-2013",
                    "section": "6.1.1"
                  }
                },
                {
                  "measure": "파일의 이음은 흙, 녹 등 이물질을 제거한 후 용접을 실시하여야 하며 용접이음부는 모재의 응력 부담능력 이상이 되도록 시행하여야 한다.",
                  "controlLevel": "engineering",
                  "basis": {
                    "guide": "doc:kosha_guide/C-88-2013",
                    "section": "6.1.1"
                  }
                }
              ]
            }
          ]
        },
        {
          "hazardLabel": "감전",
          "basis": [
            {
              "guide": "doc:kosha_guide/C-88-2013",
              "section": "6.1.1",
              "controlLevel": "engineering"
            }
          ],
          "hazard": "hazard:electric_shock",
          "risks": [
            {
              "statement": "크레인 붐이 고압전선에 근접하여 감전",
              "priority": "★★",
              "measures": [
                {
                  "measure": "흙막이 가시설 설치 작업장 주변에서 크레인작업 시 크레인 붐대와 고압전선 및 고압전주의 근접에 의한 감전사고 위험이 있을 때에는 이설 및 방호관, 방책 설치, 신호수 배치 등 감전사고 발생방지에 필요한 대책을 수립하여야 한다.",
                  "controlLevel": "engineering",
                  "basis": {
                    "guide": "doc:kosha_guide/C-88-2013",
                    "section": "6.1.1"
                  }
                }
              ]
            }
          ]
        },
        {
          "hazardLabel": "깔림",
          "basis": [
            {
              "guide": "doc:kosha_guide/C-88-2013",
              "section": "6.1.1",
              "controlLevel": "engineering"
            }
          ],
          "hazard": "hazard:struck_by_overturn",
          "risks": [
            {
              "statement": "천공장비가 전도되어 근로자가 깔림",
              "priority": "★",
              "measures": [
                {
                  "measure": "천공장비는 파일위치에 정확히 위치시키고 작업중 전도되지 않도록 아웃트리거 하부에 받침목 등을 설치하여야 한다.",
                  "controlLevel": "engineering",
                  "basis": {
                    "guide": "doc:kosha_guide/C-88-2013",
                    "section": "6.1.1"
                  }
                }
              ]
            }
          ]
        },
        {
          "hazardLabel": "화재·폭발",
          "basis": [
            {
              "guide": "doc:kosha_guide/C-88-2013",
              "section": "5",
              "controlLevel": "administrative"
            },
            {
              "guide": "doc:kosha_guide/C-88-2013",
              "section": "6.1.1",
              "controlLevel": "elimination"
            }
          ],
          "hazard": "hazard:fire_explosion",
          "risks": [
            {
              "statement": "지장물을 확인하지 않고 흙막이 공사를 착수하여 매설물을 손괴",
              "priority": "★",
              "measures": [
                {
                  "measure": "흙막이 공사에 앞서 지장물(지하 매설물, 가공선, 매설관, 기설 구조물 등)의 유무를 확인하고 이설이 필요한 경우에는 소관 부처와 협의하여야 한다.",
                  "controlLevel": "elimination",
                  "basis": {
                    "guide": "doc:kosha_guide/C-88-2013",
                    "section": "6.1.1"
                  }
                },
                {
                  "measure": "설계도서와 현장조건이 일치하는지의 여부를 확인하고 추진강관의 제원ㆍ설계 기울기ㆍ추진거리ㆍ추진기지 규모ㆍ장애물 및 지장물의 종류, 발진기지와 주변도로 상황, 전원설비ㆍ굴착ㆍ운반 등 잔토처리 설비ㆍ그라우팅 설비, 용접기구, 기계장비를 사전에 검토하여야 한다.",
                  "controlLevel": "administrative",
                  "basis": {
                    "guide": "doc:kosha_guide/C-88-2013",
                    "section": "5"
                  }
                },
                {
                  "measure": "작업전 관리감독자는 위험성 평가를 실시하여 유해 위험요소를 확인하고 작업 중에도 관리감독을 철저히 하여 재해예방을 하여야 한다.",
                  "controlLevel": "administrative",
                  "basis": {
                    "guide": "doc:kosha_guide/C-88-2013",
                    "section": "5"
                  }
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "stepName": "NTR 강관 추진 및 굴착",
      "stepHazards": [
        {
          "hazardLabel": "무너짐",
          "basis": [
            {
              "guide": "doc:kosha_guide/C-88-2013",
              "section": "6.2",
              "controlLevel": "administrative"
            },
            {
              "guide": "doc:kosha_guide/C-88-2013",
              "section": "6.2",
              "controlLevel": "engineering"
            },
            {
              "guide": "doc:kosha_guide/C-88-2013",
              "section": "6.3",
              "controlLevel": "administrative"
            },
            {
              "guide": "doc:kosha_guide/C-88-2013",
              "section": "6.3",
              "controlLevel": "engineering"
            },
            {
              "guide": "doc:kosha_guide/C-88-2013",
              "section": "5",
              "controlLevel": "engineering"
            },
            {
              "guide": "doc:kosha_guide/C-88-2013",
              "section": "6.2",
              "controlLevel": "elimination"
            }
          ],
          "hazard": "hazard:cave_in",
          "risks": [
            {
              "statement": "강관 내부 굴착 중 지하수 유출로 막장이 무너져 근로자가 묻힘",
              "priority": "★★",
              "measures": [
                {
                  "measure": "강관내부 굴착 시 지반 및 지하수 상태를 항상 확인하여야 하며 굴착에 따른 지하수의 유출 등으로 막장에서의 무너짐 및 묻힘 등의 우려가 있을 경우에는 차수 그라우팅을 실시한 후 굴착하여야 하고 항상 안전대책을 수립하여야 한다.",
                  "controlLevel": "elimination",
                  "basis": {
                    "guide": "doc:kosha_guide/C-88-2013",
                    "section": "6.2"
                  }
                },
                {
                  "measure": "굴착작업이 종료된 후에는 견고하게 제작된 막장안정 관마개를 막장 토사의 붕괴방지를 위해 관주변부에 빈공간이 발생하지 않도록 밀실하게 설치하고 강관에 견고하게 용접하여야 한다.",
                  "controlLevel": "engineering",
                  "basis": {
                    "guide": "doc:kosha_guide/C-88-2013",
                    "section": "6.2"
                  }
                },
                {
                  "measure": "굴착 시 여굴이 발생되면 공사 진행중이거나 공사 완료 후 상부 구조물 및 도로 등의 침하가 우려되고 구조물에도 심각한 영향을 줄 수 있기 때문에 선굴착없이 강관 추진 후 굴착, 작업 종료시 굴착이 없는 관추진만 하고 중단, 굴착후에도 흙막이용 토사를 남겨둠 등의 여굴 방지대책을 참고하여 여굴이 발생하지 않도록 주의하여야 한다.",
                  "controlLevel": "administrative",
                  "basis": {
                    "guide": "doc:kosha_guide/C-88-2013",
                    "section": "6.2"
                  }
                },
                {
                  "measure": "굴착방법, 반출 토사량을 기준으로 1일 강관압입량을 결정하여야 한다.",
                  "controlLevel": "administrative",
                  "basis": {
                    "guide": "doc:kosha_guide/C-88-2013",
                    "section": "6.2"
                  }
                },
                {
                  "measure": "지반조건 등을 고려하여 인력굴착 및 기계굴착 방법을 결정하여야 한다.",
                  "controlLevel": "administrative",
                  "basis": {
                    "guide": "doc:kosha_guide/C-88-2013",
                    "section": "6.2"
                  }
                }
              ]
