          "risks": [
            {
              "@id": "workrisk:작업의자형_달비계/2.1",
              "@type": "WorkRisk",
              "statement": "고정점의 강도·수량이 부족하여 뽑히면서 추락",
              "priority": "★★",
              "measures": [
                {
                  "@id": "workmeasure:4116110a5153",
                  "@type": "WorkMeasure",
                  "measure": "작업용 섬유로프는 콘크리트에 매립된 고리, 건축물의 콘크리트 또는 철재 구조물 등 2개 이상의 견고한 고정점에 풀리지 않도록 결속한다",
                  "controlLevel": "engineering",
                  "basis": {
                    "basisArticle": "art:기준규칙:63",
                    "paragraph": 2,
                    "item": 3
                  }
                },
                {
                  "@id": "workmeasure:399b610fdedb",
                  "@type": "WorkMeasure",
                  "measure": "작업하는 근로자의 하중을 견딜 수 있을 정도의 강도를 가진 작업용 섬유로프, 구명줄 및 고정점을 사용한다",
                  "controlLevel": "engineering",
                  "basis": {
                    "basisArticle": "art:기준규칙:63",
                    "paragraph": 2,
                    "item": 5
                  }
                },
                {
                  "@id": "workmeasure:7f02a3d171a5",
                  "@type": "WorkMeasure",
                  "measure": "작업용 로프와 구명줄은 각각 별도의 고정점에 묶어야 하며 고정점은 2,340 kgf 이상을 지지할 수 있어야 한다",
                  "controlLevel": "engineering",
                  "basis": {
                    "basisGuide": "doc:kosha_guide/D-C-7-2026",
                    "guideSection": "7.3.7"
                  }
                },
                {
                  "@id": "workmeasure:70ce806026e8",
                  "@type": "WorkMeasure",
                  "measure": "로프 고정용 고리는 옥상 구조물 공사 시 매입 설치하고, 매입하는 로프 고정용 고리 설치간격은 3m 내외가 적당하다",
                  "controlLevel": "engineering",
                  "basis": {
                    "basisGuide": "doc:kosha_guide/D-C-7-2026",
                    "guideSection": "7.3.3"
                  }
                },
                {
                  "@id": "workmeasure:f6f8cd8d8cea",
                  "@type": "WorkMeasure",
                  "measure": "고리를 매입할 때 고리 앵커를 구조물의 철근에 용접하거나 고리 앵커 홀에 철근을 관통시키는 방법으로 고정하여 로프를 결속하였을 때 고리가 뽑히는 일이 없도록 한다",
                  "controlLevel": "engineering",
                  "basis": {
                    "basisGuide": "doc:kosha_guide/D-C-7-2026",
                    "guideSection": "7.3.3"
                  }
                },
                {
                  "@id": "workmeasure:3c74b73f31c2",
                  "@type": "WorkMeasure",
                  "measure": "철재구조물을 이용할 때에는 철저한 점검을 통하여 부식이 되었거나 연결부위의 처리가 불량한 곳에는 달비계를 고정하지 않도록 한다",
                  "controlLevel": "administrative",
                  "basis": {
                    "basisGuide": "doc:kosha_guide/D-C-7-2026",
                    "guideSection": "7.3.3"
                  }
                }
              ]
            },
            {
              "@id": "workrisk:작업의자형_달비계/2.2",
              "@type": "WorkRisk",
              "statement": "작업용 로프와 구명줄을 같은 고정점에 묶어 동시에 상실됨",
              "priority": "★★",
              "measures": [
                {
                  "@id": "workmeasure:ef43596cd143",
                  "@type": "WorkMeasure",
                  "measure": "작업용 섬유로프와 구명줄은 다른 고정점에 결속되도록 한다",
                  "controlLevel": "engineering",
                  "basis": {
                    "basisArticle": "art:기준규칙:63",
                    "paragraph": 2,
                    "item": 4
                  }
                },
                {
                  "@id": "workmeasure:dbebca1d7c8f",
                  "@type": "WorkMeasure",
                  "measure": "하나의 고정점에 작업용 로프와 구명줄이 동시에 결속되지 않도록 충분한 수량의 고정점을 설치한다",
                  "controlLevel": "engineering",
                  "basis": {
                    "basisGuide": "doc:kosha_guide/D-C-7-2026",
                    "guideSection": "7.3.4"
                  }
                },
                {
                  "@id": "workmeasure:687d11f48896",
                  "@type": "WorkMeasure",
                  "measure": "안전대를 지지하는 구명줄 고정점은 작업용 로프를 지지하는 고정점과 별도로 고정점을 확보하여 안전대를 지지하는 구명줄을 지지하도록 한다",
                  "controlLevel": "engineering",
                  "basis": {
                    "basisGuide": "doc:kosha_guide/D-C-7-2026",
                    "guideSection": "7.3.7"
                  }
                }
              ]
            },
            {
              "@id": "workrisk:작업의자형_달비계/2.3",
              "@type": "WorkRisk",
              "statement": "고정점이 없는 옥상에서 임시 결속하여 이탈로 추락",
              "priority": "★★",
              "measures": [
                {
                  "@id": "workmeasure:e8efe031b01b",
                  "@type": "WorkMeasure",
                  "measure": "로프용 고리 및 구조물이 없는 옥상, 지붕에서는 작업용 로프, 구명줄을 결속할 수 있는 철물 등을 설치하여 고정점을 확보한다",
                  "controlLevel": "engineering",
                  "basis": {
                    "basisGuide": "doc:kosha_guide/D-C-7-2026",
                    "guideSection": "7.3.4"
                  }
                },
                {
                  "@id": "workmeasure:265c69cd806c",
                  "@type": "WorkMeasure",
                  "measure": "철물 등 고정점은 앵커로 고정하는 등 작업 중 이탈되지 않도록 견고하게 설치하여야 하며, 작업하중을 충분히 지지할 수 있어야 한다",
                  "controlLevel": "engineering",
                  "basis": {
                    "basisGuide": "doc:kosha_guide/D-C-7-2026",
                    "guideSection": "7.3.4"
                  }
                },
                {
                  "@id": "workmeasure:6e81aa3b5ae1",
                  "@type": "WorkMeasure",
                  "measure": "지붕 또는 옥상의 돌출물 등과 같은 콘크리트 구조물을 이용할 경우에는 로프와 모서리의 접촉면을 고무패드 등으로 보호하고 구조물 위로 로프가 벗겨지는 것을 방지하기 위하여 못이나 앵글 등을 이용 로프를 고정시킨다",
                  "controlLevel": "engineering",
                  "basis": {
                    "basisGuide": "doc:kosha_guide/D-C-7-2026",
                    "guideSection": "7.3.3"
                  }
                },
                {
                  "@id": "workmeasure:d68fa29f7962",
                  "@type": "WorkMeasure",
                  "measure": "지붕 또는 옥상의 철골구조물이나 냉각탑, 계단의 난간이나 철재 파이프 같은 철재 구조물은 구조물의 상황에 따라 안전성이 큰 차이를 보일 수 있으므로 강도가 충분하고 로프가 벗겨지지 않은 구조물을 선택한다",
                  "controlLevel": "administrative",
