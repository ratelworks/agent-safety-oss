          "risks": [
            {
              "@id": "workrisk:작업의자형_달비계/1.1",
              "@type": "WorkRisk",
              "statement": "사전 점검 없이 손상된 철물·카라비너를 사용하여 이탈로 추락",
              "priority": "★★",
              "measures": [
                {
                  "@id": "workmeasure:aab2e293a592",
                  "@type": "WorkMeasure",
                  "measure": "고리, 안전대, 카라비너, 샤클 등 철물은 손상되거나 부서지거나 휘어지면 안 되며, 날카로운 모서리, 틈, 닳은 부분, 녹 등이 없어야 한다",
                  "controlLevel": "administrative",
                  "basis": {
                    "basisGuide": "doc:kosha_guide/D-C-7-2026",
                    "guideSection": "7.3.7"
                  }
                },
                {
                  "@id": "workmeasure:9702162b9861",
                  "@type": "WorkMeasure",
                  "measure": "카라비너의 후크는 자유롭게 움직이고 닫힐 때 자동으로 잠겨야 한다",
                  "controlLevel": "administrative",
                  "basis": {
                    "basisGuide": "doc:kosha_guide/D-C-7-2026",
                    "guideSection": "7.3.7"
                  }
                },
                {
                  "@id": "workmeasure:63e252275394",
                  "@type": "WorkMeasure",
                  "measure": "작업자는 작업계획을 충분히 숙지하고 작업용 로프 및 구명줄, 작업대와 샤클 등 달비계 작업에 필요한 설비와 추락방지에 필요한 안전대 등에 대한 사전 점검을 실시한다",
                  "controlLevel": "administrative",
                  "basis": {
                    "basisGuide": "doc:kosha_guide/D-C-7-2026",
                    "guideSection": "7.3.7"
                  }
                },
                {
                  "@id": "workmeasure:808634095164",
                  "@type": "WorkMeasure",
                  "measure": "검사결과 불안전하거나 결함이 있는 달비계 또는 추락방지 설비는 제거 또는 폐기한다",
                  "controlLevel": "administrative",
                  "basis": {
                    "basisGuide": "doc:kosha_guide/D-C-7-2026",
                    "guideSection": "7.3.7"
                  }
                },
                {
                  "@id": "workmeasure:01b3dc10132b",
                  "@type": "WorkMeasure",
                  "measure": "검사를 실시한 후 날짜와 결과를 기록하여 보관한다",
                  "controlLevel": "administrative",
                  "basis": {
                    "basisGuide": "doc:kosha_guide/D-C-7-2026",
                    "guideSection": "7.3.7"
                  }
                }
              ]
            },
            {
              "@id": "workrisk:작업의자형_달비계/1.2",
              "@type": "WorkRisk",
              "statement": "결함이 있는 작업용 섬유로프·섬유벨트를 사용하여 절단으로 추락",
              "priority": "★★",
              "measures": [
                {
                  "@id": "workmeasure:2ba843e20f48",
                  "@type": "WorkMeasure",
                  "measure": "꼬임이 끊어진 작업용 섬유로프 또는 안전대의 섬유벨트를 달비계에 사용하지 않는다",
                  "controlLevel": "elimination",
                  "basis": {
                    "basisArticle": "art:기준규칙:63",
                    "paragraph": 2,
                    "item": 9,
                    "subitem": "가"
                  }
                },
                {
                  "@id": "workmeasure:71868b49c73e",
                  "@type": "WorkMeasure",
                  "measure": "심하게 손상되거나 부식된 작업용 섬유로프 또는 안전대의 섬유벨트를 달비계에 사용하지 않는다",
                  "controlLevel": "elimination",
                  "basis": {
                    "basisArticle": "art:기준규칙:63",
                    "paragraph": 2,
                    "item": 9,
                    "subitem": "나"
                  }
                },
                {
                  "@id": "workmeasure:d94e55de9deb",
                  "@type": "WorkMeasure",
                  "measure": "2개 이상의 작업용 섬유로프 또는 섬유벨트를 연결한 것을 달비계에 사용하지 않는다",
                  "controlLevel": "elimination",
                  "basis": {
                    "basisArticle": "art:기준규칙:63",
                    "paragraph": 2,
                    "item": 9,
                    "subitem": "다"
                  }
                },
                {
                  "@id": "workmeasure:fbb6377405a7",
                  "@type": "WorkMeasure",
                  "measure": "작업높이보다 길이가 짧은 작업용 섬유로프 또는 섬유벨트를 달비계에 사용하지 않는다",
                  "controlLevel": "elimination",
                  "basis": {
                    "basisArticle": "art:기준규칙:63",
                    "paragraph": 2,
                    "item": 9,
                    "subitem": "라"
                  }
                },
                {
                  "@id": "workmeasure:3937c5676588",
                  "@type": "WorkMeasure",
                  "measure": "로프는 헤지거나 소선의 절단, 마모 또는 불타거나 변색된 부분이 없어야 한다",
                  "controlLevel": "administrative",
                  "basis": {
                    "basisGuide": "doc:kosha_guide/D-C-7-2026",
                    "guideSection": "7.3.7"
                  }
                },
                {
                  "@id": "workmeasure:dbcd9008e9d0",
                  "@type": "WorkMeasure",
                  "measure": "그을리거나 변색되거나 물러진 부분 등 화학적 또는 열에 의한 손상 여부와 로프 표면의 변색과 터짐 등 자외선에 의한 손상을 확인한다",
                  "controlLevel": "administrative",
                  "basis": {
                    "basisGuide": "doc:kosha_guide/D-C-7-2026",
                    "guideSection": "7.3.7"
                  }
                }
              ]
            },
            {
              "@id": "workrisk:작업의자형_달비계/1.3",
              "@type": "WorkRisk",
              "statement": "강도가 부족하거나 균열된 작업대를 사용하여 파손으로 추락",
              "priority": "★★",
              "measures": [
                {
                  "@id": "workmeasure:430eedd44ac7",
                  "@type": "WorkMeasure",
                  "measure": "달비계의 작업대는 나무 등 근로자의 하중을 견딜 수 있는 강도의 재료를 사용하여 견고한 구조로 제작한다",
                  "controlLevel": "engineering",
                  "basis": {
                    "basisArticle": "art:기준규칙:63",
                    "paragraph": 2,
                    "item": 1
                  }
                },
                {
                  "@id": "workmeasure:1a3ac506f85f",
                  "@type": "WorkMeasure",
                  "measure": "작업대의 나무판을 검사하여 나무의 균열여부를 확인하고, 거친 모서리나 홈은 갈라짐을 야기할 수 있으므로 주의하여 검사한다",
                  "controlLevel": "administrative",
                  "basis": {
                    "basisGuide": "doc:kosha_guide/D-C-7-2026",
                    "guideSection": "7.3.7"
                  }
                },
                {
                  "@id": "workmeasure:e0e49e493b3c",
                  "@type": "WorkMeasure",
                  "measure": "작업대의 변형, 손상 등 접합부의 상태에 대한 이상 유무를 검사한다",
                  "controlLevel": "administrative",
                  "basis": {
                    "basisGuide": "doc:kosha_guide/D-C-7-2026",
                    "guideSection": "7.3.7"
                  }
                }
              ]
            },
            {
              "@id": "workrisk:작업의자형_달비계/1.4",
              "@type": "WorkRisk",
              "statement": "악천후에 작업을 강행하여 로프가 흔들려 추락",
              "priority": "★★",
              "measures": [
                {
                  "@id": "workmeasure:29b584529418",
                  "@type": "WorkMeasure",
                  "measure": "비, 눈, 그 밖의 기상상태의 불안정으로 날씨가 몹시 나쁜 경우에는 달비계의 작업을 중지한다",
                  "controlLevel": "elimination",
                  "basis": {
                    "basisGuide": "doc:kosha_guide/D-C-7-2026",
                    "guideSection": "7.3.7"
                  }
                }
              ]
            }
          ]
        }
      ]
    },
