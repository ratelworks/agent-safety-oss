          ],
          "risks": [
            {
              "@id": "workrisk:Shield_TBM/1.1",
              "@type": "WorkRisk",
              "statement": "지질·지장물 조사 없이 착수하여 굴착 중 지하매설물을 손괴하거나 붕괴",
              "priority": "★★",
              "measures": [
                {
                  "@id": "workmeasure:e4260f638679",
                  "@type": "WorkMeasure",
                  "measure": "공사 위치에 대한 지질조사 및 주변 지장물 조사를 실시하고 공사에 필요한 가설전기 설치위치 선정 등의 사항에 대한 사전 검토를 철저히 한다.",
                  "controlLevel": "administrative",
                  "basis": {
                    "basisGuide": "doc:kosha_guide/C-61-2012",
                    "guideSection": "4"
                  }
                },
                {
                  "@id": "workmeasure:f6bdb7102189",
                  "@type": "WorkMeasure",
                  "measure": "공사 전 작업구간 내에 기 설치되어 있는 상수도 및 하수관로, 송유관, 통신 및 전력케이블, 도시 가스관, 지하갱도 등의 지하 지장물의 종류, 심도 및 크기를 파악하여 안전한 시공이 가능하도록 조치한다.",
                  "controlLevel": "elimination",
                  "basis": {
                    "basisGuide": "doc:kosha_guide/C-61-2012",
                    "guideSection": "5.1"
                  }
                },
                {
                  "@id": "workmeasure:9f2e716e343b",
                  "@type": "WorkMeasure",
                  "measure": "지질 및 지층에 관한 조사를 실시하고 시추(보링) 위치, 토층 분포 상태, 투수계수, 지하수위, 지반의 지지력 등을 확인하여 시공계획에 반영한다.",
                  "controlLevel": "administrative",
                  "basis": {
                    "basisGuide": "doc:kosha_guide/C-61-2012",
                    "guideSection": "5.1"
                  }
                },
                {
                  "@id": "workmeasure:f5d97769003c",
                  "@type": "WorkMeasure",
                  "measure": "공사현장의 제반 여건과 터널 형상을 파악한 후 가시설물 설치계획, 수직터널 및 수평 보조 터널 등 세부작업 단계별 안전작업 방법과 순서, 장비에 대한 안전조치 사항 등이 포함된 작업계획을 수립한다.",
                  "controlLevel": "administrative",
                  "basis": {
                    "basisGuide": "doc:kosha_guide/C-61-2012",
                    "guideSection": "4"
                  }
                },
                {
                  "@id": "workmeasure:c63298f0a122",
                  "@type": "WorkMeasure",
                  "measure": "작업계획서는 본 공법에 풍부한 경험과 지식을 갖춘 자가 수립하여야 하며 공사 중 계획서의 내용이 제대로 이행되는지의 여부를 수시로 확인할 수 있도록 한다.",
                  "controlLevel": "administrative",
                  "basis": {
                    "basisGuide": "doc:kosha_guide/C-61-2012",
                    "guideSection": "4"
                  }
                }
              ]
            },
            {
              "@id": "workrisk:Shield_TBM/1.2",
              "@type": "WorkRisk",
              "statement": "수직구 굴착 중 용수·흙막이 변위를 놓쳐 붕괴",
              "priority": "★",
              "measures": [
                {
                  "@id": "workmeasure:ecbf02be1b36",
                  "@type": "WorkMeasure",
                  "measure": "수직구 굴착공사 시 세부공정표, 지반깊이별 굴착방법, 단계별 벽체 시공방법, 사용장비ㆍ굴착토사 인양ㆍ적재ㆍ운반ㆍ사토 방법 등이 포함된 작업계획을 작성한다.",
                  "controlLevel": "administrative",
                  "basis": {
                    "basisGuide": "doc:kosha_guide/C-61-2012",
                    "guideSection": "5.2"
                  }
                },
                {
                  "@id": "workmeasure:14d5709b3873",
                  "@type": "WorkMeasure",
                  "measure": "흙막이지보공에 대한 계측을 실시한다.",
                  "controlLevel": "administrative",
                  "basis": {
                    "basisGuide": "doc:kosha_guide/C-61-2012",
                    "guideSection": "5.2"
                  }
                },
                {
                  "@id": "workmeasure:8176032cf1cd",
                  "@type": "WorkMeasure",
                  "measure": "굴착작업 진행 중 용수량에 적합한 배수시설을 확보한다.",
                  "controlLevel": "engineering",
                  "basis": {
                    "basisGuide": "doc:kosha_guide/C-61-2012",
                    "guideSection": "5.2"
                  }
                }
              ]
