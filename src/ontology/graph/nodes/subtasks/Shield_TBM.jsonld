              "priority": "★",
              "measures": [
                {
                  "@id": "workmeasure:9c4f4820c341",
                  "@type": "WorkMeasure",
                  "measure": "세그먼트 블록 투입과 버력 반출용 양중장비 설치 및 작업계획을 작성하고 1개 수직구에 2개의 인양장비 설치 여부 검토, 장비형식ㆍ설치위치ㆍ용량ㆍ장비 간 간섭여부 확인, 부재 중량 및 조립작업용 장비ㆍ기자재ㆍ작업순서 및 방법 결정 등을 한다.",
                  "controlLevel": "administrative",
                  "basis": {
                    "basisGuide": "doc:kosha_guide/C-61-2012",
                    "guideSection": "5.2"
