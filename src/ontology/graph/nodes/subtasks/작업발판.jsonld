              "guide": "doc:kosha_guide/D-C-7-2026",
              "section": "7.5.1",
              "controlLevel": "administrative"
            },
            {
              "article": "art:기준규칙:57",
              "paragraph": 1,
              "item": 6,
              "controlLevel": "administrative"
            }
          ],
          "hazard": "hazard:fall_object",
          "risks": [
            {
              "statement": "해체 구역 하부에 출입통제 없이 작업하여 부재에 맞음",
              "priority": "★★",
              "measures": [
                {
                  "measure": "작업발판을 해체할 때 그 주변에는 관계자 외 출입을 금지시킨다",
                  "controlLevel": "administrative",
                  "basis": {
                    "guide": "doc:kosha_guide/D-C-7-2026",
                    "section": "7.5.1"
                  }
                },
                {
                  "measure": "재료·기구 또는 공구 등을 올리거나 내리는 경우에는 근로자가 달줄 또는 달포대 등을 사용하게 한다",
                  "controlLevel": "administrative",
                  "basis": {
                    "article": "art:기준규칙:57",
                    "paragraph": 1,
                    "item": 6
                  }
                }
              ]
            }
          ]
        }
      ]
    }
  ]
