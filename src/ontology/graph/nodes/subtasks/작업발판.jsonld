  "@id": "subtask:작업발판",
  "@type": [
    "ConstructionSubtask"
  ],
  "title": "작업발판",
  "workGroup": "가설·비계공사",
  "jurisdiction": "KR",
  "_meta": {
    "createdAt": "2026-11-12",
    "note": "공종의 작업 단계와 단계별 재해유형·위험요인·대책·근거. 공식 공종 분류가 아니다. 근거는 번들 조문·별표·가이드 본문과 대조해 실재하는 것만 연결했다. 현장 검토 전.",
    "sourceNote": "안전보건공단 산업안전 AI 어시스턴트(건설업) 자료를 바탕으로 구성 — 위험요인·대책 문장과 중요도 표시는 그 자료의 것"
  },
  "broader": "activity:scaffolding_assembly",
  "hasHazard": [
    "hazard:cave_in",
    "hazard:fall_from_height",
    "hazard:fall_object",
    "hazard:trip_slip"
  ],
  "regulatedBy": [
    "art:기준규칙:56",
    "art:기준규칙:13",
    "art:기준규칙:58",
    "art:기준규칙:55",
    "art:기준규칙:57"
  ],
  "guidedBy": [
    "doc:kosha_guide/D-C-7-2026"
  ],
  "references": [
    "act:가설공사표준안전작업지침",
    "act:추락재해방지표준안전작업지침"
  ],
  "steps": [
    {
      "stepName": "설치",
      "stepHazards": [
        {
          "hazardLabel": "무너짐",
          "basis": [
            {
              "guide": "doc:kosha_guide/D-C-7-2026",
              "section": "7.5.2",
              "controlLevel": "administrative"
            },
            {
              "article": "art:기준규칙:56",
              "item": 1,
              "controlLevel": "engineering"
            },
            {
              "article": "art:기준규칙:56",
              "item": 5,
              "controlLevel": "engineering"
            }
          ],
          "hazard": "hazard:cave_in",
          "risks": [
            {
              "statement": "발판재료의 강도가 부족하거나 지지물이 파괴되어 무너짐",
              "priority": "★",
              "measures": [
                {
                  "measure": "발판재료는 작업할 때의 하중을 견딜 수 있도록 견고한 것으로 한다",
                  "controlLevel": "engineering",
                  "basis": {
                    "article": "art:기준규칙:56",
                    "item": 1
                  }
                },
                {
                  "measure": "작업발판의 지지물은 하중에 의하여 파괴될 우려가 없는 것을 사용한다",
                  "controlLevel": "engineering",
                  "basis": {
                    "article": "art:기준규칙:56",
                    "item": 5
                  }
                },
                {
                  "measure": "재사용 강재 작업발판 사용 시에는 작업장에 작업발판을 반입하는 시점에 작업발판의 재료 성능에 대한 점검을 실시하여 이상여부를 확인한다",
                  "controlLevel": "administrative",
                  "basis": {
                    "guide": "doc:kosha_guide/D-C-7-2026",
                    "section": "7.5.2"
                  }
                }
              ]
            }
          ]
        },
        {
          "hazardLabel": "떨어짐",
          "basis": [
            {
              "guide": "doc:kosha_guide/D-C-7-2026",
              "section": "7.5.1",
              "controlLevel": "engineering"
            },
            {
              "article": "art:기준규칙:13",
              "item": 1,
              "controlLevel": "engineering"
            },
            {
              "article": "art:기준규칙:56",
              "item": 2,
              "controlLevel": "engineering"
            },
            {
              "article": "art:기준규칙:56",
              "item": 4,
              "controlLevel": "engineering"
            }
          ],
          "hazard": "hazard:fall_from_height",
          "risks": [
            {
              "statement": "발판 폭이 좁거나 재료 간 틈이 벌어져 떨어짐",
              "priority": "★★",
              "measures": [
                {
                  "measure": "작업발판의 폭은 40센티미터 이상으로 하고, 발판재료 간의 틈은 3센티미터 이하로 한다",
                  "controlLevel": "engineering",
                  "basis": {
                    "article": "art:기준규칙:56",
                    "item": 2
                  }
                }
              ]
            },
            {
              "statement": "추락 위험 장소에 안전난간을 설치하지 않아 떨어짐",
              "priority": "★★",
              "measures": [
                {
                  "measure": "추락의 위험이 있는 장소에는 안전난간을 설치한다",
                  "controlLevel": "engineering",
                  "basis": {
                    "article": "art:기준규칙:56",
                    "item": 4
                  }
                },
                {
                  "measure": "안전난간을 설치하는 것이 곤란한 경우 또는 작업의 필요상 임시로 안전난간을 해체할 때에는 추락방호망을 설치하거나 근로자로 하여금 안전대를 사용하도록 하는 등 추락위험 방지 조치를 한다",
                  "controlLevel": "engineering",
                  "basis": {
                    "guide": "doc:kosha_guide/D-C-7-2026",
                    "section": "7.5.1"
                  }
                },
                {
                  "measure": "안전난간은 상부 난간대, 중간 난간대, 발끝막이판 및 난간기둥으로 구성한다",
                  "controlLevel": "engineering",
                  "basis": {
                    "article": "art:기준규칙:13",
                    "item": 1
                  }
                }
              ]
            }
          ]
        },
        {
          "hazardLabel": "물체에 맞음",
          "basis": [
            {
              "article": "art:기준규칙:56",
              "item": 6,
              "controlLevel": "engineering"
            }
          ],
          "hazard": "hazard:fall_object",
          "risks": [
            {
              "statement": "발판재료가 뒤집히거나 떨어져 하부 근로자가 맞음",
              "priority": "★★",
              "measures": [
                {
                  "measure": "작업발판재료는 뒤집히거나 떨어지지 않도록 둘 이상의 지지물에 연결하거나 고정시킨다",
                  "controlLevel": "engineering",
                  "basis": {
                    "article": "art:기준규칙:56",
                    "item": 6
                  }
                }
              ]
            }
          ]
        },
        {
          "hazardLabel": "넘어짐",
          "basis": [
            {
              "guide": "doc:kosha_guide/D-C-7-2026",
              "section": "7.5.1",
              "controlLevel": "engineering"
            }
          ],
          "hazard": "hazard:trip_slip",
          "risks": [
            {
              "statement": "고정용 못·철선·볼트에 걸려 넘어짐",
              "priority": "★",
              "measures": [
                {
                  "measure": "근로자가 작업발판 고정용 못, 철선 및 볼트 등에 걸려 넘어지지 않도록 조치한다",
                  "controlLevel": "engineering",
                  "basis": {
                    "guide": "doc:kosha_guide/D-C-7-2026",
                    "section": "7.5.1"
                  }
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "stepName": "사용",
      "stepHazards": [
        {
          "hazardLabel": "떨어짐",
          "basis": [
            {
              "guide": "doc:kosha_guide/D-C-7-2026",
              "section": "7.5.2",
              "controlLevel": "administrative"
            },
            {
              "article": "art:기준규칙:58",
              "item": 1,
              "controlLevel": "administrative"
            }
          ],
          "hazard": "hazard:fall_from_height",
          "risks": [
            {
              "statement": "작업 전 점검 없이 사용하여 발판 손상·걸림 불량을 놓쳐 떨어짐",
              "priority": "★★",
              "measures": [
                {
                  "measure": "작업발판 점검계획을 수립하여 당해 작업 시작 전에 작업발판에 대한 점검을 실시한 후 작업발판 안전점검표를 당해 작업장에 게시하고 작업발판 주변에 지적된 내용을 표시하여 작업발판을 사용하는 근로자가 점검내용을 확인할 수 있도록 한다",
                  "controlLevel": "administrative",
                  "basis": {
                    "guide": "doc:kosha_guide/D-C-7-2026",
                    "section": "7.5.2"
                  }
                },
                {
                  "measure": "점검결과 설치된 작업발판이 안전기준에 부합되지 않을 때에는 근로자가 그 작업발판을 사용하기 전까지 개선한다",
                  "controlLevel": "administrative",
                  "basis": {
                    "guide": "doc:kosha_guide/D-C-7-2026",
                    "section": "7.5.2"
                  }
                },
                {
                  "measure": "발판 재료의 손상 여부 및 부착 또는 걸림 상태를 점검한다",
                  "controlLevel": "administrative",
                  "basis": {
                    "article": "art:기준규칙:58",
                    "item": 1
                  }
                }
              ]
            }
          ]
        },
        {
          "hazardLabel": "무너짐",
          "basis": [
            {
              "guide": "doc:kosha_guide/D-C-7-2026",
              "section": "7.5.2",
              "controlLevel": "administrative"
            },
            {
              "article": "art:기준규칙:55",
              "controlLevel": "administrative"
            }
          ],
          "hazard": "hazard:cave_in",
          "risks": [
            {
              "statement": "최대적재하중을 초과하여 적재해 발판이 파괴됨",
              "priority": "★★",
              "measures": [
                {
                  "measure": "비계의 구조 및 재료에 따라 작업발판의 최대적재하중을 정하고, 이를 초과하여 실지 않는다",
                  "controlLevel": "administrative",
                  "basis": {
                    "article": "art:기준규칙:55"
                  }
                },
                {
                  "measure": "작업발판의 최대적재하중 및 각 재료별 최대적재수량을 비계의 구조에 따라 정한 후 그 내용을 게시하여 근로자가 확인할 수 있도록 하고 이를 초과하여 적재하지 않는다",
                  "controlLevel": "administrative",
                  "basis": {
                    "guide": "doc:kosha_guide/D-C-7-2026",
                    "section": "7.5.2"
                  }
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "stepName": "이동·해체",
      "stepHazards": [
        {
          "hazardLabel": "떨어짐",
          "basis": [
            {
              "article": "art:기준규칙:56",
              "item": 7,
              "controlLevel": "administrative"
            }
          ],
          "hazard": "hazard:fall_from_height",
          "risks": [
            {
              "statement": "작업발판을 이동시키는 중 떨어지거나 부재가 낙하함",
              "priority": "★",
              "measures": [
                {
                  "measure": "작업발판을 작업에 따라 이동시킬 경우에는 위험 방지에 필요한 조치를 한다",
                  "controlLevel": "administrative",
                  "basis": {
                    "article": "art:기준규칙:56",
                    "item": 7
                  }
                }
              ]
            }
          ]
        },
        {
          "hazardLabel": "물체에 맞음",
          "basis": [
