          "hazard": "hazard:fire_explosion",
          "risks": [
            {
              "statement": "선도관 진입부를 절단하다 원지반이 붕괴하거나 가스가 누출",
              "priority": "★★",
              "measures": [
                {
                  "measure": "선도관 진입부는 약 3cm 정도의 확인공을 먼저 뚫어서 원지반의 안정여부와 가스 누출 여부를 확인한 다음 시행하여야 하며 누수 등이 있는 경우에는 지수제로 차수 조치하여 안전한 상태에서 절단을 하도록 하여야 한다",
                  "controlLevel": "administrative",
                  "variant": "비개착",
                  "basis": {
                    "guide": "doc:kosha_guide/D-C-11-2026",
                    "section": "7.4.8"
                  }
                },
                {
                  "measure": "선도관 진입부 절단은 숙련된 용접 자격자만이 수행하도록 하여야 한다",
                  "controlLevel": "administrative",
                  "variant": "비개착",
                  "basis": {
                    "guide": "doc:kosha_guide/D-C-11-2026",
                    "section": "7.4.8"
                  }
                },
                {
                  "measure": "선도관 진입부 절단작업은 원지반의 붕괴, 노면의 함몰 등과 같은 위험이 많으므로 전면 흙막이 지보공 절단은 부분파쇄를 통해 원지반의 교란을 최소화 하고, 절단은 4등분으로 하부로부터 제거하여 절단한 조각이 갑자기 떨어지지 않도록 주의하여야 한다",
                  "controlLevel": "administrative",
                  "variant": "비개착",
                  "basis": {
                    "guide": "doc:kosha_guide/D-C-11-2026",
                    "section": "7.4.8"
                  }
                }
              ]
            },
            {
              "statement": "협소한 관내 연결작업 중 용접 화재·질식·감전",
              "priority": "★",
              "measures": [
                {
                  "measure": "추진관 연결 작업은 작업조건이 매우 불량한 협소한 장소에서 작업이 이루어지므로 최소 2인 이상이 상호교대로 작업을 실시하고 작업지휘자를 지정하여 작업을 지휘하도록 하여야 한다",
                  "controlLevel": "administrative",
                  "variant": "비개착",
                  "basis": {
                    "guide": "doc:kosha_guide/D-C-11-2026",
                    "section": "7.4.8"
                  }
                },
                {
                  "measure": "가연물 제거와 화재예방 조치를 한다",
                  "controlLevel": "elimination",
                  "variant": "기본",
                  "basis": {
                    "guide": "doc:kosha_guide/D-C-11-2026",
                    "section": "7.4.8"
                  }
                },
                {
