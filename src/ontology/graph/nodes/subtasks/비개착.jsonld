    {
      "stepName": "추진·도달기지 설치",
      "stepHazards": [
        {
          "hazardLabel": "무너짐",
          "basis": [
            {
              "guide": "doc:kosha_guide/D-C-11-2026",
              "section": "7.4.1",
              "controlLevel": "administrative"
            },
            {
