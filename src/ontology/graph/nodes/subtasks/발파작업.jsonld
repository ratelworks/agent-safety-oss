  "steps": [
    {
      "stepName": "발파 천공",
      "stepHazards": [
        {
          "hazardLabel": "화재·폭발",
          "basis": [
            {
              "guide": "doc:kosha_guide/D-C-6-2025",
              "section": "5.2.6",
              "controlLevel": "elimination"
            },
            {
              "guide": "doc:kosha_guide/D-C-6-2025",
              "section": "5.2.6"
            },
            {
              "guide": "doc:kosha_guide/D-C-6-2025",
              "section": "5.2.6",
              "controlLevel": "administrative"
            },
            {
              "guide": "doc:kosha_guide/D-C-6-2025",
              "section": "6.2.5"
            }
          ],
          "hazard": "hazard:fire_explosion",
          "risks": [
            {
              "statement": "1차 발파 지역의 불발공을 확인하지 않고 천공기가 잔류 화약을 타격하여 폭발",
              "priority": "★★",
              "measures": [
                {
                  "measure": "1차 발파된 지역에서 천공 작업을 하는 경우 전 지역에 폭파되지 않은 화약의 유무를 세밀히 조사하여 확인될 때까지 천공하지 않는다",
                  "controlLevel": "administrative",
                  "variant": "기본",
                  "basis": {
                    "guide": "doc:kosha_guide/D-C-6-2025",
                    "section": "5.2.6"
                  }
                },
                {
                  "measure": "화약류를 발견하지 못하였다 하더라도 천공 구멍에 천공기, 곡괭이 또는 금속재 봉 등을 삽입하지 않는다",
                  "controlLevel": "elimination",
                  "variant": "기본",
                  "basis": {
                    "guide": "doc:kosha_guide/D-C-6-2025",
                    "section": "5.2.6"
                  }
                },
                {
                  "measure": "불발된 발파공에서부터 15m 이내에서는 동력 기계를 이용한 천공작업을 금지한다",
                  "controlLevel": "elimination",
                  "variant": "기본",
                  "basis": {
                    "guide": "doc:kosha_guide/D-C-6-2025",
                    "section": "5.2.6"
                  }
                }
              ]
            },
            {
              "statement": "같은 장소에서 천공과 장약이 동시에 진행되어 천공 충격이 장약된 화약류에 전달되어 폭발",
              "priority": "★",
              "measures": [
                {
                  "measure": "천공 작업과 장약 작업은 같은 작업 장소에서 병행하지 않고, 작업 장소 간에 충분한 안전거리를 확보한다",
                  "variant": "기본",
                  "basis": {
                    "guide": "doc:kosha_guide/D-C-6-2025",
                    "section": "5.2.6"
                  }
                }
              ]
            },
            {
              "statement": "천공 장소에 전기뇌관·폭약을 근접 보관하여 대전된 정전기가 뇌관에 전달되어 기폭",
              "priority": "★",
              "measures": [
                {
                  "measure": "천공 장소에서 전기뇌관이나 폭약을 충분히 이격시켜 둔다",
                  "variant": "전기",
                  "basis": {
                    "guide": "doc:kosha_guide/D-C-6-2025",
                    "section": "6.2.5"
                  }
                }
              ]
            },
            {
              "statement": "발파공 직경이 화약류보다 작아 장약 시 무리한 삽입으로 약포에 충격이 가해져 폭발",
              "priority": "★",
              "measures": [
                {
                  "measure": "발파공의 크기는 사용할 화약류의 직경보다 크게 한다",
                  "variant": "기본",
                  "basis": {
                    "guide": "doc:kosha_guide/D-C-6-2025",
                    "section": "5.2.6"
                  }
                }
              ]
            }
          ]
        },
        {
          "hazardLabel": "떨어짐",
          "basis": [
            {
              "guide": "doc:kosha_guide/D-C-6-2025",
              "section": "5.2.6"
            },
            {
              "article": "art:기준규칙:42",
              "paragraph": 1
            },
            {
              "article": "art:기준규칙:42",
              "paragraph": 2
            }
          ],
          "hazard": "hazard:fall_from_height",
          "risks": [
            {
              "statement": "고소 천공 위치에서 작업발판 없이 작업하다 떨어짐",
              "measures": [
                {
                  "measure": "천공 작업 중 근로자가 추락할 우려가 있는 때에는 작업 발판을 설치하고 안전대를 착용하도록 한다",
                  "variant": "기본",
                  "basis": {
                    "guide": "doc:kosha_guide/D-C-6-2025",
                    "section": "5.2.6"
                  }
                },
                {
                  "measure": "근로자가 추락하거나 넘어질 위험이 있는 장소에서 작업을 할 때에 근로자가 위험해질 우려가 있는 경우 비계를 조립하는 등의 방법으로 작업발판을 설치한다",
                  "variant": "기본",
                  "basis": {
                    "article": "art:기준규칙:42",
                    "paragraph": 1
                  }
                },
                {
                  "measure": "작업발판을 설치하기 곤란한 경우 추락방호망을 설치하고, 추락방호망을 설치하기 곤란한 경우에는 근로자에게 안전대를 착용하도록 하는 등 추락위험을 방지하기 위하여 필요한 조치를 한다",
                  "variant": "기본",
                  "basis": {
                    "article": "art:기준규칙:42",
                    "paragraph": 2
                  }
                }
              ]
            }
          ]
        },
        {
          "hazardLabel": "끼임·감김",
          "basis": [
            {
              "guide": "doc:kosha_guide/D-C-6-2025",
              "section": "5.2.6",
              "controlLevel": "administrative"
            }
          ],
          "hazard": "hazard:machine_entanglement",
          "risks": [
            {
              "statement": "회전 중인 천공기 로드에 신체·의복이 말려 끼임",
              "priority": "★★",
              "measures": [
                {
                  "measure": "천공 작업을 하는 때에는 회전체에 끼이지 않도록 주의한다",
                  "controlLevel": "administrative",
                  "variant": "기본",
                  "basis": {
                    "guide": "doc:kosha_guide/D-C-6-2025",
                    "section": "5.2.6"
                  }
                },
                {
                  "measure": "오거 및 천공기가 작동할 때는 관계 근로자가 아닌 사람의 출입을 금지한다",
                  "controlLevel": "administrative",
                  "variant": "기본",
                  "basis": {
                    "guide": "doc:kosha_guide/D-C-6-2025",
                    "section": "5.2.6"
                  }
                }
              ]
            }
          ]
        },
        {
          "hazardLabel": "감전",
          "basis": [
            {
              "guide": "doc:kosha_guide/D-C-6-2025",
              "section": "5.2.6"
            },
            {
              "article": "art:기준규칙:322",
              "paragraph": 1
            }
          ],
          "hazard": "hazard:electric_shock",
          "risks": [
            {
              "statement": "천공기를 이동하던 중 붐·공구류가 송전선에 접촉하여 감전",
              "priority": "★",
              "measures": [
                {
                  "measure": "천공기를 이동할 때는 드릴 등 작업공구류를 안전한 위치에 두어야 하며, 송전선 아래나 그 주위로 이동할 때는 특히 주의한다",
                  "variant": "기본",
                  "basis": {
                    "guide": "doc:kosha_guide/D-C-6-2025",
                    "section": "5.2.6"
                  }
                },
                {
                  "measure": "충전전로 인근에서 차량·기계장치 작업을 하는 경우 충전부로부터 300cm 이상 이격한다",
                  "variant": "기본",
                  "basis": {
                    "article": "art:기준규칙:322",
                    "paragraph": 1
                  }
                }
              ]
            }
          ]
        },
        {
          "hazardLabel": "물체에 맞음",
          "basis": [
            {
              "guide": "doc:kosha_guide/D-C-6-2025",
              "section": "5.2.6"
            },
            {
              "article": "art:기준규칙:14",
              "paragraph": 1
            },
            {
              "article": "art:기준규칙:20",
              "item": 10,
              "subitem": "가"
            },
            {
              "article": "art:기준규칙:32",
              "paragraph": 1,
              "item": 1
            }
          ],
          "hazard": "hazard:fall_object",
          "risks": [
            {
              "statement": "천공 중 막장·비탈면의 낙반이 작업자에게 떨어짐",
              "priority": "★",
              "measures": [
                {
                  "measure": "천공 작업 중에 발생할 우려가 있는 낙반 및 추락 등에 의한 위험을 방지하기 위한 조치를 한다",
                  "variant": "기본",
                  "basis": {
                    "guide": "doc:kosha_guide/D-C-6-2025",
                    "section": "5.2.6"
                  }
                },
                {
                  "measure": "작업장의 바닥, 도로 및 통로 등에서 낙하물이 근로자에게 위험을 미칠 우려가 있는 경우 보호망을 설치하는 등 필요한 조치를 한다",
                  "variant": "기본",
                  "basis": {
                    "article": "art:기준규칙:14",
                    "paragraph": 1
                  }
                },
                {
                  "measure": "부석의 낙하에 의하여 근로자에게 위험을 미칠 우려가 있는 장소에는 울타리를 설치하는 등 관계 근로자가 아닌 사람의 출입을 금지한다",
                  "variant": "기본",
                  "basis": {
                    "article": "art:기준규칙:20",
                    "item": 10,
                    "subitem": "가"
                  }
                },
                {
                  "measure": "물체가 떨어지거나 날아올 위험 또는 근로자가 추락할 위험이 있는 작업을 하는 근로자에게 안전모를 지급하고 착용하도록 한다",
                  "variant": "기본",
                  "basis": {
                    "article": "art:기준규칙:32",
                    "paragraph": 1,
                    "item": 1
                  }
                }
              ]
            }
          ]
        },
        {
          "hazardLabel": "건강장해",
          "basis": [
            {
              "guide": "doc:kosha_guide/D-C-6-2025",
              "section": "5.2.6"
            },
            {
              "article": "art:기준규칙:4의2"
            }
          ],
          "risks": [
            {
              "statement": "건식 천공으로 분진이 흩날려 작업자가 흡입",
              "measures": [
                {
                  "measure": "천공 작업으로 인해 발생하는 먼지는 가능한 한 물을 뿌리는 등 습식으로 제거한다",
                  "variant": "기본",
                  "basis": {
                    "guide": "doc:kosha_guide/D-C-6-2025",
                    "section": "5.2.6"
                  }
                },
                {
                  "measure": "분진이 심하게 흩날리는 작업장에 대하여 물을 뿌리는 등 분진이 흩날리는 것을 방지하기 위하여 필요한 조치를 한다",
                  "variant": "기본",
                  "basis": {
                    "article": "art:기준규칙:4의2"
                  }
                }
              ]
            }
          ]
        }
      ]
    },
