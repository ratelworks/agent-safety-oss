          "hazard": "hazard:fire_explosion",
          "risks": [
            {
              "statement": "취급소를 기준에 맞지 않게 설치하거나 취급소 외 장소에 화약류를 방치하여 폭발",
              "priority": "★",
              "measures": [
                {
                  "measure": "화약류를 사용할 때는 화약류의 사용장소 부근에 화약류의 관리 및 발파의 준비에 전용되는 건물을 「총포화약법 시행령」에서 정하는 기준에 맞게 설치한다",
                  "variant": "기본",
                  "basis": {
                    "guide": "doc:kosha_guide/D-C-6-2025",
                    "section": "5.2.2"
                  }
                },
                {
                  "measure": "화약류취급소 이외의 장소에는 화약류를 방치 또는 보관하지 않도록 한다",
                  "variant": "기본",
                  "basis": {
                    "guide": "doc:kosha_guide/D-C-6-2025",
                    "section": "5.2.2"
                  }
                },
                {
                  "measure": "화약류취급소 및 인근에서는 약포에 뇌관류를 삽입하거나, 삽입된 약포를 취급하지 않는다",
                  "variant": "기본",
                  "basis": {
                    "guide": "doc:kosha_guide/D-C-6-2025",
                    "section": "5.2.2"
                  }
                },
                {
                  "measure": "화약류저장소로부터 매일 발파에 필요한 최소량을 화약류취급소로 운반하도록 한다",
                  "variant": "기본",
                  "basis": {
                    "guide": "doc:kosha_guide/D-C-6-2025",
                    "section": "5.2.1"
                  }
                },
                {
                  "measure": "발파작업 현장에는 여분의 화약류를 들고 들어가지 않는다",
                  "variant": "기본",
                  "basis": {
                    "guide": "doc:kosha_guide/D-C-6-2025",
                    "section": "5.2.4"
                  }
                },
                {
                  "measure": "화약류, 발파기재 등을 사용 및 관리, 취급, 폐기하거나 사업장에 반입할 때에는 「총포화약법」 및 제조사의 사용지침에서 정하는 바에 따라 조치를 한다",
                  "variant": "기본",
                  "basis": {
                    "guide": "doc:kosha_guide/D-C-6-2025",
                    "section": "5.1.1"
                  }
                }
              ]
            },
            {
              "statement": "취급소 인근의 화기·흡연으로 화재가 발생하여 보관 화약류가 폭발",
              "priority": "★★",
              "measures": [
                {
                  "measure": "화약류취급소 인근에서는 흡연, 화기사용 등 화재의 위험을 초래하는 행위를 금지하고, 방화수, 방화사 및 소화기 등을 비치한다",
                  "controlLevel": "engineering",
                  "variant": "기본",
                  "basis": {
                    "guide": "doc:kosha_guide/D-C-6-2025",
                    "section": "5.2.2"
                  }
                },
                {
                  "measure": "화약류를 사용, 취급 및 관리하는 장소 인근에서는 화기사용, 흡연 등의 행위를 금지한다",
                  "controlLevel": "elimination",
                  "variant": "기본",
                  "basis": {
                    "guide": "doc:kosha_guide/D-C-6-2025",
                    "section": "5.1.1"
                  }
                },
                {
                  "measure": "화기의 사용 또는 불꽃을 발생시키는 작업을 하는 장소의 부근이나 누전의 위험이 있는 장소에서는 화약류를 취급하지 않는다",
                  "controlLevel": "elimination",
