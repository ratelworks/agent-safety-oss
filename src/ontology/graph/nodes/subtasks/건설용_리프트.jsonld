  "guidedBy": [
    "doc:kosha_guide/C-79-2015"
  ],
  "steps": [
    {
      "stepName": "리프트 마스트 설치·지지",
      "stepHazards": [
        {
          "hazardLabel": "무너짐",
          "basis": [
            {
              "guide": "doc:kosha_guide/C-79-2015",
              "section": "5.2",
              "controlLevel": "administrative"
            },
            {
              "guide": "doc:kosha_guide/C-79-2015",
              "section": "5.2",
              "controlLevel": "engineering"
            },
            {
              "guide": "doc:kosha_guide/C-79-2015",
              "section": "6.4",
              "controlLevel": "engineering"
            },
            {
              "article": "art:기준규칙:156",
              "paragraph": 1,
              "controlLevel": "administrative"
            }
          ],
          "hazard": "hazard:cave_in",
          "risks": [
            {
              "statement": "마스트 부재 강도 미확보로 좌굴로 무너짐",
              "measures": [
                {
                  "measure": "리프트의 마스트 등 부속품은 설치높이 및 운행속도 등에 적합한 강도를 갖는지를 확인한다",
                  "controlLevel": "administrative",
                  "basis": {
                    "guide": "doc:kosha_guide/C-79-2015",
                    "section": "5.2"
                  }
                }
              ]
            },
            {
              "statement": "설치높이별 구조검토 미수행으로 마스트 부재가 축소되어 좌굴·무너짐",
              "measures": [
                {
                  "measure": "타워크레인은 건축물 부재의 최대중량 또는 인양하고자 하는 설비의 최대 중량, 작업반경, 인양속도, 마스트의 상승방법, 해체방법 등을 검토하여 그에 적합한 장비종류, 정격하중 및 설치위치를 선정한다",
                  "controlLevel": "engineering",
                  "basis": {
                    "guide": "doc:kosha_guide/C-79-2015",
                    "section": "5.2"
                  }
                },
                {
                  "measure": "곤돌라는 외부마감공사를 위하여 설치하는 것이 주된 목적이므로 사용목적 에 적합한 구조성능 및 설치위치를 계획한다",
                  "controlLevel": "engineering",
                  "basis": {
                    "guide": "doc:kosha_guide/C-79-2015",
                    "section": "5.2"
                  }
                },
                {
                  "measure": "건설용 리프트는 설치높이에 따른 별도의 구조검토를 수행하여야 하며, 설치 높이가 증가함에 따른 마스트 부재의 축소를 고려한다",
                  "controlLevel": "engineering",
                  "basis": {
                    "guide": "doc:kosha_guide/C-79-2015",
                    "section": "6.4"
                  }
                }
              ]
            },
            {
              "statement": "기상 악화 시 작업으로 무너짐 또는 떨어짐",
              "measures": [
                {
                  "measure": "사업주는 리프트의 설치ㆍ조립ㆍ수리ㆍ점검 또는 해체 작업을 하는 경우 다음 각 호의 조치를 하여야 한다. 비, 눈, 그 밖에 기상상태의 불안정으로 날씨가 몹시 나쁜 경우에는 그 작업을 중지시킬 것",
                  "controlLevel": "administrative",
                  "basis": {
                    "article": "art:기준규칙:156",
                    "paragraph": 1
                  }
                }
              ]
            },
            {
              "statement": "부적합 강도·구조의 마스트 사용으로 무너짐",
              "measures": [
                {
                  "measure": "리프트의 마스트 등 부속품은 설치높이 및 운행속도 등에 적합한 강도를 갖는지를 확인한다",
                  "controlLevel": "administrative",
                  "basis": {
                    "guide": "doc:kosha_guide/C-79-2015",
                    "section": "5.2"
                  }
                },
                {
                  "measure": "건설용 리프트는 설치높이에 따른 별도의 구조검토를 수행하여야 하며, 설치 높이가 증가함에 따른 마스트 부재의 축소를 고려한다",
                  "controlLevel": "engineering",
                  "basis": {
                    "guide": "doc:kosha_guide/C-79-2015",
                    "section": "6.4"
                  }
                }
              ]
            }
          ]
        },
        {
          "hazardLabel": "물체에 맞음",
          "basis": [
            {
              "article": "art:기준규칙:152",
              "paragraph": 2,
              "controlLevel": "engineering"
            },
            {
              "article": "art:기준규칙:156",
              "paragraph": 1,
              "controlLevel": "administrative"
            }
          ],
          "hazard": "hazard:fall_object",
          "risks": [
            {
              "statement": "관계자 외 출입을 막지 않아 운반구 승강부에 끼임",
              "measures": [
                {
                  "measure": "사업주는 리프트의 설치ㆍ조립ㆍ수리ㆍ점검 또는 해체 작업을 하는 경우 다음 각 호의 조치를 하여야 한다. 작업을 할 구역에 관계 근로자가 아닌 사람의 출입을 금지하고 그 취지를 보기 쉬운 장소에 표시할 것",
                  "controlLevel": "administrative",
                  "basis": {
                    "article": "art:기준규칙:156",
                    "paragraph": 1
                  }
                }
              ]
            },
            {
              "statement": "임의 조작으로 맞음 또는 끼임",
              "measures": [
                {
                  "measure": "사업주는 리프트 조작반(盤)에 잠금장치를 설치하는 등 관계 근로자가 아닌 사람이 리프트를 임의로 조작함으로써 발생하는 위험을 방지하기 위하여 필요한 조치를 한다",
                  "controlLevel": "engineering",
                  "basis": {
                    "article": "art:기준규칙:152",
                    "paragraph": 2
                  }
                }
              ]
            }
          ]
        },
        {
          "hazardLabel": "끼임·감김",
          "basis": [
