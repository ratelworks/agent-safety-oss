          ],
          "hazard": "hazard:machine_entanglement",
          "risks": [
            {
              "statement": "관계자 외 출입금지 미실시로 작업자 끼임",
              "measures": [
                {
                  "measure": "사업주는 리프트의 설치ㆍ조립ㆍ수리ㆍ점검 또는 해체 작업을 하는 경우 다음 각 호의 조치를 하여야 한다. 작업을 할 구역에 관계 근로자가 아닌 사람의 출입을 금지하고 그 취지를 보기 쉬운 장소에 표시할 것",
                  "controlLevel": "administrative",
                  "basis": {
                    "article": "art:기준규칙:156",
                    "paragraph": 1
                  }
                }
              ]
            },
            {
              "statement": "조작반 잠금 미설치로 임의조작 중 끼임",
              "measures": [
                {
                  "measure": "사업주는 리프트 조작반(盤)에 잠금장치를 설치하는 등 관계 근로자가 아닌 사람이 리프트를 임의로 조작함으로써 발생하는 위험을 방지하기 위하여 필요한 조치를 한다",
                  "controlLevel": "engineering",
                  "basis": {
                    "article": "art:기준규칙:152",
                    "paragraph": 2
                  }
                }
              ]
            }
          ]
        }
