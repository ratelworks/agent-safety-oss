      "stepName": "석재 및 타일 자재반입",
      "stepHazards": [
        {
          "hazardLabel": "끼임·감김",
          "basis": [
            {
              "guide": "doc:kosha_guide/C-6-2015",
              "section": "5.1",
              "controlLevel": "engineering"
