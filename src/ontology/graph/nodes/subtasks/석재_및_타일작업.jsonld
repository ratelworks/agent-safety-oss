          "hazard": "hazard:struck_by_overturn",
          "risks": [
            {
              "statement": "적재해 둔 석재가 전도되거나 충격을 받아 파손되며 근로자를 덮침",
              "priority": "★",
              "measures": [
                {
                  "measure": "자재반입 시는 적재높이, 적재방법 등을 사전에 검토한 후 반입하고, 반입된 부재가 전도 또는 외력에 의한 충격에 파손되지 않도록 지정된 장소에 적재하여야 한다.",
                  "controlLevel": "administrative",
                  "basis": {
                    "guide": "doc:kosha_guide/C-57-2017",
                    "section": "4"
                  }
                },
                {
                  "measure": "자재반입은 현장 작업공정을 고려하여 공장에서 순서에 맞게 반입하고, 바닥재 및 벽재 등 용도별로 부재를 적재하여야 한다.",
                  "controlLevel": "administrative",
                  "basis": {
                    "guide": "doc:kosha_guide/C-57-2017",
                    "section": "4"
                  }
                },
                {
                  "measure": "제품, 자재, 부재 등이 넘어지지 않도록 붙들어 지탱하게 하는 등 안전 조치를 하여야 한다.",
                  "controlLevel": "administrative",
                  "basis": {
                    "article": "art:기준규칙:3",
                    "paragraph": 2
                  }
                },
                {
                  "measure": "구름멈춤대, 쐐기 등을 이용하여 중량물의 동요나 이동을 조절한다.",
                  "controlLevel": "engineering",
                  "basis": {
                    "article": "art:기준규칙:386",
                    "item": 1
                  }
                },
                {
                  "measure": "중량물이 구를 위험이 있는 방향 앞의 일정거리 이내로는 근로자의 출입을 제한한다.",
                  "controlLevel": "administrative",
                  "basis": {
                    "article": "art:기준규칙:386",
                    "item": 2
                  }
                },
                {
                  "measure": "하적단의 붕괴 또는 화물의 낙하에 의하여 근로자가 위험해질 우려가 있는 경우에는 그 하적단을 로프로 묶거나 망을 치는 등 위험을 방지하기 위하여 필요한 조치를 하여야 한다.",
                  "controlLevel": "engineering",
                  "basis": {
                    "article": "art:기준규칙:392",
                    "paragraph": 1
                  }
                },
                {
                  "measure": "하적단을 헐어내는 경우에는 위에서부터 순차적으로 층계를 만들면서 헐어내어야 하며, 중간에서 헐어내어서는 아니 된다.",
                  "controlLevel": "administrative",
                  "basis": {
                    "article": "art:기준규칙:392",
                    "paragraph": 3
                  }
                }
              ]
            }
          ]
