            {
              "article": "art:기준규칙:665",
              "item": 2,
              "controlLevel": "substitution"
            }
          ],
          "hazard": "hazard:machine_entanglement",
          "risks": [
            {
              "statement": "타일박스를 들어 올리거나 내리다 손이 바닥면에 끼임",
              "priority": "★",
              "measures": [
                {
                  "measure": "타일박스를 들어 올리거나 내릴 경우에는 손이 타일박스와 바닥면에 끼일 우려가 높으므로 적정 받침목을 설치하는 등 안전대책을 강구하여야 한다.",
                  "controlLevel": "engineering",
                  "basis": {
                    "guide": "doc:kosha_guide/C-6-2015",
                    "section": "5.1"
                  }
                },
                {
                  "measure": "자재를 인력운반 시에는 자재를 떨어뜨려 발 등에 재해를 당할 우려가 있으므로 적당한 양을 운반하고 안전화를 착용하여야 한다.",
                  "controlLevel": "ppe",
                  "basis": {
                    "guide": "doc:kosha_guide/C-6-2015",
                    "section": "5.1"
                  }
                },
                {
                  "measure": "취급하기 곤란한 물품은 손잡이를 붙이거나 갈고리, 진공빨판 등 적절한 보조도구를 활용한다.",
                  "controlLevel": "substitution",
                  "basis": {
                    "article": "art:기준규칙:665",
                    "item": 2
                  }
                }
              ]
            }
          ]
        },
        {
          "hazardLabel": "건강장해",
          "basis": [
            {
              "guide": "doc:kosha_guide/C-57-2017",
              "section": "5.2",
              "controlLevel": "administrative"
            },
            {
              "guide": "doc:kosha_guide/C-6-2015",
              "section": "5.1",
              "controlLevel": "administrative"
            },
            {
              "article": "art:기준규칙:385",
              "controlLevel": "substitution"
            },
            {
              "article": "art:기준규칙:663",
              "controlLevel": "administrative"
            },
            {
              "article": "art:기준규칙:664",
              "controlLevel": "administrative"
            },
            {
              "article": "art:기준규칙:665",
              "item": 1,
              "controlLevel": "administrative"
            },
            {
              "article": "art:기준규칙:666",
              "controlLevel": "administrative"
            }
          ],
          "risks": [
            {
              "statement": "석재·타일을 인력으로 반복해 들어올려 허리를 다침",
              "priority": "★",
              "measures": [
                {
                  "measure": "석재를 인력으로 들어올리는 작업을 하는 때에는 과도한 중량으로 인하여 근로자의 목, 허리 등 근골격계에 무리한 부담을 주지 않도록 하여야 한다.",
                  "controlLevel": "administrative",
                  "basis": {
                    "guide": "doc:kosha_guide/C-57-2017",
                    "section": "5.2"
                  }
                },
                {
                  "measure": "석재의 중량과 형상을 고려하여 무게중심을 낮추고 대상물에 몸을 밀착하는 등 신체에 부담을 감소시킬 수 있는 자세에 대해 근로자에게 알려야 한다.",
                  "controlLevel": "administrative",
                  "basis": {
                    "guide": "doc:kosha_guide/C-57-2017",
                    "section": "5.2"
                  }
                },
                {
                  "measure": "석재의 무게가 5킬로그램 이상인 중량물을 들어올리는 작업을 하는 때에는 석재 중량과 무게중심에 대하여 작업장 주변에 안내표시를 하여야 한다.",
                  "controlLevel": "administrative",
                  "basis": {
                    "guide": "doc:kosha_guide/C-57-2017",
                    "section": "5.2"
                  }
                },
                {
                  "measure": "근로자가 중량물을 인력으로 들어올리는 작업을 하는 경우에 과도한 무게로 인하여 근로자의 목·허리 등 근골격계에 무리한 부담을 주지 않도록 최대한 노력해야 한다.",
                  "controlLevel": "administrative",
                  "basis": {
                    "article": "art:기준규칙:663"
                  }
                },
                {
                  "measure": "근로자가 중량물을 인력으로 들어올리는 작업을 하는 경우에 무게중심을 낮추거나 대상물에 몸을 밀착하도록 하는 등 근로자에게 신체의 부담을 줄일 수 있는 자세에 대하여 알려야 한다.",
                  "controlLevel": "administrative",
                  "basis": {
                    "article": "art:기준규칙:666"
                  }
                },
                {
                  "measure": "근로자가 중량물을 인력으로 들어올리거나 운반하는 작업을 하는 경우에 근로자가 취급하는 물품의 중량·취급빈도·운반거리·운반속도 등 인체에 부담을 주는 작업의 조건에 따라 작업시간과 휴식시간 등을 적정하게 배분해야 한다.",
                  "controlLevel": "administrative",
                  "basis": {
                    "article": "art:기준규칙:664"
                  }
                },
                {
                  "measure": "주로 취급하는 물품에 대하여 근로자가 쉽게 알 수 있도록 물품의 중량과 무게중심에 대하여 작업장 주변에 안내표시를 한다.",
                  "controlLevel": "administrative",
                  "basis": {
                    "article": "art:기준규칙:665",
                    "item": 1
                  }
                },
                {
                  "measure": "중량물을 운반하거나 취급하는 경우에 하역운반기계·운반용구를 사용하여야 한다.",
                  "controlLevel": "substitution",
                  "basis": {
                    "article": "art:기준규칙:385"
                  }
                },
                {
                  "measure": "타일자재 운반 작업 시에는 근골격계 재해예방을 위한 안전작업방법을 강구하여야 한다.",
                  "controlLevel": "administrative",
                  "basis": {
                    "guide": "doc:kosha_guide/C-6-2015",
                    "section": "5.1"
                  }
                },
                {
                  "measure": "운반 작업 전 근로자에 대하여 충분한 준비운동을 실시하여야 한다.",
                  "controlLevel": "administrative",
                  "basis": {
                    "guide": "doc:kosha_guide/C-6-2015",
                    "section": "5.1"
                  }
                }
              ]
            }
          ]
        },
