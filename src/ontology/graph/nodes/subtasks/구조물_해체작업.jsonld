          ],
          "hazard": "hazard:asphyxiation",
          "risks": [
            {
              "statement": "이중슬래브·피트 등 밀폐구조 내부의 유해가스를 확인하지 않고 진입하여 질식",
              "priority": "★",
              "measures": [
                {
                  "measure": "밀폐구조와 피트 등의 내부 침전물 및 유해·위험 가스·증기 유무를 사전에 확인한다.",
                  "controlLevel": "administrative",
                  "basis": {
                    "guide": "doc:kosha_guide/C-47-2023",
                    "section": "4.1"
                  }
                },
                {
                  "measure": "밀폐공간의 위치 파악 및 관리 방안과 질식·중독 등을 일으킬 수 있는 유해·위험 요인의 파악 및 관리 방안이 포함된 밀폐공간 작업 프로그램을 수립하여 시행한다.",
                  "controlLevel": "administrative",
                  "basis": {
                    "article": "art:기준규칙:619",
                    "paragraph": 1
                  }
                },
                {
                  "measure": "작업을 시작하기 전에 산소 및 유해가스 농도의 측정결과 및 후속조치 사항과 작업 시 착용하여야 할 보호구의 종류, 비상연락체계를 확인하여 근로자가 안전한 상태에서 작업하도록 한다.",
