  "steps": [
    {
      "stepName": "네일 천공작업",
      "stepHazards": [
        {
          "hazardLabel": "깔림",
          "basis": [
            {
              "guide": "doc:kosha_guide/D-C-1-2025",
              "section": "8.1.2",
              "controlLevel": "administrative"
            },
            {
              "guide": "doc:kosha_guide/D-C-1-2025",
              "section": "8.1.2",
              "controlLevel": "engineering"
            },
            {
              "article": "art:기준규칙:199",
              "controlLevel": "administrative"
            }
          ],
          "hazard": "hazard:struck_by_overturn",
          "risks": [
            {
              "statement": "천공 장비를 이동하는 중 통로가 불안정해 장비가 넘어지거나 이동 경로의 근로자가 부딪히고 끼임",
              "priority": "★★",
              "measures": [
                {
                  "measure": "천공 장비를 이동할 경우에는 장비의 전도·전락을 방지하기 위하여 이동통로의 안전성을 확보하여야 하며, 근로자의 협착 및 충돌 재해를 방지하기 위하여 이동 경로에는 출입 통제를 하여야 한다.",
                  "controlLevel": "administrative",
                  "basis": {
                    "guide": "doc:kosha_guide/D-C-1-2025",
                    "section": "8.1.2"
                  }
                },
                {
                  "measure": "천공 장비는 천공 작업 중 흔들림, 이동 등이 없도록 설치 지반을 정지하여야 한다.",
                  "controlLevel": "engineering",
                  "basis": {
                    "guide": "doc:kosha_guide/D-C-1-2025",
                    "section": "8.1.2"
                  }
                },
                {
                  "measure": "차량계 건설기계를 사용하는 작업을 하는 경우 지반의 부동침하 방지, 갓길의 붕괴 방지 및 도로 폭의 유지 등 필요한 조치를 한다.",
                  "controlLevel": "administrative",
                  "basis": {
                    "article": "art:기준규칙:199"
                  }
                },
                {
                  "measure": "천공 장비의 조정원은 건설기계관리법에 규정된 공기압축기 면허를 갖춘 자로 하여야 한다.",
                  "controlLevel": "administrative",
                  "basis": {
                    "guide": "doc:kosha_guide/D-C-1-2025",
                    "section": "8.1.2"
                  }
                }
              ]
            }
          ]
        },
        {
          "hazardLabel": "화재·폭발",
          "basis": [
            {
              "guide": "doc:kosha_guide/D-C-1-2025",
              "section": "8.1.2",
              "controlLevel": "administrative"
            },
            {
              "article": "art:기준규칙:341",
              "paragraph": 2,
              "controlLevel": "engineering"
            }
          ],
          "hazard": "hazard:fire_explosion",
          "risks": [
            {
              "statement": "천공 중 가스관·상하수도관 등 매설물을 파손해 폭발하거나 감전됨",
              "priority": "★",
              "measures": [
                {
                  "measure": "천공의 지점은 설계도서에 준하여 미리 측량하여 표식하여 두어야 한다. 이때 수직 높이의 오차가 최소가 되도록 주의하여야 하며, 천공작업 전에는 가스관, 상하수도관, 인근 구조물 등 지장물의 유무를 확인하여야 한다.",
                  "controlLevel": "administrative",
                  "basis": {
                    "guide": "doc:kosha_guide/D-C-1-2025",
                    "section": "8.1.2"
                  }
                },
                {
                  "measure": "굴착작업에 의하여 노출된 매설물 등이 파손됨으로써 근로자가 위험해질 우려가 있는 경우에는 해당 매설물 등에 대한 방호조치를 하거나 이설하는 등 필요한 조치를 한다.",
                  "controlLevel": "engineering",
                  "basis": {
                    "article": "art:기준규칙:341",
                    "paragraph": 2
                  }
                }
              ]
            }
          ]
        },
        {
          "hazardLabel": "무너짐",
          "basis": [
            {
              "guide": "doc:kosha_guide/D-C-1-2025",
              "section": "8.1.2",
              "controlLevel": "administrative"
            },
            {
              "guide": "doc:kosha_guide/D-C-1-2025",
              "section": "8.1.2",
              "controlLevel": "engineering"
            },
            {
              "article": "art:기준규칙:50",
              "item": 1,
              "controlLevel": "engineering"
            }
          ],
          "hazard": "hazard:cave_in",
          "risks": [
            {
              "statement": "천공 후 케이싱 없이 방치해 공벽이 무너지고 흙막이에 과대응력이 발생함",
              "priority": "★★",
              "measures": [
                {
                  "measure": "천공 중에는 공벽의 붕괴를 방지하기 위하여 케이싱을 설치한다. 공벽 붕괴의 우려가 없는 경우에는 예외로 한다.",
                  "controlLevel": "engineering",
                  "basis": {
                    "guide": "doc:kosha_guide/D-C-1-2025",
                    "section": "8.1.2"
                  }
                },
                {
                  "measure": "수직으로 굴착하여 천공지점이 노출된 후 장기간 방치하여 흙막이구조에 과대응력이 발생되지 않도록 후속 공정을 조속히 진행하여야 한다.",
                  "controlLevel": "administrative",
                  "basis": {
                    "guide": "doc:kosha_guide/D-C-1-2025",
                    "section": "8.1.2"
                  }
                },
                {
                  "measure": "천공 홀 바닥의 굴착 토사를 완전히 제거하여야 하며 설계 심도까지의 천공 여부를 확인하여야 한다.",
                  "controlLevel": "administrative",
                  "basis": {
                    "guide": "doc:kosha_guide/D-C-1-2025",
                    "section": "8.1.2"
                  }
                },
                {
                  "measure": "토사등이 붕괴되거나 낙하할 우려가 있는 장소에 흙막이 지보공을 설치하여 위험을 방지하기 위한 조치를 한다.",
                  "controlLevel": "engineering",
                  "basis": {
                    "article": "art:기준규칙:50",
                    "item": 1
                  }
                }
              ]
            },
            {
              "statement": "천공 각도·직경·위치가 설계와 달라 네일이 지지력을 내지 못하고 흙막이가 무너짐",
              "priority": "★",
              "measures": [
                {
                  "measure": "설계된 천공 각도 및 천공 깊이를 확인하고 장비를 설치하여야 하며, 천공 도중에는 설계 각도를 유지하고 이를 확인할 수 있도록 하여야 하고, 천공이 완료된 때에는 천공 깊이를 확인하여야 한다.",
                  "controlLevel": "administrative",
                  "basis": {
                    "guide": "doc:kosha_guide/D-C-1-2025",
                    "section": "8.1.2"
                  }
                },
                {
                  "measure": "주입재와 주변 지반과의 마찰력이 충분히 발현될 수 있도록 천공의 직경은 설계에서 정한 치수 이상을 확보하여야 한다.",
                  "controlLevel": "administrative",
                  "basis": {
                    "guide": "doc:kosha_guide/D-C-1-2025",
                    "section": "8.1.2"
                  }
                },
                {
                  "measure": "천공 지점은 수평열이 일직선이 되도록 천공 지점 높이의 오차를 최소화 하여야 한다. 이는 띠장의 위치에서 강선이 절곡될 우려가 있기 때문이며 그러할 경우에는 긴장력의 손실이 발생된다.",
                  "controlLevel": "administrative",
                  "basis": {
                    "guide": "doc:kosha_guide/D-C-1-2025",
                    "section": "8.1.2"
                  }
                },
                {
                  "measure": "동절기에 천공하는 경우에는 이수의 동결을 방지하기 위하여 온수를 사용하여야 한다.",
                  "controlLevel": "administrative",
                  "basis": {
                    "guide": "doc:kosha_guide/D-C-1-2025",
                    "section": "8.1.2"
                  }
                }
              ]
            }
          ]
        },
        {
          "hazardLabel": "건강장해",
          "basis": [
            {
              "guide": "doc:kosha_guide/D-C-1-2025",
              "section": "8.1.2",
              "controlLevel": "ppe"
            }
          ],
          "risks": [
            {
              "statement": "천공 중 비산먼지·소음에 노출되어 근로자가 건강장해를 입음",
              "priority": "★",
              "measures": [
                {
                  "measure": "천공 중에는 비산먼지 및 소음이 심하므로 근로자에게는 방진 마스크 및 귀마개를 착용하도록 하고, 천공 입구에는 비산먼지를 최소화할 수 있도록 집진장치 또는 분진 방지책을 설치하여야 한다.",
                  "controlLevel": "ppe",
                  "basis": {
                    "guide": "doc:kosha_guide/D-C-1-2025",
                    "section": "8.1.2"
                  }
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "stepName": "네일체 제작·삽입",
      "stepHazards": [
        {
          "hazardLabel": "무너짐",
          "basis": [
            {
              "guide": "doc:kosha_guide/D-C-1-2025",
              "section": "8.4.4",
              "controlLevel": "administrative"
            },
            {
              "guide": "doc:kosha_guide/D-C-1-2025",
              "section": "8.4.4",
              "controlLevel": "elimination"
            },
            {
              "guide": "doc:kosha_guide/D-C-1-2025",
              "section": "8.4.4",
              "controlLevel": "engineering"
            },
            {
              "article": "art:기준규칙:345",
              "controlLevel": "elimination"
            },
            {
              "article": "art:기준규칙:346",
              "paragraph": 1,
              "controlLevel": "administrative"
            }
          ],
          "hazard": "hazard:cave_in",
          "risks": [
            {
              "statement": "네일을 산소절단 등으로 절단해 재료 성질이 변하고 인장 저항력을 잃음",
              "priority": "★",
              "measures": [
                {
                  "measure": "네일의 절단은 기계적 방식에 의하여 절단하며 절단으로 인한 재료의 국부적 성질의 변화가 없도록 하여야 한다.",
                  "controlLevel": "elimination",
                  "basis": {
                    "guide": "doc:kosha_guide/D-C-1-2025",
                    "section": "8.4.4"
                  }
                },
                {
                  "measure": "제작된 네일체를 검수할 때에는 다음과 같은 항목을 중점적으로 확인하여야 한다.",
                  "controlLevel": "administrative",
                  "basis": {
                    "guide": "doc:kosha_guide/D-C-1-2025",
                    "section": "8.4.4"
                  }
                },
                {
                  "measure": "흙막이지보공의 재료로 변형·부식되거나 심하게 손상된 것을 사용해서는 아니 된다.",
                  "controlLevel": "elimination",
                  "basis": {
                    "article": "art:기준규칙:345"
                  }
                }
              ]
            },
            {
              "statement": "네일 길이·여유길이가 설계와 달라 지압판을 체결하지 못하고 면판이 탈락함",
              "priority": "★",
              "measures": [
                {
                  "measure": "설계도서에서 정한 네일의 길이가 확보되도록 제작되어야 하며, 지압판 및 너트를 체결할 수 있는 여유길이를 두어야 한다.",
                  "controlLevel": "engineering",
                  "basis": {
                    "guide": "doc:kosha_guide/D-C-1-2025",
                    "section": "8.4.4"
                  }
                },
                {
                  "measure": "흙막이지보공을 조립하는 경우 미리 그 구조를 검토한 후 조립도를 작성하여 그 조립도에 따라 조립하도록 한다.",
                  "controlLevel": "administrative",
                  "basis": {
                    "article": "art:기준규칙:346",
                    "paragraph": 1
                  }
                }
              ]
            },
            {
              "statement": "네일을 급하게 삽입해 공벽이 무너지거나 네일체가 손상됨",
              "priority": "★★",
              "measures": [
                {
                  "measure": "네일을 삽입할 때에는 공벽이 붕괴되거나 네일체가 손상되지 않도록 서서히 하여야 한다.",
                  "controlLevel": "administrative",
                  "basis": {
                    "guide": "doc:kosha_guide/D-C-1-2025",
                    "section": "8.4.4"
                  }
                },
                {
                  "measure": "네일을 삽입하기 전에는 네일에 부착된 먼지, 기름 등 이물질을 제거하여야 한다.",
                  "controlLevel": "administrative",
                  "basis": {
                    "guide": "doc:kosha_guide/D-C-1-2025",
                    "section": "8.4.4"
                  }
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "stepName": "네일 주입재 배합·주입",
      "stepHazards": [
        {
          "hazardLabel": "무너짐",
          "basis": [
            {
              "guide": "doc:kosha_guide/D-C-1-2025",
              "section": "8.1.3",
              "controlLevel": "administrative"
            },
            {
              "guide": "doc:kosha_guide/D-C-1-2025",
              "section": "8.1.3",
              "controlLevel": "engineering"
            }
          ],
          "hazard": "hazard:cave_in",
          "risks": [
            {
              "statement": "천공 후 오래 방치하거나 주입이 늦어져 공벽이 무너짐",
              "priority": "★★",
              "measures": [
                {
                  "measure": "공벽의 붕괴 등을 방지하기 위하여 천공 후 장기간 방치하지 않으며, 보강재 삽입 후 즉시 주입하여야 한다.",
                  "controlLevel": "engineering",
                  "basis": {
                    "guide": "doc:kosha_guide/D-C-1-2025",
                    "section": "8.1.3"
                  }
                },
                {
                  "measure": "주입재의 주입은 천공 홀 선단부에 슬라임이 완전 배출될 때 까지 1차 주입하고 케이싱을 제거한 후 공벽을 완전히 채우도록 2차 주입을 수행한다.",
                  "controlLevel": "administrative",
                  "basis": {
                    "guide": "doc:kosha_guide/D-C-1-2025",
                    "section": "8.1.3"
                  }
                }
              ]
            },
            {
              "statement": "주입재 배합강도가 부족하거나 공극이 남아 네일이 인발되며 흙막이가 무너짐",
              "priority": "★",
              "measures": [
                {
                  "measure": "배합강도는 주변토질과 인장재가 부착하여 소요강도를 발현할 수 있도록 배합되어야 하며, 주입 후 공시체를 제작하여 현장 및 실내 양생하여 인발 전 발현 강도를 확인하여야 한다.",
                  "controlLevel": "administrative",
                  "basis": {
                    "guide": "doc:kosha_guide/D-C-1-2025",
                    "section": "8.1.3"
                  }
                },
                {
                  "measure": "주입은 천공 홀 바닥에서 공내부의 물과 공기를 밀어내면서 주입되도록 하고 주입재 내부에 공극이 발생되지 않도록 하여야 한다.",
                  "controlLevel": "administrative",
                  "basis": {
                    "guide": "doc:kosha_guide/D-C-1-2025",
                    "section": "8.1.3"
                  }
