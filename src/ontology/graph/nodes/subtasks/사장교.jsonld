                  "controlLevel": "engineering",
                  "basis": {
                    "guide": "doc:kosha_guide/C-22-2011",
                    "section": "5.2"
                  }
                },
                {
                  "measure": "작업대 간 이동할 수 있는 견고한 계단 및 이동통로를 확보하여야 한다.",
                  "controlLevel": "engineering",
                  "basis": {
