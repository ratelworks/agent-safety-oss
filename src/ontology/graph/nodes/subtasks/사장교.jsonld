          "risks": [
            {
              "statement": "이동식 거푸집 인양·상승 중 자재가 낙하하거나 간섭으로 재해",
              "priority": "★",
              "measures": [
                {
                  "measure": "이동식 거푸집 인양 시 각 작업발판 위에는 낙하할 만한 자재나 공구 등이 없어야 한다.",
                  "controlLevel": "elimination",
