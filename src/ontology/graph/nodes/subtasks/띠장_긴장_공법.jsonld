            }
          ],
          "risks": [
            {
              "@id": "workrisk:띠장_긴장_공법/1.1",
              "@type": "WorkRisk",
              "statement": "띠장 이음·연속성이 부족해 긴장력이 전달되지 않고 흙막이가 무너짐",
              "priority": "★",
              "measures": [
                {
                  "@id": "workmeasure:7d8d0e070460",
                  "@type": "WorkMeasure",
                  "measure": "띠장은 끊어짐이 없이 연속해서 설치하고 띠장의 이음은 원칙적으로 엄지말뚝을 중심으로 전단력과 휨모멘트가 작은 곳에서 실시하여야 한다.",
                  "controlLevel": "engineering",
                  "basis": {
                    "basisGuide": "doc:kosha_guide/D-C-1-2025",
                    "guideSection": "8.2.2"
                  }
                },
                {
                  "@id": "workmeasure:4c703faddda8",
                  "@type": "WorkMeasure",
                  "measure": "보걸이는 띠장 1개당 2개 이상으로 설치하고 띠장보다 약 5㎝ 정도의 여유폭이 되도록 하며 4m 이내의 간격으로 설치하여야 한다.",
                  "controlLevel": "engineering",
                  "basis": {
                    "basisGuide": "doc:kosha_guide/D-C-1-2025",
                    "guideSection": "8.2.2"
                  }
                },
                {
                  "@id": "workmeasure:be342983005f",
                  "@type": "WorkMeasure",
                  "measure": "흙막이지보공을 설치하였을 때에는 부재의 손상·변형·부식·변위 및 탈락의 유무와 상태를 정기적으로 점검하고 이상을 발견하면 즉시 보수한다.",
                  "controlLevel": "engineering",
                  "basis": {
                    "basisArticle": "art:기준규칙:347",
                    "paragraph": 1,
                    "item": 1
                  }
                }
              ]
            },
            {
              "@id": "workrisk:띠장_긴장_공법/1.2",
              "@type": "WorkRisk",
              "statement": "띠장 배면 홈메우기를 하지 않아 긴장 중 띠장에 편심·변형이 발생함",
              "priority": "★",
              "measures": [
                {
                  "@id": "workmeasure:5638715f494a",
                  "@type": "WorkMeasure",
                  "measure": "다음단계의 PS 강선 긴장작업 시 발생할 수 있는 띠장의 편심, 변형 등을 방지하기 위하여 띠장 배면에 강재, 시멘트 그라우팅 등을 이용한 홈메우기 등을 사전에 시공하여야 한다.",
                  "controlLevel": "administrative",
                  "basis": {
                    "basisGuide": "doc:kosha_guide/D-C-1-2025",
                    "guideSection": "8.5.3"
                  }
                },
                {
                  "@id": "workmeasure:ab63962c6ac6",
                  "@type": "WorkMeasure",
                  "measure": "또한 PS 강선 긴장작업 중 띠장의 뒤틀림, 넘어짐 등을 방지하기 위하여 누름 브라켓(Braket) 등의 안전대책을 수립하여야 한다.",
                  "controlLevel": "administrative",
                  "basis": {
                    "basisGuide": "doc:kosha_guide/D-C-1-2025",
                    "guideSection": "8.5.3"
                  }
                }
              ]
            }
          ]
        },
        {
          "hazardLabel": "떨어짐",
          "hasHazard": "hazard:fall_from_height",
          "basis": [
