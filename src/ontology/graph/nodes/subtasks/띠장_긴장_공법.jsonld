    {
      "@id": "workstep:띠장_긴장_공법/2",
      "@type": "WorkStep",
      "stepName": "버팀보 가압·PS 강선 긴장",
      "stepHazards": [
        {
          "hazardLabel": "물체에 맞음",
          "hasHazard": "hazard:fall_object",
          "basis": [
            {
              "basisGuide": "doc:kosha_guide/D-C-1-2025",
              "guideSection": "8.5.3",
              "controlLevel": "administrative"
            },
            {
              "basisGuide": "doc:kosha_guide/D-C-1-2025",
