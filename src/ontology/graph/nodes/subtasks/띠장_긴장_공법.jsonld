            }
          ],
          "risks": [
            {
              "@id": "workrisk:띠장_긴장_공법/1.3",
              "@type": "WorkRisk",
              "statement": "띠장 위에서 작업하던 근로자가 떨어짐",
              "priority": "★★",
              "measures": [
                {
                  "@id": "workmeasure:f9969ed00cf2",
                  "@type": "WorkMeasure",
                  "measure": "띠장 설치 즉시 설치된 띠장을 따라 띠장 위 약 1.5m 높이에 안전대 부착설비를 설치하고 띠장 위에서 작업 시 안전대를 걸도록 하여야 한다.",
                  "controlLevel": "engineering",
                  "basis": {
                    "basisGuide": "doc:kosha_guide/D-C-1-2025",
                    "guideSection": "8.2.2"
                  }
                },
                {
                  "@id": "workmeasure:c7770181517c",
                  "@type": "WorkMeasure",
                  "measure": "안전대를 안전하게 걸어 사용할 수 있는 설비 등을 설치하고, 그 설비의 이상 유무를 정기적으로 점검한다.",
                  "controlLevel": "engineering",
                  "basis": {
                    "basisArticle": "art:기준규칙:44",
                    "paragraph": 1
                  }
                },
                {
                  "@id": "workmeasure:e9174f6db1d3",
                  "@type": "WorkMeasure",
                  "measure": "높이 또는 깊이 2미터 이상의 추락할 위험이 있는 장소에서 하는 작업에는 안전대를 지급하고 착용하도록 한다.",
                  "controlLevel": "ppe",
                  "basis": {
                    "basisArticle": "art:기준규칙:32",
                    "paragraph": 1,
                    "item": 2
                  }
                }
              ]
