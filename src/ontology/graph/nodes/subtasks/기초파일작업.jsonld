          "hazard": "hazard:fall_object",
          "risks": [
            {
              "statement": "항타기 조립 중 권상기에 쐐기장치·역회전방지 브레이크가 없어 감아올리던 리더가 역회전하며 떨어짐",
              "priority": "★★",
              "measures": [
                {
                  "measure": "항타기 또는 항발기에 사용하는 권상기에 쐐기장치 또는 역회전방지용 브레이크를 부착한다.",
                  "controlLevel": "engineering",
                  "basis": {
                    "article": "art:기준규칙:207",
                    "paragraph": 1,
                    "item": 1
                  }
                },
                {
                  "measure": "항타기 또는 항발기의 권상기가 들리거나 미끄러지거나 흔들리지 않도록 설치한다.",
                  "controlLevel": "engineering",
                  "basis": {
                    "article": "art:기준규칙:207",
                    "paragraph": 1,
                    "item": 2
                  }
                },
                {
                  "measure": "그 밖에 조립·해체에 필요한 사항은 제조사에서 정한 설치·해체 작업 설명서에 따른다.",
                  "controlLevel": "administrative",
                  "basis": {
                    "article": "art:기준규칙:207",
                    "paragraph": 1,
                    "item": 3
                  }
                },
                {
                  "measure": "설치·조립 또는 해체 매뉴얼에 제시된 절차를 작업팀장의 책임 하에 준수한다.",
                  "controlLevel": "administrative",
                  "basis": {
                    "guide": "doc:kosha_guide/D-C-10-2026",
                    "section": "7.7"
                  }
                },
                {
                  "measure": "항타기를 조립·해체·변경 또는 이동하는 작업의 방법과 절차를 정하여 근로자에게 주지시킨다.",
                  "controlLevel": "administrative",
                  "basis": {
                    "article": "art:기준규칙:38",
                    "paragraph": 3
                  }
                },
                {
                  "measure": "조립 작업 전에 사전에 충분한 공간을 확보한다.",
                  "controlLevel": "administrative",
                  "basis": {
                    "guide": "doc:kosha_guide/C-71-2012",
                    "section": "7"
                  }
                }
              ]
            },
            {
              "statement": "조립·해체 시 본체 연결부·리더 고정상태를 점검하지 않아 작업 중 부재가 풀려 떨어짐",
              "priority": "★",
              "measures": [
                {
                  "measure": "본체 연결부의 풀림 또는 손상의 유무를 점검한다.",
                  "controlLevel": "administrative",
                  "basis": {
                    "article": "art:기준규칙:207",
                    "paragraph": 2,
                    "item": 1
                  }
                },
                {
                  "measure": "리더(leader)의 버팀 방법 및 고정상태의 이상 유무를 점검한다.",
                  "controlLevel": "administrative",
                  "basis": {
                    "article": "art:기준규칙:207",
                    "paragraph": 2,
                    "item": 5
                  }
                },
                {
                  "measure": "본체·부속장치 및 부속품에 심한 손상·마모·변형 또는 부식이 있는지 여부를 점검한다.",
                  "controlLevel": "administrative",
                  "basis": {
                    "article": "art:기준규칙:207",
                    "paragraph": 2,
                    "item": 7
                  }
                },
                {
                  "measure": "본체·부속장치 및 부속품의 강도가 적합한지 여부를 점검한다.",
                  "controlLevel": "administrative",
                  "basis": {
                    "article": "art:기준규칙:207",
                    "paragraph": 2,
                    "item": 6
                  }
                },
                {
                  "measure": "모든 도르래, 케이블, 기계류, 훅걸이 및 항타기의 주요 부분을 작업 전에 점검하고, 마모되거나 파손된 부품이나 기계는 즉시 수리하거나 교환한다.",
                  "controlLevel": "administrative",
                  "basis": {
                    "guide": "doc:kosha_guide/C-71-2012",
                    "section": "6"
                  }
                },
                {
                  "measure": "사용 작업 전에는 산업안전보건기준에 관한 규칙 제207조(조립시 점검)에서 제221조(가스배관 등의 손상방지)에 따라 점검하고, 필요시 수리·교체 후 그 결과를 작업계획서에 기록한다.",
                  "controlLevel": "administrative",
                  "basis": {
                    "guide": "doc:kosha_guide/D-C-10-2026",
                    "section": "7.6"
                  }
                },
                {
                  "measure": "항타기·항발기를 조립·해체·변경 또는 이동하여 작업하는 경우 작업지휘자를 지정하여 지휘·감독하도록 한다.",
                  "controlLevel": "administrative",
                  "basis": {
                    "article": "art:기준규칙:39",
                    "paragraph": 2
                  }
                }
              ]
            },
            {
              "statement": "결함이 있는 권상용 와이어로프를 사용하여 인양 중 로프가 끊어지고 매단 물체가 떨어짐",
              "priority": "★★",
              "measures": [
                {
                  "measure": "권상용 와이어로프로 이음매가 있는 것 등 제63조제1항제1호 각 목에 해당하는 것을 사용하지 않는다.",
                  "controlLevel": "elimination",
                  "basis": {
                    "article": "art:기준규칙:210"
                  }
                },
                {
                  "measure": "권상용 와이어로프의 안전계수가 5 이상이 아니면 사용하지 않는다.",
                  "controlLevel": "elimination",
                  "basis": {
                    "article": "art:기준규칙:211"
                  }
                },
                {
                  "measure": "작업 전 와이어로프에 대하여 점검을 실시하고 이음매가 있는 것, 와이어로프의 한 꼬임에서 끊어진 소선의 수가 10퍼센트 이상인 것에 해당되는 것은 사용을 금지한다.",
                  "controlLevel": "elimination",
                  "basis": {
                    "guide": "doc:kosha_guide/C-71-2012",
                    "section": "7"
                  }
                },
                {
                  "measure": "권상용 와이어로프는 권상장치의 드럼에 클램프·클립 등을 사용하여 견고하게 고정한다.",
                  "controlLevel": "engineering",
                  "basis": {
                    "article": "art:기준규칙:212",
                    "item": 2
                  }
                },
                {
                  "measure": "권상용 와이어로프에서 추·해머 등과의 연결은 클램프·클립 등을 사용하여 견고하게 한다.",
                  "controlLevel": "engineering",
                  "basis": {
                    "article": "art:기준규칙:212",
                    "item": 3
                  }
                },
                {
                  "measure": "클램프·클립 등은 한국산업표준 제품이거나 한국산업표준이 없는 제품의 경우에는 이에 준하는 규격을 갖춘 제품을 사용한다.",
                  "controlLevel": "substitution",
                  "basis": {
                    "article": "art:기준규칙:212",
                    "item": 4
                  }
                },
                {
                  "measure": "도르래나 도르래 뭉치를 부착하는 경우에는 부착부가 받는 하중에 의하여 파괴될 우려가 없는 브라켓·샤클 및 와이어로프 등으로 견고하게 부착한다.",
                  "controlLevel": "engineering",
                  "basis": {
                    "article": "art:기준규칙:216",
                    "paragraph": 1
                  }
                }
              ]
            }
          ]
