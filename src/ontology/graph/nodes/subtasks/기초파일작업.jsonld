          ],
          "hazard": "hazard:struck_by_overturn",
          "risks": [
            {
              "statement": "연약한 지반에 세운 항타기의 아웃트리거가 침하하여 장비가 넘어지며 근로자를 덮침",
              "priority": "★★",
              "measures": [
                {
                  "measure": "연약한 지반에 설치하는 경우에는 아웃트리거·받침 등 지지구조물의 침하를 방지하기 위하여 깔판·받침목 등을 사용한다.",
                  "controlLevel": "engineering",
                  "basis": {
                    "article": "art:기준규칙:209",
                    "item": 1
                  }
                },
                {
                  "measure": "아웃트리거·받침 등 지지구조물이 미끄러질 우려가 있는 경우에는 말뚝 또는 쐐기 등을 사용하여 해당 지지구조물을 고정시킨다.",
                  "controlLevel": "engineering",
                  "basis": {
                    "article": "art:기준규칙:209",
                    "item": 3
                  }
                },
                {
                  "measure": "상단 부분은 버팀대·버팀줄로 고정하여 안정시키고, 그 하단 부분은 견고한 버팀·말뚝 또는 철골 등으로 고정시킨다.",
                  "controlLevel": "engineering",
                  "basis": {
                    "article": "art:기준규칙:209",
                    "item": 5
                  }
                },
                {
                  "measure": "레일 클램프는 체결 토크 300～350 N·m 이상, 아웃트리거 지지력은 장비별 요구 지지력 이상을 확보하고 쐐기·아웃트리거 등의 이상유무를 정확히 확인한다.",
                  "controlLevel": "engineering",
                  "basis": {
                    "guide": "doc:kosha_guide/D-C-10-2026",
                    "section": "7.6"
                  }
                },
                {
                  "measure": "지반의 상태를 정확히 확인한 후 장비를 정확히 고정하고 작업을 진행할 수 있도록 관리한다.",
