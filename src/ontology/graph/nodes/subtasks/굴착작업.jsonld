  "steps": [
    {
      "stepName": "굴착 장비반입",
      "stepHazards": [
        {
          "hazardLabel": "부딪힘",
          "basis": [
            {
              "guide": "doc:kosha_guide/D-C-11-2026",
              "section": "7.3.3",
              "controlLevel": "administrative"
            },
            {
              "guide": "doc:kosha_guide/D-C-11-2026",
              "section": "7.3.3",
              "controlLevel": "elimination"
            },
            {
              "article": "art:기준규칙:197",
              "controlLevel": "engineering"
            }
          ],
          "hazard": "hazard:struck_by",
          "risks": [
            {
              "statement": "면허가 없거나 과로한 운전자가 굴착기를 조작하여 오조작 재해",
              "priority": "★",
              "measures": [
                {
                  "measure": "운전자의 해당 면허소지 여부 및 건강상태를 확인하여야 하며 과로시키지 않아야 한다",
                  "controlLevel": "administrative",
                  "variant": "기본",
                  "basis": {
                    "guide": "doc:kosha_guide/D-C-11-2026",
                    "section": "7.3.3"
                  }
                },
                {
                  "measure": "작업반은 숙련자로 구성하여야 하며 신호수를 지정하여 표준 신호방법에 의해 신호하여야 한다",
                  "controlLevel": "administrative",
                  "variant": "기본",
                  "basis": {
                    "guide": "doc:kosha_guide/D-C-11-2026",
                    "section": "7.3.3"
                  }
                }
              ]
            },
            {
              "statement": "전조등·경보장치가 없는 장비를 사용하여 야간·후진 중 부딪힘",
              "priority": "★",
              "measures": [
                {
                  "measure": "차량계 건설기계에는 전조등을 갖추어야 한다",
                  "controlLevel": "engineering",
                  "variant": "기본",
                  "basis": {
                    "article": "art:기준규칙:197"
                  }
                },
                {
                  "measure": "전조등, 경보장치 등이 부착되지 않은 기계를 운전시켜서는 안 된다",
                  "controlLevel": "elimination",
                  "variant": "기본",
                  "basis": {
                    "guide": "doc:kosha_guide/D-C-11-2026",
                    "section": "7.3.3"
                  }
                }
              ]
            }
          ]
        },
        {
          "hazardLabel": "깔림",
          "basis": [
            {
              "guide": "doc:kosha_guide/D-C-11-2026",
              "section": "7.3.3",
              "controlLevel": "engineering"
            },
            {
              "guide": "doc:kosha_guide/D-C-11-2026",
              "section": "7.3.3",
              "controlLevel": "administrative"
            },
            {
              "article": "art:기준규칙:201",
              "controlLevel": "engineering"
            },
            {
              "article": "art:기준규칙:205",
              "controlLevel": "engineering"
            }
          ],
          "hazard": "hazard:struck_by_overturn",
          "risks": [
            {
              "statement": "장비를 트레일러에 싣거나 내리는 중 전도되어 깔림",
              "priority": "★★",
              "measures": [
                {
                  "measure": "차량계 건설기계를 이송하기 위하여 자주 또는 견인에 의하여 화물자동차에 싣거나 내리는 작업을 할 때에 발판·성토 등을 사용하는 경우에는 해당 차량계 건설기계의 전도 또는 굴러 떨어짐에 의한 위험을 방지하기 위하여 필요한 조치를 한다",
                  "controlLevel": "engineering",
                  "variant": "기본",
                  "basis": {
                    "article": "art:기준규칙:201"
                  }
                },
                {
                  "measure": "장비를 차량으로 운반해야 될 경우에는 전용 트레일러를 사용하여야 하며, 전용 발판을 이용하여 적재할 경우에는 장비가 전도되지 않도록 안전한 강도와 기울기, 폭 및 두께를 확보하여야 하며 발판위에서 방향을 바꾸어서는 안된다",
                  "controlLevel": "engineering",
                  "variant": "기본",
                  "basis": {
                    "guide": "doc:kosha_guide/D-C-11-2026",
                    "section": "7.3.3"
                  }
                }
              ]
            },
            {
              "statement": "붐·암을 올린 채 그 밑에서 수리하다 갑자기 내려와 깔림",
              "priority": "★★",
              "measures": [
                {
                  "measure": "차량계 건설기계의 붐·암 등을 올리고 그 밑에서 수리·점검작업 등을 하는 경우 붐·암 등이 갑자기 내려옴으로써 발생하는 위험을 방지하기 위하여 해당 작업에 종사하는 근로자에게 안전지지대 또는 안전블록 등을 사용하도록 한다",
                  "controlLevel": "engineering",
                  "variant": "기본",
                  "basis": {
                    "article": "art:기준규칙:205"
                  }
                },
                {
                  "measure": "장비의 수리 시에는 붐, 암 등이 불시에 하강함으로서 발생하는 위험 방지를 위하여 안전지주, 안전블록 등을 사용하여야 한다",
                  "controlLevel": "engineering",
                  "variant": "기본",
                  "basis": {
                    "guide": "doc:kosha_guide/D-C-11-2026",
                    "section": "7.3.3"
                  }
                },
                {
                  "measure": "장비에 이상이 발견되면 즉시 부속장치를 교환하거나 수리하여야 한다",
                  "controlLevel": "administrative",
                  "variant": "기본",
                  "basis": {
                    "guide": "doc:kosha_guide/D-C-11-2026",
                    "section": "7.3.3"
                  }
                }
              ]
            }
          ]
        },
        {
          "hazardLabel": "물체에 맞음",
          "basis": [
            {
              "guide": "doc:kosha_guide/D-C-11-2026",
              "section": "7.3.3",
              "controlLevel": "engineering"
            },
            {
              "article": "art:기준규칙:198",
              "controlLevel": "engineering"
            }
          ],
          "hazard": "hazard:fall_object",
          "risks": [
            {
              "statement": "낙석 위험 장소에서 헤드가드 없는 장비를 사용하여 맞음",
              "priority": "★",
              "measures": [
                {
                  "measure": "암석이 떨어질 우려가 있는 등 위험한 장소에서 차량계 건설기계를 사용하는 경우에는 견고한 낙하물 보호구조를 갖춰야 한다",
                  "controlLevel": "engineering",
                  "variant": "기본",
                  "basis": {
                    "article": "art:기준규칙:198"
                  }
                },
                {
                  "measure": "낙석 등의 위험이 있는 장소에서 작업할 경우에는 장비에 헤드가드 등 견고한 방호조치를 설치하여야 한다",
                  "controlLevel": "engineering",
                  "variant": "기본",
                  "basis": {
                    "guide": "doc:kosha_guide/D-C-11-2026",
                    "section": "7.3.3"
                  }
                }
              ]
            }
          ]
        }
      ]
    },
