  "steps": [
    {
      "stepName": "가설도로 벌목 및 표토제거",
      "stepHazards": [
        {
          "hazardLabel": "깔림",
          "basis": [
            {
              "article": "art:기준규칙:405",
              "item": 1,
              "controlLevel": "administrative"
            },
            {
              "article": "art:기준규칙:405",
              "item": 2,
              "controlLevel": "engineering"
            },
            {
              "article": "art:기준규칙:405",
              "item": 3,
              "controlLevel": "elimination"
            },
            {
              "article": "art:기준규칙:405",
              "controlLevel": "engineering"
            }
          ],
          "hazard": "hazard:struck_by_overturn",
          "risks": [
            {
              "statement": "벌목한 나무가 예상과 다른 방향으로 넘어져 근로자가 깔림",
              "priority": "★★",
              "measures": [
                {
                  "measure": "벌목하려는 경우에는 미리 대피로 및 대피장소를 정해 둔다.",
                  "controlLevel": "administrative",
                  "basis": {
                    "article": "art:기준규칙:405",
                    "item": 1
                  }
                },
                {
                  "measure": "벌목하려는 나무의 가슴높이지름이 20센티미터 이상인 경우에는 수구(베어지는 쪽의 밑동 부근에 만드는 쐐기 모양의 절단면)의 상면ㆍ하면의 각도를 30도 이상으로 하며, 수구 깊이는 뿌리부분 지름의 4분의 1 이상 3분의 1 이하로 만든다.",
                  "controlLevel": "engineering",
                  "basis": {
                    "article": "art:기준규칙:405",
                    "item": 2
                  }
                },
                {
                  "measure": "벌목작업 중에는 벌목하려는 나무로부터 해당 나무 높이의 2배에 해당하는 직선거리 안에서 다른 작업을 하지 않는다.",
                  "controlLevel": "elimination",
                  "basis": {
                    "article": "art:기준규칙:405",
                    "item": 3
                  }
                },
                {
                  "measure": "유압식 벌목기에는 견고한 헤드 가드(head guard)를 부착한다.",
                  "controlLevel": "engineering",
                  "basis": {
                    "article": "art:기준규칙:405"
                  }
                }
              ]
            }
          ]
        },
        {
          "hazardLabel": "물체에 맞음",
          "basis": [
            {
              "article": "art:기준규칙:197",
              "controlLevel": "engineering"
            },
            {
              "article": "art:기준규칙:198",
              "controlLevel": "engineering"
            },
            {
              "article": "art:기준규칙:202",
              "controlLevel": "elimination"
            },
            {
              "article": "art:기준규칙:203",
              "controlLevel": "administrative"
            },
            {
              "article": "art:기준규칙:405",
              "item": 4,
              "subitem": "가",
              "controlLevel": "elimination"
            },
            {
              "article": "art:기준규칙:405",
              "item": 4,
              "subitem": "나",
              "controlLevel": "elimination"
            }
          ],
          "hazard": "hazard:fall_object",
          "risks": [
            {
              "statement": "다른 나무에 걸린 나무를 무리하게 처리하다 낙하하는 나무에 맞음",
              "priority": "★",
              "measures": [
                {
                  "measure": "나무가 다른 나무에 걸려있는 경우에는 걸려있는 나무 밑에서 작업을 하지 않는다.",
                  "controlLevel": "elimination",
                  "basis": {
                    "article": "art:기준규칙:405",
                    "item": 4,
                    "subitem": "가"
                  }
                },
                {
                  "measure": "받치고 있는 나무를 벌목하지 않는다.",
                  "controlLevel": "elimination",
                  "basis": {
                    "article": "art:기준규칙:405",
                    "item": 4,
                    "subitem": "나"
                  }
                }
              ]
            },
            {
              "statement": "장비 운전자가 낙하물·전도로 재해",
              "priority": "★",
              "measures": [
                {
                  "measure": "암석이 떨어질 우려가 있는 등 위험한 장소에서 차량계 건설기계[불도저, 트랙터, 굴착기, 로더(loader), 스크레이퍼(scraper), 덤프트럭, 모터그레이더(motor grader), 로드롤러(road roller), 천공기, 항타기 및 항발기로 한정한다]를 사용하는 경우에는 해당 차량계 건설기계에 견고한 낙하물 보호구조를 갖춰야 한다.",
                  "controlLevel": "engineering",
                  "basis": {
                    "article": "art:기준규칙:198"
                  }
                },
                {
                  "measure": "어두운 장소에서 사용하는 차량계 건설기계에는 전조등을 갖추어야 하며, 다만 작업을 안전하게 수행하기 위하여 필요한 조명이 있는 장소에서 사용하는 경우에는 그러하지 아니하다.",
                  "controlLevel": "engineering",
                  "basis": {
                    "article": "art:기준규칙:197"
                  }
                },
                {
                  "measure": "차량계 건설기계의 승차석이 아닌 위치에 근로자를 탑승시켜서는 아니 된다.",
                  "controlLevel": "elimination",
                  "basis": {
                    "article": "art:기준규칙:202"
                  }
                },
                {
                  "measure": "차량계 건설기계를 사용하여 작업을 하는 경우 그 차량계 건설기계가 넘어지거나 붕괴될 위험 또는 붐ㆍ암 등 작업장치가 파괴될 위험을 방지하기 위하여 그 기계의 구조 및 사용상 안전도 및 최대사용하중을 준수하여야 한다.",
                  "controlLevel": "administrative",
                  "basis": {
                    "article": "art:기준규칙:203"
                  }
                }
              ]
            }
          ]
        },
        {
          "hazardLabel": "부딪힘",
          "basis": [
            {
              "article": "art:기준규칙:199",
              "controlLevel": "engineering"
            },
            {
              "article": "art:기준규칙:200",
              "controlLevel": "administrative"
            },
            {
              "article": "art:기준규칙:200",
              "controlLevel": "elimination"
            },
            {
              "article": "art:기준규칙:99",
              "controlLevel": "engineering"
            }
          ],
          "hazard": "hazard:struck_by",
          "risks": [
            {
              "statement": "표토제거 장비가 근로자와 접촉하여 협착",
              "priority": "★★",
              "measures": [
                {
                  "measure": "차량계 건설기계를 사용하여 작업을 하는 경우에는 운전 중인 해당 차량계 건설기계에 접촉되어 근로자가 부딪칠 위험이 있는 장소에 근로자를 출입시켜서는 아니 된다. 다만, 유도자를 배치하고 해당 차량계 건설기계를 유도하는 경우에는 그러하지 아니하다.",
                  "controlLevel": "elimination",
                  "basis": {
                    "article": "art:기준규칙:200"
                  }
                },
                {
                  "measure": "운전자는 유도자가 유도하는 대로 따라야 한다.",
                  "controlLevel": "administrative",
                  "basis": {
                    "article": "art:기준규칙:200"
                  }
                },
                {
                  "measure": "차량계 건설기계의 운전자가 운전위치를 이탈하는 경우 해당 운전자에게 포크, 버킷, 디퍼 등의 장치를 가장 낮은 위치 또는 지면에 내려 두도록 하고, 원동기를 정지시키고 브레이크를 확실히 거는 등 갑작스러운 주행이나 이탈을 방지하기 위한 조치를 하도록 하여야 한다.",
                  "controlLevel": "engineering",
                  "basis": {
                    "article": "art:기준규칙:99"
                  }
                },
                {
                  "measure": "차량계 건설기계를 사용하여 작업을 할 때에 그 기계가 넘어지거나 굴러떨어짐으로써 근로자가 위험해질 우려가 있는 경우에는 그 기계를 유도하는 사람을 배치하고 지반의 부동침하 방지, 갓길의 붕괴 방지 및 도로 폭의 유지 등 필요한 조치를 하여야 한다.",
                  "controlLevel": "engineering",
                  "basis": {
                    "article": "art:기준규칙:199"
                  }
                }
              ]
            }
          ]
        },
        {
          "hazardLabel": "무너짐",
          "basis": [
            {
              "annex": "annex:기준규칙:별표4-3호",
              "controlLevel": "administrative"
            },
            {
              "article": "art:기준규칙:14",
              "controlLevel": "engineering"
            },
            {
              "article": "art:기준규칙:37",
              "controlLevel": "elimination"
            }
          ],
          "hazard": "hazard:cave_in",
          "risks": [
            {
              "statement": "작업계획서 없이 착수하여 지반 붕괴·전도 위험이 통제되지 않음",
              "priority": "★",
              "measures": [
                {
                  "measure": "해당 기계의 굴러 떨어짐, 지반의 붕괴 등으로 인한 근로자의 위험을 방지하기 위한 해당 작업장소의 지형 및 지반상태, 차량계 건설기계의 종류 및 성능, 차량계 건설기계의 운행경로, 차량계 건설기계에 의한 작업방법을 작업계획서에 포함한다.",
                  "controlLevel": "administrative",
                  "basis": {
                    "annex": "annex:기준규칙:별표4-3호"
                  }
                },
                {
                  "measure": "비ㆍ눈ㆍ바람 또는 그 밖의 기상상태의 불안정으로 인하여 근로자가 위험해질 우려가 있는 경우 작업을 중지한다.",
                  "controlLevel": "elimination",
                  "basis": {
                    "article": "art:기준규칙:37"
                  }
                },
                {
                  "measure": "작업으로 인하여 물체가 떨어지거나 날아올 위험이 있는 경우 낙하물 방지망, 수직보호망 또는 방호선반의 설치, 출입금지구역의 설정, 보호구의 착용 등 위험을 방지하기 위하여 필요한 조치를 한다.",
                  "controlLevel": "engineering",
                  "basis": {
                    "article": "art:기준규칙:14"
                  }
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "stepName": "가설도로 시공",
      "stepHazards": [
        {
          "hazardLabel": "깔림",
          "basis": [
            {
              "article": "art:기준규칙:201",
              "controlLevel": "engineering"
            },
            {
              "guide": "doc:kosha_guide/C-114-2020",
              "section": "6.2",
              "controlLevel": "administrative"
            },
            {
              "guide": "doc:kosha_guide/C-114-2020",
              "section": "6.2",
              "controlLevel": "engineering"
            },
            {
              "article": "art:기준규칙:199",
              "controlLevel": "engineering"
            },
            {
              "article": "art:기준규칙:379",
              "item": 1,
              "controlLevel": "engineering"
            },
            {
              "article": "art:기준규칙:379",
              "item": 3,
              "controlLevel": "engineering"
            }
          ],
          "hazard": "hazard:struck_by_overturn",
          "risks": [
            {
              "statement": "가설도로가 견고하지 않아 운행 중 장비가 전도",
              "priority": "★★",
              "measures": [
                {
                  "measure": "도로는 장비와 차량이 안전하게 운행할 수 있도록 견고하게 설치한다.",
                  "controlLevel": "engineering",
                  "basis": {
                    "article": "art:기준규칙:379",
                    "item": 1
                  }
                },
                {
                  "measure": "차량계 건설기계를 사용하여 작업을 할 때에 그 기계가 넘어지거나 굴러떨어짐으로써 근로자가 위험해질 우려가 있는 경우에는 그 기계를 유도하는 사람을 배치하고 지반의 부동침하 방지, 갓길의 붕괴 방지 및 도로 폭의 유지 등 필요한 조치를 하여야 한다.",
                  "controlLevel": "engineering",
                  "basis": {
                    "article": "art:기준규칙:199"
                  }
                },
                {
                  "measure": "관리감독자는 이동경로와 진·출입로 및 화물을 싣거나 내리는 장소의 지반 부동침하와 갓길 붕괴방지 조치를 하여야 한다.",
                  "controlLevel": "engineering",
                  "basis": {
                    "guide": "doc:kosha_guide/C-114-2020",
                    "section": "6.2"
                  }
                },
                {
                  "measure": "운전자는 운행 중 차량의 전도․전락 등의 위험이 발생하지 않도록 지반의 평탄성 등 지반의 안전 상태를 확인하며 운전하여야 한다.",
                  "controlLevel": "administrative",
                  "basis": {
                    "guide": "doc:kosha_guide/C-114-2020",
                    "section": "6.2"
                  }
                }
              ]
            },
            {
              "statement": "도로 배수 불량으로 노면이 연약해져 침하·전도",
              "priority": "★",
              "measures": [
                {
                  "measure": "도로는 배수를 위하여 경사지게 설치하거나 배수시설을 설치한다.",
                  "controlLevel": "engineering",
                  "basis": {
                    "article": "art:기준규칙:379",
                    "item": 3
                  }
                }
              ]
            },
            {
              "statement": "건설기계 이송을 위해 발판으로 싣고 내리다 전도",
              "priority": "★",
              "measures": [
                {
                  "measure": "차량계 건설기계를 이송하기 위하여 자주(自主) 또는 견인에 의하여 화물자동차 등에 싣거나 내리는 작업을 할 때에 발판ㆍ성토 등을 사용하는 경우에는 차량계 건설기계의 넘어짐 또는 굴러떨어짐에 의한 위험을 방지하기 위하여 싣거나 내리는 작업은 평탄하고 견고한 장소에서 하여야 한다.",
                  "controlLevel": "engineering",
                  "basis": {
                    "article": "art:기준규칙:201"
                  }
                },
                {
                  "measure": "발판을 사용하는 경우에는 충분한 길이ㆍ폭 및 강도를 가진 것을 사용하고 적당한 경사를 유지하기 위하여 견고하게 설치할 것을 준수하여야 한다.",
                  "controlLevel": "engineering",
                  "basis": {
                    "article": "art:기준규칙:201"
                  }
                },
                {
                  "measure": "가설대 등을 사용하는 경우에는 충분한 폭ㆍ강도와 적당한 경사를 확보할 것을 준수하여야 한다.",
                  "controlLevel": "engineering",
                  "basis": {
                    "article": "art:기준규칙:201"
                  }
