    {
      "@id": "workstep:MSS/2",
      "@type": "WorkStep",
      "stepName": "MSS 비계 이동·시공·해체",
      "stepHazards": [
        {
          "hazardLabel": "무너짐",
          "hasHazard": "hazard:cave_in",
