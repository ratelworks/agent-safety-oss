              "controlLevel": "administrative"
            }
          ],
          "risks": [
            {
              "@id": "workrisk:MSS/1.4",
              "@type": "WorkRisk",
              "statement": "비계보를 공중에서 연결하다 근로자가 떨어짐",
              "priority": "★",
              "measures": [
                {
                  "@id": "workmeasure:e0143e6d3601",
                  "@type": "WorkMeasure",
                  "measure": "비계보 분절을 크레인으로 인양하여 공중에서 연결할 때에는 작업대(Cage)를 설치하여 작업하도록 하는 등 추락재해 예방조치를 하여야 한다.",
                  "controlLevel": "engineering",
                  "basis": {
                    "basisGuide": "doc:kosha_guide/D-C-2-2025",
                    "guideSection": "9.2"
                  }
                },
                {
                  "@id": "workmeasure:247de2c2fdba",
                  "@type": "WorkMeasure",
                  "measure": "가로보 및 추진코를 크레인 등으로 인양하여 공중에서 비계보에 조립할 때에는 작업대 등을 설치하여 추락재해를 예방하여야 한다.",
                  "controlLevel": "engineering",
                  "basis": {
                    "basisGuide": "doc:kosha_guide/D-C-2-2025",
                    "guideSection": "9.2"
                  }
                },
                {
                  "@id": "workmeasure:c86e056bcf87",
                  "@type": "WorkMeasure",
                  "measure": "외부 거푸집 조립시에는 측면 거푸집의 작업발판 단부에 미리 지상에서 표준안전난간을 설치한 후 인양하여 조립하여야 한다.",
                  "controlLevel": "engineering",
                  "basis": {
                    "basisGuide": "doc:kosha_guide/D-C-2-2025",
                    "guideSection": "9.2"
                  }
                },
                {
                  "@id": "workmeasure:1735a49b0bdf",
                  "@type": "WorkMeasure",
                  "measure": "이동식 비계에 설치하는 작업발판, 통로, 안전난간 등 안전시설은 고정형으로 설치하는 것을 원칙으로 한다.",
                  "controlLevel": "engineering",
                  "basis": {
                    "basisGuide": "doc:kosha_guide/D-C-2-2025",
                    "guideSection": "9.5"
                  }
                },
                {
                  "@id": "workmeasure:0d4218ac3da0",
                  "@type": "WorkMeasure",
                  "measure": "이동식 비계 제작공장에서 설치할 안전시설은 운반 및 보관하는 동안 손상되지 않도록 관리하고, 운반 시 손상을 방지하기 위하여 안전시설을 분리할 때는 인양하여 설치하기 전에 지상에서 미리 부착하여야 한다.",
                  "controlLevel": "administrative",
                  "basis": {
                    "basisGuide": "doc:kosha_guide/D-C-2-2025",
                    "guideSection": "9.5"
                  }
                },
                {
                  "@id": "workmeasure:b1103f53b3f8",
                  "@type": "WorkMeasure",
                  "measure": "추락 및 낙하ㆍ비래 재해예방을 위한 안전방망은 부재의 조립ㆍ해체 등 고소작업을 시작하기 전에 고소작업장 하부 전체에 걸쳐 견실하게 설치하여야 한다.",
                  "controlLevel": "engineering",
                  "basis": {
                    "basisGuide": "doc:kosha_guide/D-C-2-2025",
                    "guideSection": "9.5"
                  }
                }
              ]
            }
          ]
        },
