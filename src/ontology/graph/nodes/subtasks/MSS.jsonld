          ],
          "risks": [
            {
              "@id": "workrisk:MSS/1.5",
              "@type": "WorkRisk",
              "statement": "외부 거푸집 인양·설치 중 하부 근로자가 맞음",
              "priority": "★",
              "measures": [
                {
                  "@id": "workmeasure:872ef03d6c8a",
                  "@type": "WorkMeasure",
                  "measure": "외부 거푸집을 크레인으로 인양하여 설치할 경우에는 신호수를 배치하고 하부의 근로자를 대피시킨 상태에서 하부의 지주 연결핀을 체결하여야 한다.",
                  "controlLevel": "elimination",
                  "basis": {
                    "basisGuide": "doc:kosha_guide/D-C-2-2025",
                    "guideSection": "9.2"
                  }
                },
                {
                  "@id": "workmeasure:66b88bbe7982",
                  "@type": "WorkMeasure",
                  "measure": "이동식 비계의 각 부재를 크레인으로 인양할 때에는 인양용 와이어로프를 부재의 2지점 이상에 결속하고 별도의 유도 로프를 설치하여 안전하게 유도하여야 하고, 공중에서 연결할 때는 작업이 종료될 때까지 크레인에 부재를 확실하게 매달고 있어야 한다.",
                  "controlLevel": "engineering",
                  "basis": {
                    "basisGuide": "doc:kosha_guide/D-C-2-2025",
                    "guideSection": "9.1"
                  }
                },
                {
                  "@id": "workmeasure:83f0c3c86d25",
                  "@type": "WorkMeasure",
                  "measure": "낙하물로부터 통행차량을 보호하기 위하여 도로횡단구간의 이동식 비계 하부에 안전방망 또는 방호선반을 설치하여야 한다.",
                  "controlLevel": "engineering",
                  "basis": {
                    "basisGuide": "doc:kosha_guide/D-C-2-2025",
                    "guideSection": "9.5"
                  }
                },
                {
                  "@id": "workmeasure:afb008c5b65d",
                  "@type": "WorkMeasure",
                  "measure": "작업으로 인하여 물체가 떨어지거나 날아올 위험이 있는 경우 낙하물 방지망, 수직보호망 또는 방호선반의 설치, 출입금지구역의 설정, 보호구의 착용 등 위험을 방지하기 위하여 필요한 조치를 한다.",
                  "controlLevel": "engineering",
                  "basis": {
                    "basisArticle": "art:기준규칙:14"
                  }
                }
              ]
            }
          ]
        }
      ]
