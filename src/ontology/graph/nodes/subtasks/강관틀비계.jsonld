              "item": 5,
              "controlLevel": "engineering"
            }
          ],
          "hazard": "hazard:cave_in",
          "risks": [
            {
              "statement": "밑받침철물을 쓰지 않거나 고저차를 조정하지 않아 기울어 무너짐",
              "priority": "★★",
              "measures": [
                {
                  "measure": "비계기둥의 밑둥에는 밑받침 철물을 사용하여야 하며 밑받침에 고저차가 있는 경우에는 조절형 밑받침철물을 사용하여 각각의 강관틀비계가 항상 수평 및 수직을 유지하도록 한다",
                  "controlLevel": "engineering",
                  "basis": {
                    "article": "art:기준규칙:62",
                    "item": 1
                  }
                }
              ]
            },
            {
              "statement": "주틀 간격이 기준을 초과하여 좌굴됨",
              "priority": "★",
              "measures": [
                {
                  "measure": "높이가 20미터를 초과하거나 중량물의 적재를 수반하는 작업을 할 경우에는 주틀 간의 간격을 1.8미터 이하로 한다",
                  "controlLevel": "engineering",
                  "basis": {
                    "article": "art:기준규칙:62",
                    "item": 2
                  }
                }
              ]
            },
            {
              "statement": "교차가새·수평재를 빠뜨려 틀이 변형되어 무너짐",
              "priority": "★★",
              "measures": [
                {
                  "measure": "주틀 간에 교차 가새를 설치하고 최상층 및 5층 이내마다 수평재를 설치한다",
                  "controlLevel": "engineering",
                  "basis": {
                    "article": "art:기준규칙:62",
                    "item": 3
                  }
                }
              ]
            },
            {
              "statement": "벽이음 간격을 초과하여 비계가 무너짐",
              "priority": "★★",
              "measures": [
                {
                  "measure": "수직방향으로 6미터, 수평방향으로 8미터 이내마다 벽이음을 한다",
                  "controlLevel": "engineering",
                  "basis": {
                    "article": "art:기준규칙:62",
                    "item": 4
                  }
                }
              ]
            },
            {
              "statement": "폭이 좁고 높은 구간에 버팀기둥을 설치하지 않아 전도됨",
              "priority": "★",
              "measures": [
                {
                  "measure": "길이가 띠장 방향으로 4미터 이하이고 높이가 10미터를 초과하는 경우에는 10미터 이내마다 띠장 방향으로 버팀기둥을 설치한다",
                  "controlLevel": "engineering",
                  "basis": {
                    "article": "art:기준규칙:62",
                    "item": 5
                  }
                }
              ]
            }
          ]
        }
      ]
    },
