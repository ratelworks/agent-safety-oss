              "measures": [
                {
                  "@id": "workmeasure:cb8b90c4f27f",
                  "@type": "WorkMeasure",
                  "measure": "천공작업중 이상 용출수의 다량 발생시 작업을 중지하고 긴급 방수대책을 실시하여야 하며 상부 수직시추 및 수평시추를 실시하여 채수대 여부를 확인후 적절한 보강공법 및 공법변경 등의 조치를 취한다.",
                  "controlLevel": "elimination",
                  "basis": {
                    "basisGuide": "doc:kosha_guide/C-45-2012",
