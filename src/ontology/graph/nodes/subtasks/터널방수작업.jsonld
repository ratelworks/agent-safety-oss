          "risks": [
            {
              "@id": "workrisk:터널방수작업/1.1",
              "@type": "WorkRisk",
              "statement": "산소농도·유해가스를 측정하지 않고 방수작업 공간에 들어가 질식",
              "priority": "★★",
              "measures": [
                {
                  "@id": "workmeasure:436dcb5590cd",
                  "@type": "WorkMeasure",
                  "measure": "밀폐공간에서 근로자에게 작업을 하도록 하는 경우 작업을 시작하기 전에 밀폐공간의 산소 및 유해가스 농도의 측정 및 평가에 관한 지식과 실무경험이 있는 자를 지정하여 그로 하여금 해당 밀폐공간의 산소 및 유해가스 농도를 측정하여 적정공기가 유지되고 있는지를 평가하도록 해야 한다.",
                  "controlLevel": "administrative",
                  "basis": {
                    "basisArticle": "art:기준규칙:619의2"
                  }
                },
                {
                  "@id": "workmeasure:45a41e149c5f",
                  "@type": "WorkMeasure",
                  "measure": "산소농도 및 유해가스 유무를 확인하기 위해 작업장소의 수직방향 및 수평방향으로 각각 3개소 이상 측정하여야 하며 측정가스 기준농도는 산소 18% ~ 23.5%, 탄산가스 1.5% 미만, 황화수소 10ppm 미만, 가연성가스 하한치 10% 이하로 한다.",
                  "controlLevel": "administrative",
                  "basis": {
                    "basisGuide": "doc:kosha_guide/C-14-2012",
                    "guideSection": "4.1"
                  }
                },
                {
                  "@id": "workmeasure:e8fad0ec96d6",
                  "@type": "WorkMeasure",
                  "measure": "작업 전에 산소농도를 측정하여 산소농도가 18% 이상 23.5% 미만으로 유지될 수 있도록 한다.",
                  "controlLevel": "administrative",
                  "basis": {
                    "basisGuide": "doc:kosha_guide/C-14-2012",
                    "guideSection": "4.2"
                  }
                },
                {
                  "@id": "workmeasure:c7b3b9bdeed8",
                  "@type": "WorkMeasure",
                  "measure": "산소 및 유해가스 농도를 측정한 결과 적정공기가 유지되고 있지 아니하다고 평가된 경우에는 작업장을 환기시키거나, 근로자에게 공기호흡기 또는 송기마스크를 지급하여 착용하도록 하는 등 근로자의 건강장해 예방을 위하여 필요한 조치를 한다.",
                  "controlLevel": "engineering",
                  "basis": {
                    "basisArticle": "art:기준규칙:619의2"
                  }
                },
                {
                  "@id": "workmeasure:97c310c02ae9",
                  "@type": "WorkMeasure",
                  "measure": "밀폐공간의 산소 및 유해가스 농도를 측정 및 평가하는 자에 대하여 밀폐공간에서 작업을 시작하기 전에 밀폐공간의 위험성, 측정장비의 이상 유무 확인 및 조작 방법, 밀폐공간 내에서의 산소 및 유해가스 농도 측정방법, 적정공기의 기준과 평가 방법의 숙지여부를 확인하고 필요한 교육을 실시해야 한다.",
                  "controlLevel": "administrative",
                  "basis": {
                    "basisArticle": "art:기준규칙:619의2"
                  }
                },
                {
                  "@id": "workmeasure:95436cd784ba",
                  "@type": "WorkMeasure",
                  "measure": "작업 전이나 작업 중 유해가스 및 산소농도의 측정장소, 측정방법 등 계획을 수립한다.",
                  "controlLevel": "administrative",
                  "basis": {
                    "basisGuide": "doc:kosha_guide/C-14-2012",
                    "guideSection": "4.1"
                  }
                }
              ]
            },
            {
              "@id": "workrisk:터널방수작업/1.2",
              "@type": "WorkRisk",
              "statement": "환기가 불충분하거나 중단된 상태에서 작업을 계속하여 질식",
              "priority": "★★",
              "measures": [
                {
                  "@id": "workmeasure:b0dffe0d0539",
                  "@type": "WorkMeasure",
                  "measure": "밀폐공간에서 작업을 하는 경우에 작업을 시작하기 전과 작업 중에 해당 작업장을 적정공기 상태가 유지되도록 환기하여야 하며, 폭발이나 산화 등의 위험으로 인하여 환기할 수 없거나 작업의 성질상 환기하기가 매우 곤란한 경우에는 근로자에게 공기호흡기 또는 송기마스크를 지급하여 착용하도록 한다.",
                  "controlLevel": "engineering",
                  "basis": {
                    "basisArticle": "art:기준규칙:620"
                  }
                },
                {
                  "@id": "workmeasure:f04701293e26",
                  "@type": "WorkMeasure",
                  "measure": "작업 중에 정전 등에 의한 환기 중단 시에는 즉시 외부로 대피한다.",
                  "controlLevel": "elimination",
                  "basis": {
                    "basisGuide": "doc:kosha_guide/C-14-2012",
                    "guideSection": "4.2"
                  }
                },
                {
                  "@id": "workmeasure:9d0f1c00c4ee",
                  "@type": "WorkMeasure",
                  "measure": "작업 중에 산소농도의 지속적 측정으로 산소농도 결핍우려가 있을 경우 근로자를 즉시 대피시킬 수 있도록 한다.",
                  "controlLevel": "elimination",
                  "basis": {
                    "basisGuide": "doc:kosha_guide/C-14-2012",
                    "guideSection": "4.2"
                  }
                },
                {
                  "@id": "workmeasure:4ff9949af429",
                  "@type": "WorkMeasure",
                  "measure": "작업 중에 수시로 유해가스 상태를 점검하고 유해가스의 농도가 기준치를 초과하였을 경우는 추가 환기 할 수 있도록 조치한다.",
                  "controlLevel": "engineering",
                  "basis": {
                    "basisGuide": "doc:kosha_guide/C-14-2012",
                    "guideSection": "4.2"
                  }
                },
                {
                  "@id": "workmeasure:8ef17cc648ab",
                  "@type": "WorkMeasure",
                  "measure": "밀폐공간 작업장의 환기를 위한 급기구는 외부의 신선한 공기를 공급할 수 있도록 설치하여야 하며, 배기구는 유해한 공기를 외부로 배출되도록 설치하되 배출된 유해한 공기가 다시 유입되지 않는 구조로 설치하여 작업장 내 공기를 적정한 공기 상태로 유지한다.",
                  "controlLevel": "engineering",
                  "basis": {
                    "basisGuide": "doc:kosha_guide/C-14-2012",
                    "guideSection": "4.2"
                  }
                },
                {
                  "@id": "workmeasure:d8ccb0920d90",
                  "@type": "WorkMeasure",
                  "measure": "작업 전 및 작업 중 산소농도를 측정하여 적정한 공기상태로 유지되도록 환기설비 계획을 수립하여야 하며 환기량은 적정한 필요 환기량을 산정하여 강제 환기를 실시한다.",
                  "controlLevel": "engineering",
                  "basis": {
                    "basisGuide": "doc:kosha_guide/C-14-2012",
                    "guideSection": "4.1"
                  }
                },
                {
                  "@id": "workmeasure:14f0042cfce0",
                  "@type": "WorkMeasure",
                  "measure": "작업 전 및 작업 중 유해가스를 조사하여 유해가스의 처리방법ㆍ시기 등의 계획을 수립한다.",
                  "controlLevel": "administrative",
                  "basis": {
                    "basisGuide": "doc:kosha_guide/C-14-2012",
                    "guideSection": "4.1"
                  }
                }
              ]
            },
            {
              "@id": "workrisk:터널방수작업/1.3",
              "@type": "WorkRisk",
              "statement": "사고 발생을 외부가 인지하지 못해 구조가 지연되어 사망",
              "priority": "★",
              "measures": [
                {
                  "@id": "workmeasure:2997ac53f2e3",
                  "@type": "WorkMeasure",
                  "measure": "근로자가 밀폐공간에서 작업을 하는 동안 작업상황을 감시할 수 있는 감시인을 지정하여 밀폐공간 외부에 배치한다.",
                  "controlLevel": "administrative",
                  "basis": {
                    "basisArticle": "art:기준규칙:623"
                  }
                },
                {
                  "@id": "workmeasure:aa0623040ae7",
                  "@type": "WorkMeasure",
                  "measure": "감시인은 밀폐공간에 종사하는 근로자에게 이상이 있을 경우에 구조요청 등 필요한 조치를 한 후 이를 즉시 관리감독자에게 알려야 한다.",
                  "controlLevel": "administrative",
                  "basis": {
                    "basisArticle": "art:기준규칙:623"
