                  "controlLevel": "administrative",
                  "basis": {
                    "basisGuide": "doc:kosha_guide/C-14-2012",
                    "guideSection": "4.1"
                  }
                },
                {
                  "@id": "workmeasure:c24dc7efeb49",
                  "@type": "WorkMeasure",
                  "measure": "공기호흡기 또는 송기마스크 등 호흡용 보호구 지급 및 점검계획을 수립한다.",
                  "controlLevel": "ppe",
