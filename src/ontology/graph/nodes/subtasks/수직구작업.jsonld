            }
          ],
          "risks": [
            {
              "@id": "workrisk:수직구작업/1.1",
              "@type": "WorkRisk",
              "statement": "연약지층을 정밀조사하지 않고 수직갱을 굴착하여 굴착 중 붕괴",
              "priority": "★★",
              "measures": [
                {
                  "@id": "workmeasure:d33cefbb234e",
                  "@type": "WorkMeasure",
                  "measure": "작업구, 환기구 등 수직갱 굴착계획구간의 연약지층ㆍ지반을 정밀조사하여야 하며 필요시 발주자와 협의한 다음 지반보강말뚝공법, 지반고결공법, 그라우팅 등의 보강 조치를 취하여 굴착중 발생되는 붕괴에 대비하여 안전한 공법을 계획한다.",
                  "controlLevel": "elimination",
                  "basis": {
                    "basisGuide": "doc:kosha_guide/C-45-2012",
                    "guideSection": "4"
                  }
                },
                {
                  "@id": "workmeasure:7327e6edf0ef",
                  "@type": "WorkMeasure",
                  "measure": "지질 및 지층에 관한 조사를 실시하고 시추(보링)위치, 토층분포상태, 투수계수, 지하수위, 지반의 지지력을 확인한다.",
                  "controlLevel": "administrative",
                  "basis": {
                    "basisGuide": "doc:kosha_guide/C-45-2012",
                    "guideSection": "4"
                  }
                },
                {
                  "@id": "workmeasure:b559d639d7ce",
                  "@type": "WorkMeasure",
                  "measure": "설계도서의 시추결과표 및 주상도 등에 명시된 시추공 이외에 중요구조물의 축조, 인접구조물의 지반상태 및 위험지장물 등 상세한 지반ㆍ지층 상황을 사전에 조사하여야 하며 필요시 발주자와 협의한 다음 추가시추를 실시한다.",
                  "controlLevel": "administrative",
                  "basis": {
                    "basisGuide": "doc:kosha_guide/C-45-2012",
                    "guideSection": "4"
                  }
                },
                {
                  "@id": "workmeasure:4cacf24f160e",
                  "@type": "WorkMeasure",
                  "measure": "굴착방법 및 순서, 토사등 반출 방법, 필요한 인원 및 장비 사용계획, 매설물 등에 대한 이설ㆍ보호대책, 사업장 내 연락방법 및 신호방법, 흙막이 지보공 설치방법 및 계측계획, 작업지휘자의 배치계획을 작업계획서에 포함한다.",
                  "controlLevel": "administrative",
                  "basis": {
                    "basisAnnex": "annex:기준규칙:별표4-6호"
                  }
                }
              ]
            },
            {
              "@id": "workrisk:수직구작업/1.2",
              "@type": "WorkRisk",
              "statement": "그라우팅 주입재 배합·주입 불량으로 공벽이 붕괴",
              "priority": "★",
              "measures": [
                {
                  "@id": "workmeasure:80ffc9450668",
                  "@type": "WorkMeasure",
                  "measure": "공벽의 붕괴 등을 방지하기 위하여 천공 후 장기간 방치하지 않으며, 보강재 삽입 후 즉시 주입한다.",
                  "controlLevel": "administrative",
                  "basis": {
                    "basisGuide": "doc:kosha_guide/D-C-1-2025",
                    "guideSection": "8.1"
                  }
                },
                {
                  "@id": "workmeasure:273108f67b4c",
                  "@type": "WorkMeasure",
                  "measure": "천공 중에는 공벽의 붕괴를 방지하기 위하여 케이싱을 설치한다.",
                  "controlLevel": "engineering",
                  "basis": {
                    "basisGuide": "doc:kosha_guide/D-C-1-2025",
                    "guideSection": "8.1"
                  }
                },
                {
                  "@id": "workmeasure:bc1df0e588e4",
                  "@type": "WorkMeasure",
                  "measure": "주입은 천공 홀 바닥에서 공내부의 물과 공기를 밀어내면서 주입되도록 하고 주입재 내부에 공극이 발생되지 않도록 한다.",
                  "controlLevel": "administrative",
                  "basis": {
                    "basisGuide": "doc:kosha_guide/D-C-1-2025",
                    "guideSection": "8.1"
                  }
                },
                {
                  "@id": "workmeasure:caea09ed0e3b",
                  "@type": "WorkMeasure",
                  "measure": "배합강도는 주변토질과 인장재가 부착하여 소요강도를 발현할 수 있도록 배합되어야 하며, 주입 후 공시체를 제작하여 현장 및 실내 양생하여 인발 전 발현 강도를 확인한다.",
                  "controlLevel": "administrative",
                  "basis": {
                    "basisGuide": "doc:kosha_guide/D-C-1-2025",
                    "guideSection": "8.1"
                  }
                }
              ]
            }
          ]
