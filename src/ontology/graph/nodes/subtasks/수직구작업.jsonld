            }
          ],
          "risks": [
            {
              "@id": "workrisk:수직구작업/1.4",
              "@type": "WorkRisk",
              "statement": "천공 장비가 이동 중 전도되거나 근로자와 충돌",
              "priority": "★",
              "measures": [
                {
                  "@id": "workmeasure:6990e509e153",
                  "@type": "WorkMeasure",
                  "measure": "천공 장비를 이동할 경우에는 장비의 전도·전락을 방지하기 위하여 이동통로의 안전성을 확보하여야 하며, 근로자의 협착 및 충돌 재해를 방지하기 위하여 이동 경로에는 출입 통제를 한다.",
                  "controlLevel": "administrative",
                  "basis": {
                    "basisGuide": "doc:kosha_guide/D-C-1-2025",
                    "guideSection": "8.1"
                  }
                },
                {
                  "@id": "workmeasure:0b91d9cda977",
                  "@type": "WorkMeasure",
                  "measure": "천공 장비는 천공 작업 중 흔들림, 이동 등이 없도록 설치 지반을 정지한다.",
                  "controlLevel": "engineering",
                  "basis": {
                    "basisGuide": "doc:kosha_guide/D-C-1-2025",
                    "guideSection": "8.1"
                  }
                },
                {
                  "@id": "workmeasure:8650a627bc3f",
                  "@type": "WorkMeasure",
                  "measure": "천공 장비의 조정원은 건설기계관리법에 규정된 공기압축기 면허를 갖춘 자로 한다.",
                  "controlLevel": "administrative",
                  "basis": {
                    "basisGuide": "doc:kosha_guide/D-C-1-2025",
                    "guideSection": "8.1"
                  }
                }
              ]
            }
          ]
