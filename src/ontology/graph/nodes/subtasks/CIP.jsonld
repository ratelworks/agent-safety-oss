          "risks": [
            {
              "@id": "workrisk:CIP/4.2",
              "@type": "WorkRisk",
              "statement": "근입깊이·수직도가 확보되지 않은 벽체가 굴착 후 측압을 못 버티고 무너짐",
              "priority": "★",
              "measures": [
                {
                  "@id": "workmeasure:0405f2b7b156",
                  "@type": "WorkMeasure",
                  "measure": "흙막이 벽체의 선단은 설계도서에 의거 충분한 근입깊이를 확보한다.",
                  "controlLevel": "administrative",
