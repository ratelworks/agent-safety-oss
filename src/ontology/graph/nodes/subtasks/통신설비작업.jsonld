          ],
          "hazard": "hazard:struck_by_overturn",
          "risks": [
            {
              "statement": "케이블 드럼·트레이 자재를 취급하다 굴러 덮치거나 깔림",
              "priority": "★",
              "measures": [
                {
                  "measure": "드럼통 등 구를 위험이 있는 중량물을 보관하거나 작업 중 취급하는 경우에는 구름멈춤대와 쐐기 등을 이용하여 중량물의 동요나 이동을 조절한다.",
                  "controlLevel": "engineering",
                  "basis": {
                    "article": "art:기준규칙:386",
                    "item": 1
                  }
                },
                {
                  "measure": "중량물이 구를 위험이 있는 방향 앞의 일정거리 이내로는 근로자의 출입을 제한하며, 보관하거나 작업 중인 장소가 경사면인 경우에는 경사면 아래로 출입을 제한한다.",
                  "controlLevel": "administrative",
                  "basis": {
                    "article": "art:기준규칙:386",
                    "item": 2
                  }
                },
                {
                  "measure": "중량물을 운반하거나 취급하는 경우에는 하역운반기계 또는 운반용구를 사용한다.",
                  "controlLevel": "engineering",
                  "basis": {
                    "article": "art:기준규칙:385"
                  }
                },
                {
                  "measure": "부재의 현장 반입은 작업공정 순서에 맞게 이루어지도록 하고 불필요한 과다 반입과 소운반을 최소화한다.",
                  "controlLevel": "administrative",
                  "basis": {
                    "guide": "doc:kosha_guide/C-17-2011",
                    "section": "6.1"
                  }
                }
              ]
            }
          ]
        },
        {
          "hazardLabel": "건강장해",
          "basis": [
            {
              "guide": "doc:kosha_guide/C-17-2011",
              "section": "6.3",
              "controlLevel": "administrative"
            },
            {
              "guide": "doc:kosha_guide/C-17-2011",
              "section": "6.1",
              "controlLevel": "administrative"
            }
          ],
          "risks": [
            {
              "statement": "케이블 드럼을 반복 인력운반하여 근골격계 부담이 누적",
              "priority": "★",
              "measures": [
                {
                  "measure": "자재운반 작업 시에는 근골격계 질환예방을 위한 운반물 무게의 적정성이 유지되어야 하며, 남자는 20~30kgf, 여자는 10~15kgf 이하로 한다.",
                  "controlLevel": "administrative",
                  "basis": {
                    "guide": "doc:kosha_guide/C-17-2011",
                    "section": "6.3"
                  }
                },
                {
                  "measure": "5kgf 이상의 자재를 들어서 운반하는 경우 취급물품에 대하여 작업근로자가 쉽게 알아볼 수 있도록 물품의 중량과 무게중심에 대하여 작업장 주변에 안내표시를 한다.",
                  "controlLevel": "administrative",
                  "basis": {
                    "guide": "doc:kosha_guide/C-17-2011",
                    "section": "6.3"
                  }
                },
                {
                  "measure": "건축물 내부 부재 소운반 시에는 부재별 형상에 적합한 소운반 장비를 선정하여 사용한다.",
                  "controlLevel": "administrative",
                  "basis": {
                    "guide": "doc:kosha_guide/C-17-2011",
                    "section": "6.1"
                  }
                }
              ]
            }
          ]
        }
      ]
