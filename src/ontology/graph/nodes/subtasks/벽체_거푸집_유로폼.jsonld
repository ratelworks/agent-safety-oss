          "risks": [
            {
              "@id": "workrisk:벽체_거푸집_유로폼/1.1",
              "@type": "WorkRisk",
              "statement": "흠집·옹이 많거나 접착이 떨어진 합판 거푸집 널을 사용하여 구조 약화로 무너짐",
              "measures": [
                {
                  "@id": "workmeasure:6ce2abc296d0",
                  "@type": "WorkMeasure",
                  "measure": "목재 거푸집은 흠집 및 옹이가 많거나 합판의 접착 부분이 떨어져 구조적으로 약 한 것을 사용하지 않는다",
                  "controlLevel": "elimination",
                  "basis": {
                    "basisGuide": "doc:kosha_guide/D-C-15-2026",
                    "guideSection": "5.2"
                  }
                },
                {
                  "@id": "workmeasure:7076abc5f204",
                  "@type": "WorkMeasure",
                  "measure": "거푸집 널은 다음 사항에 적합한 것을 사용한다",
                  "controlLevel": "substitution",
                  "basis": {
                    "basisGuide": "doc:kosha_guide/D-C-9-2026",
                    "guideSection": "5"
                  }
                },
                {
                  "@id": "workmeasure:867e5d2defd9",
                  "@type": "WorkMeasure",
                  "measure": "흠집 및 옹이가 많은 거푸집 널재나 접착부분이 떨어져 구조적으로 약한 합판을 사용하지 않는다",
                  "controlLevel": "elimination",
                  "basis": {
                    "basisGuide": "doc:kosha_guide/D-C-9-2026",
                    "guideSection": "5"
                  }
                }
              ]
            },
            {
              "@id": "workrisk:벽체_거푸집_유로폼/1.2",
              "@type": "WorkRisk",
              "statement": "변형·찌그러짐·비틀림 있는 강재 거푸집 널을 사용하여 지지력 부족으로 무너짐",
              "measures": [
                {
                  "@id": "workmeasure:e89b2da6039f",
                  "@type": "WorkMeasure",
                  "measure": "강재 거푸집은 형상이 찌그러지거나, 비틀림 등 변형이 있는 것은 교정한 다음 사용한다",
                  "controlLevel": "substitution",
                  "basis": {
                    "basisGuide": "doc:kosha_guide/D-C-15-2026",
                    "guideSection": "5.2"
                  }
                },
                {
                  "@id": "workmeasure:915eb9dcb642",
                  "@type": "WorkMeasure",
                  "measure": "현저한 손상, 변형, 부식이 있는 것은 사용하지 않는다",
                  "controlLevel": "elimination",
                  "basis": {
                    "basisGuide": "doc:kosha_guide/D-C-15-2026",
                    "guideSection": "5.2"
                  }
                },
                {
                  "@id": "workmeasure:a6027efac186",
                  "@type": "WorkMeasure",
                  "measure": "매립형은 콘크리트 표면을 깨뜨리지 않고 제거할 수 있는 선단이나 선단 긴결재를 두어 콘크리트 표면에서 25 mm 이상의 깊이를 갖는 구멍을 남길 수 있는 구조 이도록 한다",
                  "controlLevel": "substitution",
                  "basis": {
                    "basisGuide": "doc:kosha_guide/D-C-9-2026",
                    "guideSection": "5"
                  }
                },
                {
                  "@id": "workmeasure:664e83685658",
                  "@type": "WorkMeasure",
                  "measure": "형상이 찌그러지거나 비틀림 등 변형이 있는 것은 교정한 다음 사용한다",
                  "controlLevel": "substitution",
                  "basis": {
                    "basisGuide": "doc:kosha_guide/D-C-9-2026",
                    "guideSection": "5"
                  }
                }
              ]
            },
            {
              "@id": "workrisk:벽체_거푸집_유로폼/1.3",
              "@type": "WorkRisk",
              "statement": "허용하중 미표시 폼행거·앵커 사용하다 하중 초과로 무너짐",
              "measures": [
                {
                  "@id": "workmeasure:335d90955215",
                  "@type": "WorkMeasure",
                  "measure": "앵커 및 폼행거는 공인시험기관의 성능시험 등에 의하여 사용길이별 허용하중이 표시된 제품을 사용한다",
                  "controlLevel": "substitution",
                  "basis": {
                    "basisGuide": "doc:kosha_guide/D-C-9-2026",
                    "guideSection": "5"
                  }
                }
              ]
            },
            {
              "@id": "workrisk:벽체_거푸집_유로폼/1.4",
              "@type": "WorkRisk",
              "statement": "공인시험 미실시 거푸집 사용하다 품질 미달로 무너짐",
              "measures": [
                {
                  "@id": "workmeasure:ec382618476d",
                  "@type": "WorkMeasure",
                  "measure": "거푸집(재사용하는 거푸집을 포함한다)은 공인시험기관에서 품질시험을 실시한 것을 사용한다",
                  "controlLevel": "substitution",
                  "basis": {
                    "basisGuide": "doc:kosha_guide/D-C-15-2026",
                    "guideSection": "5.2"
                  }
                }
              ]
            },
            {
              "@id": "workrisk:벽체_거푸집_유로폼/1.5",
              "@type": "WorkRisk",
              "statement": "장기 방치로 변형된 거푸집 자재를 조립하여 무너짐",
              "measures": [
                {
                  "@id": "workmeasure:6d7366e291e9",
                  "@type": "WorkMeasure",
                  "measure": "자재의 반입은 사용 순서 및 시기를 고려하여, 장기간 현장에 방치되지 않도록 그 반입시기를 적절히 조절하고 적치장소를 미리 확인한다",
                  "controlLevel": "administrative",
                  "basis": {
                    "basisGuide": "doc:kosha_guide/D-C-9-2026",
                    "guideSection": "7.5.2"
                  }
                }
              ]
            },
            {
              "@id": "workrisk:벽체_거푸집_유로폼/1.6",
              "@type": "WorkRisk",
              "statement": "재사용 가설기자재의 변형·부식·손상 상태를 확인하지 않고 반입하여 무너짐",
              "measures": [
                {
                  "@id": "workmeasure:9be375c5ef13",
                  "@type": "WorkMeasure",
                  "measure": "가설기자재는 방호장치 안전인증 고시 및 방호장치 자율안전기준 고시에 적합한 제품을 사용하고, 재사용 가설기자재는 변형, 부식 또는 손상상태 등이 재사용 성능기준에 적합한 것을 사용한다",
                  "controlLevel": "substitution",
                  "basis": {
                    "basisGuide": "doc:kosha_guide/D-C-9-2026",
                    "guideSection": "7.5.2"
                  }
                }
              ]
            }
          ]
        },
