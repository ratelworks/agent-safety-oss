  ],
  "references": [
    "act:터널공사표준안전작업지침NATM공법"
  ],
  "steps": [
    {
      "stepName": "터널배수",
      "stepHazards": [
        {
          "hazardLabel": "무너짐",
          "basis": [
            {
              "guide": "doc:kosha_guide/C-45-2012",
              "section": "11.2",
              "controlLevel": "administrative"
            },
