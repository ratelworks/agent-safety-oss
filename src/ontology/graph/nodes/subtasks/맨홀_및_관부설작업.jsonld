              "priority": "★",
              "measures": [
                {
                  "@id": "workmeasure:d9a7e4ccc69c",
                  "@type": "WorkMeasure",
                  "measure": "굴착 깊이에 관계없이 적어도 30m 간격 이내로 사다리, 계단 등 승강설비를 설치하여야 한다",
                  "controlLevel": "engineering",
                  "variant": "기본",
                  "basis": {
