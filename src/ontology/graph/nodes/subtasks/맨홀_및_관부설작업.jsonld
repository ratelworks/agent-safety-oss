                },
                {
                  "@id": "workmeasure:67124f56eafe",
                  "@type": "WorkMeasure",
                  "measure": "굴착토사나 자재 등을 굴착면 및 흙막이 상단에 쌓아 두지 않도록 한다",
                  "controlLevel": "elimination",
                  "variant": "기본",
                  "basis": {
                    "basisGuide": "doc:kosha_guide/D-C-11-2026",
                    "guideSection": "8.2.3"
