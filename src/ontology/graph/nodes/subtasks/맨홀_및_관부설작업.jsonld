            {
              "@id": "workrisk:맨홀_및_관부설작업/1.3",
              "@type": "WorkRisk",
              "statement": "굴착토사를 굴착면 가까이 쌓아 하중으로 트렌치가 붕괴",
              "priority": "★★",
              "measures": [
                {
                  "@id": "workmeasure:ea753dbcdf54",
                  "@type": "WorkMeasure",
                  "measure": "굴착토사는 굴착바닥에서 45° 이상 경사선에서 깊이의 2배 이상의 위치에 적치하도록 하고 건설기계가 통행하는 장소에는 별도의 통행로를 설치하여야 한다",
                  "controlLevel": "engineering",
                  "variant": "기본",
                  "basis": {
                    "basisGuide": "doc:kosha_guide/D-C-11-2026",
                    "guideSection": "7.3.4"
