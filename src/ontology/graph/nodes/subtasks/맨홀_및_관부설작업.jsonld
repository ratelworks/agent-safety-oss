                  "controlLevel": "engineering",
                  "variant": "기본",
                  "basis": {
                    "basisGuide": "doc:kosha_guide/D-C-11-2026",
                    "guideSection": "7.3.4"
                  }
                },
                {
                  "@id": "workmeasure:de46da510ca1",
                  "@type": "WorkMeasure",
                  "measure": "바닥면의 굴착 깊이를 확인하면서 작업하여야 한다",
