            },
            {
              "@id": "workrisk:갱폼작업/4.5",
              "@type": "WorkRisk",
              "statement": "하부 케이지 미장·치장 작업이 상부 거푸집 작업과 겹쳐 낙하물에 노출됨",
              "priority": "★",
              "measures": [
                {
                  "@id": "workmeasure:bfebb86149ce",
                  "@type": "WorkMeasure",
                  "measure": "하부 케이지에서의 미장·치장 등 작업은 상부에서의 거푸집 설치·해체작업 공정에 맞추어 갱폼이 설치되어 있는 기간에 해당부분의 미장·치장 등 작업을 마무리하며, 케이지 내에서의 작업안전 사항은 갱폼 설치·해체작업에 준한다",
                  "variant": "갱폼",
