                {
                  "@id": "workmeasure:38563f73b50e",
                  "@type": "WorkMeasure",
                  "measure": "해체·인양장비를 점검하고 작업자를 배치한다",
                  "controlLevel": "administrative",
                  "variant": "기본",
                  "basis": {
