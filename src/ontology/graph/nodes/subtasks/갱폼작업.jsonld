            }
          ],
          "risks": [
            {
              "@id": "workrisk:갱폼작업/2.1",
              "@type": "WorkRisk",
              "statement": "폼타이 볼트의 규격·수량을 확인하지 않아 타설 중 거푸집이 벌어져 무너짐",
              "priority": "★★",
              "measures": [
                {
                  "@id": "workmeasure:fc8d08eb6b49",
                  "@type": "WorkMeasure",
                  "measure": "폼타이 볼트는 내부 유로폼과의 간격을 유지할 수 있도록 정확하게 설치한다",
                  "controlLevel": "engineering",
                  "variant": "갱폼",
                  "basis": {
                    "basisGuide": "doc:kosha_guide/D-C-8-2026",
                    "guideSection": "8.1.3"
                  }
                },
                {
                  "@id": "workmeasure:507ececc4d8e",
                  "@type": "WorkMeasure",
                  "measure": "폼타이 볼트는 정해진 규격의 것을 사용하고 볼트의 길이가 갱폼 거푸집 밖으로 10cm 이상 튀어나오지 않는 것으로 소요수량 전량을 확인·긴결한다",
                  "controlLevel": "engineering",
                  "variant": "갱폼",
                  "basis": {
                    "basisGuide": "doc:kosha_guide/D-C-8-2026",
                    "guideSection": "8.1.3"
                  }
                },
                {
                  "@id": "workmeasure:52bdbfdfb58f",
                  "@type": "WorkMeasure",
                  "measure": "거푸집을 조립하는 경우에는 거푸집이 콘크리트 하중이나 그 밖의 외력에 견딜 수 있거나, 넘어지지 않도록 견고한 구조의 긴결재, 버팀대 또는 지지대를 설치하는 등 필요한 조치를 한다",
                  "controlLevel": "engineering",
                  "variant": "기본",
                  "basis": {
                    "basisArticle": "art:기준규칙:331의2",
                    "item": 1
                  }
                }
              ]
            },
            {
              "@id": "workrisk:갱폼작업/2.2",
              "@type": "WorkRisk",
              "statement": "이음부 볼트 체결이 불량하여 타설 진동·충격에 변형됨",
              "priority": "★",
              "measures": [
                {
                  "@id": "workmeasure:c9a57d1c6db8",
                  "@type": "WorkMeasure",
                  "measure": "거푸집을 도면에 따라 부위별로 정확하게 설치하고, 콘크리트 타설 시의 진동이나 충격으로 변형되거나 움직이지 않도록 견고하게 조립하며, 거푸집 상호 이음부는 볼트를 사용하여 조립부위에 결함이 생기지 않도록 정확하게 설치한다",
                  "variant": "기본",
                  "basis": {
                    "basisGuide": "doc:kosha_guide/D-C-8-2026",
                    "guideSection": "8.1.2"
                  }
                },
                {
                  "@id": "workmeasure:c57cb9516608",
                  "@type": "WorkMeasure",
                  "measure": "거푸집의 철판이 도장된 상태에서 외관상 휨이나 변형이 없는지, 설계도면의 치수와 잘 맞는지 점검한 후 정확히 조립한다",
                  "variant": "기본",
                  "basis": {
                    "basisGuide": "doc:kosha_guide/D-C-8-2026",
                    "guideSection": "8.1.2"
                  }
                },
                {
                  "@id": "workmeasure:849ae97e106f",
                  "@type": "WorkMeasure",
                  "measure": "설치 후 거푸집 설치상태의 견고성과 뒤틀림 및 변형 여부, 부속철물의 위치와 간격, 접합정도와 용접부의 이상 유무를 확인한다",
                  "variant": "기본",
                  "basis": {
                    "basisGuide": "doc:kosha_guide/D-C-8-2026",
                    "guideSection": "8.1.3"
                  }
                },
                {
                  "@id": "workmeasure:b9154ea45ac1",
                  "@type": "WorkMeasure",
                  "measure": "동절기에는 매립볼트와 철선을 동시에 사용하여 볼트의 빠짐에 대비한다",
                  "variant": "기본",
                  "basis": {
                    "basisGuide": "doc:kosha_guide/D-C-8-2026",
                    "guideSection": "8.1.2"
                  }
                }
              ]
            }
          ]
