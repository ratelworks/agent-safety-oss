          "risks": [
            {
              "@id": "workrisk:지장물조사_및_이설작업/1.6",
              "@type": "WorkRisk",
              "statement": "케이블 매설 구간을 기계로 굴착하여 관로를 파손하고 감전",
              "priority": "★",
              "measures": [
                {
                  "@id": "workmeasure:147de767aa11",
                  "@type": "WorkMeasure",
                  "measure": "소형 브레이커에 의한 케이블 또는 관로의 파손 방지를 위하여 케이블 매설장소 부근은 표면층을 제외하고는 인력굴착을 하고 공사 착수 전에 시험굴착을 하여야 한다",
                  "controlLevel": "elimination",
                  "variant": "기본",
                  "basis": {
                    "basisGuide": "doc:kosha_guide/D-C-11-2026",
                    "guideSection": "8.3.5"
                  }
                },
                {
                  "@id": "workmeasure:1320028a8238",
                  "@type": "WorkMeasure",
                  "measure": "굴착기로 굴착 중 굴착 깊이가 케이블 또는 관로의 토피보다 얕을 경우에도 백호우의 날 부분으로 관로가 손상될 때가 있으므로 표지를 설치하거나 인력으로 굴착한다",
                  "controlLevel": "administrative",
                  "variant": "기본",
                  "basis": {
                    "basisGuide": "doc:kosha_guide/D-C-11-2026",
                    "guideSection": "8.3.5"
                  }
                },
                {
                  "@id": "workmeasure:4ce899916d1e",
                  "@type": "WorkMeasure",
                  "measure": "공사의 계획단계 등 착공 전에 전력 및 전기통신 설비의 위치와 규모에 대해서 관계 기관에 조회하고 실태파악을 하여야 한다",
                  "controlLevel": "administrative",
                  "variant": "기본",
                  "basis": {
                    "basisGuide": "doc:kosha_guide/D-C-11-2026",
                    "guideSection": "8.3.5"
                  }
                }
              ]
            },
            {
              "@id": "workrisk:지장물조사_및_이설작업/1.7",
              "@type": "WorkRisk",
              "statement": "매설물 근접 구간에서 전동공구·기계식 굴착기를 사용하여 케이블을 손상",
              "priority": "★",
              "measures": [
                {
                  "@id": "workmeasure:c32d2b2250f2",
                  "@type": "WorkMeasure",
                  "measure": "지하 매설물이 탐지된 곳 위 혹은 가까이에서 굴착작업을 할 때에는 각별한 주의를 기울여야 하며, 손에 들고 쓰는 전동공구와 기계적 굴착기는 주요한 위험요인이므로 이것들을 지하 매설물 가까이에서 사용해서는 안 된다",
                  "controlLevel": "elimination",
                  "variant": "기본",
                  "basis": {
                    "basisGuide": "doc:kosha_guide/G-29-2011",
                    "guideSection": "5"
                  }
                },
                {
                  "@id": "workmeasure:dd95387579cb",
                  "@type": "WorkMeasure",
                  "measure": "딱딱한 표면을 깨기 위해 손에 들고 쓰는 전동 공구들을 사용할 때는 표면 아래 매설된 케이블 선으로부터 최소한 500mm 이상 떨어져서 사용해야 하며, 가능한 경우에는 케이블의 위치추적기를 사용하여 굴착에 도움이 되도록 하여야 한다",
                  "controlLevel": "engineering",
                  "variant": "기본",
                  "basis": {
                    "basisGuide": "doc:kosha_guide/G-29-2011",
                    "guideSection": "6"
                  }
                },
                {
                  "@id": "workmeasure:a6d7a21abe65",
                  "@type": "WorkMeasure",
                  "measure": "콘크리트 속에 매설된 케이블에 대한 굴착은 원칙적으로 금한다",
                  "controlLevel": "elimination",
                  "variant": "기본",
                  "basis": {
                    "basisGuide": "doc:kosha_guide/G-29-2011",
                    "guideSection": "6"
                  }
                },
                {
                  "@id": "workmeasure:d4909eec7e77",
                  "@type": "WorkMeasure",
                  "measure": "기계식 굴착기는 지하 케이블 근접거리에서는 신중히 사용해야 한다",
                  "controlLevel": "administrative",
                  "variant": "기본",
                  "basis": {
                    "basisGuide": "doc:kosha_guide/G-29-2011",
                    "guideSection": "6"
                  }
                },
                {
                  "@id": "workmeasure:d66877aff797",
                  "@type": "WorkMeasure",
                  "measure": "기계적 굴착기는 배관망에 최소 500mm 이상의 거리를 두고 사용할 수 있다",
                  "controlLevel": "engineering",
                  "variant": "기본",
                  "basis": {
                    "basisGuide": "doc:kosha_guide/G-29-2011",
                    "guideSection": "6"
                  }
                }
              ]
            }
          ]
        }
      ]
    },
