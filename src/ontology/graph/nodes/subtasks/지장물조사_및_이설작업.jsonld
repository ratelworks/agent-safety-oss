  "title": "지장물조사 및 이설작업",
  "workGroup": "토공·굴착공사",
  "jurisdiction": "KR",
  "_meta": {
    "createdAt": "2026-11-12",
    "note": "공종의 작업 단계와 단계별 재해유형·위험요인·대책·근거. 공식 공종 분류가 아니다. 근거는 번들 조문·별표·가이드 본문과 대조해 실재하는 것만 연결했다. 현장 검토 전.",
    "sourceNote": "안전보건공단 산업안전 AI 어시스턴트(건설업) 자료를 바탕으로 구성 — 위험요인·대책 문장과 중요도 표시는 그 자료의 것"
  },
  "broader": "activity:underground_utility",
  "hasHazard": [
    "hazard:fire_explosion",
    "hazard:electric_shock",
    "hazard:fall_object"
  ],
  "regulatedBy": [
    "art:기준규칙:341",
    "art:기준규칙:342"
  ],
  "guidedBy": [
    "doc:kosha_guide/D-C-11-2026",
    "doc:kosha_guide/G-29-2011"
  ],
  "references": [
    "act:굴착공사표준안전작업지침"
  ],
  "steps": [
