            }
          ],
          "risks": [
            {
              "@id": "workrisk:지장물조사_및_이설작업/1.1",
              "@type": "WorkRisk",
              "statement": "도면만 믿고 기계굴착하여 실제 위치가 다른 매설물을 손상",
              "priority": "★",
              "measures": [
                {
                  "@id": "workmeasure:3c98ae025da4",
                  "@type": "WorkMeasure",
                  "measure": "공사구역 내 산재되어 있는 지하매설물에 대해서는 지하매설물 대장 및 도면에 표시된 위치를 조사한다",
                  "controlLevel": "administrative",
                  "variant": "기본",
                  "basis": {
                    "basisGuide": "doc:kosha_guide/D-C-11-2026",
                    "guideSection": "8.3.1"
                  }
                },
                {
                  "@id": "workmeasure:a8fa5311f49f",
                  "@type": "WorkMeasure",
                  "measure": "도면에 표시된 지하매설물 위치는 실제 위치와는 일치하지 않는 경우가 많으므로 인력굴착으로 재확인하여야 한다",
                  "controlLevel": "administrative",
                  "variant": "기본",
                  "basis": {
                    "basisGuide": "doc:kosha_guide/D-C-11-2026",
                    "guideSection": "8.3.1"
                  }
                },
                {
                  "@id": "workmeasure:039f52730e61",
                  "@type": "WorkMeasure",
                  "measure": "지하매설물의 매설깊이는 공사구역 내 인근 맨홀에서 개략깊이를 확인하여야 한다",
                  "controlLevel": "administrative",
                  "variant": "기본",
                  "basis": {
                    "basisGuide": "doc:kosha_guide/D-C-11-2026",
                    "guideSection": "8.3.1"
                  }
                },
                {
                  "@id": "workmeasure:2fe61852aee5",
                  "@type": "WorkMeasure",
                  "measure": "인력 등으로 줄파기를 실시하여 지하 매설물의 위치를 재확인하고 위치표시를 점검하여야 한다",
                  "controlLevel": "administrative",
                  "variant": "기본",
                  "basis": {
                    "basisGuide": "doc:kosha_guide/D-C-11-2026",
                    "guideSection": "8.1.1"
                  }
                }
              ]
            },
            {
              "@id": "workrisk:지장물조사_및_이설작업/1.2",
              "@type": "WorkRisk",
              "statement": "줄파기 깊이가 부족하여 매설물을 발견하지 못한 채 굴착",
              "priority": "★",
              "measures": [
                {
                  "@id": "workmeasure:6439776e900c",
                  "@type": "WorkMeasure",
                  "measure": "줄파기 작업 시 굴착 깊이는 인력으로 최소 1.5m 이상 실시하고 배관탐지기로 매설여부를 확인 후 관노출시까지 인력줄파기를 시행한다",
                  "controlLevel": "administrative",
                  "variant": "기본",
                  "basis": {
                    "basisGuide": "doc:kosha_guide/D-C-11-2026",
                    "guideSection": "8.3.1"
                  }
                },
                {
                  "@id": "workmeasure:c8466901c2b4",
                  "@type": "WorkMeasure",
                  "measure": "줄파기 작업 중 지하매설물을 발견한 때에는 발견된 지하매설물 밑에 또 다른 지장물이 있는지 여부를 확인하여야 한다",
                  "controlLevel": "administrative",
                  "variant": "기본",
                  "basis": {
                    "basisGuide": "doc:kosha_guide/D-C-11-2026",
                    "guideSection": "8.3.1"
                  }
                },
                {
                  "@id": "workmeasure:f60427c5f36c",
                  "@type": "WorkMeasure",
                  "measure": "오래된 도로부의 지하에서는 매설물이 보통구간보다 깊이 매설되어 있으므로 줄파기를 충분한 깊이로 시행하여야 한다",
                  "controlLevel": "administrative",
                  "variant": "기본",
                  "basis": {
                    "basisGuide": "doc:kosha_guide/D-C-11-2026",
                    "guideSection": "8.3.1"
                  }
                }
              ]
            },
            {
              "@id": "workrisk:지장물조사_및_이설작업/1.3",
              "@type": "WorkRisk",
              "statement": "발견된 매설물에 표지가 없어 후속 작업에서 손상",
              "priority": "★",
              "measures": [
                {
                  "@id": "workmeasure:60c6fd86f592",
                  "@type": "WorkMeasure",
                  "measure": "줄파기 결과 지하매설물이 확인되었을 때 현장 근로자 누구나가 알 수 있도록 지하매설물의 종류를 기입한 표지판을 설치한다",
                  "controlLevel": "engineering",
                  "variant": "기본",
                  "basis": {
                    "basisGuide": "doc:kosha_guide/D-C-11-2026",
                    "guideSection": "8.3.1"
                  }
                }
              ]
            },
            {
              "@id": "workrisk:지장물조사_및_이설작업/1.4",
              "@type": "WorkRisk",
              "statement": "굴착기계로 지하 공작물을 파손하고도 작업을 계속",
              "priority": "★",
              "measures": [
                {
                  "@id": "workmeasure:e5a5878d47fe",
                  "@type": "WorkMeasure",
                  "measure": "굴착기계등의 사용으로 가스도관, 지중전선로, 그 밖에 지하에 위치한 공작물이 파손되어 그 결과 근로자가 위험해질 우려가 있는 경우에는 그 기계를 사용한 굴착작업을 중지한다",
                  "controlLevel": "elimination",
                  "variant": "기본",
                  "basis": {
                    "basisArticle": "art:기준규칙:342",
                    "item": 1
                  }
                },
                {
                  "@id": "workmeasure:785c3773ddec",
                  "@type": "WorkMeasure",
                  "measure": "매설물·조적벽·콘크리트벽 또는 옹벽 등의 건설물에 근접한 장소에서 굴착작업을 할 때에 해당 가설물의 파손 등에 의하여 근로자가 위험해질 우려가 있는 경우에는 해당 건설물을 보강하거나 이설하는 등 해당 위험을 방지하기 위한 조치를 한다",
                  "controlLevel": "engineering",
                  "variant": "기본",
                  "basis": {
                    "basisArticle": "art:기준규칙:341",
                    "paragraph": 1
                  }
                }
              ]
            },
            {
              "@id": "workrisk:지장물조사_및_이설작업/1.5",
              "@type": "WorkRisk",
              "statement": "위치탐지장치·시험굴착 없이 본굴착을 시작하여 매설물을 손상",
              "priority": "★",
              "measures": [
                {
                  "@id": "workmeasure:e87c4895c200",
                  "@type": "WorkMeasure",
                  "measure": "작업구역 내 혹은 근처에 있는 어떤 시설물의 위치는 위치탐지장치를 사용하여 가능한 한 정확히 확인해야 한다",
                  "controlLevel": "administrative",
                  "variant": "기본",
                  "basis": {
                    "basisGuide": "doc:kosha_guide/G-29-2011",
                    "guideSection": "5"
                  }
                },
                {
                  "@id": "workmeasure:d1d64a9b8c00",
                  "@type": "WorkMeasure",
                  "measure": "우선 위치탐지장치를 사용하여 작업위치와 통로를 확인한 후 굴착작업을 진행하는데 필요한 경우 먼저 적절한 수공구를 사용하여 시험적으로 예비 굴착을 하여 매설된 시설물의 위치를 확인한 후 본 굴착작업을 실행한다",
                  "controlLevel": "administrative",
                  "variant": "기본",
                  "basis": {
                    "basisGuide": "doc:kosha_guide/G-29-2011",
                    "guideSection": "5"
                  }
                },
                {
                  "@id": "workmeasure:8ea7b9897186",
                  "@type": "WorkMeasure",
                  "measure": "작업구역에 매설되어 있는 모든 시설물에 대한 설계도 혹은 지하 매설물의 위치, 지형, 수량 등 다른 적절하고 정확한 정보들이 굴착 작업 개시 전 작업이 계획되는 과정에서 확보되어야 한다",
                  "controlLevel": "administrative",
                  "variant": "기본",
                  "basis": {
                    "basisGuide": "doc:kosha_guide/G-29-2011",
                    "guideSection": "5"
                  }
                },
                {
                  "@id": "workmeasure:91fd7306860b",
                  "@type": "WorkMeasure",
                  "measure": "위험성 평가 시에는 작업지역의 여러 환경적 측면을 확인하면서 어떻게 작업을 수행할 것인지를 고려해야 한다",
                  "controlLevel": "administrative",
                  "variant": "기본",
                  "basis": {
                    "basisGuide": "doc:kosha_guide/G-29-2011",
                    "guideSection": "5"
                  }
                }
              ]
            }
          ]
        },
