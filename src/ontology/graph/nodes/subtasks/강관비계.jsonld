          "risks": [
            {
              "@id": "workrisk:강관비계/2.1",
              "@type": "WorkRisk",
              "statement": "조립도·구조검토 없이 조립하여 지지력이 부족해 무너짐",
              "priority": "★★",
              "measures": [
                {
                  "@id": "workmeasure:c7a9053a42dc",
                  "@type": "WorkMeasure",
                  "measure": "작업계획, 작업내용 등을 충분히 검토하고 비계의 조립도에 따라 비계의 치수와 구조물과 비계 사이 간격을 확인한다",
                  "controlLevel": "administrative",
                  "basis": {
                    "basisGuide": "doc:kosha_guide/D-C-7-2026",
                    "guideSection": "7.1.1"
                  }
                },
                {
                  "@id": "workmeasure:b30c63e0e0a2",
                  "@type": "WorkMeasure",
                  "measure": "비계 높이가 31m 이상이거나 발주자 또는 인·허가기관의 장이 필요하다고 인정하는 비계는 관계전문가로부터 구조적 안전성을 확인받는다",
                  "controlLevel": "administrative",
                  "basis": {
                    "basisGuide": "doc:kosha_guide/D-C-7-2026",
                    "guideSection": "7.1.1"
                  }
                },
                {
                  "@id": "workmeasure:913af4fd0b7f",
                  "@type": "WorkMeasure",
                  "measure": "출입구, 단부, 우각부 등의 보강 방법을 확인한다",
                  "controlLevel": "administrative",
                  "basis": {
                    "basisGuide": "doc:kosha_guide/D-C-7-2026",
                    "guideSection": "7.1.1"
                  }
                }
              ]
            },
            {
              "@id": "workrisk:강관비계/2.2",
              "@type": "WorkRisk",
              "statement": "지반이 침하하여 비계기둥이 가라앉아 무너짐",
              "priority": "★★",
              "measures": [
                {
                  "@id": "workmeasure:8e0e6141aba0",
                  "@type": "WorkMeasure",
                  "measure": "비계기둥에는 미끄러지거나 침하하는 것을 방지하기 위하여 밑받침철물을 사용하거나 깔판·받침목 등을 사용하여 밑둥잡이를 설치하는 등의 조치를 한다",
                  "controlLevel": "engineering",
                  "basis": {
                    "basisArticle": "art:기준규칙:59",
                    "item": 1
                  }
                },
                {
                  "@id": "workmeasure:1d698efc3786",
                  "@type": "WorkMeasure",
                  "measure": "지반은 비계기둥이 침하하지 않도록 충분히 다짐하고, 깔판·받침목 등은 평탄하게 설치한다",
                  "controlLevel": "engineering",
                  "basis": {
                    "basisGuide": "doc:kosha_guide/D-C-7-2026",
                    "guideSection": "7.1.3"
                  }
                },
                {
                  "@id": "workmeasure:9b250bbb2887",
                  "@type": "WorkMeasure",
                  "measure": "연약지반은 비계기둥이 침하하지 않도록 두께 45mm 이상의 깔판·받침목을 소요 폭 이상으로 설치하거나 콘크리트를 타설한다",
                  "controlLevel": "engineering",
                  "basis": {
                    "basisGuide": "doc:kosha_guide/D-C-7-2026",
                    "guideSection": "7.1.3"
                  }
                },
                {
                  "@id": "workmeasure:f86c9657af6f",
                  "@type": "WorkMeasure",
                  "measure": "고정형 받침철물은 깔판이나 받침목의 중심에 정해진 비계기둥 간격으로 배치하고 이동을 방지하기 위하여 지반에 최대한 근접하여 밑둥잡이를 설치하는 등의 조치를 한다",
                  "controlLevel": "engineering",
                  "basis": {
                    "basisGuide": "doc:kosha_guide/D-C-7-2026",
                    "guideSection": "7.1.3"
                  }
                }
              ]
            },
            {
              "@id": "workrisk:강관비계/2.3",
              "@type": "WorkRisk",
              "statement": "비계기둥·띠장 간격이 기준을 초과하여 좌굴로 무너짐",
              "priority": "★★",
              "measures": [
                {
                  "@id": "workmeasure:848d7cc6ecc1",
                  "@type": "WorkMeasure",
                  "measure": "비계기둥의 간격은 띠장 방향에서는 1.85미터 이하, 장선 방향에서는 1.5미터 이하로 한다",
                  "controlLevel": "engineering",
                  "basis": {
                    "basisArticle": "art:기준규칙:60",
                    "item": 1
                  }
                },
                {
                  "@id": "workmeasure:3e260cd68b41",
                  "@type": "WorkMeasure",
                  "measure": "띠장 간격은 2.0미터 이하로 한다",
                  "controlLevel": "engineering",
                  "basis": {
                    "basisArticle": "art:기준규칙:60",
                    "item": 2
                  }
                },
                {
                  "@id": "workmeasure:7fc4865cb846",
                  "@type": "WorkMeasure",
                  "measure": "비계기둥은 수직도를 유지하도록 설치하며 필요한 경우 임시 가새를 설치한다",
                  "controlLevel": "engineering",
                  "basis": {
                    "basisGuide": "doc:kosha_guide/D-C-7-2026",
                    "guideSection": "7.1.3"
                  }
                },
                {
                  "@id": "workmeasure:bfd7496ad949",
                  "@type": "WorkMeasure",
                  "measure": "장선은 작업발판을 지지할 수 있도록 1.85m 이하로 설치하되, 부득이한 경우 작업발판 지지용 철물을 띠장에 클램프로 고정하여 설치한다",
                  "controlLevel": "engineering",
                  "basis": {
                    "basisGuide": "doc:kosha_guide/D-C-7-2026",
                    "guideSection": "7.1.3"
                  }
                }
              ]
            },
            {
              "@id": "workrisk:강관비계/2.4",
              "@type": "WorkRisk",
              "statement": "최상부로부터 31m 아래 구간의 기둥 보강이 미흡하여 좌굴",
              "priority": "★",
              "measures": [
                {
                  "@id": "workmeasure:6544a93faabd",
                  "@type": "WorkMeasure",
                  "measure": "비계기둥의 제일 윗부분으로부터 31미터되는 지점 밑부분의 비계기둥은 2개의 강관으로 묶어 세운다",
                  "controlLevel": "engineering",
                  "basis": {
                    "basisArticle": "art:기준규칙:60",
                    "item": 3
                  }
                },
                {
                  "@id": "workmeasure:a70b226d5923",
                  "@type": "WorkMeasure",
                  "measure": "2개의 강관을 묶을 경우에는 전용 클램프로 체결하며, 클램프의 설치간격은 좌굴이 발생하지 않도록 최대 2m 이내로 체결한다",
                  "controlLevel": "engineering",
                  "basis": {
                    "basisGuide": "doc:kosha_guide/D-C-7-2026",
                    "guideSection": "7.1.3"
                  }
                },
                {
                  "@id": "workmeasure:0e45fdaf26db",
                  "@type": "WorkMeasure",
                  "measure": "비계기둥의 연결은 이음철물이나 조임철물 등을 사용하며 연결 위치가 동일한 위치에 집중되지 않도록 길이가 서로 다른 강관을 사용하여 조립한다",
                  "controlLevel": "engineering",
                  "basis": {
                    "basisGuide": "doc:kosha_guide/D-C-7-2026",
                    "guideSection": "7.1.3"
                  }
                }
              ]
            },
            {
              "@id": "workrisk:강관비계/2.5",
              "@type": "WorkRisk",
              "statement": "벽이음을 설치하지 않거나 간격을 초과하여 비계가 무너짐",
              "priority": "★★",
              "measures": [
                {
                  "@id": "workmeasure:1d35dd8e3c64",
                  "@type": "WorkMeasure",
                  "measure": "외줄비계·쌍줄비계 또는 돌출비계에 대해서는 벽이음 및 버팀을 설치한다",
                  "controlLevel": "engineering",
                  "basis": {
                    "basisArticle": "art:기준규칙:59",
                    "item": 4
                  }
                },
                {
                  "@id": "workmeasure:383e2690e9ab",
                  "@type": "WorkMeasure",
                  "measure": "벽이음재는 안전인증품을 사용하고, 설치간격은 구조검토 결과 조립 간격을 준수하고 최대 수직방향 5m 이하, 수평방향 5m 이하로 설치한다",
                  "controlLevel": "engineering",
                  "basis": {
                    "basisGuide": "doc:kosha_guide/D-C-7-2026",
                    "guideSection": "7.1.3"
                  }
                },
                {
                  "@id": "workmeasure:65d009f88c13",
                  "@type": "WorkMeasure",
                  "measure": "벽이음의 설치위치는 기둥과 띠장의 결합 부근으로 하며, 벽면과 직각이 되도록 설치하고, 비계의 최상단과 가장자리 끝에도 벽이음을 설치한다",
                  "controlLevel": "engineering",
                  "basis": {
                    "basisGuide": "doc:kosha_guide/D-C-7-2026",
                    "guideSection": "7.1.3"
                  }
                },
