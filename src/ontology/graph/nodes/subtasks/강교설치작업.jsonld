                    "guideSection": "5"
                  }
                },
                {
                  "@id": "workmeasure:17fdbf944a38",
                  "@type": "WorkMeasure",
                  "measure": "작업에 사용할 장비, 기계, 기구, 공구 등은 해당 공법에 적합 여부를 확인하고 사용 중 문제가 발생하지 않도록 점검하여야 한다.",
                  "controlLevel": "administrative",
