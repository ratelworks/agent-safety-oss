          "risks": [
            {
              "@id": "workrisk:띠장_버팀대/2.1",
              "@type": "WorkRisk",
              "statement": "소정 깊이보다 과굴착하거나 버팀대 설치를 미뤄 흙막이가 토압을 못 버티고 무너짐",
              "priority": "★",
              "measures": [
                {
                  "@id": "workmeasure:c18f82ead716",
                  "@type": "WorkMeasure",
                  "measure": "띠장, 버팀대는 설계도 및 공종별 시공계획서를 따라 각 단계마다 소정의 깊이까지 굴착 후, 신속히 설치하고 과굴착을 하여서는 안 된다.",
                  "controlLevel": "elimination",
                  "basis": {
                    "basisGuide": "doc:kosha_guide/D-C-1-2025",
                    "guideSection": "8.1.1"
                  }
                },
                {
                  "@id": "workmeasure:299b5be0037d",
                  "@type": "WorkMeasure",
                  "measure": "버팀대는 좌우 흙막이의 토압이 균형을 이룬 상태에서 실시하고 정확히 수평이 되도록 정밀하게 설치하여야 한다.",
                  "controlLevel": "engineering",
                  "basis": {
                    "basisGuide": "doc:kosha_guide/D-C-1-2025",
                    "guideSection": "8.2.3"
                  }
                },
                {
                  "@id": "workmeasure:2c665ceda7ca",
                  "@type": "WorkMeasure",
                  "measure": "띠장, 버팀대의 설치 간격은 설계도서에 명시한 값 이내로 하며 지장물의 유무, 구조물의 타설 계획, 재료 및 장비 투입 공간 확보 관계를 고려하여 설치간격을 결정하여야 한다.",
                  "controlLevel": "administrative",
                  "basis": {
                    "basisGuide": "doc:kosha_guide/D-C-1-2025",
                    "guideSection": "8.1.1"
                  }
                },
                {
                  "@id": "workmeasure:88ebce5d02c9",
                  "@type": "WorkMeasure",
                  "measure": "흙막이 지보공을 설치하여 위험을 방지하기 위한 조치를 한다.",
                  "controlLevel": "engineering",
                  "basis": {
                    "basisArticle": "art:기준규칙:50",
                    "item": 1
                  }
                },
                {
                  "@id": "workmeasure:0923f6f859c2",
                  "@type": "WorkMeasure",
                  "measure": "굴착작업의 작업계획서에는 굴착방법 및 순서, 토사등 반출 방법, 필요한 인원 및 장비 사용계획, 매설물 등에 대한 이설·보호대책, 사업장 내 연락방법 및 신호방법, 흙막이 지보공 설치방법 및 계측계획, 작업지휘자의 배치계획을 포함한다.",
                  "controlLevel": "administrative",
                  "basis": {
                    "basisAnnex": "annex:기준규칙:별표4-6호"
                  }
                },
                {
                  "@id": "workmeasure:17ce17179329",
                  "@type": "WorkMeasure",
                  "measure": "굴착작업을 하는 경우 사전조사 결과를 고려하여 별표 4의 구분에 따른 사항을 포함한 작업계획서를 작성하고 그 계획에 따라 작업을 하도록 한다.",
                  "controlLevel": "administrative",
                  "basis": {
                    "basisArticle": "art:기준규칙:38",
                    "paragraph": 1,
                    "item": 6
                  }
                }
              ]
            },
            {
              "@id": "workrisk:띠장_버팀대/2.2",
              "@type": "WorkRisk",
              "statement": "접합부·이음부가 느슨하거나 강도가 부족해 버팀대가 좌굴되며 흙막이 전체가 무너짐",
              "priority": "★★",
              "measures": [
                {
                  "@id": "workmeasure:f7442a1411be",
                  "@type": "WorkMeasure",
                  "measure": "띠장, 버팀대는 이동이 없도록 설치하여야 하며, 접합부와 이음부는 느슨하거나 강도 부족이 없도록 한다.",
                  "controlLevel": "engineering",
                  "basis": {
