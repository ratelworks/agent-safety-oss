  "steps": [
    {
      "@id": "workstep:승강기_설치/1",
      "@type": "WorkStep",
      "stepName": "엘리베이터 자재반입·보관",
      "stepHazards": [
        {
          "hazardLabel": "물체에 맞음",
          "hasHazard": "hazard:fall_object",
          "basis": [
            {
              "basisGuide": "doc:kosha_guide/D-C-14-2026",
              "guideSection": "7.1",
              "controlLevel": "engineering"
            }
          ],
          "risks": [
            {
              "@id": "workrisk:승강기_설치/1.1",
              "@type": "WorkRisk",
              "statement": "자재 적재 높이가 높아 넘어지거나 쓰러져 맞음",
              "measures": [
                {
                  "@id": "workmeasure:d173b61a868d",
                  "@type": "WorkMeasure",
                  "measure": "현장에 반입된 자재가 넘어지거나 쓰러지지 않도록 높게 적재하지 않아야 하고 넘어 지거나 쓰러지는 위험이 있는 경우에는 견고하게 고정하거나 근로자의 출입을 통제 하는 등 필요한 조치를 한다",
                  "controlLevel": "engineering",
                  "basis": {
                    "basisGuide": "doc:kosha_guide/D-C-14-2026",
                    "guideSection": "7.1"
                  }
                }
              ]
            }
          ]
        },
        {
          "hazardLabel": "무너짐",
          "hasHazard": "hazard:cave_in",
          "basis": [
            {
              "basisGuide": "doc:kosha_guide/D-C-14-2026",
              "guideSection": "7.1",
              "controlLevel": "engineering"
            }
          ],
          "risks": [
            {
              "@id": "workrisk:승강기_설치/1.2",
              "@type": "WorkRisk",
              "statement": "변형·부식된 승강기 부재를 확인 없이 반입하여 설치 후 무너짐",
              "measures": [
                {
                  "@id": "workmeasure:71039889f4ea",
                  "@type": "WorkMeasure",
                  "measure": "현장에 조립용으로 입고되는 자재는 변형되거나, 비에 맞아 녹슬지 않도록 평평한 바닥에 침목 등을 깔아 보관한다",
                  "controlLevel": "engineering",
                  "basis": {
                    "basisGuide": "doc:kosha_guide/D-C-14-2026",
                    "guideSection": "7.1"
                  }
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "@id": "workstep:승강기_설치/2",
      "@type": "WorkStep",
      "stepName": "승강로 가설작업대 설치",
      "stepHazards": [
        {
          "hazardLabel": "무너짐",
          "hasHazard": "hazard:cave_in",
          "basis": [
            {
              "basisGuide": "doc:kosha_guide/D-C-14-2026",
              "guideSection": "5.3.5",
              "controlLevel": "engineering"
            },
            {
              "basisGuide": "doc:kosha_guide/D-C-14-2026",
              "guideSection": "7.2.2",
              "controlLevel": "administrative"
            },
            {
              "basisGuide": "doc:kosha_guide/D-C-14-2026",
              "guideSection": "5.3.4",
              "controlLevel": "engineering"
            }
          ],
          "risks": [
            {
              "@id": "workrisk:승강기_설치/2.1",
              "@type": "WorkRisk",
              "statement": "벽체지지대 앵커볼트 고정 미흡으로 승강로 구조물 무너짐",
              "measures": [
                {
                  "@id": "workmeasure:b2ab18a6dcfb",
                  "@type": "WorkMeasure",
                  "measure": "작업대에 전단볼트가 체결된 후 전체 유동방지를 위해 벽체지지대를 벽면에 밀착 설치한다",
                  "controlLevel": "engineering",
                  "basis": {
                    "basisGuide": "doc:kosha_guide/D-C-14-2026",
                    "guideSection": "5.3.5"
                  }
                },
                {
                  "@id": "workmeasure:e8cf51ec17cc",
                  "@type": "WorkMeasure",
                  "measure": "벽체 또는 슬래브에 매립되는 앵커볼트는 콘크리트 타설 및 진동다짐 등에 의해 위치 이동이 발생하지 않도록 지속적으로 모니터링을 실시하여 앵커볼트의 수직 및 수평 상태를 정확히 유지하도록 한다",
                  "controlLevel": "administrative",
                  "basis": {
                    "basisGuide": "doc:kosha_guide/D-C-14-2026",
                    "guideSection": "7.2.2"
                  }
                }
              ]
            },
            {
              "@id": "workrisk:승강기_설치/2.2",
              "@type": "WorkRisk",
              "statement": "부재 치수·조립 상태를 점검하지 않아 작업대가 변형되어 무너짐",
              "measures": [
                {
                  "@id": "workmeasure:9643a874171c",
                  "@type": "WorkMeasure",
                  "measure": "부재는 외관상 휨이나 변형 등을 설계도면의 치수와 일치여부를 점검 후 설계도면에 따라 부재별 설치 위치 준수하여 정확히 조립한다",
                  "controlLevel": "administrative",
                  "basis": {
                    "basisGuide": "doc:kosha_guide/D-C-14-2026",
                    "guideSection": "7.2.2"
                  }
                },
                {
                  "@id": "workmeasure:5faff566f6fa",
                  "@type": "WorkMeasure",
                  "measure": "설치 후 작업대의 조립상태, 뒤틀림 및 변형여부, 부속철물의 위치와 간격, 접합 정도와 용접부의 이상 유무를 확인해야 하고, 문제가 발견된 경우 즉시 보수 또는 교체 작업을 한다",
                  "controlLevel": "administrative",
                  "basis": {
                    "basisGuide": "doc:kosha_guide/D-C-14-2026",
                    "guideSection": "7.2.2"
                  }
                }
              ]
            },
            {
              "@id": "workrisk:승강기_설치/2.3",
              "@type": "WorkRisk",
              "statement": "브라켓 돌출 길이 부족·고임 미비로 작업대가 이동·전도되어 무너짐",
              "measures": [
                {
                  "@id": "workmeasure:e303dbd62255",
                  "@type": "WorkMeasure",
                  "measure": "작업대를 인양하여 다음 층에 설치할 시 브라켓이 슬래브 위에 충분한 길이로 돌출 되어야 하고, 슬래브와의 높이차가 있는 경우 견고한 고임목을 고여야 한다",
                  "controlLevel": "engineering",
                  "basis": {
                    "basisGuide": "doc:kosha_guide/D-C-14-2026",
                    "guideSection": "5.3.4"
                  }
                },
                {
                  "@id": "workmeasure:a0d3dbbba7a6",
                  "@type": "WorkMeasure",
                  "measure": "브라켓의 재료와 구조, 설치방법은 제조사의 취급설명서 또는 매뉴얼에 따른다.",
                  "controlLevel": "engineering",
                  "basis": {
                    "basisGuide": "doc:kosha_guide/D-C-14-2026",
                    "guideSection": "5.3.4"
                  }
                }
              ]
            },
            {
              "@id": "workrisk:승강기_설치/2.4",
              "@type": "WorkRisk",
              "statement": "벽면 밀착용 지지대 미설치로 작업대와 외벽 간격이 벌어져 전도되어 무너짐",
              "measures": [
                {
                  "@id": "workmeasure:64dfc404f1ad",
                  "@type": "WorkMeasure",
                  "measure": "작업대와 구조물 외벽의 간격유지와 밀착을 위해 둥근 톱날형, 사다리꼴 박스형, 각재형 등의 벽면 밀착용 지지대를 제작⸱설치한다",
                  "controlLevel": "engineering",
                  "basis": {
                    "basisGuide": "doc:kosha_guide/D-C-14-2026",
                    "guideSection": "5.3.5"
                  }
                },
                {
                  "@id": "workmeasure:8c56ab5a226f",
                  "@type": "WorkMeasure",
                  "measure": "벽체지지대의 재료와 구조, 설치방법은 제조사의 취급설명서 또는 매뉴얼에 따른다.",
                  "controlLevel": "engineering",
                  "basis": {
                    "basisGuide": "doc:kosha_guide/D-C-14-2026",
                    "guideSection": "5.3.5"
                  }
                }
              ]
            }
          ]
        },
        {
          "hazardLabel": "물체에 맞음",
          "hasHazard": "hazard:fall_object",
          "basis": [
            {
              "basisGuide": "doc:kosha_guide/D-C-14-2026",
              "guideSection": "7.2.1",
              "controlLevel": "administrative"
            }
          ],
          "risks": [
            {
              "@id": "workrisk:승강기_설치/2.5",
              "@type": "WorkRisk",
              "statement": "동일 위치 동시작업으로 충돌 또는 떨어짐",
              "measures": [
                {
                  "@id": "workmeasure:c376d4cb589b",
                  "@type": "WorkMeasure",
                  "measure": "산업안전보건법상 동일 위치에서 작업을 금지하고 있으므로 동일 위치에서 동시에 작업을 하지 않도록 관리한다",
                  "controlLevel": "administrative",
                  "basis": {
                    "basisGuide": "doc:kosha_guide/D-C-14-2026",
                    "guideSection": "7.2.1"
                  }
                },
                {
                  "@id": "workmeasure:140ddc43695c",
                  "@type": "WorkMeasure",
                  "measure": "층의 작업발판이 완성되기 전까지는 상부에서 떨어짐 및 낙하물로 인한 부딪힘 가능성이 있으므로 상하부 동시작업을 금지한다",
                  "controlLevel": "administrative",
                  "basis": {
                    "basisGuide": "doc:kosha_guide/D-C-14-2026",
                    "guideSection": "7.2.1"
                  }
                }
              ]
            }
          ]
        },
        {
          "hazardLabel": "떨어짐",
          "hasHazard": "hazard:fall_from_height",
          "basis": [
            {
              "basisGuide": "doc:kosha_guide/D-C-14-2026",
              "guideSection": "5.3.3",
              "controlLevel": "engineering"
            },
            {
              "basisGuide": "doc:kosha_guide/D-C-14-2026",
              "guideSection": "7.2.1",
              "controlLevel": "administrative"
            },
            {
              "basisGuide": "doc:kosha_guide/D-C-14-2026",
              "guideSection": "5.3.3",
              "controlLevel": "administrative"
            },
            {
              "basisGuide": "doc:kosha_guide/D-C-14-2026",
              "guideSection": "7.3",
              "controlLevel": "engineering"
            }
          ],
          "risks": [
            {
              "@id": "workrisk:승강기_설치/2.6",
              "@type": "WorkRisk",
              "statement": "작업대 내부 통로 미설치로 근로자가 불안정하게 이동하다 떨어짐",
              "measures": [
                {
                  "@id": "workmeasure:5532024a6311",
                  "@type": "WorkMeasure",
                  "measure": "작업대 내부에는 근로자가 안전하게 구조물 내부에서 작업발판으로 출입·이동할 수 있도록 계단 등 안전한 통로를 설치한다",
                  "controlLevel": "engineering",
                  "basis": {
                    "basisGuide": "doc:kosha_guide/D-C-14-2026",
                    "guideSection": "5.3.3"
                  }
                },
                {
                  "@id": "workmeasure:4d9a9610192c",
                  "@type": "WorkMeasure",
                  "measure": "항의 사다리와 작업발판이 연속되는 지점에는 경첩 등을 이용하여 여닫이문을 설치하고, 여닫이문은 근로자 이동하는 경우 외에는 항상 닫혀있도록 관리한다",
                  "controlLevel": "administrative",
                  "basis": {
                    "basisGuide": "doc:kosha_guide/D-C-14-2026",
                    "guideSection": "5.3.3"
                  }
                },
                {
                  "@id": "workmeasure:bbc111480c92",
                  "@type": "WorkMeasure",
                  "measure": "사다리식 통로 등을 설치하는 경우에는 슬래브 콘크리트 타설된 지점과 작업 발판간 근로자가 이동할 수 있는 수직형 승강사다리를 견고하게 설치한다",
                  "controlLevel": "engineering",
                  "basis": {
                    "basisGuide": "doc:kosha_guide/D-C-14-2026",
                    "guideSection": "5.3.3"
                  }
                },
                {
                  "@id": "workmeasure:7047332a6c7f",
                  "@type": "WorkMeasure",
                  "measure": "승강사다리의 위치는 동일 작업대 내에서 작업발판의 각 단에서 서로 엇갈리게 하고, 최상부의 여유길이는 60cm 이상 돌출되도록 해야 한다. 이 경우 돌출부위가 근로자 이동에 간섭이 없도록 설치 위치를 적정하게 고려한다",
                  "controlLevel": "engineering",
                  "basis": {
                    "basisGuide": "doc:kosha_guide/D-C-14-2026",
                    "guideSection": "5.3.3"
                  }
                }
              ]
            },
            {
              "@id": "workrisk:승강기_설치/2.7",
              "@type": "WorkRisk",
              "statement": "과적 또는 최대적재하중 초과로 작업대 파손되어 떨어짐",
              "measures": [
                {
                  "@id": "workmeasure:f26eb62faf8a",
                  "@type": "WorkMeasure",
                  "measure": "EV 고소 가설작업대는 작업 위치에서 최대적재하중을 고려하여 자재를 과적하지 않도록 한다",
                  "controlLevel": "administrative",
                  "basis": {
                    "basisGuide": "doc:kosha_guide/D-C-14-2026",
                    "guideSection": "7.2.1"
                  }
                }
              ]
            },
            {
              "@id": "workrisk:승강기_설치/2.8",
              "@type": "WorkRisk",
              "statement": "작업발판 위를 뛰거나 슬래브에서 작업대로 뛰어내려 떨어짐",
              "measures": [
                {
                  "@id": "workmeasure:b2514de2dd77",
                  "@type": "WorkMeasure",
                  "measure": "작업대 위의 작업자는 지정된 설비를 갖춘 작업발판 연결통로를 이용하여 작업대 내부로 출입해야 하며, 발판 위에서 뛰거나 슬래브 또는 승강 사다리에서 발판으로 뛰어 내리는 행위를 금지한다",
                  "controlLevel": "administrative",
                  "basis": {
                    "basisGuide": "doc:kosha_guide/D-C-14-2026",
                    "guideSection": "7.2.1"
                  }
                }
              ]
            },
            {
              "@id": "workrisk:승강기_설치/2.9",
              "@type": "WorkRisk",
              "statement": "작업대 내부 거푸집 등을 밟고 작업하다 떨어짐",
              "measures": [
                {
                  "@id": "workmeasure:db022060ea60",
                  "@type": "WorkMeasure",
                  "measure": "작업대 내부 거푸집 등을 밟고 작업하지 않도록 말비계 등 적정한 작업발판을 설치 하고, 작업자의 신장보다 높은 위치에 안전대 부착설비를 설치하여 안전대 고리를 체결한 후 작업한다",
                  "controlLevel": "engineering",
                  "basis": {
                    "basisGuide": "doc:kosha_guide/D-C-14-2026",
                    "guideSection": "7.3"
                  }
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "@id": "workstep:승강기_설치/3",
      "@type": "WorkStep",
      "stepName": "기계·가이드레일 설치",
      "stepHazards": [
        {
          "hazardLabel": "무너짐",
          "hasHazard": "hazard:cave_in",
          "basis": [
            {
              "basisGuide": "doc:kosha_guide/D-C-14-2026",
              "guideSection": "5.3.1",
              "controlLevel": "engineering"
            }
          ],
          "risks": [
            {
              "@id": "workrisk:승강기_설치/3.1",
              "@type": "WorkRisk",
              "statement": "인양구 지지점 부족·부재 안전율 미달로 인양 중 작업대가 변형되어 무너짐",
              "measures": [
                {
                  "@id": "workmeasure:196a1f8fc09d",
                  "@type": "WorkMeasure",
                  "measure": "작업대 전하중을 안전하게 인양할 수 있는 안전율 5 이상의 부재를 사용하여 인양 시 작업대에 변형을 주지 않는 구조로 한다",
                  "controlLevel": "engineering",
                  "basis": {
                    "basisGuide": "doc:kosha_guide/D-C-14-2026",
                    "guideSection": "5.3.1"
                  }
                },
                {
                  "@id": "workmeasure:b815c58bcb77",
                  "@type": "WorkMeasure",
                  "measure": "인양구는 4점 이상 지지할 수 있도록 수직재에 용접 고정하고, 2구형 이상 작업대는 인양구의 방향이 줄걸이 방향에 오도록 하여 변형을 주지 않아야 한다",
                  "controlLevel": "engineering",
                  "basis": {
                    "basisGuide": "doc:kosha_guide/D-C-14-2026",
                    "guideSection": "5.3.1"
                  }
                }
              ]
            }
          ]
        },
        {
          "hazardLabel": "물체에 맞음",
          "hasHazard": "hazard:fall_object",
          "basis": [
