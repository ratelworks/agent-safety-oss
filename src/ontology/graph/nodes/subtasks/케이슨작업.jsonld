              "controlLevel": "administrative"
            },
            {
              "guide": "doc:kosha_guide/C-93-2013",
              "section": "5",
              "controlLevel": "elimination"
            },
            {
              "guide": "doc:kosha_guide/C-93-2013",
              "section": "7.1",
              "controlLevel": "elimination"
            }
          ],
          "hazard": "hazard:cave_in",
          "risks": [
            {
              "statement": "강재 거푸집이 콘크리트 측압을 견디지 못하고 무너져 근로자가 깔림",
              "priority": "★★",
              "measures": [
                {
                  "measure": "강재 거푸집 사용 시에는 반드시 벽체에 작용하는 콘크리트 측압 등에 대한 구조검토를 실시하여 조립도를 작성하여야 하고, 해당 조립도에 따라 시공되도록 하여야 한다.",
                  "controlLevel": "engineering",
                  "basis": {
                    "guide": "doc:kosha_guide/C-93-2013",
                    "section": "7.1"
                  }
                },
                {
                  "measure": "타설 작업을 시작하기 전에 해당 작업에 관한 거푸집, 동바리 등의 변형·변위 및 지반의 침하 유무 등을 점검하고 이상이 있는 경우 조치하여야 한다.",
                  "controlLevel": "administrative",
                  "basis": {
                    "guide": "doc:kosha_guide/C-93-2013",
                    "section": "7.1"
                  }
                },
                {
                  "measure": "콘크리트 타설 작업 시 거푸집이 무너질 위험이 발생할 우려가 있는 경우 충분한 보강조치를 취하여야 한다.",
                  "controlLevel": "engineering",
                  "basis": {
                    "guide": "doc:kosha_guide/C-93-2013",
                    "section": "7.1"
                  }
                },
                {
                  "measure": "콘크리트를 타설하는 경우에는 편심이 발생하지 않도록 골고루 분산하여 타설하여야 한다.",
                  "controlLevel": "administrative",
                  "basis": {
                    "guide": "doc:kosha_guide/C-93-2013",
                    "section": "7.1"
                  }
                },
                {
                  "measure": "콘크리트 타설 시 급격한 침하가 발생되지 않도록 최대한 시간을 두고 여유 있게 타설하여야 한다.",
                  "controlLevel": "administrative",
                  "basis": {
                    "guide": "doc:kosha_guide/C-93-2013",
                    "section": "7.1"
                  }
                },
                {
                  "measure": "설계도서상의 콘크리트 양생기간을 준수하여 거푸집, 동바리 등을 해체하여야 한다.",
                  "controlLevel": "elimination",
                  "basis": {
                    "guide": "doc:kosha_guide/C-93-2013",
                    "section": "7.1"
                  }
                }
              ]
            },
            {
              "statement": "조립 중인 철근망이 무너지거나 노출 철근에 찔림",
              "priority": "★",
              "measures": [
                {
                  "measure": "철근조립 시 철근 이음위치에 대하여 충분히 검토하고 철근의 무너짐을 방지를 위하여 강관파이프, 와이어로프, 각재 등으로 일정 간격마다 버팀대를 설치한다.",
                  "controlLevel": "engineering",
                  "basis": {
                    "guide": "doc:kosha_guide/C-93-2013",
                    "section": "7.1"
                  }
                },
                {
                  "measure": "노출된 철근 및 강선에는 보호캡을 씌우고 위험표시를 한다.",
                  "controlLevel": "engineering",
                  "basis": {
                    "guide": "doc:kosha_guide/C-93-2013",
                    "section": "7.1"
                  }
                },
                {
                  "measure": "철근 절단 시 철근의 탄력에 의한 재해방지를 위해 절단 부위가 튀지 않도록 주의하여 작업한다.",
                  "controlLevel": "administrative",
                  "basis": {
                    "guide": "doc:kosha_guide/C-93-2013",
                    "section": "7.1"
                  }
                }
              ]
            },
            {
              "statement": "작업계획서·작업지휘자 없이 착수하여 위험이 통제되지 않음",
              "priority": "★",
              "measures": [
                {
                  "measure": "근로자의 위험을 방지하기 위하여 사업주는 사전에 차량계 하역운반기계 작업, 굴착면의 높이가 2미터 이상 지반의 굴착작업, 중량물의 취급작업, 우물통기초의 설치작업에 관련한 작업계획서의 작성 및 작업지휘자를 지정하여야 하며 해당 근로자에게 안전한 작업방법 및 순서를 교육하여야 한다.",
                  "controlLevel": "administrative",
                  "basis": {
                    "guide": "doc:kosha_guide/C-93-2013",
                    "section": "5"
                  }
                },
                {
                  "measure": "작업 방법 및 순서, 부재(部材)의 낙하ㆍ전도 또는 붕괴를 방지하기 위한 방법, 작업에 종사하는 근로자의 추락 위험을 방지하기 위한 안전조치 방법, 공사에 사용되는 가설 철구조물 등의 설치ㆍ사용ㆍ해체 시 안전성 검토 방법, 사용하는 기계 등의 종류 및 성능ㆍ작업방법, 작업지휘자 배치계획, 그 밖에 안전ㆍ보건에 관련된 사항을 작업계획서에 포함한다.",
                  "controlLevel": "administrative",
                  "basis": {
                    "annex": "annex:기준규칙:별표4-8호"
                  }
                },
                {
                  "measure": "단위공종별 작업을 시작하기 전에는 위험성평가를 실시하고 세부 단위작업별 허용 가능한 위험범위 이내가 되도록 작업방법을 개선한 후가 아니면 작업하지 않도록 하여야 한다.",
                  "controlLevel": "administrative",
                  "basis": {
                    "guide": "doc:kosha_guide/C-93-2013",
                    "section": "5"
                  }
                },
                {
                  "measure": "관리감독자는 우물통기초공법을 시공함에 있어 필요로 한 안전한 작업방법 및 순서에 대하여 교육을 받지 않은 근로자는 작업에 투입시키지 않아야 하며, 작업 중 근로자의 떨어짐 또는 끼임 등의 위험이 있다고 판단되는 때에는 작업을 중지하여야 한다.",
                  "controlLevel": "elimination",
                  "basis": {
                    "guide": "doc:kosha_guide/C-93-2013",
                    "section": "5"
                  }
                },
                {
                  "measure": "공사 착수 전에 본 공사 시행으로 인한 인접 제반 시설물 및 지장물에 피해가 없도록 안전대책을 수립함은 물론 이에 대한 현황을 면밀히 조사, 기록, 표시하여야 하며, 인접 제반 시설물의 관계기관에게 확인시킨다.",
                  "controlLevel": "administrative",
                  "basis": {
                    "guide": "doc:kosha_guide/C-93-2013",
                    "section": "5"
                  }
                },
                {
                  "measure": "시공 전 설계도서와 현장조건이 일치하는지의 여부를 확인하고 공사용지 사용 확보, 공사용 자재 운반ㆍ적치, 지질층 시추조사표 검토, 시공기계·기구 선정 등의 사항들을 사전에 검토하여 안전한 시공이 되도록 하여야 한다.",
                  "controlLevel": "administrative",
                  "basis": {
                    "guide": "doc:kosha_guide/C-93-2013",
                    "section": "5"
                  }
                }
              ]
            }
          ]
        },
