          "hazard": "hazard:electric_shock",
          "risks": [
            {
              "statement": "철근 운반 중 주변 전선에 접촉하거나 용접기 누전으로 감전",
              "priority": "★",
              "measures": [
                {
                  "measure": "철근 및 거푸집 운반 시 감전 사고를 예방하기 위하여 주변의 전선은 사용 철근의 최대길이 이상의 높이에 배선되어야 하며 이격 거리는 최소한 2 미터 이상으로 한다.",
                  "controlLevel": "engineering",
                  "basis": {
                    "guide": "doc:kosha_guide/C-93-2013",
                    "section": "7.1"
                  }
