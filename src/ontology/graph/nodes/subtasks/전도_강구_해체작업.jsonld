  "steps": [
    {
      "stepName": "사전 취약화 및 철근 절단",
      "stepHazards": [
        {
          "hazardLabel": "무너짐",
          "basis": [
            {
              "guide": "doc:kosha_guide/C-47-2023",
              "section": "5.2.12",
              "controlLevel": "administrative"
            },
            {
              "guide": "doc:kosha_guide/C-47-2023",
              "section": "5.2.12",
              "controlLevel": "engineering"
            },
            {
              "guide": "doc:kosha_guide/C-47-2023",
              "section": "5.2.12",
              "controlLevel": "elimination"
            }
          ],
          "hazard": "hazard:cave_in",
          "risks": [
            {
              "statement": "전도방향 전면 철근을 먼저 모두 절단하여 구조물이 계획과 반대방향으로 넘어짐",
              "priority": "★★",
              "measures": [
                {
                  "measure": "기둥철근 절단 순서는 전도방향의 전면 그리고 양측면, 마지막으로 뒷부분 철근을 절단하도록 하고, 반대방향 전도를 방지하기 위해 전도방향 전면 철근을 2본 이상 남겨 두어야 한다.",
                  "controlLevel": "engineering",
                  "basis": {
                    "guide": "doc:kosha_guide/C-47-2023",
                    "section": "5.2.12"
                  }
                },
                {
                  "measure": "전도를 목적으로 절삭할 부분은 시공계획 수립 시 결정하고 절삭되지 않는 단면은 안전하게 유지되도록 하여 계획과 반대방향의 전도를 방지한다.",
                  "controlLevel": "engineering",
                  "basis": {
                    "guide": "doc:kosha_guide/C-47-2023",
                    "section": "5.2.12"
                  }
                },
                {
                  "measure": "벽체의 절삭 부분 철근 절단 시는 가로철근은 아래에서 위쪽으로, 세로 철근은 중앙에서 양단방향으로 차례로 절단한다.",
                  "controlLevel": "administrative",
                  "basis": {
                    "guide": "doc:kosha_guide/C-47-2023",
                    "section": "5.2.12"
                  }
                }
              ]
            },
            {
              "statement": "절삭한 상태로 구조물을 방치하여 야간·무인 상태에서 자중으로 무너짐",
              "priority": "★★",
              "measures": [
                {
                  "measure": "전도 작업은 반드시 연속해서 실시하고, 그날 중으로 종료시키도록 하며 절삭한 상태로 방치해서는 안된다.",
                  "controlLevel": "elimination",
                  "basis": {
                    "guide": "doc:kosha_guide/C-47-2023",
                    "section": "5.2.12"
                  }
                },
                {
                  "measure": "전도 작업은 작업순서가 임의로 변경될 경우 대형재해의 위험을 초래하므로 사전 작업계획에 따라 작업하여야 하며 순서에 의한 단계별 작업을 확인한다.",
                  "controlLevel": "administrative",
                  "basis": {
                    "guide": "doc:kosha_guide/C-47-2023",
                    "section": "5.2.12"
                  }
                }
              ]
            }
          ]
        },
        {
          "hazardLabel": "화재·폭발",
          "basis": [
            {
              "guide": "doc:kosha_guide/C-47-2023",
              "section": "5.1",
              "controlLevel": "engineering"
            },
            {
              "guide": "doc:kosha_guide/C-56-2017",
              "section": "6",
              "controlLevel": "elimination"
            },
            {
              "article": "art:기준규칙:241",
              "paragraph": 2,
              "item": 2,
              "controlLevel": "engineering"
            },
            {
              "article": "art:기준규칙:241",
              "paragraph": 2,
              "item": 5,
              "controlLevel": "engineering"
            },
            {
              "article": "art:기준규칙:241",
              "paragraph": 2,
              "item": 6,
              "controlLevel": "administrative"
            },
            {
              "article": "art:기준규칙:241",
              "paragraph": 4,
              "controlLevel": "administrative"
            },
            {
              "article": "art:기준규칙:241의2",
              "paragraph": 1,
              "controlLevel": "administrative"
            },
            {
              "article": "art:기준규칙:241의2",
              "paragraph": 3,
              "controlLevel": "ppe"
            }
          ],
          "hazard": "hazard:fire_explosion",
          "risks": [
            {
              "statement": "철근 용단 불티가 해체 구조물 내부의 가연물에 착화되어 화재",
              "priority": "★",
              "measures": [
                {
                  "measure": "철근 용단 등의 작업을 위해 화기를 사용할 경우에는 용접방화포 등 불꽃, 불티 등의 비산방지조치를 한다.",
                  "controlLevel": "engineering",
                  "basis": {
                    "guide": "doc:kosha_guide/C-47-2023",
                    "section": "5.1"
                  }
                },
                {
                  "measure": "가연성물질이 있는 장소에서 화재위험작업을 하는 경우에는 작업장 내 위험물의 사용·보관 현황을 파악하고 화기작업에 따른 인근 가연성물질에 대한 방호조치 및 소화기구를 비치한다.",
                  "controlLevel": "engineering",
                  "basis": {
                    "article": "art:기준규칙:241",
                    "paragraph": 2,
                    "item": 2
                  }
                },
                {
                  "measure": "작업반경 11미터 이내에 건물구조 자체나 내부에 가연성물질이 있는 장소에서 용접·용단 작업을 하도록 하는 경우에는 화재감시자를 지정하여 용접·용단 작업 장소에 배치한다.",
                  "controlLevel": "administrative",
                  "basis": {
                    "article": "art:기준규칙:241의2",
                    "paragraph": 1
                  }
                },
                {
                  "measure": "용접 또는 용단작업 시 용접불꽃의 비산에 의한 화재, 화상 등의 재해를 예방하기 위하여 작업장 주위의 인화성 물질을 제거하고 불꽃 비산방지포를 설치한다.",
                  "controlLevel": "elimination",
                  "basis": {
                    "guide": "doc:kosha_guide/C-56-2017",
                    "section": "6"
                  }
                },
                {
                  "measure": "인화성 액체의 증기 및 인화성 가스가 남아 있지 않도록 환기 등의 조치를 한다.",
                  "controlLevel": "engineering",
                  "basis": {
                    "article": "art:기준규칙:241",
                    "paragraph": 2,
                    "item": 5
                  }
                },
                {
                  "measure": "작업근로자에 대한 화재예방 및 피난교육 등 비상조치를 한다.",
                  "controlLevel": "administrative",
                  "basis": {
                    "article": "art:기준규칙:241",
                    "paragraph": 2,
                    "item": 6
                  }
                },
                {
                  "measure": "화재위험작업이 시작되는 시점부터 종료될 때까지 작업내용, 작업일시, 안전점검 및 조치에 관한 사항 등을 해당 작업장소에 서면으로 게시한다.",
                  "controlLevel": "administrative",
                  "basis": {
                    "article": "art:기준규칙:241",
                    "paragraph": 4
                  }
                },
                {
                  "measure": "배치된 화재감시자에게 업무 수행에 필요한 확성기, 휴대용 조명기구 및 화재 대피용 마스크 등 대피용 방연장비를 지급한다.",
                  "controlLevel": "ppe",
                  "basis": {
                    "article": "art:기준규칙:241의2",
                    "paragraph": 3
                  }
                }
              ]
            }
          ]
        },
        {
          "hazardLabel": "깔림",
          "basis": [
            {
              "guide": "doc:kosha_guide/C-47-2023",
              "section": "5.2.12",
              "controlLevel": "engineering"
            },
            {
              "guide": "doc:kosha_guide/C-56-2017",
              "section": "5.1",
              "controlLevel": "engineering"
            }
          ],
          "hazard": "hazard:struck_by_overturn",
          "risks": [
            {
              "statement": "취약화 작업 중인 구조물이 예정보다 일찍 넘어져 절단 작업자가 깔림",
              "priority": "★",
              "measures": [
                {
                  "measure": "전도 작업 시에는 미리 일정신호를 정하여 작업자에게 주지시켜야 하며 안전한 거리에 대피소를 설치한다.",
                  "controlLevel": "engineering",
                  "basis": {
                    "guide": "doc:kosha_guide/C-47-2023",
                    "section": "5.2.12"
                  }
                },
                {
                  "measure": "전도공법에 의한 해체작업 시 벽체, 기둥 등 해체부재의 전도위치와 파편의 비산거리 등을 검토하여 위험구역을 설정하고 강관비계, 철골 등으로 가설 방호벽을 설치한다.",
                  "controlLevel": "engineering",
                  "basis": {
                    "guide": "doc:kosha_guide/C-56-2017",
                    "section": "5.1"
                  }
                }
              ]
            }
          ]
        }
      ]
