          ],
          "risks": [
            {
              "@id": "workrisk:철골작업/8.1",
              "@type": "WorkRisk",
              "statement": "달대비계 재료가 부식·변형되었거나 성능검정 미필 달기체인을 써 비계가 무너짐",
              "priority": "★",
              "measures": [
                {
                  "@id": "workmeasure:852fa4e07a9e",
                  "@type": "WorkMeasure",
                  "measure": "달기틀 및 달비계용 달기체인은 위험기계·기구 방호장치 성능검정규정에 적합한 것이어야 한다.",
                  "controlLevel": "administrative",
                  "basis": {
                    "basisGuide": "doc:kosha_guide/D-C-3-2025",
                    "guideSection": "8.1"
                  }
                },
                {
                  "@id": "workmeasure:6bab4c2b618d",
                  "@type": "WorkMeasure",
                  "measure": "달대비계는 가급적 안전성이 확보된 기성제품을 사용하고, 현장에서 제작하는 경우 안전하중을 고려하여야 하며, 사용재료는 변형, 부식, 손상이 없어야 한다.",
                  "controlLevel": "administrative",
                  "basis": {
                    "basisGuide": "doc:kosha_guide/D-C-3-2025",
                    "guideSection": "8.1"
                  }
                },
                {
                  "@id": "workmeasure:4007fd1df933",
                  "@type": "WorkMeasure",
                  "measure": "달대비계에는 최대 적재하중과 안전 표지판을 설치한다.",
                  "controlLevel": "engineering",
                  "basis": {
                    "basisGuide": "doc:kosha_guide/D-C-3-2025",
                    "guideSection": "8.1"
                  }
                }
              ]
            },
            {
              "@id": "workrisk:철골작업/8.2",
              "@type": "WorkRisk",
              "statement": "적치장 최대적재하중을 넘겨 쌓아 작업장이 무너짐",
              "priority": "★",
              "measures": [
                {
                  "@id": "workmeasure:255cbb419283",
                  "@type": "WorkMeasure",
                  "measure": "계획상 최대적재하중과 작업내용, 공정 등을 검토하여 작업장에 적재되는 자재의 수량, 배치방법 등의 제한요령을 명확히 정하여 안전수칙을 부착하여야 한다.",
                  "controlLevel": "administrative",
                  "basis": {
                    "basisGuide": "doc:kosha_guide/D-C-3-2025",
                    "guideSection": "8.2"
                  }
                },
                {
                  "@id": "workmeasure:0de3e0e33bd8",
                  "@type": "WorkMeasure",
                  "measure": "건물 외부로 돌출된 작업장은 적재하중과 작업하중을 고려하여 충분한 안전성을 갖도록 하여야 하며, 작업자의 추락 및 자재의 낙하·비래방지를 위하여 안전방망, 안전난간 등 안전설비를 갖추어야 한다.",
                  "controlLevel": "engineering",
                  "basis": {
                    "basisGuide": "doc:kosha_guide/D-C-3-2025",
                    "guideSection": "8.2"
                  }
                },
                {
                  "@id": "workmeasure:762684591513",
                  "@type": "WorkMeasure",
                  "measure": "철골조의 바닥에는 철판을 부설하여 이를 통로로 사용할 수 있으나, 재료를 쌓아 둘 수는 없으므로 통로와는 별도로 재료를 쌓아 놓기 위한 적치대를 설치 후 사용하도록 하여야 한다.",
                  "controlLevel": "engineering",
                  "basis": {
                    "basisGuide": "doc:kosha_guide/D-C-3-2025",
                    "guideSection": "8.2"
                  }
                },
                {
                  "@id": "workmeasure:9e5bc5b08ffb",
                  "@type": "WorkMeasure",
                  "measure": "철골 철근콘크리트조의 경우 작업장을 통상 연면적 1,000 ㎡ 에 1개소를 설치하고, 그 면적은 50 ㎡ 이상이어야 하며, 또한 2개소 이상 설치할 경우에는 작업장 간 상호 연락통로를 설치하여야 한다.",
                  "controlLevel": "engineering",
                  "basis": {
                    "basisGuide": "doc:kosha_guide/D-C-3-2025",
                    "guideSection": "8.2"
                  }
                },
                {
                  "@id": "workmeasure:f8942f640e17",
                  "@type": "WorkMeasure",
                  "measure": "철골 세우기의 진행에 따라 공사용 재료, 공구, 용접기 등을 쌓아놓는 장소와 통로를 설치하여야 하며, 구체공사에도 이용될 수 있도록 계획하여야 한다.",
                  "controlLevel": "engineering",
                  "basis": {
                    "basisGuide": "doc:kosha_guide/D-C-3-2025",
                    "guideSection": "8.2"
                  }
                },
                {
                  "@id": "workmeasure:15c32c89f5d6",
                  "@type": "WorkMeasure",
                  "measure": "작업장 설치위치는 크레인의 선회범위 내에서 수평운반거리가 가장 짧게 되도록 계획하여야 한다.",
                  "controlLevel": "engineering",
                  "basis": {
                    "basisGuide": "doc:kosha_guide/D-C-3-2025",
                    "guideSection": "8.2"
                  }
                }
              ]
            },
            {
              "@id": "workrisk:철골작업/8.3",
              "@type": "WorkRisk",
              "statement": "통기성 낮은 수직보호망이 풍압을 받아 지지 가설구조물이 무너짐",
              "priority": "★",
              "measures": [
                {
                  "@id": "workmeasure:51533b870512",
                  "@type": "WorkMeasure",
                  "measure": "통기성이 적은 수직보호망은 예상되는 최대풍압력과 지지대의 내력을 검토하여 벽이음을 보강하고, 벽이음을 일시적으로 해체하는 경우에는 가설 구조물의 안전성을 확인하여야 한다.",
                  "controlLevel": "engineering",
                  "basis": {
                    "basisGuide": "doc:kosha_guide/C-29-2017",
                    "guideSection": "4"
                  }
                },
                {
                  "@id": "workmeasure:2460af7ac7bb",
                  "@type": "WorkMeasure",
                  "measure": "수직보호망이 설치되는 가설구조물의 붕괴 또는 전도위험에 대한 안전성 여부를 사전에 확인하여야 한다.",
                  "controlLevel": "administrative",
                  "basis": {
                    "basisGuide": "doc:kosha_guide/C-29-2017",
                    "guideSection": "6"
                  }
                }
              ]
            }
