                  "@type": "WorkMeasure",
                  "measure": "가스등의 호스와 취관은 손상·마모 등에 의하여 가스등이 누출할 우려가 없는 것을 사용할 것",
                  "controlLevel": "administrative",
                  "basis": {
                    "basisArticle": "art:기준규칙:233",
                    "item": 1
