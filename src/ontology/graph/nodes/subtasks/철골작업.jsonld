            {
              "@id": "workrisk:철골작업/4.6",
              "@type": "WorkRisk",
              "statement": "인양 와이어로프를 풀려고 기둥을 오르내리다 떨어짐",
              "priority": "★",
              "measures": [
                {
                  "@id": "workmeasure:80da31f92a84",
                  "@type": "WorkMeasure",
                  "measure": "인양 와이어로프를 제거하기 위하여 기둥위로 올라가거나 기둥에서 내려올 경우에는 기둥의 트랩을 이용하여야 한다.",
                  "controlLevel": "administrative",
                  "basis": {
