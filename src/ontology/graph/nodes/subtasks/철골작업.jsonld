    {
      "@id": "workstep:철골작업/1",
      "@type": "WorkStep",
      "stepName": "앵커볼트 매립",
      "stepHazards": [
        {
          "hazardLabel": "무너짐",
          "hasHazard": "hazard:cave_in",
          "basis": [
            {
              "basisGuide": "doc:kosha_guide/D-C-3-2025",
              "guideSection": "6.3",
              "controlLevel": "engineering"
            },
            {
              "basisGuide": "doc:kosha_guide/D-C-3-2025",
              "guideSection": "6.2",
              "controlLevel": "administrative"
            },
            {
              "basisGuide": "doc:kosha_guide/D-C-3-2025",
              "guideSection": "6.4",
              "controlLevel": "administrative"
            },
            {
              "basisGuide": "doc:kosha_guide/D-C-3-2025",
              "guideSection": "6.4",
              "controlLevel": "engineering"
            },
            {
              "basisArticle": "art:기준규칙:51",
              "controlLevel": "engineering"
            }
          ],
          "risks": [
            {
              "@id": "workrisk:철골작업/1.1",
              "@type": "WorkRisk",
              "statement": "배합강도 미달 기초에 앵커볼트를 매립해 정착부가 뽑히며 세운 기둥이 무너짐",
              "priority": "★",
              "measures": [
                {
                  "@id": "workmeasure:1c9681b0970c",
                  "@type": "WorkMeasure",
                  "measure": "앵커볼트 매립 전에 철골기초 콘크리트의 배합강도는 설계기준과 같은지를 확인하여야 한다.",
                  "controlLevel": "administrative",
                  "basis": {
                    "basisGuide": "doc:kosha_guide/D-C-3-2025",
                    "guideSection": "6.2"
                  }
                },
                {
                  "@id": "workmeasure:2819be42bded",
                  "@type": "WorkMeasure",
                  "measure": "철골을 세우기 위한 앵커볼트는 지정된 위치에 매립될 수 있도록 품질 규격 및 수량을 확인하여야 한다.",
                  "controlLevel": "administrative",
                  "basis": {
                    "basisGuide": "doc:kosha_guide/D-C-3-2025",
                    "guideSection": "6.2"
                  }
                },
                {
                  "@id": "workmeasure:9afeae5c03a6",
                  "@type": "WorkMeasure",
                  "measure": "구축물등이 고정하중, 적재하중, 시공·해체 작업 중 발생하는 하중, 적설, 풍압, 지진이나 진동 및 충격 등에 의하여 전도하거나 무너지는 등의 위험을 예방하기 위하여 설계도면, 시방서, 구조설계도서 등 설계도서를 준수하여 필요한 조치를 한다.",
                  "controlLevel": "engineering",
                  "basis": {
                    "basisArticle": "art:기준규칙:51"
                  }
                }
              ]
            },
            {
              "@id": "workrisk:철골작업/1.2",
              "@type": "WorkRisk",
              "statement": "콘크리트 타설 중 앵커볼트가 이동·변형되어 기둥 베이스가 정착력을 잃음",
              "priority": "★",
              "measures": [
                {
                  "@id": "workmeasure:e0137977f112",
                  "@type": "WorkMeasure",
                  "measure": "앵커볼트는 견고하게 고정시키고 이동, 변형이 발생하지 않도록 주의하면서 콘크리트를 타설하여야 한다.",
                  "controlLevel": "engineering",
                  "basis": {
                    "basisGuide": "doc:kosha_guide/D-C-3-2025",
                    "guideSection": "6.3"
                  }
                },
                {
                  "@id": "workmeasure:10cc522b018d",
                  "@type": "WorkMeasure",
                  "measure": "앵커볼트는 매립 후에 수정하지 않도록 설치하여야 한다.",
                  "controlLevel": "engineering",
                  "basis": {
                    "basisGuide": "doc:kosha_guide/D-C-3-2025",
                    "guideSection": "6.3"
                  }
                }
              ]
            },
            {
              "@id": "workrisk:철골작업/1.3",
              "@type": "WorkRisk",
              "statement": "매립 정밀도를 벗어난 앵커볼트에 기둥을 앉혀 베이스 플레이트가 편심 지지됨",
              "priority": "★",
              "measures": [
                {
                  "@id": "workmeasure:044b1fc91baf",
                  "@type": "WorkMeasure",
                  "measure": "기둥중심은 기준선 및 인접기둥의 중심에서 5 mm 이상 벗어나지 않아야 한다.",
                  "controlLevel": "engineering",
                  "basis": {
                    "basisGuide": "doc:kosha_guide/D-C-3-2025",
                    "guideSection": "6.3"
                  }
                },
                {
                  "@id": "workmeasure:2e50c3e3dd7b",
                  "@type": "WorkMeasure",
                  "measure": "인접기둥 간 중심거리의 오차는 3 mm 이하이어야 한다.",
                  "controlLevel": "engineering",
                  "basis": {
                    "basisGuide": "doc:kosha_guide/D-C-3-2025",
                    "guideSection": "6.3"
                  }
                },
                {
                  "@id": "workmeasure:7dbeb8f6f127",
                  "@type": "WorkMeasure",
                  "measure": "앵커볼트는 정 위치에서 2 mm 이상 벗어나지 않아야 한다.",
                  "controlLevel": "engineering",
                  "basis": {
                    "basisGuide": "doc:kosha_guide/D-C-3-2025",
                    "guideSection": "6.3"
                  }
                },
                {
                  "@id": "workmeasure:7ca1f35dcf48",
                  "@type": "WorkMeasure",
                  "measure": "베이스 플레이트의 하단은 기준 높이 및 인접기둥의 높이에서 3 mm 이상 벗어나지 않아야 한다.",
                  "controlLevel": "engineering",
                  "basis": {
                    "basisGuide": "doc:kosha_guide/D-C-3-2025",
                    "guideSection": "6.3"
                  }
                }
              ]
            },
            {
              "@id": "workrisk:철골작업/1.4",
              "@type": "WorkRisk",
              "statement": "기초 기본치수를 측정하지 않아 오차가 누적된 채 세우기에 착수",
              "priority": "★",
              "measures": [
                {
                  "@id": "workmeasure:622b2f3b65e1",
                  "@type": "WorkMeasure",
                  "measure": "기둥간격, 수직, 수평도 등의 기본치수를 측정하여 확인하여야 한다.",
                  "controlLevel": "administrative",
                  "basis": {
                    "basisGuide": "doc:kosha_guide/D-C-3-2025",
                    "guideSection": "6.4"
                  }
                },
                {
                  "@id": "workmeasure:4c399e2f26c8",
                  "@type": "WorkMeasure",
                  "measure": "부정확하게 설치된 앵커 볼트는 수정하여야 한다.",
                  "controlLevel": "engineering",
                  "basis": {
                    "basisGuide": "doc:kosha_guide/D-C-3-2025",
                    "guideSection": "6.4"
                  }
                }
              ]
            }
          ]
        }
      ]
    },
