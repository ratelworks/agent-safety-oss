          ],
          "risks": [
            {
              "@id": "workrisk:철골작업/2.1",
              "@type": "WorkRisk",
              "statement": "트럭 적재함에서 결속을 푸는 중 쌓여 있던 부재가 무너져 깔림",
              "priority": "★★",
              "measures": [
                {
                  "@id": "workmeasure:908beb063936",
                  "@type": "WorkMeasure",
                  "measure": "로프 풀기 작업 또는 덮개 벗기기 작업은 적재함의 화물이 떨어질 위험이 없음을 확인한 후에 하도록 하여야 한다.",
                  "controlLevel": "engineering",
                  "basis": {
                    "basisArticle": "art:기준규칙:177",
                    "item": 4
                  }
                },
                {
                  "@id": "workmeasure:1e19f29dab55",
                  "@type": "WorkMeasure",
                  "measure": "부재 하차 시에는 쌓여 있는 부재가 무너지는 경우를 대비하여야 한다.",
                  "controlLevel": "administrative",
                  "basis": {
                    "basisGuide": "doc:kosha_guide/D-C-3-2025",
                    "guideSection": "6.6"
                  }
                },
                {
                  "@id": "workmeasure:57a314e81d60",
                  "@type": "WorkMeasure",
                  "measure": "부재 하차 시 트럭 위에서의 작업은 불안정하므로 인양 시 부재가 무너지지 않도록 주의하여야 한다.",
                  "controlLevel": "administrative",
                  "basis": {
                    "basisGuide": "doc:kosha_guide/D-C-3-2025",
                    "guideSection": "6.6"
                  }
                },
                {
                  "@id": "workmeasure:92bc56253fc6",
                  "@type": "WorkMeasure",
                  "measure": "단위화물의 무게가 100킬로그램 이상인 화물을 싣거나 내리는 작업을 하는 경우 해당 작업의 지휘자에게 작업순서 및 그 순서마다의 작업방법을 정하고 작업을 지휘하도록 하여야 한다.",
                  "controlLevel": "administrative",
                  "basis": {
                    "basisArticle": "art:기준규칙:177",
                    "item": 1
                  }
                },
                {
                  "@id": "workmeasure:906a3fcc3ac1",
                  "@type": "WorkMeasure",
                  "measure": "해당 작업을 하는 장소에 관계 근로자가 아닌 사람이 출입하는 것을 금지하여야 한다.",
                  "controlLevel": "administrative",
                  "basis": {
                    "basisArticle": "art:기준규칙:177",
                    "item": 3
                  }
                }
              ]
            },
            {
              "@id": "workrisk:철골작업/2.2",
              "@type": "WorkRisk",
              "statement": "하역운반기계를 쓰지 않고 인력으로 철골 부재를 옮기다 깔림",
              "priority": "★",
              "measures": [
                {
                  "@id": "workmeasure:2586914f29a3",
                  "@type": "WorkMeasure",
                  "measure": "중량물을 운반하거나 취급하는 경우에 하역운반기계·운반용구를 사용하여야 한다. 다만, 작업의 성질상 하역운반기계등을 사용하기 곤란한 경우에는 그러하지 아니하다.",
                  "controlLevel": "engineering",
                  "basis": {
                    "basisArticle": "art:기준규칙:385"
                  }
                },
                {
                  "@id": "workmeasure:32e5b6a480c1",
                  "@type": "WorkMeasure",
                  "measure": "근로자가 중량물을 인력으로 들어올리는 작업을 하는 경우에 과도한 무게로 인하여 근로자의 목·허리 등 근골격계에 무리한 부담을 주지 않도록 최대한 노력해야 한다.",
                  "controlLevel": "administrative",
                  "basis": {
                    "basisArticle": "art:기준규칙:663"
                  }
                }
              ]
            },
            {
              "@id": "workrisk:철골작업/2.3",
              "@type": "WorkRisk",
              "statement": "반입 차량이 부동침하·갓길 붕괴로 넘어져 깔림",
              "priority": "★",
              "measures": [
                {
                  "@id": "workmeasure:65a8e84a5d94",
                  "@type": "WorkMeasure",
                  "measure": "차량계 하역운반기계등이 넘어지거나 굴러떨어짐으로써 근로자에게 위험을 미칠 우려가 있는 경우에는 유도자를 배치하고 지반의 부동침하 및 갓길 붕괴를 방지하기 위한 조치를 해야 한다.",
                  "controlLevel": "administrative",
                  "basis": {
                    "basisArticle": "art:기준규칙:171"
                  }
                },
                {
                  "@id": "workmeasure:4d2e67bf7343",
                  "@type": "WorkMeasure",
                  "measure": "공사차량의 출입로를 확보하고 차량유도계획을 수립하여 제3자에게 피해를 주지 않도록 하여야 한다.",
                  "controlLevel": "administrative",
                  "basis": {
                    "basisGuide": "doc:kosha_guide/D-C-3-2025",
                    "guideSection": "5.2"
                  }
                }
              ]
            },
            {
              "@id": "workrisk:철골작업/2.4",
              "@type": "WorkRisk",
              "statement": "장비를 화물자동차에 싣고 내리는 중 발판에서 굴러떨어짐",
              "priority": "★",
              "measures": [
                {
                  "@id": "workmeasure:76cc804b42a2",
