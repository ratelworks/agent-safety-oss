            {
              "@id": "workrisk:철골작업/8.4",
              "@type": "WorkRisk",
              "statement": "방망 없이 전면비계를 사용하거나 설치 중 떨어짐",
              "priority": "★",
              "measures": [
                {
                  "@id": "workmeasure:fdfa2aa667d3",
                  "@type": "WorkMeasure",
                  "measure": "달비계 등 전면에 걸쳐 설치하는 전면비계는 추락 방지용 방망을 설치한 후 사용하여야 한다.",
