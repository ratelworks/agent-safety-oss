          ],
          "hazard": "hazard:cave_in",
          "risks": [
            {
              "statement": "하중을 견디지 못하고 달대비계가 무너짐",
              "priority": "★★",
              "measures": [
                {
                  "measure": "달대비계를 조립하여 사용하는 경우 하중에 충분히 견딜 수 있도록 조치한다",
                  "controlLevel": "engineering",
                  "basis": {
                    "article": "art:기준규칙:65"
                  }
                },
                {
                  "measure": "비계의 구조 및 재료에 따라 작업발판의 최대적재하중을 정하고, 이를 초과하여 실지 않는다",
                  "controlLevel": "administrative",
                  "basis": {
                    "article": "art:기준규칙:55"
                  }
                },
                {
                  "measure": "비계의 재료로 변형·부식 또는 심하게 손상된 것을 사용하지 않는다",
                  "controlLevel": "elimination",
                  "basis": {
                    "article": "art:기준규칙:54",
                    "paragraph": 1
                  }
                }
              ]
            }
          ]
        },
        {
          "hazardLabel": "떨어짐",
          "basis": [
            {
              "article": "art:기준규칙:13",
              "item": 1,
              "controlLevel": "engineering"
            },
            {
              "article": "art:기준규칙:42",
