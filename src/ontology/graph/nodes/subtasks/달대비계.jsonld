            {
              "article": "art:기준규칙:58",
              "item": 3,
              "controlLevel": "administrative"
            }
          ],
          "hazard": "hazard:fall_from_height",
          "risks": [
            {
              "statement": "안전난간·안전대 없이 작업하다 떨어짐",
              "priority": "★★",
              "measures": [
                {
                  "measure": "근로자가 추락하거나 넘어질 위험이 있는 장소에서 작업을 할 때에 근로자가 위험해질 우려가 있는 경우 비계를 조립하는 등의 방법으로 작업발판을 설치한다",
                  "controlLevel": "engineering",
                  "basis": {
                    "article": "art:기준규칙:42",
                    "paragraph": 1
                  }
                },
                {
                  "measure": "작업발판을 설치하기 곤란한 경우 추락방호망을 설치하고, 추락방호망을 설치하기 곤란한 경우에는 근로자에게 안전대를 착용하도록 하는 등 추락위험을 방지하기 위하여 필요한 조치를 한다",
                  "controlLevel": "engineering",
                  "basis": {
                    "article": "art:기준규칙:42",
                    "paragraph": 2
                  }
                },
                {
                  "measure": "안전난간은 상부 난간대, 중간 난간대, 발끝막이판 및 난간기둥으로 구성한다",
                  "controlLevel": "engineering",
                  "basis": {
                    "article": "art:기준규칙:13",
                    "item": 1
                  }
                }
              ]
            },
            {
              "statement": "점검 없이 사용하여 연결부 풀림·발판 손상을 놓침",
              "priority": "★",
              "measures": [
                {
                  "measure": "비계의 연결부 또는 접속부의 풀림 상태를 점검하고 이상을 발견하면 즉시 보수한다",
                  "controlLevel": "administrative",
                  "basis": {
                    "article": "art:기준규칙:58",
                    "item": 2
                  }
                },
                {
                  "measure": "발판 재료의 손상 여부 및 부착 또는 걸림 상태를 점검한다",
                  "controlLevel": "administrative",
                  "basis": {
                    "article": "art:기준규칙:58",
                    "item": 1
                  }
                },
                {
                  "measure": "연결 재료 및 연결 철물의 손상 또는 부식 상태를 점검한다",
                  "controlLevel": "administrative",
                  "basis": {
                    "article": "art:기준규칙:58",
                    "item": 3
                  }
                }
              ]
            }
          ]
        }
