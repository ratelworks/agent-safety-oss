          ],
          "hazard": "hazard:fall_object",
          "risks": [
            {
              "statement": "장약부위와 개구부에 방호막을 설치하지 않아 발파 시 해체물이 비산하고 폭풍압이 외부로 분출",
              "priority": "★★",
              "measures": [
                {
                  "measure": "폭파해체 작업 시에는 해체물의 비산과 폭풍압 방지를 위하여 장약부위 및 외부로 통하는 개구부에는 철망이나 부직포 등을 이용하여 방호막을 설치한다.",
                  "controlLevel": "engineering",
                  "basis": {
                    "guide": "doc:kosha_guide/C-47-2023",
                    "section": "5.2.14"
                  }
                },
                {
                  "measure": "소음, 분진, 진동으로 인한 공해대책, 파편에 대한 예방대책을 수립한다.",
                  "controlLevel": "administrative",
                  "basis": {
                    "guide": "doc:kosha_guide/C-47-2023",
                    "section": "5.2.14"
                  }
                },
                {
                  "measure": "해체구조물 외곽에 방호용 울타리를 설치하고 해체물의 넘어짐, 떨어짐 등에 대비하여 안전거리를 유지한다.",
                  "controlLevel": "engineering",
                  "basis": {
                    "guide": "doc:kosha_guide/C-47-2023",
                    "section": "5.1"
                  }
                }
              ]
            }
          ]
        },
        {
          "hazardLabel": "건강장해",
          "basis": [
            {
              "guide": "doc:kosha_guide/C-47-2023",
              "section": "5.1",
              "controlLevel": "elimination"
            },
            {
              "guide": "doc:kosha_guide/C-47-2023",
              "section": "5.2.14",
              "controlLevel": "elimination"
            }
          ],
          "risks": [
            {
              "statement": "배관보온재 등 유해물질을 제거하지 않고 폭파하여 분진에 유해물질이 섞여 확산",
              "priority": "★",
              "measures": [
                {
                  "measure": "폭파해체 시 발생되는 분진에 유해물질이 함유되지 않도록 배관보온재 등 유해물질을 미리 제거한다.",
                  "controlLevel": "elimination",
                  "basis": {
                    "guide": "doc:kosha_guide/C-47-2023",
                    "section": "5.2.14"
                  }
                },
                {
                  "measure": "해체 구조물 내·외부의 화재, 폭발, 중독 등의 유해·위험물질은 관계 법령에 따른 기준을 준수하여 사전에 제거하거나 격리하는 조치를 한다.",
                  "controlLevel": "elimination",
                  "basis": {
                    "guide": "doc:kosha_guide/C-47-2023",
                    "section": "5.1"
                  }
                }
              ]
            }
          ]
        }
      ]
    },
