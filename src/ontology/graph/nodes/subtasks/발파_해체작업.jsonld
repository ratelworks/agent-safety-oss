  "references": [
    "act:해체공사표준안전작업지침",
    "art:해체공사-지침:21"
  ],
  "steps": [
    {
      "stepName": "발파해체 설계 및 사전 취약화",
      "stepHazards": [
        {
          "hazardLabel": "무너짐",
          "basis": [
            {
              "guide": "doc:kosha_guide/C-47-2023",
              "section": "5.2.14",
              "controlLevel": "administrative"
            },
            {
              "guide": "doc:kosha_guide/C-47-2023",
              "section": "5.2.14",
              "controlLevel": "engineering"
            },
            {
              "article": "art:기준규칙:384",
              "paragraph": 2,
              "controlLevel": "engineering"
            }
          ],
          "hazard": "hazard:cave_in",
          "risks": [
            {
              "statement": "구조도면 검토 없이 발파해체를 설계하여 철근배근 상태와 다른 장약으로 구조물이 계획과 다르게 붕괴",
              "priority": "★★",
              "measures": [
                {
                  "measure": "해체대상 구조물의 구조도면을 입수하여 검토하여야 하며, 도면이 없는 경우에는 철근배근상태 등에 대한 도면을 재작성하여 검토한다.",
                  "controlLevel": "administrative",
                  "basis": {
                    "guide": "doc:kosha_guide/C-47-2023",
                    "section": "5.2.14"
                  }
                },
                {
                  "measure": "구조도면 분석 및 기술적 검토를 거쳐 구조물의 천공위치 및 방법, 사전 취약화 작업 위치, 위험구역·경계구역의 설정이 포함된 설계도면 및 작업계획을 작성한다.",
                  "controlLevel": "administrative",
                  "basis": {
                    "guide": "doc:kosha_guide/C-47-2023",
                    "section": "5.2.14"
                  }
                },
                {
                  "measure": "건축물 해체공법 및 해체공사 구조 안전성을 검토한 결과 해체계획서대로 해체되지 못하고 건축물이 붕괴할 우려가 있는 경우에는 구조보강계획을 작성한다.",
                  "controlLevel": "engineering",
                  "basis": {
                    "article": "art:기준규칙:384",
                    "paragraph": 2
                  }
                }
              ]
            },
            {
              "statement": "시험발파 없이 본발파를 실시하여 예상을 초과한 진동·파쇄력으로 인접 구조물이 손상",
              "priority": "★",
              "measures": [
                {
                  "measure": "화약류에 의한 발파 해체시에는 사전에 시험발파에 의한 폭력, 폭속, 진동치 속도 등의 파쇄능력과 진동, 소음의 영향력을 검토한다.",
                  "controlLevel": "administrative",
                  "basis": {
                    "guide": "doc:kosha_guide/C-47-2023",
                    "section": "5.2.14"
                  }
                },
                {
                  "measure": "폭파 시 인접구조물 및 주변의 영향을 최소화하기 위하여 적정량의 폭약과 정확한 시간차를 계산한다.",
                  "controlLevel": "engineering",
                  "basis": {
                    "guide": "doc:kosha_guide/C-47-2023",
                    "section": "5.2.14"
                  }
                }
              ]
            }
          ]
        },
        {
          "hazardLabel": "깔림",
          "basis": [
            {
              "guide": "doc:kosha_guide/C-47-2023",
              "section": "5.1",
              "controlLevel": "engineering"
            }
          ],
          "hazard": "hazard:struck_by_overturn",
          "risks": [
            {
              "statement": "사전 취약화 작업 중 이미 약해진 구조물이 발파 전에 무너져 작업자가 깔림",
              "priority": "★",
              "measures": [
                {
                  "measure": "구조물을 부분 해체하거나 주변 구조물 또는 시설물에 근접하여 해체할 때에는 구조물의 남은 부분 또는 인접 구조물 등이 해체공사 진동, 충격 등에 안전하도록 사전에 구조보강, 보호시설 설치 등의 필요한 조치를 한다.",
                  "controlLevel": "engineering",
                  "basis": {
                    "guide": "doc:kosha_guide/C-47-2023",
                    "section": "5.1"
                  }
                },
                {
                  "measure": "해체 구조물 구조규격, 노후정도 등의 조사결과를 반영하여 사전에 구조적 안전성을 확인하고 임시 버팀 설치 등 보강조치를 한다.",
                  "controlLevel": "engineering",
                  "basis": {
                    "guide": "doc:kosha_guide/C-47-2023",
                    "section": "5.1"
                  }
                }
              ]
            }
          ]
        }
      ]
    },
    {
