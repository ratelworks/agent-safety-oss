          "risks": [
            {
              "@id": "workrisk:조경작업/1.1",
              "@type": "WorkRisk",
              "statement": "가지치기용 이동식 사다리가 뒤집히며 떨어짐",
              "priority": "★",
              "measures": [
                {
                  "@id": "workmeasure:6fccbf3f1a89",
                  "@type": "WorkMeasure",
                  "measure": "수목식재 전 수목의 가지치기 작업 시에 이동식 사다리를 사용할 때 뒤집힘 방지 조치를 실시하고 반드시 근로자 2인1조로 작업을 실시하여야 한다.",
                  "controlLevel": "administrative",
                  "basis": {
                    "basisGuide": "doc:kosha_guide/C-75-2013",
                    "guideSection": "4.2"
                  }
                },
                {
                  "@id": "workmeasure:5fb2b3efa947",
                  "@type": "WorkMeasure",
                  "measure": "계단식 사다리에서 작업 시에는 최상부 발판으로부터 상부 3개 발판에서의 작업은 금지하여야 한다.",
                  "controlLevel": "administrative",
                  "basis": {
                    "basisGuide": "doc:kosha_guide/C-75-2013",
                    "guideSection": "4.2"
                  }
                },
                {
                  "@id": "workmeasure:18c81debaa66",
                  "@type": "WorkMeasure",
                  "measure": "3개 이상의 버팀대를 가지고 지면으로부터 안정적으로 세울 수 있는 구조를 갖춘 이동식 사다리를 사용한다.",
                  "controlLevel": "substitution",
                  "basis": {
                    "basisArticle": "art:기준규칙:42",
                    "paragraph": 4
                  }
                },
                {
                  "@id": "workmeasure:392ee38769c4",
                  "@type": "WorkMeasure",
                  "measure": "평탄하고 견고하며 미끄럽지 않은 바닥에 이동식 사다리를 설치한다.",
                  "controlLevel": "engineering",
                  "basis": {
                    "basisArticle": "art:기준규칙:42",
                    "paragraph": 4,
                    "item": 1
                  }
                },
                {
                  "@id": "workmeasure:8b69daad52b8",
                  "@type": "WorkMeasure",
                  "measure": "이동식 사다리를 견고한 시설물에 연결하여 고정하거나, 아웃트리거를 설치하거나, 다른 근로자가 지지하여 넘어지지 않도록 한다.",
                  "controlLevel": "engineering",
                  "basis": {
                    "basisArticle": "art:기준규칙:42",
                    "paragraph": 4,
                    "item": 2
                  }
                },
                {
                  "@id": "workmeasure:99a57e3a586f",
                  "@type": "WorkMeasure",
                  "measure": "이동식 사다리를 설치한 바닥면에서 높이 3.5미터 이하의 장소에서만 작업한다.",
                  "controlLevel": "administrative",
                  "basis": {
                    "basisArticle": "art:기준규칙:42",
                    "paragraph": 4,
                    "item": 4
                  }
                },
                {
                  "@id": "workmeasure:7d6ec510563e",
                  "@type": "WorkMeasure",
                  "measure": "이동식 사다리의 최상부 발판 및 그 하단 디딤대에 올라서서 작업하지 않는다.",
                  "controlLevel": "elimination",
                  "basis": {
                    "basisArticle": "art:기준규칙:42",
                    "paragraph": 4,
                    "item": 5
                  }
                },
                {
                  "@id": "workmeasure:85c79747f61e",
                  "@type": "WorkMeasure",
                  "measure": "안전모를 착용하되, 작업 높이가 2미터 이상인 경우에는 안전모와 안전대를 함께 착용한다.",
                  "controlLevel": "ppe",
                  "basis": {
                    "basisArticle": "art:기준규칙:42",
                    "paragraph": 4,
                    "item": 6
                  }
                },
                {
                  "@id": "workmeasure:027f03af282a",
                  "@type": "WorkMeasure",
                  "measure": "이동식 사다리 사용 전 변형 및 이상 유무 등을 점검하여 이상이 발견되면 즉시 수리하거나 그 밖에 필요한 조치를 한다.",
                  "controlLevel": "administrative",
                  "basis": {
                    "basisArticle": "art:기준규칙:42",
                    "paragraph": 4,
                    "item": 7
                  }
                }
              ]
            }
          ]
