          ],
          "risks": [
            {
              "@id": "workrisk:조경작업/1.4",
              "@type": "WorkRisk",
              "statement": "한 구덩이에서 곡괭이 작업을 동시에 하다 서로를 타격함",
              "priority": "★",
              "measures": [
                {
                  "@id": "workmeasure:4e79458dfefd",
                  "@type": "WorkMeasure",
                  "measure": "곡괭이 작업시 곡괭이의 상태를 점검하고, 2인이 한구덩이 안에서 동시작업을 하지 못하도록 주지하거나 통제하여야 한다.",
                  "controlLevel": "administrative",
                  "basis": {
                    "basisGuide": "doc:kosha_guide/C-75-2013",
                    "guideSection": "4.3"
                  }
                },
                {
                  "@id": "workmeasure:4b0bd151caf3",
                  "@type": "WorkMeasure",
                  "measure": "근로자작업과 장비작업 시 동시작업을 금지하여야 하며, 다만, 근로자와 장비가 동시작업을 하는 경우에는 신호수를 배치하고 작업하여야 한다.",
                  "controlLevel": "administrative",
                  "basis": {
                    "basisGuide": "doc:kosha_guide/C-75-2013",
                    "guideSection": "4.3"
                  }
                }
              ]
            },
            {
              "@id": "workrisk:조경작업/1.5",
              "@type": "WorkRisk",
              "statement": "인양·하차 작업반경 안에 근로자가 들어와 부딪힘",
              "priority": "★",
              "measures": [
                {
                  "@id": "workmeasure:d83481f0f7b1",
                  "@type": "WorkMeasure",
                  "measure": "장비를 이용하여 수목을 인양, 하차시 및 운반 장소의 작업반경내 관계 근로자외의 사람이 출입하지 못하도록 통제한 상태에서 작업해야 한다.",
                  "controlLevel": "administrative",
                  "basis": {
                    "basisGuide": "doc:kosha_guide/C-75-2013",
                    "guideSection": "4.3"
                  }
                },
                {
                  "@id": "workmeasure:a92ba94002b6",
                  "@type": "WorkMeasure",
                  "measure": "미리 근로자의 출입을 통제하여 인양 중인 하물이 작업자의 머리 위로 통과하지 않도록 한다.",
                  "controlLevel": "administrative",
                  "basis": {
                    "basisArticle": "art:기준규칙:146",
                    "paragraph": 1,
                    "item": 4
                  }
                },
                {
                  "@id": "workmeasure:9f2a040bd3c4",
                  "@type": "WorkMeasure",
                  "measure": "인양할 하물을 바닥에서 끌어당기거나 밀어내는 작업을 하지 아니한다.",
                  "controlLevel": "administrative",
                  "basis": {
                    "basisArticle": "art:기준규칙:146",
                    "paragraph": 1,
                    "item": 1
                  }
                },
                {
                  "@id": "workmeasure:52d6d2b1fdfc",
                  "@type": "WorkMeasure",
                  "measure": "인양할 하물이 보이지 아니하는 경우에는 어떠한 동작도 하지 아니한다. 다만 신호하는 사람에 의하여 작업을 하는 경우는 제외한다.",
                  "controlLevel": "administrative",
                  "basis": {
                    "basisArticle": "art:기준규칙:146",
                    "paragraph": 1,
                    "item": 5
                  }
                },
                {
                  "@id": "workmeasure:66e397bcd533",
                  "@type": "WorkMeasure",
                  "measure": "장비 작업구간에는 반드시 유도자 및 작업지휘자를 배치하여 정해진 운행 경로를 확보해야 하며, 화물자동차의 적재함에 근로자를 탑승시켜서는 안된다.",
                  "controlLevel": "administrative",
                  "basis": {
                    "basisGuide": "doc:kosha_guide/C-75-2013",
                    "guideSection": "4.3"
                  }
                },
                {
