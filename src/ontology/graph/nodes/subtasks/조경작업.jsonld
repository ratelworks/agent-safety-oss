            }
          ],
          "risks": [
            {
              "@id": "workrisk:조경작업/1.3",
              "@type": "WorkRisk",
              "statement": "굴취 중인 수목이 넘어지며 근로자를 덮침",
              "priority": "★★",
              "measures": [
                {
                  "@id": "workmeasure:d817a9bcff3e",
                  "@type": "WorkMeasure",
                  "measure": "수목의 굴취는 수직으로 파내려 가지 말고 주변의 상황에 따라 계단식으로 수목을 굴취 하여야 한다. 근원부의 잡초를 제거하고 근원직경의 3∼5배 이상 크기로 뿌리분을 떠야 하며, 분의 흙이 떨어지지 않도록 새끼, 가마니, 철사, 보호재료로 결박시켜야 한다. 또한 수목 굴취시 수목이 넘어지는 것을 방지하기 위하여 수목에 지주를 설치하여 고정해야 한다.",
                  "controlLevel": "administrative",
                  "basis": {
                    "basisGuide": "doc:kosha_guide/C-75-2013",
                    "guideSection": "4.3"
                  }
                },
                {
                  "@id": "workmeasure:14d983d07961",
                  "@type": "WorkMeasure",
                  "measure": "특수한 수목에 대하여 필요한 경우 굴취 전에 가지주를 세우고 수목굴취에 착수하여 수목의 넘어짐을 방지하여야 한다.",
                  "controlLevel": "administrative",
                  "basis": {
                    "basisGuide": "doc:kosha_guide/C-75-2013",
                    "guideSection": "4.2"
                  }
                },
                {
                  "@id": "workmeasure:f80b4b0ccf59",
                  "@type": "WorkMeasure",
                  "measure": "제품, 자재, 부재 등이 넘어지지 않도록 붙들어 지탱하게 하는 등 안전 조치를 하여야 한다.",
                  "controlLevel": "administrative",
                  "basis": {
                    "basisArticle": "art:기준규칙:3",
                    "paragraph": 2
                  }
                },
                {
                  "@id": "workmeasure:36847762c05f",
                  "@type": "WorkMeasure",
                  "measure": "수목을 굴취하여 뿌리분 및 수관을 잘 포장해야 하며, 뿌리분 등의 포장은 새끼, 마대, 짚 등으로 싸매주어 뿌리 및 수피에 손상이 없도록 반드시 근로자 2인 이상 공동 작업을 실시하여야 한다.",
                  "controlLevel": "administrative",
                  "basis": {
                    "basisGuide": "doc:kosha_guide/C-75-2013",
                    "guideSection": "4.2"
                  }
                }
              ]
            }
          ]
        },
