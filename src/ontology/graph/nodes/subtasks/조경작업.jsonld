          ],
          "risks": [
            {
              "@id": "workrisk:조경작업/1.2",
              "@type": "WorkRisk",
              "statement": "정지한 나뭇가지에 찔리거나 인양 중 옷이 걸려 끌려감",
              "priority": "★",
              "measures": [
                {
                  "@id": "workmeasure:f71538f42a5e",
                  "@type": "WorkMeasure",
                  "measure": "수목식재 전 수목의 가지를 다듬어 주어야 하고, 지엽이 무성한 것은 속가지를 수형에 부합되게 정지해야하며, 근로자의 찔림 및 인양작업 시 옷 걸림 사고를 예방하여야 한다.",
                  "controlLevel": "administrative",
                  "basis": {
                    "basisGuide": "doc:kosha_guide/C-75-2013",
                    "guideSection": "4.2"
                  }
                },
                {
                  "@id": "workmeasure:2a530cee0205",
                  "@type": "WorkMeasure",
                  "measure": "수목의 운반에 지장이 되는 비교적 큰 가지를 제거하여야 하며 가지는 운반에 지장이 없도록 간편하게 결박하여야 한다. 또한 비포장 도로 운반 시에 충격을 받지 않도록 완충재를 이용하여야 한다.",
                  "controlLevel": "administrative",
                  "basis": {
                    "basisGuide": "doc:kosha_guide/C-75-2013",
                    "guideSection": "4.3"
                  }
                },
                {
                  "@id": "workmeasure:1e0c11a20f46",
                  "@type": "WorkMeasure",
                  "measure": "물체가 떨어지거나 날아올 위험이 있는 작업을 하는 근로자에게 안전모를 지급하고 착용하도록 한다.",
                  "controlLevel": "ppe",
                  "basis": {
                    "basisArticle": "art:기준규칙:32",
                    "paragraph": 1,
                    "item": 1
                  }
                }
              ]
            }
          ]
        },
        {
          "hazardLabel": "깔림",
          "hasHazard": "hazard:struck_by_overturn",
          "basis": [
            {
              "basisGuide": "doc:kosha_guide/C-75-2013",
