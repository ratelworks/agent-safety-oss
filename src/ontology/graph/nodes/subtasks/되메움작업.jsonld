            }
          ],
          "risks": [
            {
              "@id": "workrisk:되메움작업/1.1",
              "@type": "WorkRisk",
              "statement": "작업계획 없이 장비를 운행하여 넘어짐·끼임·부딪힘",
              "priority": "★",
              "measures": [
                {
                  "@id": "workmeasure:415b509f4c78",
                  "@type": "WorkMeasure",
                  "measure": "되메우기 및 다짐작업 시 장비의 넘어짐, 끼임, 부딪힘 등의 재해를 예방하기 위하여 되메우기 및 다짐용 장비의 운행경로 등 작업계획을 수립하여 작업토록 하여야 한다",
                  "controlLevel": "administrative",
                  "variant": "기본",
                  "basis": {
                    "basisGuide": "doc:kosha_guide/D-C-11-2026",
                    "guideSection": "8.2.6"
                  }
                },
                {
                  "@id": "workmeasure:de32da566cae",
                  "@type": "WorkMeasure",
                  "measure": "굴착기계등의 운행경로 및 토석 적재장소의 출입방법을 정하여 관계 근로자에게 주지시킨다",
                  "controlLevel": "administrative",
                  "variant": "기본",
                  "basis": {
                    "basisArticle": "art:기준규칙:342",
                    "item": 2
                  }
                }
              ]
            },
            {
              "@id": "workrisk:되메움작업/1.2",
              "@type": "WorkRisk",
              "statement": "작업구간에 근로자·일반인이 출입하여 장비에 접촉",
              "priority": "★★",
              "measures": [
                {
                  "@id": "workmeasure:ec3eb4870680",
                  "@type": "WorkMeasure",
                  "measure": "건설기계를 사용하는 작업구간에는 근로자 및 일반인이 출입하지 않도록 통제하여야 하고, 유도자를 배치하도록 하여야 한다",
                  "controlLevel": "administrative",
                  "variant": "기본",
                  "basis": {
                    "basisGuide": "doc:kosha_guide/D-C-11-2026",
                    "guideSection": "8.2.6"
                  }
                },
                {
                  "@id": "workmeasure:e0fa01a255c7",
                  "@type": "WorkMeasure",
                  "measure": "차량계 건설기계를 사용하여 작업을 하는 경우에는 운전 중인 해당 차량계 건설기계에 접촉되어 근로자가 부딪칠 위험이 있는 장소에 근로자를 출입시키지 않는다",
                  "controlLevel": "administrative",
                  "variant": "기본",
                  "basis": {
                    "basisArticle": "art:기준규칙:200",
                    "paragraph": 1
                  }
                }
              ]
            },
            {
