  "steps": [
    {
      "@id": "workstep:곤돌라/1",
      "@type": "WorkStep",
      "stepName": "곤돌라 설치",
      "stepHazards": [
        {
          "hazardLabel": "무너짐",
          "hasHazard": "hazard:cave_in",
          "basis": [
            {
              "basisGuide": "doc:kosha_guide/C-62-2012",
              "guideSection": "6.3",
              "controlLevel": "administrative"
            },
            {
              "basisGuide": "doc:kosha_guide/C-62-2012",
              "guideSection": "5.1",
              "controlLevel": "engineering"
            },
            {
              "basisGuide": "doc:kosha_guide/C-62-2012",
              "guideSection": "7.1",
              "controlLevel": "engineering"
            },
            {
              "basisGuide": "doc:kosha_guide/C-79-2015",
              "guideSection": "6.4",
              "controlLevel": "administrative"
            }
          ],
          "risks": [
            {
              "@id": "workrisk:곤돌라/1.1",
              "@type": "WorkRisk",
              "statement": "지지대 고정 미흡으로 곤돌라가 전도 또는 이탈하여 무너짐",
              "measures": [
                {
                  "@id": "workmeasure:817b640c880c",
                  "@type": "WorkMeasure",
                  "measure": "지지대를 고정한 상태에서 불필요한 틈새가 있는지, 전도 또는 이탈 위험은 없는지 를 점검한다",
                  "controlLevel": "administrative",
                  "basis": {
                    "basisGuide": "doc:kosha_guide/C-62-2012",
                    "guideSection": "6.3"
                  }
                },
                {
                  "@id": "workmeasure:1c332c9e24e9",
                  "@type": "WorkMeasure",
                  "measure": "곤돌라를 설치할 때에는 곤돌라가 전도 이탈 또는 낙하하지 않게 구조물에 와이어 로프 및 앵커 볼트 등을 사용하여 구조적으로 견고하게 설치하고 지지한다",
                  "controlLevel": "engineering",
                  "basis": {
                    "basisGuide": "doc:kosha_guide/C-62-2012",
                    "guideSection": "7.1"
                  }
                }
              ]
            },
            {
              "@id": "workrisk:곤돌라/1.2",
              "@type": "WorkRisk",
              "statement": "와이어로프 결속 미흡으로 곤돌라가 낙하하여 무너짐",
              "measures": [
                {
                  "@id": "workmeasure:ec94c6366cc2",
                  "@type": "WorkMeasure",
                  "measure": "지지대의 와이어로프 및 보조 와이어로프의 결속 및 고정상태를 점검하여야 한다. 이때, 보조 와이어로프는 주 와이어로프와 별개로 다른 곳에 지지한다",
                  "controlLevel": "administrative",
                  "basis": {
                    "basisGuide": "doc:kosha_guide/C-62-2012",
                    "guideSection": "6.3"
                  }
                }
              ]
            },
            {
              "@id": "workrisk:곤돌라/1.3",
              "@type": "WorkRisk",
              "statement": "설치상태 부적합(구조검토 미실시 등)으로 곤돌라가 무너짐",
              "measures": [
                {
                  "@id": "workmeasure:8ea5979e0e0b",
                  "@type": "WorkMeasure",
                  "measure": "곤돌라는「위험기계․기구 자율안전 확인(노동부 고시)」에서 정하는 제작기준과 안전기준에 적합한 구조이어야 한다. 다만 부득이한 사유로 구조를 변경 할 경우에는 제작․설치 전 구조검토를 반드시 한다",
                  "controlLevel": "engineering",
                  "basis": {
                    "basisGuide": "doc:kosha_guide/C-62-2012",
                    "guideSection": "5.1"
                  }
                },
                {
                  "@id": "workmeasure:fda8b1a5cd0b",
                  "@type": "WorkMeasure",
                  "measure": "곤돌라를 설치한 때에는 설치상태가 구조검토서 및 매뉴얼에 적합한지를 관리감독자가 확인하고 이를 승인한 후 사용한다",
                  "controlLevel": "administrative",
                  "basis": {
                    "basisGuide": "doc:kosha_guide/C-79-2015",
                    "guideSection": "6.4"
                  }
                }
              ]
            }
          ]
        },
        {
          "hazardLabel": "물체에 맞음",
          "hasHazard": "hazard:fall_object",
          "basis": [
            {
              "basisGuide": "doc:kosha_guide/C-62-2012",
              "guideSection": "6.4",
              "controlLevel": "administrative"
            },
            {
              "basisGuide": "doc:kosha_guide/C-62-2012",
              "guideSection": "7.1",
              "controlLevel": "engineering"
            },
            {
              "basisGuide": "doc:kosha_guide/C-62-2012",
              "guideSection": "7.2",
              "controlLevel": "administrative"
            }
          ],
          "risks": [
            {
              "@id": "workrisk:곤돌라/1.4",
              "@type": "WorkRisk",
              "statement": "구명줄 미설치 또는 고정 불량으로 곤돌라 낙하 시 작업자가 맞음",
              "measures": [
                {
                  "@id": "workmeasure:8f03f5552f93",
                  "@type": "WorkMeasure",
                  "measure": "구명줄은 지지대와 별도로 콘크리트 기둥 등 견고한 구조물에 설치하고 로프가 풀 리지 않는가를 점검한다",
                  "controlLevel": "administrative",
                  "basis": {
                    "basisGuide": "doc:kosha_guide/C-62-2012",
                    "guideSection": "6.4"
                  }
                },
                {
                  "@id": "workmeasure:0608ef86328c",
                  "@type": "WorkMeasure",
                  "measure": "곤돌라의 낙하에 의한 위험을 방지하기 위하여 곤돌라와는 별개로 콘크리트 기둥 등 견고한 구조물에 구명줄을 설치하고 그 구명줄에 안전대(추락방지대)를 걸고 운 반구에 탑승하여 작업을 한다",
                  "controlLevel": "engineering",
                  "basis": {
                    "basisGuide": "doc:kosha_guide/C-62-2012",
                    "guideSection": "7.1"
                  }
                }
              ]
            },
            {
              "@id": "workrisk:곤돌라/1.5",
              "@type": "WorkRisk",
              "statement": "작업공구·자재 낙하로 맞음",
              "measures": [
                {
                  "@id": "workmeasure:2c3c8ea5226d",
                  "@type": "WorkMeasure",
                  "measure": "작업공구 및 자재의 낙하를 방지할 수 있도록 정리정돈을 실시한다",
                  "controlLevel": "administrative",
                  "basis": {
                    "basisGuide": "doc:kosha_guide/C-62-2012",
                    "guideSection": "7.2"
                  }
                }
              ]
            }
          ]
        },
        {
          "hazardLabel": "감전",
          "hasHazard": "hazard:electric_shock",
          "basis": [
            {
              "basisGuide": "doc:kosha_guide/C-62-2012",
              "guideSection": "7.2",
              "controlLevel": "engineering"
            }
          ],
          "risks": [
            {
              "@id": "workrisk:곤돌라/1.6",
              "@type": "WorkRisk",
              "statement": "고압선 근접작업 중 절연조치 미흡으로 감전",
              "measures": [
                {
                  "@id": "workmeasure:8ef487d8901d",
                  "@type": "WorkMeasure",
                  "measure": "고압선이 지나는 장소에서 작업할 경우에는 충전전로에 절연용 방호구를 설치하거 나 작업자에게 보호구를 착용시키는 등 활선근접작업 시 감전재해예방조치를 취하 여야 한다",
                  "controlLevel": "engineering",
                  "basis": {
                    "basisGuide": "doc:kosha_guide/C-62-2012",
                    "guideSection": "7.2"
                  }
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "@id": "workstep:곤돌라/2",
      "@type": "WorkStep",
      "stepName": "곤돌라 점검",
      "stepHazards": [
        {
          "hazardLabel": "떨어짐",
          "hasHazard": "hazard:fall_from_height",
          "basis": [
