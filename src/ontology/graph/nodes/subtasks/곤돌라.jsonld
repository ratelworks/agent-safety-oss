              "basisGuide": "doc:kosha_guide/C-62-2012",
              "guideSection": "7.1",
              "controlLevel": "administrative"
            }
          ],
          "risks": [
            {
              "@id": "workrisk:곤돌라/2.1",
              "@type": "WorkRisk",
              "statement": "점검 미실시로 곤돌라 안전장치·브레이크가 작동하지 않아 떨어짐",
              "measures": [
                {
                  "@id": "workmeasure:9e378ff40d1f",
                  "@type": "WorkMeasure",
                  "measure": "그밖에 권과방지장치, 과부하방지장치 등 각종 안전장치를 부착한 곤돌라를 제작하 고 사용한다",
                  "controlLevel": "engineering",
                  "basis": {
                    "basisGuide": "doc:kosha_guide/C-62-2012",
                    "guideSection": "5.1"
                  }
                },
                {
                  "@id": "workmeasure:a2bd948f3f37",
                  "@type": "WorkMeasure",
                  "measure": "브레이크의 작동상태, 가속방지장치, 과부하방지장치, 권과방지장치, 리밋스위치, 레버, 로드, 핀, 스프링 등의 비상정지장치 등 안전장치 작동상태 확인과, 변형이나 손상유무를 점검하고 이상한 냄새가 나는지를 확인한다",
                  "controlLevel": "administrative",
                  "basis": {
                    "basisGuide": "doc:kosha_guide/C-62-2012",
                    "guideSection": "6.6"
                  }
                },
                {
                  "@id": "workmeasure:5c439c58ffb4",
                  "@type": "WorkMeasure",
                  "measure": "작업시작 전에는 반드시 각종 방호장치, 브레이크의 기능, 와이어로프 등의 상태를 점검표에 의거 점검을 실시한다",
                  "controlLevel": "administrative",
                  "basis": {
                    "basisGuide": "doc:kosha_guide/C-62-2012",
                    "guideSection": "7.1"
                  }
                }
              ]
            },
            {
              "@id": "workrisk:곤돌라/2.2",
              "@type": "WorkRisk",
              "statement": "와이어로프·연결부 손상을 점검하지 않아 파단되어 떨어짐",
              "measures": [
                {
                  "@id": "workmeasure:ed727b22ec35",
                  "@type": "WorkMeasure",
                  "measure": "이음매가 있는 것, 꼬인 것, 심하게 변형 또는 부식된 것은 사용하여서는 아니 된 다.",
                  "controlLevel": "elimination",
                  "basis": {
                    "basisGuide": "doc:kosha_guide/C-62-2012",
                    "guideSection": "6.1"
                  }
                },
                {
                  "@id": "workmeasure:b7818fccf12c",
                  "@type": "WorkMeasure",
                  "measure": "와이어로프의 연결부 및 연결 상태를 점검한다",
                  "controlLevel": "administrative",
                  "basis": {
                    "basisGuide": "doc:kosha_guide/C-62-2012",
                    "guideSection": "6.2"
                  }
                },
                {
                  "@id": "workmeasure:19606ea8a2f1",
                  "@type": "WorkMeasure",
                  "measure": "승강핸들 및 축의 손상 유무 확인과 균형추 부착상태, 권상드럼의 표면상태, 안내홈 의 접합이나 돌기상태, 와이어로프 감기는 상태, 접합볼트의 풀림, 부식, 탈락 등의 유무를 점검한다",
                  "controlLevel": "administrative",
                  "basis": {
                    "basisGuide": "doc:kosha_guide/C-62-2012",
                    "guideSection": "6.5"
                  }
                }
              ]
            },
            {
              "@id": "workrisk:곤돌라/2.3",
              "@type": "WorkRisk",
              "statement": "지지대·바닥재·이동바퀴 상태를 점검하지 않아 곤돌라가 기울어 떨어짐",
              "measures": [
                {
                  "@id": "workmeasure:b59f5c2742f6",
                  "@type": "WorkMeasure",
                  "measure": "바닥재의 파손, 부식, 미끄럼방지조치가 되어 있는지를 점검한다",
                  "controlLevel": "administrative",
                  "basis": {
                    "basisGuide": "doc:kosha_guide/C-62-2012",
                    "guideSection": "6.2"
                  }
                },
                {
                  "@id": "workmeasure:278056da36a2",
                  "@type": "WorkMeasure",
                  "measure": "설치상태, 볼트의 체결상태, 용접부의 균열, 부식, 변형유무를 점검한다",
                  "controlLevel": "administrative",
                  "basis": {
                    "basisGuide": "doc:kosha_guide/C-62-2012",
                    "guideSection": "6.2"
                  }
                },
                {
                  "@id": "workmeasure:fca2438d7de5",
                  "@type": "WorkMeasure",
                  "measure": "이동용 바퀴의 상태, 완충고무의 손상 또는 이탈유무를 점검한다",
                  "controlLevel": "administrative",
                  "basis": {
                    "basisGuide": "doc:kosha_guide/C-62-2012",
                    "guideSection": "6.2"
                  }
                },
                {
                  "@id": "workmeasure:c0b157397623",
                  "@type": "WorkMeasure",
                  "measure": "지지대 프레임은 부식과 변형이 없고, 용접부의 접합상태가 양호한다",
                  "controlLevel": "engineering",
                  "basis": {
                    "basisGuide": "doc:kosha_guide/C-62-2012",
                    "guideSection": "6.3"
                  }
                },
                {
                  "@id": "workmeasure:4e25a6213abb",
                  "@type": "WorkMeasure",
                  "measure": "지지대의 점검은 매 작업시작 전에 실시한다",
                  "controlLevel": "administrative",
                  "basis": {
                    "basisGuide": "doc:kosha_guide/C-62-2012",
                    "guideSection": "6.3"
                  }
                }
              ]
            },
            {
              "@id": "workrisk:곤돌라/2.4",
              "@type": "WorkRisk",
              "statement": "승강장치 베어링·기어 이상을 점검하지 않아 승강 중 정지·역주행하여 떨어짐",
              "measures": [
                {
                  "@id": "workmeasure:74de361af7c4",
                  "@type": "WorkMeasure",
                  "measure": "베어링의 이상음이 있는지, 풀림이나 흔들림이 없는지, 급유상태가 양호한지 등을 점검한다",
                  "controlLevel": "administrative",
                  "basis": {
                    "basisGuide": "doc:kosha_guide/C-62-2012",
                    "guideSection": "6.5"
                  }
                },
                {
                  "@id": "workmeasure:af912722773c",
                  "@type": "WorkMeasure",
                  "measure": "기어장치의 체결상태, 이상마모, 이상소음, 급유상태, 덮개나 울 등이 견고하게 부착 되어 있는지를 점검한다",
                  "controlLevel": "administrative",
                  "basis": {
                    "basisGuide": "doc:kosha_guide/C-62-2012",
                    "guideSection": "6.5"
                  }
                },
                {
                  "@id": "workmeasure:b52b7be4615f",
                  "@type": "WorkMeasure",
                  "measure": "승강장치의 점검은 매 작업시작 전에 실시한다",
                  "controlLevel": "administrative",
                  "basis": {
                    "basisGuide": "doc:kosha_guide/C-62-2012",
                    "guideSection": "6.5"
                  }
                }
              ]
            },
            {
              "@id": "workrisk:곤돌라/2.5",
              "@type": "WorkRisk",
              "statement": "배선·제어반 손상을 점검하지 않아 오작동 또는 감전",
              "measures": [
                {
                  "@id": "workmeasure:312b580ae69b",
                  "@type": "WorkMeasure",
                  "measure": "배선의 손상이나 연결부 점검, 전선 인입구의 피복 상태, 누전차단기의 작동상태, 전자 접촉기의 각 접점의 마멸상태 등을 점검한다",
                  "controlLevel": "administrative",
                  "basis": {
                    "basisGuide": "doc:kosha_guide/C-62-2012",
                    "guideSection": "6.6"
                  }
                },
                {
                  "@id": "workmeasure:e2f9c9d4836e",
                  "@type": "WorkMeasure",
                  "measure": "제어반의 작동상태, 작동방향에 대한 정확한 표시여부, 각 버튼스위치의 작동상태 확인과 조작반의 외함 등 파손이나 탈락유무를 점검한다",
                  "controlLevel": "administrative",
                  "basis": {
                    "basisGuide": "doc:kosha_guide/C-62-2012",
                    "guideSection": "6.6"
                  }
                }
              ]
            },
            {
