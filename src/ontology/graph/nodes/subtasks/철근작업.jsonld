          "hazard": "hazard:fall_object",
          "risks": [
            {
              "statement": "지게차로 철근을 하역하는 중 편하중이 발생해 철근 다발이 포크에서 미끄러져 아래 근로자가 맞음",
              "priority": "★",
              "measures": [
                {
                  "measure": "지게차로 철근을 하역·운반하는 경우 편하중이 발생되지 않도록 철근을 포크 중앙에 적재하고 철근이 미끄러지지 않도록 단단히 고정한다.",
                  "controlLevel": "engineering",
                  "basis": {
                    "guide": "doc:kosha_guide/D-C-15-2026",
                    "section": "6.2"
                  }
                },
                {
                  "measure": "지게차의 포크 또는 그에 의하여 지탱되어 있는 화물의 밑에 근로자가 출입하지 않도록 울타리를 설치하는 등 출입을 금지한다.",
                  "controlLevel": "administrative",
                  "basis": {
                    "article": "art:기준규칙:20",
                    "item": 7
                  }
                },
                {
                  "measure": "지게차 작업반경 내 근로자의 출입을 통제한다.",
                  "controlLevel": "administrative",
                  "basis": {
                    "guide": "doc:kosha_guide/D-C-15-2026",
                    "section": "6.2"
                  }
                },
                {
                  "measure": "물체가 떨어지거나 날아올 위험이 있으므로 안전모를 지급하고 착용하도록 한다.",
                  "controlLevel": "ppe",
                  "basis": {
                    "article": "art:기준규칙:32",
                    "paragraph": 1,
                    "item": 1
                  }
                }
              ]
            },
            {
              "statement": "양중기로 철근 다발을 내리는 중 한 군데만 묶어 다발이 빠져나가 아래 근로자가 맞음",
              "priority": "★",
              "measures": [
                {
                  "measure": "양중기로 철근을 운반하는 경우에는 두 군데 이상 묶어서 수평으로 운반한다.",
                  "controlLevel": "administrative",
                  "basis": {
                    "article": "art:기준규칙:333",
                    "paragraph": 2,
                    "item": 1
                  }
                },
                {
                  "measure": "양중기로 철근을 운반하는 경우 작업반경 내 근로자의 출입을 통제한다.",
                  "controlLevel": "administrative",
                  "basis": {
                    "guide": "doc:kosha_guide/D-C-15-2026",
                    "section": "6.2"
                  }
                },
                {
                  "measure": "미리 근로자의 출입을 통제하여 인양 중인 하물이 작업자의 머리 위로 통과하지 않도록 한다.",
                  "controlLevel": "administrative",
                  "basis": {
                    "article": "art:기준규칙:146",
                    "paragraph": 1,
                    "item": 4
                  }
                },
                {
                  "measure": "철근을 달아 올리는 부근에는 관계 근로자 이외의 사람의 출입을 금지한다.",
                  "controlLevel": "administrative",
                  "basis": {
                    "guide": "doc:kosha_guide/D-C-15-2026",
                    "section": "6.2"
                  }
                },
                {
                  "measure": "운반작업 시에는 작업 책임자를 배치하여 수신호 또는 표준신호 방법에 의하여 시행한다.",
                  "controlLevel": "administrative",
                  "basis": {
                    "guide": "doc:kosha_guide/D-C-15-2026",
                    "section": "6.2"
                  }
                },
                {
                  "measure": "작업으로 인하여 물체가 떨어지거나 날아올 위험이 있는 경우 낙하물 방지망, 수직보호망 또는 방호선반의 설치, 출입금지구역의 설정, 보호구의 착용 등 위험을 방지하기 위하여 필요한 조치를 한다.",
                  "controlLevel": "engineering",
                  "basis": {
                    "article": "art:기준규칙:14",
                    "paragraph": 2
                  }
                },
                {
                  "measure": "작업장의 바닥, 도로 및 통로 등에서 낙하물이 근로자에게 위험을 미칠 우려가 있는 경우 보호망을 설치하는 등 필요한 조치를 한다.",
                  "controlLevel": "engineering",
