            {
              "@id": "workrisk:포장작업/1.6",
              "@type": "WorkRisk",
              "statement": "싣거나 내리는 작업 중 화물이 낙하하여 근로자가 맞음",
              "priority": "★",
              "measures": [
                {
                  "@id": "workmeasure:494ed7a68c10",
                  "@type": "WorkMeasure",
                  "measure": "싣거나 내리는 작업을 하는 경우 작업순서 및 그 순서마다 작업방법을 정하고 작업을 지휘할 것, 기구와 공구를 점검하고 불량품을 제거할 것, 작업 반경 내에 관계 근로자가 아닌 사람의 출입을 금지할 것, 로프 풀기 또는 덮개 벗기기 작업은 적재함의 화물이 떨어질 위험이 없음을 확인한 다음 작업할 것을 준수하여야 한다.",
                  "controlLevel": "administrative",
                  "basis": {
                    "basisArticle": "art:기준규칙:177"
                  }
                },
