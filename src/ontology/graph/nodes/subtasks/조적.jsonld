          "hazard": "hazard:trip_slip",
          "risks": [
            {
              "statement": "운반물이 시야를 가리거나 바닥 돌출물에 걸려 넘어짐",
              "priority": "★",
              "measures": [
                {
                  "measure": "인력운반작업을 할 경우에는 운반물이 다른 물체에 부딪히지 않도록 사전에 운반경로를 확인하고, 운반물이 전방 시야를 방해하지 않도록 하여야 한다.",
                  "controlLevel": "administrative",
                  "basis": {
                    "guide": "doc:kosha_guide/C-64-2018",
                    "section": "4.1.2"
                  }
                },
                {
                  "measure": "운반경로의 바닥면 등에 돌출물이 있을 경우에는 넘어짐 재해예방을 위하여 즉시 제거하고, 바닥면은 미끄럽지 않도록 유지하여야 한다.",
                  "controlLevel": "administrative",
                  "basis": {
                    "guide": "doc:kosha_guide/C-64-2018",
                    "section": "4.1.2"
                  }
                },
                {
                  "measure": "근로자가 작업장에서 넘어지거나 미끄러지는 등의 위험이 없도록 작업장 바닥 등을 안전하고 청결한 상태로 유지하여야 한다.",
                  "controlLevel": "administrative",
                  "basis": {
                    "article": "art:기준규칙:3",
                    "paragraph": 1
                  }
                },
                {
                  "measure": "근로자가 작업하는 장소를 항상 청결하게 유지·관리하여야 하며, 폐기물은 정해진 장소에만 버려야 한다.",
                  "controlLevel": "administrative",
                  "basis": {
                    "article": "art:기준규칙:4"
                  }
                }
              ]
            }
          ]
        },
