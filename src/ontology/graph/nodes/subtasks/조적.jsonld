            }
          ],
          "hazard": "hazard:struck_by_overturn",
          "risks": [
            {
              "statement": "수레에 자재를 과적하고 뛰어 운반하다 수레가 전도되며 자재에 깔림",
              "priority": "★",
              "measures": [
                {
                  "measure": "수레에는 과다의 자재 적재를 지양하고, 수레운반 작업 시 뛰는 행동 등 과속운반을 하여서는 아니된다. 또한 반드시 앞에서 끌어 운반하고, 가능한 2인 1조로 운반하여야 한다.",
                  "controlLevel": "administrative",
                  "basis": {
                    "guide": "doc:kosha_guide/C-64-2018",
                    "section": "4.1.3"
                  }
                },
                {
                  "measure": "수레 등 운반용구를 이용하여 자재를 운반하는 경우에는 사전에 각륜, 볼트 체결, 용접 상태 등 각 부위의 이상 유무를 확인하고 이상이 있을 경우에는 즉시 보완 조치를 하여야 한다.",
                  "controlLevel": "administrative",
                  "basis": {
                    "guide": "doc:kosha_guide/C-64-2018",
                    "section": "4.1.3"
                  }
                },
                {
                  "measure": "운반경로에는 돌출장애물이 없도록 조치하고, 시야를 확보하여야 한다. 또한 운반물은 운반도중 이탈되지 않도록 로프 등을 이용하여 견고히 고정시켜야 한다.",
                  "controlLevel": "administrative",
                  "basis": {
                    "guide": "doc:kosha_guide/C-64-2018",
                    "section": "4.1.3"
                  }
                },
                {
                  "measure": "손수레 운반 통로는 가능한 직선거리로 설치하고 전도 방지를 위하여 급회전을 금한다.",
                  "controlLevel": "administrative",
                  "basis": {
                    "guide": "doc:kosha_guide/C-16-2016",
                    "section": "4.1"
                  }
                },
                {
                  "measure": "구름멈춤대, 쐐기 등을 이용하여 중량물의 동요나 이동을 조절한다.",
                  "controlLevel": "engineering",
                  "basis": {
                    "article": "art:기준규칙:386",
                    "item": 1
                  }
                },
                {
                  "measure": "중량물이 구를 위험이 있는 방향 앞의 일정거리 이내로는 근로자의 출입을 제한한다.",
                  "controlLevel": "administrative",
                  "basis": {
                    "article": "art:기준규칙:386",
                    "item": 2
                  }
                }
              ]
            },
            {
              "statement": "자재더미 상부에 올라가 하역하다 더미가 무너지며 깔림",
              "priority": "★★",
              "measures": [
                {
                  "measure": "차량 적재함에서 벽돌, 블록 등의 자재를 하역할 경우에는 자재더미 상부에 올라가는 등의 불안전한 행동을 하여서는 아니 된다. 팔레트는 평탄하고 견고한 지반에 적재하되, 2단 이하의 높이로 적재하여야 한다.",
                  "controlLevel": "administrative",
                  "basis": {
                    "guide": "doc:kosha_guide/C-64-2018",
                    "section": "4.1.4"
                  }
                },
                {
                  "measure": "하적단의 붕괴 또는 화물의 낙하에 의하여 근로자가 위험해질 우려가 있는 경우에는 그 하적단을 로프로 묶거나 망을 치는 등 위험을 방지하기 위하여 필요한 조치를 하여야 한다.",
                  "controlLevel": "engineering",
                  "basis": {
                    "article": "art:기준규칙:392",
                    "paragraph": 1
                  }
                },
                {
                  "measure": "하적단을 쌓는 경우에는 기본형을 조성하여 쌓아야 한다.",
                  "controlLevel": "administrative",
                  "basis": {
                    "article": "art:기준규칙:392",
                    "paragraph": 2
                  }
                },
                {
                  "measure": "하적단을 헐어내는 경우에는 위에서부터 순차적으로 층계를 만들면서 헐어내어야 하며, 중간에서 헐어내어서는 아니 된다.",
                  "controlLevel": "administrative",
                  "basis": {
                    "article": "art:기준규칙:392",
                    "paragraph": 3
                  }
                },
                {
                  "measure": "제품, 자재, 부재 등이 넘어지지 않도록 붙들어 지탱하게 하는 등 안전 조치를 하여야 한다.",
                  "controlLevel": "engineering",
                  "basis": {
                    "article": "art:기준규칙:3",
                    "paragraph": 2
                  }
                },
                {
                  "measure": "인력운반작업을 하는 경우 안전모, 안전화 등 개인보호구를 반드시 착용하여야 한다.",
                  "controlLevel": "ppe",
                  "basis": {
                    "guide": "doc:kosha_guide/C-64-2018",
                    "section": "4.1.1"
                  }
                }
              ]
            }
