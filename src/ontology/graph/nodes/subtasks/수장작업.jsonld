          "risks": [
            {
              "@id": "workrisk:수장작업/1.4",
              "@type": "WorkRisk",
              "statement": "부재를 통로에 적재하여 통행 중 걸려 넘어짐",
              "measures": [
                {
                  "@id": "workmeasure:4ed1b26987ed",
                  "@type": "WorkMeasure",
                  "measure": "부재 적재장소는 근로자의 통행에 불편을 주지 않고 타 작업에 간섭이 되지 않는 위치를 선정한다",
                  "controlLevel": "engineering",
                  "basis": {
                    "basisGuide": "doc:kosha_guide/C-17-2011",
                    "guideSection": "6.1"
                  }
                }
              ]
            },
            {
              "@id": "workrisk:수장작업/1.5",
              "@type": "WorkRisk",
              "statement": "층내 소운반 중 통로가 확보되지 않아 자재에 걸려 넘어짐",
              "measures": [
                {
                  "@id": "workmeasure:9629008a58b7",
                  "@type": "WorkMeasure",
                  "measure": "작업 전에 근로자 이동통로, 자재보관장소 및 운반통로를 확보하여야 하며 작업 중 자재에 걸려 넘어지지 않도록 정리·정돈한다.",
                  "controlLevel": "administrative",
                  "basis": {
                    "basisGuide": "doc:kosha_guide/C-66-2016",
                    "guideSection": "5"
                  }
                },
                {
                  "@id": "workmeasure:45a8c754d41a",
                  "@type": "WorkMeasure",
                  "measure": "자재운반 시 작업 통로를 확보한다.",
                  "controlLevel": "administrative",
                  "basis": {
                    "basisGuide": "doc:kosha_guide/C-66-2016",
                    "guideSection": "6"
                  }
                },
                {
                  "@id": "workmeasure:bc45fa98481f",
                  "@type": "WorkMeasure",
                  "measure": "작업장으로 통하는 장소 또는 작업장 내에 근로자가 사용할 안전한 통로를 설치하고 항상 사용할 수 있는 상태로 유지한다.",
                  "controlLevel": "engineering",
                  "basis": {
                    "basisArticle": "art:기준규칙:22",
                    "paragraph": 1
                  }
                },
                {
                  "@id": "workmeasure:78740e89c749",
