          "risks": [
            {
              "@id": "workrisk:수장작업/1.1",
              "@type": "WorkRisk",
              "statement": "양중장비 없이 수장 자재를 인력으로 반입하다 낙하",
              "measures": [
                {
                  "@id": "workmeasure:7bf3702e17ea",
                  "@type": "WorkMeasure",
                  "measure": "건설용 리프트, 고소사다리 차, 이동식크레인 등 작업에 적정한 양중장비를 선정하여 부재의 현장 반입은 작업공정 순서에 맞게 이루어져야 하며, 불필요 한 과다 반입과 소운반을 최소화시켜야 한다",
                  "controlLevel": "elimination",
                  "basis": {
                    "basisGuide": "doc:kosha_guide/C-17-2011",
                    "guideSection": "6.1"
                  }
                },
                {
                  "@id": "workmeasure:7e9490717a5a",
                  "@type": "WorkMeasure",
                  "measure": "양중장비 선정 시에는 차량 진입동선 분석, 자재 대기장소 선정, 공정별 반 입 자재량 결정, 자재 양중량 분석, 자재별 포장단위 등을 파악하여 최적의 자재 투입이 이루어질 수 있도록 하여야 하며, 지게차·작업대차 등 양중 지 원장비도 함께 계획되도록 한다",
                  "controlLevel": "administrative",
                  "basis": {
                    "basisGuide": "doc:kosha_guide/C-17-2011",
                    "guideSection": "6.1"
                  }
                },
                {
                  "@id": "workmeasure:c6612ba6fab0",
                  "@type": "WorkMeasure",
                  "measure": "석재, 유리 등 중량물 양중작업 시 적정한 용량의 윈치(Winch)를 사용하고 견고한 구조의 앵커(Anchor)를 설치한다",
                  "controlLevel": "engineering",
                  "basis": {
                    "basisGuide": "doc:kosha_guide/C-56-2017",
                    "guideSection": "5.3"
                  }
                },
                {
                  "@id": "workmeasure:904b88f532ce",
                  "@type": "WorkMeasure",
                  "measure": "건설용 리프트, 이삿짐운반용 리프트, 이동식크레인 등 작업에 적정한 양중 장비를 선정하여 자재 및 부재의 현장 반입은 작업공정 순서에 맞게 이루어질 수 있도록 한다",
                  "controlLevel": "elimination",
                  "basis": {
                    "basisGuide": "doc:kosha_guide/C-66-2016",
                    "guideSection": "7"
                  }
                }
              ]
            },
            {
              "@id": "workrisk:수장작업/1.2",
              "@type": "WorkRisk",
              "statement": "난간·가시설물에 기대 세워둔 합판·석고보드·M-BAR가 넘어져 맞음",
              "measures": [
                {
                  "@id": "workmeasure:fcbd7badc038",
                  "@type": "WorkMeasure",
                  "measure": "작업발판 설치 전 작업장소는 정리정돈하여야 한다. 자재 정리정돈 시에는 합판, 석고보드, M-BAR 철물 등은 난간 또는 가시설물에 기대어 세워두 지 않아야 하며, 긴면이 바닥과 접하도록 하여 받침목을 대고 바닥에 눕혀 적재한다",
                  "controlLevel": "engineering",
                  "basis": {
                    "basisGuide": "doc:kosha_guide/C-17-2011",
                    "guideSection": "6.3"
                  }
                }
              ]
            },
            {
              "@id": "workrisk:수장작업/1.3",
              "@type": "WorkRisk",
              "statement": "화물을 편중 적재하거나 시야를 가리게 실어 낙하",
              "measures": [
                {
                  "@id": "workmeasure:e78781cc0e95",
                  "@type": "WorkMeasure",
                  "measure": "하중이 한쪽으로 치우치지 않도록 적재한다.",
                  "controlLevel": "administrative",
                  "basis": {
                    "basisArticle": "art:기준규칙:173",
                    "paragraph": 1,
                    "item": 1
                  }
                },
                {
                  "@id": "workmeasure:5804a1055fd2",
                  "@type": "WorkMeasure",
                  "measure": "화물의 붕괴 또는 낙하에 의한 위험을 방지하기 위하여 화물에 로프를 거는 등 필요한 조치를 한다.",
                  "controlLevel": "administrative",
                  "basis": {
                    "basisArticle": "art:기준규칙:173",
                    "paragraph": 1,
                    "item": 2
                  }
                },
                {
                  "@id": "workmeasure:93a84596c298",
                  "@type": "WorkMeasure",
                  "measure": "운전자의 시야를 가리지 않도록 화물을 적재한다.",
                  "controlLevel": "administrative",
                  "basis": {
                    "basisArticle": "art:기준규칙:173",
                    "paragraph": 1,
                    "item": 3
                  }
                },
                {
                  "@id": "workmeasure:74789643d8eb",
                  "@type": "WorkMeasure",
                  "measure": "화물을 적재하는 경우에는 최대적재량을 초과하지 아니한다.",
                  "controlLevel": "administrative",
                  "basis": {
                    "basisArticle": "art:기준규칙:173",
                    "paragraph": 2
                  }
                },
                {
                  "@id": "workmeasure:a53c647f9f2c",
                  "@type": "WorkMeasure",
                  "measure": "작업장의 바닥, 도로 및 통로 등에서 낙하물이 근로자에게 위험을 미칠 우려가 있는 경우 보호망을 설치하는 등 필요한 조치를 한다.",
                  "controlLevel": "administrative",
                  "basis": {
                    "basisArticle": "art:기준규칙:14",
                    "paragraph": 1
                  }
                }
              ]
            }
          ]
