            },
            {
              "article": "art:기준규칙:386",
              "item": 1,
              "controlLevel": "engineering"
            },
            {
              "article": "art:기준규칙:386",
              "item": 2,
              "controlLevel": "administrative"
            },
            {
              "article": "art:기준규칙:39",
              "paragraph": 1,
              "controlLevel": "administrative"
            }
          ],
          "hazard": "hazard:struck_by_overturn",
          "risks": [
            {
              "statement": "소화배관·밸브류를 인력으로 취급하다 깔림",
              "priority": "★",
              "measures": [
                {
                  "measure": "중량물을 운반하거나 취급하는 경우에는 하역운반기계 또는 운반용구를 사용한다.",
                  "controlLevel": "engineering",
                  "basis": {
                    "article": "art:기준규칙:385"
                  }
                },
                {
                  "measure": "중량물의 취급작업을 하는 경우 사전조사를 하고 그 결과를 기록·보존하며, 조사결과를 고려한 작업계획서를 작성하여 그 계획에 따라 작업하도록 한다.",
                  "controlLevel": "administrative",
                  "basis": {
                    "article": "art:기준규칙:38",
                    "paragraph": 1,
                    "item": 11
                  }
                },
                {
                  "measure": "중량물 취급 작업계획서에는 추락위험·낙하위험·전도위험·협착위험·붕괴위험을 예방할 수 있는 안전대책을 포함한다.",
                  "controlLevel": "administrative",
                  "basis": {
                    "annex": "annex:기준규칙:별표4-11호"
                  }
                },
                {
                  "measure": "중량물 취급작업의 작업계획서를 작성한 경우 작업지휘자를 지정하여 작업계획서에 따라 작업을 지휘하도록 한다.",
                  "controlLevel": "administrative",
                  "basis": {
                    "article": "art:기준규칙:39",
                    "paragraph": 1
                  }
                }
              ]
            },
            {
              "statement": "옥외소화전·소방탱크 등 대형 자재가 굴러 근로자를 덮침",
              "priority": "★",
              "measures": [
                {
                  "measure": "드럼통 등 구를 위험이 있는 중량물을 보관하거나 작업 중 취급하는 경우에는 구름멈춤대와 쐐기 등을 이용하여 중량물의 동요나 이동을 조절한다.",
                  "controlLevel": "engineering",
                  "basis": {
                    "article": "art:기준규칙:386",
                    "item": 1
                  }
                },
                {
                  "measure": "중량물이 구를 위험이 있는 방향 앞의 일정거리 이내로는 근로자의 출입을 제한하며, 보관하거나 작업 중인 장소가 경사면인 경우에는 경사면 아래로 출입을 제한한다.",
                  "controlLevel": "administrative",
                  "basis": {
                    "article": "art:기준규칙:386",
                    "item": 2
                  }
                },
                {
                  "measure": "부재 적재장소는 근로자의 통행에 불편을 주지 않고 타 작업에 간섭이 되지 않는 위치를 선정한다.",
                  "controlLevel": "administrative",
                  "basis": {
                    "guide": "doc:kosha_guide/C-17-2011",
                    "section": "6.1"
                  }
                }
              ]
            }
          ]
        },
        {
          "hazardLabel": "물체에 맞음",
          "basis": [
            {
              "annex": "annex:기준규칙:별표4-2호",
              "controlLevel": "administrative"
