          "hazard": "hazard:fall_from_height",
          "risks": [
            {
              "statement": "결함이 있는 와이어로프를 달비계에 사용하여 파단으로 추락",
              "priority": "★★",
              "measures": [
                {
                  "measure": "이음매가 있는 와이어로프를 달비계에 사용하지 않는다",
                  "controlLevel": "elimination",
                  "basis": {
                    "article": "art:기준규칙:63",
                    "paragraph": 1,
                    "item": 1,
                    "subitem": "가"
                  }
                },
                {
                  "measure": "와이어로프의 한 꼬임에서 끊어진 소선의 수가 10퍼센트 이상인 것을 달비계에 사용하지 않는다",
                  "controlLevel": "elimination",
                  "basis": {
                    "article": "art:기준규칙:63",
                    "paragraph": 1,
                    "item": 1,
                    "subitem": "나"
                  }
                },
                {
                  "measure": "지름의 감소가 공칭지름의 7퍼센트를 초과하는 와이어로프를 달비계에 사용하지 않는다",
                  "controlLevel": "elimination",
                  "basis": {
                    "article": "art:기준규칙:63",
                    "paragraph": 1,
                    "item": 1,
                    "subitem": "다"
                  }
                },
                {
                  "measure": "꼬인 와이어로프를 달비계에 사용하지 않는다",
                  "controlLevel": "elimination",
                  "basis": {
                    "article": "art:기준규칙:63",
                    "paragraph": 1,
                    "item": 1,
                    "subitem": "라"
                  }
                },
                {
                  "measure": "심하게 변형되거나 부식된 와이어로프를 달비계에 사용하지 않는다",
                  "controlLevel": "elimination",
                  "basis": {
                    "article": "art:기준규칙:63",
                    "paragraph": 1,
                    "item": 1,
                    "subitem": "마"
                  }
                },
                {
                  "measure": "열과 전기충격에 의해 손상된 와이어로프를 달비계에 사용하지 않는다",
                  "controlLevel": "elimination",
                  "basis": {
                    "article": "art:기준규칙:63",
                    "paragraph": 1,
                    "item": 1,
                    "subitem": "바"
                  }
                }
              ]
            },
            {
              "statement": "결함이 있는 달기 체인을 사용하여 파단으로 추락",
              "priority": "★★",
              "measures": [
                {
                  "measure": "달기 체인의 길이가 달기 체인이 제조된 때의 길이의 5퍼센트를 초과한 것을 달비계에 사용하지 않는다",
                  "controlLevel": "elimination",
                  "basis": {
                    "article": "art:기준규칙:63",
                    "paragraph": 1,
                    "item": 2,
                    "subitem": "가"
                  }
                },
                {
                  "measure": "링의 단면지름이 달기 체인이 제조된 때의 해당 링의 지름의 10퍼센트를 초과하여 감소한 것을 달비계에 사용하지 않는다",
                  "controlLevel": "elimination",
                  "basis": {
                    "article": "art:기준규칙:63",
                    "paragraph": 1,
                    "item": 2,
                    "subitem": "나"
                  }
                },
                {
                  "measure": "균열이 있거나 심하게 변형된 달기 체인을 달비계에 사용하지 않는다",
                  "controlLevel": "elimination",
                  "basis": {
                    "article": "art:기준규칙:63",
                    "paragraph": 1,
                    "item": 2,
                    "subitem": "다"
                  }
                }
