  "references": [
    "act:가설공사표준안전작업지침",
    "act:추락재해방지표준안전작업지침"
  ],
  "steps": [
    {
      "stepName": "자재하역·운반",
      "stepHazards": [
        {
          "hazardLabel": "물체에 맞음",
          "basis": [
            {
              "guide": "doc:kosha_guide/D-C-7-2026",
              "section": "7.4.3",
              "controlLevel": "administrative"
            }
          ],
          "hazard": "hazard:fall_object",
          "risks": [
            {
              "statement": "부재를 던져 올리거나 내려 하부 근로자가 맞음",
              "priority": "★",
              "measures": [
                {
                  "measure": "시스템비계 부재에 의한 맞음 사고를 방지하기 위하여 재료·기구 또는 공구 등을 올리거나 내리는 경우에는 근로자가 달줄 또는 달포대를 사용하게 한다",
                  "controlLevel": "administrative",
                  "basis": {
                    "guide": "doc:kosha_guide/D-C-7-2026",
                    "section": "7.4.3"
                  }
                }
              ]
            }
          ]
        },
        {
          "hazardLabel": "깔림",
          "basis": [
            {
              "guide": "doc:kosha_guide/D-C-7-2026",
              "section": "7.4.3",
              "controlLevel": "administrative"
            },
            {
              "article": "art:기준규칙:385",
              "controlLevel": "engineering"
            }
          ],
          "hazard": "hazard:struck_by_overturn",
          "risks": [
            {
              "statement": "중량·무게중심을 모른 채 인력으로 들어 올려 깔림·무리한 동작",
              "priority": "★",
              "measures": [
                {
                  "measure": "근로자가 5kg 이상의 중량물을 인력으로 들어 올리는 작업을 하는 경우에 취급하는 물품에 대하여 근로자가 쉽게 알 수 있도록 물품의 중량과 무게중심에 대하여 작업장 주변에 안내표시를 한다",
                  "controlLevel": "administrative",
                  "basis": {
                    "guide": "doc:kosha_guide/D-C-7-2026",
                    "section": "7.4.3"
                  }
                },
                {
                  "measure": "중량물을 운반하거나 취급하는 경우에 하역운반기계·운반용구를 사용한다",
                  "controlLevel": "engineering",
                  "basis": {
                    "article": "art:기준규칙:385"
                  }
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "stepName": "조립",
      "stepHazards": [
        {
          "hazardLabel": "무너짐",
          "basis": [
            {
              "guide": "doc:kosha_guide/D-C-7-2026",
              "section": "7.4.4",
              "controlLevel": "engineering"
            },
            {
              "article": "art:기준규칙:69",
              "item": 1,
              "controlLevel": "engineering"
            },
            {
              "article": "art:기준규칙:69",
              "item": 2,
              "controlLevel": "engineering"
            },
            {
              "article": "art:기준규칙:69",
              "item": 3,
              "controlLevel": "engineering"
            },
            {
              "article": "art:기준규칙:69",
              "item": 4,
              "controlLevel": "engineering"
            },
            {
              "article": "art:기준규칙:69",
              "item": 5,
              "controlLevel": "engineering"
            },
            {
              "article": "art:기준규칙:70",
              "item": 1,
              "controlLevel": "engineering"
            },
            {
              "article": "art:기준규칙:70",
              "item": 2,
              "controlLevel": "engineering"
            }
          ],
          "hazard": "hazard:cave_in",
          "risks": [
            {
              "statement": "지반이 침하하여 시스템비계가 무너짐",
              "priority": "★★",
              "measures": [
                {
                  "measure": "비계 기둥의 밑둥에는 밑받침 철물을 사용하여야 하며, 밑받침에 고저차가 있는 경우에는 조절형 밑받침 철물을 사용하여 시스템 비계가 항상 수평 및 수직을 유지하도록 한다",
                  "controlLevel": "engineering",
                  "basis": {
                    "article": "art:기준규칙:70",
                    "item": 1
                  }
                },
                {
                  "measure": "지반의 침하방지를 위하여 지내력을 확인하여 연약지반인 경우 깔판·받침목을 설치하거나 콘크리트를 타설하는 등 침하방지 조치를 한다",
                  "controlLevel": "engineering",
                  "basis": {
                    "guide": "doc:kosha_guide/D-C-7-2026",
                    "section": "7.4.4"
                  }
                }
              ]
            },
            {
              "statement": "경사진 바닥에서 받침철물 수평을 확보하지 않아 전도됨",
              "priority": "★",
              "measures": [
                {
                  "measure": "경사진 바닥에 설치하는 경우에는 피벗형 받침 철물 또는 쐐기 등을 사용하여 밑받침 철물의 바닥면이 수평을 유지하도록 한다",
                  "controlLevel": "engineering",
                  "basis": {
                    "article": "art:기준규칙:70",
                    "item": 2
                  }
                }
              ]
            },
            {
              "statement": "수직재와 받침철물의 겹침길이가 부족하여 이탈함",
              "priority": "★★",
              "measures": [
                {
                  "measure": "비계 밑단의 수직재와 받침철물은 밀착되도록 설치하고, 수직재와 받침철물의 연결부의 겹침길이는 받침철물 전체길이의 3분의 1 이상이 되도록 한다",
                  "controlLevel": "engineering",
                  "basis": {
                    "article": "art:기준규칙:69",
                    "item": 2
                  }
                },
                {
                  "measure": "조절형 받침철물을 설치한 다음 수직재를 설치하면 넘어짐의 위험이 있으므로 수평재를 이용하여 연결핀을 견고하게 설치한다",
                  "controlLevel": "engineering",
                  "basis": {
                    "guide": "doc:kosha_guide/D-C-7-2026",
                    "section": "7.4.4"
                  }
                }
              ]
            },
            {
              "statement": "수평재·연결철물 체결이 불량하여 부재가 이탈해 무너짐",
              "priority": "★★",
              "measures": [
                {
                  "measure": "수직재·수평재·가새재를 견고하게 연결하는 구조가 되도록 한다",
                  "controlLevel": "engineering",
                  "basis": {
                    "article": "art:기준규칙:69",
                    "item": 1
                  }
                },
                {
                  "measure": "수평재는 수직재와 직각으로 설치하여야 하며, 체결 후 흔들림이 없도록 견고하게 설치한다",
                  "controlLevel": "engineering",
                  "basis": {
                    "article": "art:기준규칙:69",
                    "item": 3
                  }
                },
                {
                  "measure": "수평재는 체결 후 흔들림이 없도록 체결한 다음 망치로 2~3회 타격하여 확인하는 등 견고하게 설치한다",
                  "controlLevel": "engineering",
                  "basis": {
                    "guide": "doc:kosha_guide/D-C-7-2026",
                    "section": "7.4.4"
                  }
                },
                {
                  "measure": "수직재와 수직재의 연결철물은 이탈되지 않도록 견고한 구조로 한다",
                  "controlLevel": "engineering",
                  "basis": {
                    "article": "art:기준규칙:69",
                    "item": 4
                  }
                }
              ]
            },
            {
              "statement": "벽 연결재 간격을 지키지 않아 비계가 무너짐",
              "priority": "★★",
              "measures": [
                {
                  "measure": "벽 연결재의 설치간격은 제조사가 정한 기준에 따라 설치한다",
                  "controlLevel": "engineering",
                  "basis": {
                    "article": "art:기준규칙:69",
                    "item": 5
                  }
                },
                {
                  "measure": "벽 연결재는 수직재와 수평재의 교차부에서 비계 면에 대하여 직각이 되도록 영구구조물에 연결한다",
                  "controlLevel": "engineering",
                  "basis": {
                    "guide": "doc:kosha_guide/D-C-7-2026",
                    "section": "7.4.4"
                  }
                },
                {
                  "measure": "가새재는 제조사의 매뉴얼과 조립도에 따라 설치하고, 전문가의 구조검토가 있는 경우 그 의견에 따라 설치한다",
                  "controlLevel": "engineering",
                  "basis": {
                    "guide": "doc:kosha_guide/D-C-7-2026",
                    "section": "7.4.4"
                  }
                }
              ]
            }
          ]
        },
        {
          "hazardLabel": "떨어짐",
          "basis": [
            {
              "guide": "doc:kosha_guide/D-C-7-2026",
              "section": "7.4.4",
              "controlLevel": "engineering"
            },
            {
              "guide": "doc:kosha_guide/D-C-7-2026",
              "section": "8.3",
