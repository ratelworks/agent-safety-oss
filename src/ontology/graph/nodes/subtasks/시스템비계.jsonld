            },
            {
              "article": "art:기준규칙:70",
              "item": 6,
              "controlLevel": "administrative"
            }
          ],
          "hazard": "hazard:cave_in",
          "risks": [
            {
              "statement": "최대적재하중을 초과하여 적재해 무너짐",
              "priority": "★",
              "measures": [
                {
                  "measure": "작업발판에는 제조사가 정한 최대적재하중을 초과하여 적재해서는 아니 되며, 최대적재하중이 표기된 표지판을 부착하고 근로자에게 주지시키도록 한다",
                  "controlLevel": "administrative",
                  "basis": {
                    "article": "art:기준규칙:70",
                    "item": 6
                  }
                }
              ]
            },
            {
              "statement": "점검 없이 사용하여 연결부 풀림·침하를 놓쳐 무너짐",
              "priority": "★★",
              "measures": [
                {
                  "measure": "비계의 연결부 또는 접속부의 풀림 상태를 점검하고 이상을 발견하면 즉시 보수한다",
                  "controlLevel": "administrative",
                  "basis": {
                    "article": "art:기준규칙:58",
                    "item": 2
                  }
                },
                {
                  "measure": "기둥의 침하, 변형, 변위 또는 흔들림 상태를 점검한다",
                  "controlLevel": "administrative",
                  "basis": {
                    "article": "art:기준규칙:58",
                    "item": 5
                  }
                },
                {
                  "measure": "연결 재료 및 연결 철물의 손상 또는 부식 상태를 점검한다",
                  "controlLevel": "administrative",
                  "basis": {
                    "article": "art:기준규칙:58",
                    "item": 3
                  }
                }
              ]
            },
            {
              "statement": "강풍 전후에 벽이음·보호망을 조치하지 않아 비계가 도괴됨",
              "priority": "★★",
              "measures": [
                {
                  "measure": "강풍 주의보가 나온 경우는 즉시 벽 이음재나 버팀목 등의 상황을 점검하고, 필요에 따라 비계의 경사, 무너짐이나 재료의 흩어짐을 방지하는 조치를 한다",
                  "controlLevel": "administrative",
                  "basis": {
                    "guide": "doc:kosha_guide/D-C-7-2026",
                    "section": "8.4"
                  }
                },
                {
                  "measure": "비계에 설치된 추락 방호망, 수직 보호망 및 작업발판 등은 해체하거나, 풍하중에 대하여 안전하도록 보강한다",
                  "controlLevel": "engineering",
                  "basis": {
                    "guide": "doc:kosha_guide/D-C-7-2026",
                    "section": "8.4"
                  }
                },
                {
                  "measure": "벽 이음재나 비계의 구성부재가 소정의 위치에 확실하게 설치되어 있는지를 확인하고, 필요에 따라 버팀목 등으로 보강한다",
                  "controlLevel": "engineering",
