              "item": 3,
              "controlLevel": "engineering"
            }
          ],
          "hazard": "hazard:electric_shock",
          "risks": [
            {
              "statement": "가공전로에 근접하여 조립하다 접촉하여 감전",
              "priority": "★★",
              "measures": [
                {
                  "measure": "가공전로에 근접하여 비계를 설치하는 경우에는 가공전로를 이설하거나 가공전로에 절연용 방호구를 설치하는 등 가공전로와의 접촉을 방지하기 위하여 필요한 조치를 한다",
                  "controlLevel": "engineering",
                  "basis": {
                    "article": "art:기준규칙:70",
                    "item": 3
                  }
                }
              ]
            }
          ]
        }
      ]
