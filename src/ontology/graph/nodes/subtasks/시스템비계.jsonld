            },
            {
              "article": "art:기준규칙:57",
              "paragraph": 1,
              "item": 5,
              "controlLevel": "engineering"
            }
          ],
          "hazard": "hazard:fall_from_height",
          "risks": [
            {
              "statement": "조립 중 안전대 부착설비 없이 작업하다 떨어짐",
              "priority": "★★",
              "measures": [
                {
                  "measure": "비계 작업 근로자는 떨어질 위험이 있으므로 안전대 부착용 로프를 먼저 설치하고 안전대를 걸고 작업을 하도록 한다",
                  "controlLevel": "engineering",
                  "basis": {
                    "guide": "doc:kosha_guide/D-C-7-2026",
                    "section": "7.4.4"
                  }
                },
                {
                  "measure": "구조물과 시스템비계 사이에는 추락방호망을 높이 10m 이내마다 설치한다",
                  "controlLevel": "engineering",
                  "basis": {
                    "guide": "doc:kosha_guide/D-C-7-2026",
                    "section": "7.4.4"
                  }
                },
                {
                  "measure": "비계재료의 연결·해체작업을 하는 경우에는 폭 20센티미터 이상의 발판을 설치하고 근로자로 하여금 안전대를 사용하도록 하는 등 추락을 방지하기 위한 조치를 한다",
                  "controlLevel": "engineering",
                  "basis": {
                    "article": "art:기준규칙:57",
                    "paragraph": 1,
                    "item": 5
                  }
                },
                {
                  "measure": "근로자는 전신형 안전대 착용 후 안전대 부착설비에 안전대 고리를 직접 체결하여야 하며, 안전대 부착설비는 비계와 별도의 구조물에 고정한다",
                  "controlLevel": "engineering",
                  "basis": {
                    "guide": "doc:kosha_guide/D-C-7-2026",
                    "section": "8.3"
                  }
                }
              ]
            }
          ]
        },
