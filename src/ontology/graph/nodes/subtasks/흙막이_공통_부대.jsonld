          "risks": [
            {
              "@id": "workrisk:흙막이_공통_부대/10.1",
              "@type": "WorkRisk",
              "statement": "보일링·히빙 검토 없이 굴착을 완료해 굴착 저면이 솟아오르며 흙막이가 무너짐",
              "priority": "★",
              "measures": [
                {
                  "@id": "workmeasure:a4b9645ecd9f",
                  "@type": "WorkMeasure",
                  "measure": "흙막이 벽체 시공 완료 전에 보일링(Boiling)과 히빙(Heaving)에 대한 안정성 검토를 실시하여 이로 인해 발생할 수 있는 흙막이 변형, 붕괴, 주변 지반 함몰 등의 대형 안전사고를 예방하여야 한다.",
                  "controlLevel": "administrative",
                  "basis": {
                    "basisGuide": "doc:kosha_guide/D-C-1-2025",
                    "guideSection": "6.7"
                  }
                },
                {
                  "@id": "workmeasure:34f9827e26ca",
                  "@type": "WorkMeasure",
                  "measure": "규격에 대한 검사는 흙막이 벽체의 위치, 방향, 높이, 기울기 및 법선에 대한 굴곡을 확인하여야 한다.",
                  "controlLevel": "administrative",
                  "basis": {
                    "basisGuide": "doc:kosha_guide/D-C-1-2025",
                    "guideSection": "6.7"
                  }
                },
                {
