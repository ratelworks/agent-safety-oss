    {
      "stepName": "앵커 주입재 배합·주입",
      "stepHazards": [
        {
          "hazardLabel": "무너짐",
          "basis": [
            {
              "guide": "doc:kosha_guide/D-C-1-2025",
              "section": "8.1.3",
