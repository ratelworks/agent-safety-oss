          "hazard": "hazard:fall_object",
          "risks": [
            {
              "statement": "강선을 산소절단 등으로 절단해 재료 성질이 변하고 인장 중 파단됨",
              "priority": "★★",
              "measures": [
                {
                  "measure": "강선의 절단은 기계적 방식에 의하여 절단하며 절단으로 인한 재료의 국부적 성질의 변화가 없도록 하여야 한다.",
                  "controlLevel": "elimination",
                  "basis": {
                    "guide": "doc:kosha_guide/D-C-1-2025",
                    "section": "8.3.4"
                  }
                },
                {
                  "measure": "제작된 앵커체를 검수할 때에는 다음과 같은 항목을 중점적으로 확인하여야 한다.",
                  "controlLevel": "administrative",
                  "basis": {
                    "guide": "doc:kosha_guide/D-C-1-2025",
                    "section": "8.3.4"
                  }
                },
                {
                  "measure": "흙막이지보공의 재료로 변형·부식되거나 심하게 손상된 것을 사용해서는 아니 된다.",
                  "controlLevel": "elimination",
                  "basis": {
                    "article": "art:기준규칙:345"
                  }
                }
              ]
            },
            {
              "statement": "앵커체 삽입 중 방청체가 손상되어 강선이 부식되고 나중에 파단됨",
              "priority": "★",
              "measures": [
                {
                  "measure": "앵커체를 삽입하기 전에는 앵커체에 부착된 먼지, 기름 등 이물질을 제거하여야 하며, 자유장에는 부식방지를 위한 조치를 하여야 한다.",
                  "controlLevel": "engineering",
                  "basis": {
                    "guide": "doc:kosha_guide/D-C-1-2025",
                    "section": "8.3.4"
                  }
                },
                {
                  "measure": "앵커체를 삽입할 때에는 앵커체에 손상이 발생되지 않도록 조심하여 서서히 삽입하고 자유장의 방청체가 손상되지 않도록 한다.",
                  "controlLevel": "engineering",
                  "basis": {
                    "guide": "doc:kosha_guide/D-C-1-2025",
                    "section": "8.3.4"
                  }
                }
              ]
            }
          ]
        },
        {
          "hazardLabel": "무너짐",
          "basis": [
