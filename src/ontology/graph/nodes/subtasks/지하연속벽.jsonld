  "steps": [
    {
      "stepName": "지하연속벽 줄파기·시험굴착",
      "stepHazards": [
        {
          "hazardLabel": "화재·폭발",
          "basis": [
            {
              "guide": "doc:kosha_guide/D-C-1-2025",
              "section": "7.1.1",
              "controlLevel": "administrative"
            },
            {
              "article": "art:기준규칙:341",
              "paragraph": 1,
              "controlLevel": "engineering"
            },
            {
              "article": "art:기준규칙:341",
              "paragraph": 2,
              "controlLevel": "engineering"
            },
            {
              "article": "art:기준규칙:341",
              "paragraph": 3,
              "controlLevel": "administrative"
            }
          ],
          "hazard": "hazard:fire_explosion",
          "risks": [
            {
              "statement": "줄파기 없이 굴착하여 지하에 묻힌 가스관·전력케이블을 파손해 폭발하거나 감전됨",
              "priority": "★★",
              "measures": [
                {
                  "measure": "지반굴착을 위한 천공 또는 항타 전에 천공위치에 따라 지하매설물 심도 이상 줄파기를 하여 지하 매설물의 유무 및 위치를 확인한다.",
                  "controlLevel": "administrative",
                  "basis": {
                    "guide": "doc:kosha_guide/D-C-1-2025",
                    "section": "7.1.1"
                  }
                },
                {
                  "measure": "주요 시설물에 대해서는 관계 법령에 따라 시설물 관리자에게 사전 통보하여 굴착 작업 시에 입회할 수 있도록 한다.",
                  "controlLevel": "administrative",
                  "basis": {
                    "guide": "doc:kosha_guide/D-C-1-2025",
                    "section": "7.1.1"
                  }
                },
                {
                  "measure": "줄파기로 노출된 매설물 등이 파손됨으로써 근로자가 위험해질 우려가 있는 경우에는 해당 매설물 등에 대한 방호조치를 하거나 이설하는 등 필요한 조치를 한다.",
                  "controlLevel": "engineering",
                  "basis": {
                    "article": "art:기준규칙:341",
                    "paragraph": 2
                  }
                },
                {
                  "measure": "매설물 등의 방호작업에 대하여 관리감독자에게 해당 작업을 지휘하도록 한다.",
                  "controlLevel": "administrative",
                  "basis": {
                    "article": "art:기준규칙:341",
                    "paragraph": 3
                  }
                },
                {
                  "measure": "매설물·조적벽·콘크리트벽 또는 옹벽 등의 건설물에 근접한 장소에서 굴착작업을 할 때에 해당 가설물의 파손 등에 의하여 근로자가 위험해질 우려가 있는 경우에는 해당 건설물을 보강하거나 이설하는 등 해당 위험을 방지하기 위한 조치를 한다.",
                  "controlLevel": "engineering",
                  "basis": {
                    "article": "art:기준규칙:341",
                    "paragraph": 1
                  }
                }
              ]
            }
          ]
        },
        {
          "hazardLabel": "떨어짐",
          "basis": [
            {
              "guide": "doc:kosha_guide/D-C-1-2025",
              "section": "7.1.1",
              "controlLevel": "engineering"
            },
            {
              "guide": "doc:kosha_guide/D-C-1-2025",
              "section": "7.1.1",
              "controlLevel": "administrative"
            },
            {
              "article": "art:기준규칙:43",
              "paragraph": 1,
              "controlLevel": "engineering"
            }
          ],
          "hazard": "hazard:fall_from_height",
          "risks": [
            {
              "statement": "줄파기 구간을 방호하지 않아 보행자가 굴착부로 떨어지거나 이완된 지반이 무너짐",
              "priority": "★",
              "measures": [
                {
                  "measure": "가능한 적은 범위 내에서 줄파기를 하고, 보행자의 안전을 위해 보도 경계선에 가설 울타리를 설치한다.",
                  "controlLevel": "engineering",
                  "basis": {
                    "guide": "doc:kosha_guide/D-C-1-2025",
                    "section": "7.1.1"
                  }
                },
                {
                  "measure": "줄파기 작업 시에는 부근의 노면 건조물, 매설물 등에 피해가 없도록 하고, 지반이 이완되지 않도록 주의하며, 필요시에는 가복공 또는 가포장한다.",
                  "controlLevel": "administrative",
                  "basis": {
                    "guide": "doc:kosha_guide/D-C-1-2025",
                    "section": "7.1.1"
                  }
                },
                {
                  "measure": "시험굴착 및 줄파기는 흙막이 벽체 설치 진행을 고려하여 소정의 범위 밖에서 시행하며, 작업완료 후 조속히 표준도에 따라 복구하여 교통소통에 지장이 없도록 하고 복구 후 노면을 유지 보수한다.",
                  "controlLevel": "engineering",
                  "basis": {
                    "guide": "doc:kosha_guide/D-C-1-2025",
                    "section": "7.1.1"
                  }
                },
                {
                  "measure": "작업발판 및 통로의 끝이나 개구부로서 근로자가 추락할 위험이 있는 장소에는 안전난간, 울타리, 수직형 추락방망 또는 덮개 등의 방호 조치를 충분한 강도를 가진 구조로 튼튼하게 설치한다.",
                  "controlLevel": "engineering",
                  "basis": {
                    "article": "art:기준규칙:43",
                    "paragraph": 1
                  }
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "stepName": "지하연속벽 안내벽 설치",
      "stepHazards": [
        {
          "hazardLabel": "무너짐",
          "basis": [
            {
              "guide": "doc:kosha_guide/D-C-1-2025",
              "section": "7.1.2",
              "controlLevel": "engineering"
            },
            {
              "guide": "doc:kosha_guide/D-C-1-2025",
              "section": "7.1.2",
              "controlLevel": "administrative"
            },
            {
              "article": "art:기준규칙:50",
              "item": 1,
              "controlLevel": "engineering"
            }
          ],
          "hazard": "hazard:cave_in",
          "risks": [
            {
              "statement": "안내벽 설치 전 트렌치가 무너져 근로자가 매몰됨",
              "priority": "★★",
              "measures": [
                {
                  "measure": "안내벽 설치가 완료되기 전 무너짐의 우려가 있는 때에는 양질의 토사로 치환, 굴착사면의 안전 경사확보 등의 조치를 한다.",
                  "controlLevel": "engineering",
                  "basis": {
                    "guide": "doc:kosha_guide/D-C-1-2025",
                    "section": "7.1.2"
                  }
                },
                {
                  "measure": "흙막이 벽체를 정확한 위치에 시공하고 수직도의 정도를 높이기 위하여 필요시 안내벽을 설치하여야 하며, 안내벽은 철근콘크리트나 H형 강재를 사용하여 설치한다.",
                  "controlLevel": "engineering",
                  "basis": {
                    "guide": "doc:kosha_guide/D-C-1-2025",
                    "section": "7.1.2"
                  }
                },
                {
                  "measure": "토사등이 붕괴되거나 낙하할 우려가 있는 장소에 흙막이 지보공을 설치하여 위험을 방지하기 위한 조치를 한다.",
                  "controlLevel": "engineering",
                  "basis": {
                    "article": "art:기준규칙:50",
                    "item": 1
                  }
                }
              ]
            },
            {
              "statement": "안내벽 거푸집이 콘크리트 측압을 못 버티고 무너지며 근로자가 맞음",
              "priority": "★",
              "measures": [
                {
                  "measure": "철근 콘크리트 타입의 안내벽 설치 시 거푸집은 콘크리트의 측압에 견딜 수 있는 견고한 구조이어야 하며, 굴착트렌치 폭의 확보와 콘크리트 타설 시의 변형 방지를 위하여 내부에 충분한 강도를 갖는 버팀보를 설치한다.",
                  "controlLevel": "engineering",
                  "basis": {
                    "guide": "doc:kosha_guide/D-C-1-2025",
                    "section": "7.1.2"
                  }
                }
              ]
            },
            {
              "statement": "안내벽 지내력이 부족해 철근망 삽입 좌대가 내려앉음",
              "priority": "★",
              "measures": [
                {
                  "measure": "안내벽은 철근망 삽입시 설치하는 좌대 등의 하중에 충분한 지내력을 확보할 수 있어야 한다.",
                  "controlLevel": "engineering",
                  "basis": {
                    "guide": "doc:kosha_guide/D-C-1-2025",
                    "section": "7.1.2"
                  }
                },
                {
                  "measure": "안내벽의 상단높이는 현장의 지반고 및 작업장 주변 펜스의 기초등과 비교·검토하여 안전성 여부를 확인하여야 하며, 안정성이 확보되지 않는다고 판단되는 때에서는 대처방안을 수립한 후 천공한다.",
                  "controlLevel": "administrative",
                  "basis": {
                    "guide": "doc:kosha_guide/D-C-1-2025",
                    "section": "7.1.2"
                  }
                },
                {
                  "measure": "설계도서에서 정한 안내벽의 위치, 폭, 깊이 등을 정확히 확인하고 그에 따라 천공한다.",
                  "controlLevel": "administrative",
                  "basis": {
                    "guide": "doc:kosha_guide/D-C-1-2025",
                    "section": "7.1.2"
                  }
                }
              ]
            }
          ]
        },
        {
          "hazardLabel": "깔림",
          "basis": [
            {
              "guide": "doc:kosha_guide/D-C-1-2025",
              "section": "7.1.2",
              "controlLevel": "engineering"
            },
            {
              "article": "art:기준규칙:199",
              "controlLevel": "administrative"
            }
          ],
          "hazard": "hazard:struck_by_overturn",
          "risks": [
            {
              "statement": "안내벽 주변에 지표수가 유입되어 지반이 약해지고 굴착 장비가 넘어짐",
              "priority": "★",
              "measures": [
                {
                  "measure": "안내벽과 장비 사이에 우수 등 지표수의 유입으로 인하여 장비위치의 지반이 약화되어 장비가 넘어질 우려가 있는 때에는 지반을 보강하는 등의 안전조치를 한다.",
                  "controlLevel": "engineering",
                  "basis": {
                    "guide": "doc:kosha_guide/D-C-1-2025",
                    "section": "7.1.2"
                  }
                },
                {
                  "measure": "차량계 건설기계를 사용하는 작업을 하는 경우 지반의 부동침하 방지, 갓길의 붕괴 방지 및 도로 폭의 유지 등 필요한 조치를 한다.",
                  "controlLevel": "administrative",
                  "basis": {
                    "article": "art:기준규칙:199"
                  }
                }
              ]
            }
          ]
        }
      ]
    },
