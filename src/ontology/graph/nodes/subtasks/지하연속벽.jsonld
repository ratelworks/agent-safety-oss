          "risks": [
            {
              "statement": "트렌치 안 안정액 수위가 떨어져 트렌치가 무너지고 근로자가 매몰됨",
              "priority": "★★",
              "measures": [
                {
                  "measure": "트렌치 굴착을 할 때에는 벤토나이트 안정액을 트렌치 내에 항시 공급하여 안내벽 상단까지 안정액의 수위를 유지한다.",
                  "controlLevel": "administrative",
