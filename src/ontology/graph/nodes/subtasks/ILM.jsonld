              "controlLevel": "administrative"
            }
          ],
          "risks": [
            {
              "@id": "workrisk:ILM/1.4",
              "@type": "WorkRisk",
              "statement": "추진코 조립·거치 중 전도되어 근로자가 깔림",
              "priority": "★",
              "measures": [
                {
                  "@id": "workmeasure:c03e973c26b8",
                  "@type": "WorkMeasure",
                  "measure": "추진코의 전도방지를 위한 지주 설치 등 전도방지 조치를 실시하여야 한다.",
                  "controlLevel": "engineering",
                  "basis": {
                    "basisGuide": "doc:kosha_guide/D-C-2-2025",
                    "guideSection": "8.1"
                  }
                },
                {
                  "@id": "workmeasure:593e2ee66e66",
                  "@type": "WorkMeasure",
                  "measure": "추진코가 안전하게 위치할 때까지 크레인으로 고정하며, 볼트체결이 완료된 후에 인양로프를 해체하여야 한다.",
                  "controlLevel": "administrative",
                  "basis": {
                    "basisGuide": "doc:kosha_guide/D-C-2-2025",
                    "guideSection": "8.1"
                  }
                },
                {
                  "@id": "workmeasure:25c8f3636eb6",
                  "@type": "WorkMeasure",
                  "measure": "크레인으로 인양 및 조립·해체작업 시 전도방지를 위하여 지반다짐 및 평탄 작업, 아웃트리거 하부에 받침목 설치, 필요시 콘크리트 타설 및 철판 사용의 조치를 하여야 한다.",
                  "controlLevel": "engineering",
                  "basis": {
                    "basisGuide": "doc:kosha_guide/D-C-2-2025",
                    "guideSection": "8.1"
                  }
                },
                {
                  "@id": "workmeasure:049dffef3444",
                  "@type": "WorkMeasure",
                  "measure": "추진코와 본체 구조물 연결부는 충분한 전단력을 발휘할 수 있는 체결방식이어야 한다.",
                  "controlLevel": "engineering",
                  "basis": {
                    "basisGuide": "doc:kosha_guide/D-C-2-2025",
                    "guideSection": "8.1"
                  }
                },
                {
                  "@id": "workmeasure:0befd5f3d1ce",
                  "@type": "WorkMeasure",
                  "measure": "추진코의 제작 조립거치 시 추진코의 하단과 본체 구조물의 하단이 정확히 동일평면에 있어야 하고, 거더의 추진에 지장이 없도록 충분한 정밀도를 가져야 한다.",
                  "controlLevel": "engineering",
                  "basis": {
                    "basisGuide": "doc:kosha_guide/D-C-2-2025",
                    "guideSection": "8.1"
                  }
                },
                {
                  "@id": "workmeasure:be5bda1c4013",
                  "@type": "WorkMeasure",
                  "measure": "부모멘트와 처짐방지를 위하여 선단부에 세그먼트(Segment) 길이의 60~70%를 조립하여 연결하는 철골 트러스이며 선단부에 유압잭을 설치하여 압출선단의 처짐량을 조정하여야 한다.",
                  "controlLevel": "engineering",
                  "basis": {
                    "basisGuide": "doc:kosha_guide/D-C-2-2025",
                    "guideSection": "8.1"
                  }
                }
              ]
            }
          ]
        },
