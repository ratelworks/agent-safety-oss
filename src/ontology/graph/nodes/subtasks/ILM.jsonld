  "steps": [
    {
      "@id": "workstep:ILM/1",
      "@type": "WorkStep",
      "stepName": "ILM 제작장·가시설 설치",
      "stepHazards": [
        {
          "hazardLabel": "무너짐",
          "hasHazard": "hazard:cave_in",
          "basis": [
            {
              "basisGuide": "doc:kosha_guide/D-C-2-2025",
              "guideSection": "8.1",
              "controlLevel": "engineering"
            },
            {
              "basisGuide": "doc:kosha_guide/D-C-2-2025",
              "guideSection": "8.1",
              "controlLevel": "administrative"
            }
          ],
          "risks": [
            {
              "@id": "workrisk:ILM/1.1",
              "@type": "WorkRisk",
              "statement": "제작장 지반이 부등침하하여 압출 선형이 어긋나고 주형이 전도",
              "priority": "★★",
              "measures": [
                {
                  "@id": "workmeasure:008dc801cf7f",
                  "@type": "WorkMeasure",
                  "measure": "제작장은 평탄성을 유지하여야 하며 부등침하가 발생하지 않도록 충분한 기초지반의 지지력이 확보되어야 한다.",
                  "controlLevel": "engineering",
                  "basis": {
                    "basisGuide": "doc:kosha_guide/D-C-2-2025",
                    "guideSection": "8.1"
                  }
                },
                {
                  "@id": "workmeasure:6a3f5b2c2171",
                  "@type": "WorkMeasure",
                  "measure": "세그먼트(Segment) 길이 2~3배의 평탄하고 견고한 지반 위에 가설교각, 압출장비 등을 설치하여야 한다.",
                  "controlLevel": "engineering",
                  "basis": {
                    "basisGuide": "doc:kosha_guide/D-C-2-2025",
                    "guideSection": "8.1"
                  }
                },
                {
                  "@id": "workmeasure:6f7f0c0e7715",
                  "@type": "WorkMeasure",
                  "measure": "주형 제작장의 위치는 설계단계에서 압출진행방향, 인접한 도로 상황, 추진코 및 경간의 길이, 제작장의 길이, 주형의 전도에 대한 안전성 등을 종합적으로 고려하여 적절하게 결정하여야 한다.",
                  "controlLevel": "administrative",
                  "basis": {
                    "basisGuide": "doc:kosha_guide/D-C-2-2025",
                    "guideSection": "8.1"
                  }
                },
                {
                  "@id": "workmeasure:c1d334a37ff5",
                  "@type": "WorkMeasure",
                  "measure": "공법의 특성상 동일 장소에서 1세그먼트(Segment)씩 반복하여 제작 시공하므로 제작장의 위치오차는 주형이 제작될수록 누적되어 전체 교량의 선형에 영향을 미치므로 슬라이딩 레일(Sliding rail) 설치 시 오차가 발생되지 않도록 주의하여야 한다.",
                  "controlLevel": "administrative",
                  "basis": {
                    "basisGuide": "doc:kosha_guide/D-C-2-2025",
                    "guideSection": "8.1"
                  }
                },
                {
                  "@id": "workmeasure:5176aab96597",
                  "@type": "WorkMeasure",
                  "measure": "버림 콘크리트 타설시 지내력을 확보된 곳에 펌프카를 설치하며, 받침목도 설치하여야 한다.",
                  "controlLevel": "engineering",
                  "basis": {
                    "basisGuide": "doc:kosha_guide/D-C-2-2025",
                    "guideSection": "8.1"
                  }
                }
              ]
            },
            {
              "@id": "workrisk:ILM/1.2",
              "@type": "WorkRisk",
              "statement": "가교각 내력 부족·부등침하로 압출 중 교량이 무너짐",
              "priority": "★★",
              "measures": [
                {
                  "@id": "workmeasure:7e095d3fdcc7",
                  "@type": "WorkMeasure",
                  "measure": "가교각의 해체 및 조립 시 가교각의 각 부분에 있어서의 내력이 충분한지의 여부, 작업지휘자를 선임해서 작업을 직접 지휘하고 있는지의 여부, 유자격자 및 경험자가 작업을 행하고 있는지의 여부, 압출 시 수평력에 저항하는 교각상부의 이음내력은 충분한지의 여부를 점검하여야 한다.",
                  "controlLevel": "administrative",
                  "basis": {
                    "basisGuide": "doc:kosha_guide/D-C-2-2025",
                    "guideSection": "8.1"
                  }
                },
                {
                  "@id": "workmeasure:0eef5f94fa16",
                  "@type": "WorkMeasure",
                  "measure": "가교각의 위치, 전후좌우의 각도 등을 압출작업 전후에 점검해서 기록을 보존하고 있는지의 여부를 점검하여야 한다.",
                  "controlLevel": "administrative",
                  "basis": {
                    "basisGuide": "doc:kosha_guide/D-C-2-2025",
                    "guideSection": "8.1"
                  }
                },
                {
                  "@id": "workmeasure:269c88419687",
                  "@type": "WorkMeasure",
                  "measure": "제작장의 가교각 및 하천과 해수면내 가교각 기초(우물통 등)가 부등침하에 안전한지의 여부와 사장교 등의 공법과 무리한 조합작업 여부를 점검하여야 한다.",
                  "controlLevel": "administrative",
                  "basis": {
                    "basisGuide": "doc:kosha_guide/D-C-2-2025",
                    "guideSection": "8.1"
                  }
                },
                {
                  "@id": "workmeasure:225517c3b2d5",
                  "@type": "WorkMeasure",
                  "measure": "가교각 상부에 안전작업을 수행하기 위하여 충분한 여유 공간이 있는지의 여부를 점검하여야 한다.",
                  "controlLevel": "engineering",
                  "basis": {
                    "basisGuide": "doc:kosha_guide/D-C-2-2025",
                    "guideSection": "8.1"
                  }
                },
                {
                  "@id": "workmeasure:84a923405d8e",
                  "@type": "WorkMeasure",
                  "measure": "가교각의 조립, 해체 등의 고공작업 시 안전설비가 되어 있는지의 여부를 점검하여야 한다.",
                  "controlLevel": "engineering",
                  "basis": {
                    "basisGuide": "doc:kosha_guide/D-C-2-2025",
                    "guideSection": "8.1"
                  }
                },
                {
                  "@id": "workmeasure:c04a6287f6e1",
                  "@type": "WorkMeasure",
                  "measure": "가교각의 해체를 용이하게 할 수 있는 구조로 되어 있는지의 여부를 점검하여야 한다.",
                  "controlLevel": "engineering",
                  "basis": {
                    "basisGuide": "doc:kosha_guide/D-C-2-2025",
                    "guideSection": "8.1"
                  }
                }
              ]
            },
            {
              "@id": "workrisk:ILM/1.3",
              "@type": "WorkRisk",
              "statement": "강제 거푸집 강성 부족·유압 파손으로 변형",
              "priority": "★",
              "measures": [
                {
                  "@id": "workmeasure:7d2282086039",
                  "@type": "WorkMeasure",
                  "measure": "압출공법에 사용하는 강제 거푸집은 반복 작용에 의하여 압출에 영향을 주는 변형이 발생하지 않을 정도의 충분한 강성을 가져야 한다.",
                  "controlLevel": "engineering",
                  "basis": {
                    "basisGuide": "doc:kosha_guide/D-C-2-2025",
                    "guideSection": "8.1"
                  }
                },
                {
                  "@id": "workmeasure:588bc0a5f195",
                  "@type": "WorkMeasure",
                  "measure": "강제 거푸집은 거푸집의 구조는 유압잭 등에 의해 기계화된 구조, 내부거푸집은 축 방향으로 용이하게 이동 가능한 구조, 외측거푸집은 고정거푸집으로 하고 회전과 높이 조정이 가능한 구조의 구조적 기능을 구비하여야 한다.",
                  "controlLevel": "engineering",
                  "basis": {
                    "basisGuide": "doc:kosha_guide/D-C-2-2025",
                    "guideSection": "8.1"
                  }
                },
                {
                  "@id": "workmeasure:aa9ed3ab6f53",
                  "@type": "WorkMeasure",
                  "measure": "압출장비 고정지지 빔은 교량 상부공 전체에 대해 압출 추진할 때 수평력이 가해져도 변위가 발생하지 않도록 충분한 강성이 있어야 하며, 확실하게 고정되어 있어야 한다.",
                  "controlLevel": "engineering",
                  "basis": {
                    "basisGuide": "doc:kosha_guide/D-C-2-2025",
                    "guideSection": "8.1"
                  }
                },
                {
                  "@id": "workmeasure:a29f63a7b85e",
                  "@type": "WorkMeasure",
                  "measure": "교량 상부구조물 압출작업시 선형성유지, 이탈방지를 위하여 교각 측면에 횡방향 가이드를 설치하여야 한다.",
                  "controlLevel": "engineering",
                  "basis": {
                    "basisGuide": "doc:kosha_guide/D-C-2-2025",
                    "guideSection": "8.1"
                  }
                },
                {
                  "@id": "workmeasure:1bd39f2d4e9a",
                  "@type": "WorkMeasure",
                  "measure": "횡방향 가이드의 폭은 계획 종단상의 중심선(Center line)에 박스 폭 및 미끄럼판의 두께를 더한 길이에 약간의 여유를 두어 설치하여야 한다.",
                  "controlLevel": "engineering",
                  "basis": {
                    "basisGuide": "doc:kosha_guide/D-C-2-2025",
                    "guideSection": "8.1"
                  }
                }
              ]
            }
          ]
        },
        {
          "hazardLabel": "깔림",
          "hasHazard": "hazard:struck_by_overturn",
          "basis": [
            {
              "basisGuide": "doc:kosha_guide/D-C-2-2025",
