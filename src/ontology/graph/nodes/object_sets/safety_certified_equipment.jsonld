  "description": "산안법 제80조 안전인증 대상과 제89조 자율안전확인 대상 장비·적용성 집합 — KCs 적격품 확인 및 법적 근거 traversal용.",
  "category": "EquipmentApplicability",
  "sparqlFilter": "{ ?equipment a safety:Equipment ; schema:category 'safety_certified' . } UNION { VALUES ?equipment { applic:safety_certification_13 applic:voluntary_safety_confirmation_21 } }",
