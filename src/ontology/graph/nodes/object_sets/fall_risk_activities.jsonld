    },
    {
      "@id": "activity:roofing"
    }
  ],
  "memberCount": 7,
  "_meta": {
    "created": "2026-05-03",
    "creator": "safety:agent/ratelworks",
    "intendedUse": "LLM이 추락 위험이 높은 작업을 모아 hasHazard=fall_from_height 및 mitigatedBy 공학적 통제를 우선 탐색한다.",
    "sourcePattern": "declarative named object-set query pattern"
