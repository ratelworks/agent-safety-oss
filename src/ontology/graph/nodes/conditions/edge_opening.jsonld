{
  "@context": "../../context.jsonld",
  "@id": "workcond:edge_opening",
  "@type": "WorkCondition",
  "title": "단부·개구부 인접",
  "altLabel": [
    "단부",
    "개구부",
    "작업발판의 끝",
    "슬래브 끝"
  ],
  "conditionAxis": "현장·공간",
  "description": "작업발판·통로의 끝이나 바닥 개구부 가까이에서의 작업.",
  "conditionRules": [
    {
      "requirement": "① 사업주는 작업발판 및 통로의 끝이나 개구부로서 근로자가 추락할 위험이 있는 장소에는 안전난간, 울타리, 수직형 추락방망 또는 덮개 등(이하 이 조에서 \"난간등\"이라 한다)의 방호 조치를 충분한 강도를 가진 구조로 튼튼하게 설치하여야 하며, 덮개를 설치하는 경우에는 뒤집히거나 떨어지지 않도록 설치하여야 한다. 이 경우 어두운 장소에서도 알아볼 수 있도록 개구부임을 표시해야 하며, 수직형 추락방망은 한국산업표준에서 정하는 성능기준에 적합한 것을 사용해야 한다. <개정 2019.12.26, 2022.10.18>",
      "basisArticle": "art:기준규칙:43",
      "paragraph": 1,
      "legalWeight": "mandatory"
    },
    {
      "requirement": "② 사업주는 난간등을 설치하는 것이 매우 곤란하거나 작업의 필요상 임시로 난간등을 해체하여야 하는 경우 제42조제2항 각 호의 기준에 맞는 추락방호망을 설치하여야 한다. 다만, 추락방호망을 설치하기 곤란한 경우에는 근로자에게 안전대를 착용하도록 하는 등 추락할 위험을 방지하기 위하여 필요한 조치를 하여야 한다. <개정 2017.12.28>",
      "basisArticle": "art:기준규칙:43",
      "paragraph": 2,
      "legalWeight": "mandatory"
    }
  ],
  "regulatedBy": [
    "art:기준규칙:43"
  ],
  "_meta": {
    "createdAt": "2026-11-16",
    "note": "조치 문장은 법령·KOSHA Guide 원문 줄을 그대로 옮겼다(머리 문장과 호를 함께 쓸 때는 ' … ' 로 이음). threshold 는 그 문장 안의 기준값 구절. appliesToActivity·appliesTo 는 조문이 그 작업·공종을 가리키는 경우에만 적었고, 없으면 작업 종류와 무관하게 적용되는 조치다.",
    "linkBasis": {
      "regulatedBy": "source",
      "appliesToActivity": "editorial",
      "appliesTo": "editorial"
    }
  }
}
