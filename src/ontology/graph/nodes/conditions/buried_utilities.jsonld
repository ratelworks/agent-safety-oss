{
  "@context": "../../context.jsonld",
  "@id": "workcond:buried_utilities",
  "@type": "WorkCondition",
  "title": "지하매설물",
  "altLabel": [
    "매설물",
    "지하 매설물",
    "매설관",
    "매설배관"
  ],
  "conditionAxis": "현장·공간",
  "description": "굴착 범위나 그 가까이에 매설물이 있는 경우.",
  "conditionRules": [
    {
      "requirement": "① 사업주는 매설물ㆍ조적벽ㆍ콘크리트벽 또는 옹벽 등의 건설물에 근접한 장소에서 굴착작업을 할 때에 해당 가설물의 파손 등에 의하여 근로자가 위험해질 우려가 있는 경우에는 해당 건설물을 보강하거나 이설하는 등 해당 위험을 방지하기 위한 조치를 하여야 한다.",
      "basisArticle": "art:기준규칙:341",
      "paragraph": 1,
      "legalWeight": "mandatory",
      "appliesToActivity": [
        "activity:excavation_2m_plus",
        "activity:underground_utility"
      ]
    },
    {
      "requirement": "② 사업주는 굴착작업에 의하여 노출된 매설물 등이 파손됨으로써 근로자가 위험해질 우려가 있는 경우에는 해당 매설물 등에 대한 방호조치를 하거나 이설하는 등 필요한 조치를 하여야 한다.",
      "basisArticle": "art:기준규칙:341",
      "paragraph": 2,
      "legalWeight": "mandatory",
      "appliesToActivity": [
        "activity:excavation_2m_plus",
        "activity:underground_utility"
      ]
    },
    {
      "requirement": "③ 사업주는 제2항의 매설물 등의 방호작업에 대하여 관리감독자에게 해당 작업을 지휘하도록 하여야 한다. <개정 2019.12.26>",
      "basisArticle": "art:기준규칙:341",
      "paragraph": 3,
      "legalWeight": "mandatory",
      "appliesToActivity": [
        "activity:excavation_2m_plus",
        "activity:underground_utility"
      ]
    }
  ],
  "regulatedBy": [
    "art:기준규칙:341"
  ],
  "guidedBy": [
    "doc:kosha_guide/G-29-2011"
  ],
  "_meta": {
    "createdAt": "2026-11-16",
    "note": "조치 문장은 법령·KOSHA Guide 원문 줄을 그대로 옮겼다(머리 문장과 호를 함께 쓸 때는 ' … ' 로 이음). threshold 는 그 문장 안의 기준값 구절. appliesToActivity·appliesTo 는 조문이 그 작업·공종을 가리키는 경우에만 적었고, 없으면 작업 종류와 무관하게 적용되는 조치다.",
