      "safety:belongsToLayer": {
        "@id": "safety:layer/dynamic"
      },
      "safety:enforcement": "must",
      "safety:policyText": "필수 입력이 부족하면 LLM은 임의로 채우지 않고 사용자에게 짧은 질문을 하거나 A2UI 폼을 호출한다."
    },
    {
      "@id": "safety:policy/human_fallback_threshold",
