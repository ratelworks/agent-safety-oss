  "@graph": [
    {
      "@id": "https://safety.ratelworks.org/operational-profile/v1",
      "@type": [
        "owl:Ontology",
        "safety:OperationalProfile"
      ],
      "owl:versionIRI": {
        "@id": "https://safety.ratelworks.org/operational-profile/v1.0.0"
      },
      "owl:versionInfo": "1.0.0 — lightweight operational ontology profile for Korean construction safety MCP",
      "dcterms:created": {
        "@value": "2026-05-04",
        "@type": "xsd:date"
      },
      "dcterms:creator": "Ratelworks Inc.",
      "dcterms:contributor": "Hwangryong Construction Co., Ltd. — Safety & Health Planning Department",
      "dcterms:license": {
        "@id": "https://opensource.org/licenses/MIT"
      },
      "rdfs:label": [
        {
          "@value": "Operational Ontology Profile for Construction Safety MCP",
          "@language": "en"
        },
        {
          "@value": "건설안전 MCP 운영 온톨로지 프로파일",
          "@language": "ko"
        }
      ],
      "rdfs:comment": [
        {
          "@value": "Vendor-neutral operational profile that binds the semantic graph, kinetic MCP actions, and dynamic LLM harness contract without adding graph database or platform lock-in.",
          "@language": "en"
        },
        {
          "@value": "그래프 DB나 특정 플랫폼 의존 없이 Semantic 그래프, Kinetic MCP 액션, Dynamic LLM 하네스 계약을 묶는 벤더 중립 운영 프로파일.",
          "@language": "ko"
        }
      ],
      "safety:profileGoal": "중소 건설사가 법령·문서·위험·통제·증거를 환각 없이 조회하고, MCP 도구로 작성·검토·증빙·조치를 실행할 수 있게 한다.",
      "safety:dynamicBoundary": "LLM은 자연어 해석, 도구 조합, 설명, 누락 질문만 수행한다. 법령 근거·필수 의무·검증 결과는 그래프와 MCP 도구에서만 나온다.",
      "safety:stackPosition": "L4 Reference Implementation",
      "safety:governedBy": {
        "@id": "agenthq:constitution/ontology-layer"
      },
      "safety:extendsCore": {
        "@id": "https://agenthq.ratelworks.org/ontology/core/v1"
      },
      "safety:dependsOnPack": {
        "@id": "agenthq:domain-pack/construction-common"
      },
      "safety:implementsDomainPack": {
        "@id": "agenthq:domain-pack/safety"
      },
      "safety:notAuthorityFor": [
        "AgentHQ Ontology Constitution",
        "AgentHQ Core",
        "construction-common foundation pack"
      ],
      "safety:promotionBoundary": "검증된 운영 패턴은 상위 Core 또는 construction-common으로 승격될 수 있지만 안전 법령·문서·위험 지식은 safety domain pack에 남는다."
    },

