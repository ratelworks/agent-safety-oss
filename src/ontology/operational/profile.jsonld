    {
      "@id": "safety:policy/no_generated_legal_basis",
      "@type": [
        "safety:HarnessPolicy",
        "owl:NamedIndividual"
      ],
      "safety:belongsToLayer": {
        "@id": "safety:layer/dynamic"
      },
      "safety:enforcement": "must",
      "safety:policyText": "LLM은 법령 근거를 생성하지 않는다. 반드시 graph node, MCP tool result, 또는 verify_safety_basis 결과를 사용한다."
    },
    {
      "@id": "safety:policy/cite_graph_sources",
      "@type": [
        "safety:HarnessPolicy",
        "owl:NamedIndividual"
      ],
      "safety:belongsToLayer": {
        "@id": "safety:layer/dynamic"
      },
      "safety:enforcement": "must",
      "safety:policyText": "최종 답변은 docId, article IRI, KOSHA guide code, evidence id 중 하나 이상의 lineage를 포함한다."
    },
    {
      "@id": "safety:policy/ask_missing_required_fields",
      "@type": [
        "safety:HarnessPolicy",
        "owl:NamedIndividual"
